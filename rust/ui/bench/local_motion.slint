import "../fonts/PressStart2P-Regular.ttf";

export component LocalMotion inherits Window {
    width: 960px;
    height: 540px;
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 2000) / 2000;

    Text {
        x: 32px;
        y: 24px;
        text: "bench: local_motion";
        font-size: 22px;
        color: #e8ecff;
    }

    Rectangle {
        x: 32px;
        y: 80px;
        width: parent.width - 64px;
        height: parent.height - 110px;
        background: #131c33;
        border-radius: 0px;
    }

    Rectangle {
        width: 48px;
        height: 48px;
        y: 90px;
        x: 40px + (parent.width - 128px) * root.phase;
        border-radius: 0px;
        background: #ff5d73;
    }
}
