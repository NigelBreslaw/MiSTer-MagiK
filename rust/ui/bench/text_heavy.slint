import { MisterWindow, MisterUi } from "../mister_window.slint";
export { MisterUi }
import "../fonts/PressStart2P-Regular.ttf";

export component TextHeavy inherits MisterWindow {
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <int> s: MisterUi.scale;
    property <duration> tick: animation-tick();
    property <int> scroll: Math.floor(Math.mod(tick / 1ms, 8000) / 8000 * 8);

    Text {
        x: 32px * s;
        y: 20px * s;
        text: "bench: text_heavy (scroll " + scroll + ")";
        font-size: 24px * s;
        color: #e8ecff;
    }

    VerticalLayout {
        x: 32px * s;
        y: 60px * s;
        width: parent.width - 64px * s;
        spacing: 3px * s;

        for i in 32: Text {
            text: "Line " + (i + scroll) + ": The quick brown fox jumps over the lazy dog — 0123456789";
            font-size: 16px * s;
            color: #c8d0f0;
        }
    }
}
