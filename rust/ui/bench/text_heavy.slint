// Many text primitives — glyph embedding / layout stress.
import "../fonts/DejaVuSans.ttf";

export component TextHeavy inherits Window {
    width: 1920px;
    height: 1080px;
    background: #0b1020;
    default-font-family: "DejaVu Sans";

    property <duration> tick: animation-tick();
    property <int> scroll: Math.floor(Math.mod(tick / 1ms, 8000) / 8000 * 8);

    Text {
        x: 64px;
        y: 40px;
        text: "bench: text_heavy (scroll " + scroll + ")";
        font-size: 40px;
        color: #e8ecff;
    }

    VerticalLayout {
        x: 64px;
        y: 120px;
        width: parent.width - 128px;
        spacing: 6px;

        for i in 32: Text {
            text: "Line " + (i + scroll) + ": The quick brown fox jumps over the lazy dog — 0123456789";
            font-size: 22px;
            color: #c8d0f0;
        }
    }
}
