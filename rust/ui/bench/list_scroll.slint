// List-style bench: ListView + `for` rows (auto scroll via viewport-y).
// All lengths are base units × ui-scale (1 = 960×540, 2 = 1920×1080).
import { ListView } from "std-widgets.slint";
import { MisterWindow, MisterUi } from "../mister_window.slint";
export { MisterUi }
import "../fonts/PressStart2P-Regular.ttf";

export component ListScroll inherits MisterWindow {
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <int> s: MisterUi.scale;
    property <int> row-count: 8 * 10;
    property <length> row-height: 56px * s;
    property <length> list-height: 350px * s;
    property <length> panel-width: 896px * s;

    property <length> attack-animation: (500px * s * animation-tick() / 20s).mod(500px * s);

    changed attack-animation => {
        scroll-panel.viewport-y = -attack-animation;
    }

    Text {
        x: 32px * s;
        y: 24px * s;
        text: "bench: list_scroll (ListView + for)";
        font-size: 24px * s;
        color: #e8ecff;
    }

    scroll-panel := ListView {
        x: 32px * s;
        y: 80px * s;
        width: panel-width;
        height: list-height;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-height: row-height * row-count;
        viewport-width: self.width;
        mouse-drag-pan-enabled: true;

        for row[i] in row-count: Rectangle {
            height: row-height;
            width: panel-width;

            Text {
                x: 10px * s;
                y: (root.row-height - self.height) / 2;
                text: "Row \{i} — MiSTer list item";
                font-size: 24px * s;
                color: (mod(i, 2) == 0 ? white : #6b6b6b);
            }
        }
    }
}
