import { ScrollView } from "std-widgets.slint";
import "../fonts/PressStart2P-Regular.ttf";

export component ListScroll inherits Window {
    width: 960px;
    height: 540px;
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <int> row-count: 56;
    property <length> row-height: 24px;
    property <length> list-height: 440px;
    property <length> panel-width: 896px;
    property <length> content-height: row-count * row-height;
    property <length> scroll-max: max(0px, content-height - list-height);

    property <duration> tick: animation-tick();
    property <int> tick-ms: Math.floor(tick / 1ms);
    property <float> phase: Math.mod(tick / 1ms, 12000) / 12000;
    property <float> tri: phase < 0.5 ? phase * 2 : 2 - phase * 2;
    property <length> scroll-pos: scroll-max * tri;
    property <int> top-row: Math.floor(scroll-pos / row-height);

    Text {
        x: 32px;
        y: 24px;
        text: "bench: list_scroll (ScrollView + for)";
        font-size: 20px;
        color: #e8ecff;
    }

    Text {
        x: 32px;
        y: 50px;
        text: "scroll " + (scroll-pos / 1px) + " / " + (scroll-max / 1px) + " px · top row " + top-row + " · tick " + tick-ms;
        font-size: 12px;
        color: #8b93b8;
    }

    Rectangle {
        x: parent.width - 24px;
        y: 80px + list-height * tri;
        width: 12px;
        height: 12px;
        border-radius: 0px;
        background: #ff5d73;
    }

    scroll-panel := ScrollView {
        x: 32px;
        y: 80px;
        width: panel-width;
        height: list-height;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-height: content-height;
        viewport-y: -scroll-pos;

        VerticalLayout {
            width: panel-width;
            spacing: 0;

            for row[i] in row-count: Rectangle {
                height: row-height;
                width: panel-width;
                background: i == top-row ? #ff5d73 : (mod(i, 2) == 0 ? #151f38 : #1c2a4a);

                Text {
                    x: 10px;
                    y: (root.row-height - self.height) / 2;
                    text: "Row " + i + " — MiSTer list item " + (i * 7 + 13);
                    font-size: 13px;
                    color: i == top-row ? #0b1020 : #d8e0ff;
                }
            }
        }
    }
}
