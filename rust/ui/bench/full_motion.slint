import "../fonts/PressStart2P-Regular.ttf";

export component FullMotion inherits Window {
    width: 960px;
    height: 540px;
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 4000) / 4000;
    property <float> bounce: phase < 0.5 ? phase * 2 : 2 - phase * 2;
    property <float> angle: Math.mod(tick / 1ms, 3000) / 3000 * 360;

    Text {
        x: 32px;
        y: 24px;
        text: "bench: full_motion";
        font-size: 22px;
        color: #e8ecff;
    }

    Rectangle {
        x: 32px;
        y: 100px;
        width: parent.width - 64px;
        height: 48px;
        background: #131c33;
        border-radius: 0px;
        clip: true;

        Rectangle {
            width: 140px;
            height: parent.height - 12px;
            y: 6px;
            x: 6px + (parent.width - 140px - 12px) * root.bounce;
            border-radius: 0px;
            background: @linear-gradient(90deg, #ff5d73 0%, #ffd166 50%, #06d6a0 100%);
        }
    }

    Rectangle {
        x: parent.width / 2 - 110px;
        y: 210px;
        width: 220px;
        height: 220px;

        for i in 12: Rectangle {
            property <angle> a: (root.angle + i * 30) * 1deg;
            width: 13px;
            height: 13px;
            border-radius: 0px;
            x: parent.width / 2 - 6px + 90px * Math.cos(a);
            y: parent.height / 2 - 6px + 90px * Math.sin(a);
            background: #4cc9f0;
            opacity: 0.4 + 0.6 * (i / 12.0);
        }
    }
}
