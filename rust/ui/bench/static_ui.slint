// Static layout — no animation-tick (minimal dirty region after first frame).
import "../fonts/DejaVuSans.ttf";

export component StaticUi inherits Window {
    width: 1920px;
    height: 1080px;
    background: #0b1020;
    default-font-family: "DejaVu Sans";

    Text {
        x: 64px;
        y: 48px;
        text: "bench: static_ui";
        font-size: 44px;
        color: #e8ecff;
    }

    Rectangle {
        x: 64px;
        y: 200px;
        width: parent.width - 128px;
        height: 96px;
        background: #1a2744;
        border-radius: 14px;

        Text {
            x: 24px;
            y: 24px;
            text: "No animation — measures idle repaint / fbcon persistence";
            font-size: 26px;
            color: #8b93b8;
        }
    }

    Rectangle {
        x: 64px;
        y: 360px;
        width: 400px;
        height: 400px;
        background: #2d6a4f;
        border-radius: 8px;
    }

    Rectangle {
        x: 520px;
        y: 360px;
        width: 400px;
        height: 400px;
        background: #9d4edd;
        border-radius: 8px;
    }
}
