import "../fonts/PressStart2P-Regular.ttf";

export component StaticUi inherits Window {
    width: 960px;
    height: 540px;
    background: #0b1020;
    default-font-family: "Press Start 2P";

    Text {
        x: 32px;
        y: 24px;
        text: "bench: static_ui";
        font-size: 22px;
        color: #e8ecff;
    }

    Rectangle {
        x: 32px;
        y: 100px;
        width: parent.width - 64px;
        height: 48px;
        background: #1a2744;
        border-radius: 0px;

        Text {
            x: 12px;
            y: 12px;
            text: "No animation — measures idle repaint / fbcon persistence";
            font-size: 13px;
            color: #8b93b8;
        }
    }

    Rectangle {
        x: 32px;
        y: 180px;
        width: 200px;
        height: 200px;
        background: #2d6a4f;
        border-radius: 0px;
    }

    Rectangle {
        x: 260px;
        y: 180px;
        width: 200px;
        height: 200px;
        background: #9d4edd;
        border-radius: 0px;
    }
}
