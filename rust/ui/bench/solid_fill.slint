// Large solid fills and borders — rectangle rasterization, little text.
import "../fonts/DejaVuSans.ttf";

export component SolidFill inherits Window {
    width: 1920px;
    height: 1080px;
    background: #101018;
    default-font-family: "DejaVu Sans";

    property <duration> tick: animation-tick();
    property <int> phase: Math.mod(tick / 1ms, 3000) / 3000 * 4;

    Text {
        x: 64px;
        y: 32px;
        text: "bench: solid_fill";
        font-size: 36px;
        color: #ffffff;
    }

    // Quadrants cycle hue each second (moderate dirty area, no full-width bar).
    Rectangle {
        x: 0;
        y: 100px;
        width: parent.width / 2;
        height: (parent.height - 100px) / 2;
        background: root.phase == 0 ? #ff0000 : (root.phase == 1 ? #cc0000 : #990000);
    }
    Rectangle {
        x: parent.width / 2;
        y: 100px;
        width: parent.width / 2;
        height: (parent.height - 100px) / 2;
        background: root.phase == 1 ? #00ff00 : (root.phase == 2 ? #00cc00 : #009900);
    }
    Rectangle {
        x: 0;
        y: 100px + (parent.height - 100px) / 2;
        width: parent.width / 2;
        height: (parent.height - 100px) / 2;
        background: root.phase == 2 ? #0000ff : (root.phase == 3 ? #0000cc : #000099);
    }
    Rectangle {
        x: parent.width / 2;
        y: 100px + (parent.height - 100px) / 2;
        width: parent.width / 2;
        height: (parent.height - 100px) / 2;
        background: root.phase == 3 ? #ffff00 : (root.phase == 0 ? #cccc00 : #999900);
    }

    Rectangle {
        x: 0;
        y: 100px;
        width: parent.width;
        height: 4px;
        background: #ffffff;
    }
}
