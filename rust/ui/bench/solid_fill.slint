import "../fonts/PressStart2P-Regular.ttf";

export component SolidFill inherits Window {
    width: 960px;
    height: 540px;
    background: #101018;
    default-font-family: "Press Start 2P";

    property <duration> tick: animation-tick();
    property <int> phase: Math.mod(tick / 1ms, 3000) / 3000 * 4;

    Text {
        x: 32px;
        y: 16px;
        text: "bench: solid_fill";
        font-size: 18px;
        color: #ffffff;
    }

    Rectangle {
        x: 0;
        y: 50px;
        width: parent.width / 2;
        height: (parent.height - 50px) / 2;
        background: root.phase == 0 ? #ff0000 : (root.phase == 1 ? #cc0000 : #990000);
    }
    Rectangle {
        x: parent.width / 2;
        y: 50px;
        width: parent.width / 2;
        height: (parent.height - 50px) / 2;
        background: root.phase == 1 ? #00ff00 : (root.phase == 2 ? #00cc00 : #009900);
    }
    Rectangle {
        x: 0;
        y: 50px + (parent.height - 50px) / 2;
        width: parent.width / 2;
        height: (parent.height - 50px) / 2;
        background: root.phase == 2 ? #0000ff : (root.phase == 3 ? #0000cc : #000099);
    }
    Rectangle {
        x: parent.width / 2;
        y: 50px + (parent.height - 50px) / 2;
        width: parent.width / 2;
        height: (parent.height - 50px) / 2;
        background: root.phase == 3 ? #ffff00 : (root.phase == 0 ? #cccc00 : #999900);
    }

    Rectangle {
        x: 0;
        y: 50px;
        width: parent.width;
        height: 2px;
        background: #ffffff;
    }
}
