// Controller setup overlay — new pad detection and USB port change rebinding.
component ConfigRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 24px;
    padding: 6px;

    Text {
        text: label;
        color: #9080a8;
        font-size: 22px;
        min-width: 260px;
        horizontal-alignment: left;
    }

    Text {
        text: value;
        color: #e8e0f0;
        font-size: 22px;
        horizontal-alignment: left;
        wrap: word-wrap;
    }
}

export component SetupOverlay inherits Rectangle {
    in property <int> phase;
    // 1=detected, 2=new-or-existing, 3=pick-existing, 4=configure, 5=name-kind
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> list-items;
    in property <int> list-selected;
    in property <[string]> config-labels;
    in property <[string]> config-values;
    in property <string> setup-name;
    in property <string> setup-kind-label;

    background: #1a1424e0;

    VerticalLayout {
        padding: 48px;
        spacing: 24px;
        alignment: center;

        Text {
            text: title;
            color: #e8e0f0;
            font-size: 44px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        if phase != 4 && phase != 5 : Text {
            text: subtitle;
            color: #9080a8;
            font-size: 26px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if phase == 2 : HorizontalLayout {
            spacing: 48px;
            alignment: center;

            Rectangle {
                width: 360px;
                height: 120px;
                border-radius: 16px;
                border-width: 4px;
                border-color: list-selected == 0 ? #06d6a0 : #5c4a72;
                background: list-selected == 0 ? #2a2236 : #1e1828;

                Text {
                    text: "New controller";
                    color: list-selected == 0 ? #06d6a0 : #e8e0f0;
                    font-size: 28px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 360px;
                height: 120px;
                border-radius: 16px;
                border-width: 4px;
                border-color: list-selected == 1 ? #06d6a0 : #5c4a72;
                background: list-selected == 1 ? #2a2236 : #1e1828;

                Text {
                    text: "Existing controller";
                    color: list-selected == 1 ? #06d6a0 : #e8e0f0;
                    font-size: 28px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if phase == 3 : VerticalLayout {
            spacing: 12px;
            alignment: center;

            for item[i] in list-items : Rectangle {
                width: 900px;
                height: 72px;
                border-radius: 12px;
                border-width: list-selected == i ? 4px : 2px;
                border-color: list-selected == i ? #06d6a0 : #5c4a72;
                background: list-selected == i ? #2a2236 : #1e1828;

                Text {
                    text: item;
                    color: list-selected == i ? #06d6a0 : #e8e0f0;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if phase == 4 : VerticalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            Text {
                text: subtitle;
                color: #06d6a0;
                font-size: 22px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                width: 1100px;
                vertical-stretch: 1;
                border-radius: 12px;
                border-width: 2px;
                border-color: #5c4a72;
                background: #1e1828;

                Flickable {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 2px;

                        for label[i] in config-labels : ConfigRow {
                            label: label;
                            value: config-values[i];
                        }
                    }
                }
            }
        }

        if phase == 5 : VerticalLayout {
            spacing: 24px;
            alignment: center;

            Text {
                text: subtitle;
                color: #9080a8;
                font-size: 22px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Name";
                    color: #9080a8;
                    font-size: 20px;
                    horizontal-alignment: left;
                }

                Rectangle {
                    width: 900px;
                    height: 72px;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: #5c4a72;
                    background: #1e1828;

                    Text {
                        text: setup-name;
                        color: #e8e0f0;
                        font-size: 26px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                alignment: center;

                Text {
                    text: "Type";
                    color: #9080a8;
                    font-size: 20px;
                    horizontal-alignment: left;
                }

                Rectangle {
                    width: 900px;
                    height: 72px;
                    border-radius: 12px;
                    border-width: 4px;
                    border-color: #06d6a0;
                    background: #2a2236;

                    Text {
                        text: setup-kind-label;
                        color: #06d6a0;
                        font-size: 28px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: phase == 1 ? "Press any button to continue"
                : phase == 2 ? "D-pad: choose  ·  A: confirm"
                : phase == 3 ? "D-pad: choose  ·  A: confirm"
                : phase == 4 ? "A: continue to naming"
                : phase == 5 ? "D-pad: change type  ·  A: save"
                : "";
            color: #706080;
            font-size: 20px;
            horizontal-alignment: center;
        }
    }
}
