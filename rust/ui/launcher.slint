import { MisterBridge } from "mister_bridge.slint";
import { ControllerPanel } from "controller_test.slint";
import { SetupOverlay } from "controller_setup.slint";
import "fonts/PressStart2P-Regular.ttf";
export { MisterBridge }

component LauncherTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <bool> focused;

    border-width: focused ? 3px : 2px;
    border-color: focused ? #06d6a0 : #5c4a72;
    border-radius: 0px;
    background: focused ? #2a2236 : #1e1828;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        Text {
            text: label;
            color: focused ? #06d6a0 : #e8e0f0;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: subtitle;
            color: #9080a8;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}

component HomeGrid inherits Rectangle {
    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "MiSTer Magic";
            color: #e8e0f0;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;

            VerticalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                LauncherTile {
                    vertical-stretch: 1;
                    label: "Controller Test";
                    subtitle: "Press A";
                    focused: MisterBridge.selected-index == 0;
                }

                LauncherTile {
                    vertical-stretch: 1;
                    label: "Pac-Man";
                    subtitle: "Arcade";
                    focused: MisterBridge.selected-index == 2;
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                LauncherTile {
                    vertical-stretch: 1;
                    label: "Donkey Kong";
                    subtitle: "Arcade";
                    focused: MisterBridge.selected-index == 1;
                }

                LauncherTile {
                    vertical-stretch: 1;
                    label: "Galaga";
                    subtitle: "Arcade";
                    focused: MisterBridge.selected-index == 3;
                }
            }
        }

        Text {
            text: "D-pad: move  ·  A: select  ·  Home: back";
            color: #706080;
            font-size: 9px;
            horizontal-alignment: center;
        }
    }
}

export component Launcher inherits Window {
    preferred-width: 960px;
    preferred-height: 540px;
    default-font-family: "Press Start 2P";
    title: "MiSTer Magic Launcher";
    background: #1a1424;

    if MisterBridge.screen-mode == 0 : HomeGrid {
        width: 100%;
        height: 100%;
    }

    if MisterBridge.screen-mode == 1 : ControllerPanel { }

    if MisterBridge.setup-visible : SetupOverlay {
        phase: MisterBridge.setup-phase;
        title: MisterBridge.setup-title;
        subtitle: MisterBridge.setup-subtitle;
        list-items: MisterBridge.setup-list;
        list-selected: MisterBridge.setup-selected;
        config-labels: MisterBridge.setup-config-labels;
        config-values: MisterBridge.setup-config-values;
        setup-name: MisterBridge.setup-name;
        setup-kind-label: MisterBridge.setup-kind-label;
    }

    if MisterBridge.loading-message != "": Rectangle {
        background: #1a1424;

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: MisterBridge.loading-message;
                color: #e8e0f0;
                font-size: 21px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Text {
                text: "Please wait…";
                color: #9080a8;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
    }
}
