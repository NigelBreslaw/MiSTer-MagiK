import { MisterBridge } from "mister_bridge.slint";
import "fonts/PressStart2P-Regular.ttf";
export { MisterBridge }

// Palette — flat fills only (software renderer friendly).
global ControllerColors {
    out property <brush> shell: #9a8aa8;
    out property <brush> shell-dark: #7a6a88;
    out property <brush> shell-line: #5c4a72;
    out property <brush> well: #6a5a78;
    out property <brush> btn-idle: #b8aec8;
    out property <brush> btn-pressed: #06d6a0;
    out property <brush> btn-border: #5c4a72;
    out property <brush> label: #2a2236;
    out property <brush> label-light: #e8e0f0;
}

component CircleBtn inherits Rectangle {
    in property <bool> pressed;
    in property <string> caption;
    in property <length> btn-size: 28px;
    width: btn-size;
    height: btn-size;
    border-radius: btn-size / 2;
    background: pressed ? ControllerColors.btn-pressed : ControllerColors.btn-idle;
    border-width: 1px;
    border-color: pressed ? #048a68 : ControllerColors.btn-border;

    Text {
        y: parent.height + 3px;
        width: parent.width + 20px;
        x: -10px;
        text: caption;
        color: ControllerColors.label-light;
        font-size: 7px;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component DpadArm inherits Rectangle {
    in property <bool> pressed;
    width: 18px;
    height: 18px;
    border-radius: 2px;
    background: pressed ? ControllerColors.btn-pressed : ControllerColors.btn-idle;
    border-width: 1px;
    border-color: pressed ? #048a68 : ControllerColors.btn-border;
}

component Dpad inherits Rectangle {
    in property <bool> up;
    in property <bool> down;
    in property <bool> left;
    in property <bool> right;
    width: 74px;
    height: 74px;

    // Circular well
    Rectangle {
        width: 74px;
        height: 74px;
        border-radius: 37px;
        background: ControllerColors.well;
        border-width: 1px;
        border-color: ControllerColors.shell-line;
    }

    DpadArm {
        x: 28px;
        y: 4px;
        pressed: up;
    }
    DpadArm {
        x: 28px;
        y: 52px;
        pressed: down;
    }
    DpadArm {
        x: 4px;
        y: 28px;
        pressed: left;
    }
    DpadArm {
        x: 52px;
        y: 28px;
        pressed: right;
    }

    // Center hub
    Rectangle {
        x: 26px;
        y: 26px;
        width: 22px;
        height: 22px;
        border-radius: 2px;
        background: ControllerColors.well;
        border-width: 1px;
        border-color: ControllerColors.shell-line;
    }
}

component StickWell inherits Rectangle {
    in property <float> stick-x;
    in property <float> stick-y;
    width: 65px;
    height: 65px;
    border-radius: 32px;
    background: ControllerColors.well;
    border-width: 1px;
    border-color: ControllerColors.shell-line;

    // Crosshair ring
    Rectangle {
        x: 32px;
        y: 10px;
        width: 1px;
        height: 45px;
        background: ControllerColors.shell-line;
    }
    Rectangle {
        x: 10px;
        y: 32px;
        width: 45px;
        height: 1px;
        background: ControllerColors.shell-line;
    }

    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: ControllerColors.btn-pressed;
        border-width: 1px;
        border-color: #048a68;
        x: (parent.width - self.width) / 2 + stick-x * 18px;
        y: (parent.height - self.height) / 2 + stick-y * 18px;
    }
}

component ShoulderBtn inherits Rectangle {
    in property <bool> pressed;
    in property <string> caption;
    width: 70px;
    height: 14px;
    border-radius: 5px;
    background: pressed ? ControllerColors.btn-pressed : ControllerColors.btn-idle;
    border-width: 1px;
    border-color: pressed ? #048a68 : ControllerColors.btn-border;

    Text {
        text: caption;
        color: ControllerColors.label;
        font-size: 6px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PillBtn inherits Rectangle {
    in property <bool> pressed;
    in property <string> caption;
    width: 44px;
    height: 13px;
    border-radius: 6px;
    background: pressed ? ControllerColors.btn-pressed : ControllerColors.btn-idle;
    border-width: 1px;
    border-color: pressed ? #048a68 : ControllerColors.btn-border;

    Text {
        y: parent.height + 4px;
        width: parent.width;
        text: caption;
        color: ControllerColors.label-light;
        font-size: 6px;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component SysBtn inherits Rectangle {
    in property <bool> pressed;
    in property <bool> available: true;
    in property <string> caption;
    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: !available ? #5a5068 : (pressed ? ControllerColors.btn-pressed : ControllerColors.btn-idle);
    border-width: 1px;
    border-color: !available ? #4a4058 : (pressed ? #048a68 : ControllerColors.btn-border);
    opacity: available ? 1.0 : 0.55;

    Text {
        y: parent.height + 3px;
        width: parent.width + 20px;
        x: -10px;
        text: available ? caption : caption + " (n/a)";
        color: ControllerColors.label-light;
        font-size: 5px;
        font-weight: 700;
        horizontal-alignment: center;
    }
}

component FaceCluster inherits Rectangle {
    in property <bool> btn-x;
    in property <bool> btn-y;
    in property <bool> btn-a;
    in property <bool> btn-b;
    width: 100px;
    height: 100px;

    // Diagonal pairing accents (X–Y and A–B), like the reference drawing.
    Rectangle {
        x: 9px;
        y: 19px;
        width: 36px;
        height: 62px;
        border-radius: 18px;
        background: #88789820;
        border-width: 1px;
        border-color: ControllerColors.shell-line;
    }
    Rectangle {
        x: 55px;
        y: 19px;
        width: 36px;
        height: 62px;
        border-radius: 18px;
        background: #88789820;
        border-width: 1px;
        border-color: ControllerColors.shell-line;
    }

    // SNES diamond: X top, Y left, A right, B bottom.
    CircleBtn {
        x: 36px;
        y: 4px;
        caption: "X";
        pressed: btn-x;
    }
    CircleBtn {
        x: 4px;
        y: 36px;
        caption: "Y";
        pressed: btn-y;
    }
    CircleBtn {
        x: 68px;
        y: 36px;
        caption: "A";
        pressed: btn-a;
    }
    CircleBtn {
        x: 36px;
        y: 68px;
        caption: "B";
        pressed: btn-b;
    }
}

// Dog-bone controller shell with SNES layout + analog stick lobes.
component ControllerBody inherits Rectangle {
    in property <bool> dpad-up;
    in property <bool> dpad-down;
    in property <bool> dpad-left;
    in property <bool> dpad-right;
    in property <bool> btn-a;
    in property <bool> btn-b;
    in property <bool> btn-x;
    in property <bool> btn-y;
    in property <bool> btn-l;
    in property <bool> btn-r;
    in property <bool> btn-zl;
    in property <bool> btn-zr;
    in property <bool> btn-select;
    in property <bool> btn-start;
    in property <bool> btn-home;
    in property <bool> btn-capture;
    in property <bool> capture-available;
    in property <float> left-x;
    in property <float> left-y;
    in property <float> right-x;
    in property <float> right-y;

    width: 590px;
    height: 270px;

    // Main torso
    Rectangle {
        y: 1px;
        width: 590px;
        height: 180px;
        border-radius: 40px;
        background: ControllerColors.shell;
        border-width: 2px;
        border-color: ControllerColors.shell-line;
    }

    // Bottom lobes (stick wells extend the dog-bone silhouette)
    Rectangle {
        x: 65px;
        y: 140px;
        width: 90px;
        height: 90px;
        border-radius: 45px;
        background: ControllerColors.shell;
        border-width: 2px;
        border-color: ControllerColors.shell-line;
    }
    Rectangle {
        x: 435px;
        y: 140px;
        width: 90px;
        height: 90px;
        border-radius: 45px;
        background: ControllerColors.shell;
        border-width: 2px;
        border-color: ControllerColors.shell-line;
    }

    // Top-center grip recess
    Rectangle {
        x: 245px;
        y: 6px;
        width: 100px;
        height: 18px;
        border-radius: 9px;
        background: ControllerColors.shell-dark;
        border-width: 1px;
        border-color: ControllerColors.shell-line;
    }

    // Shoulder buttons along top edge
    ShoulderBtn {
        x: 40px;
        y: 26px;
        caption: "L";
        pressed: btn-l;
    }
    ShoulderBtn {
        x: 480px;
        y: 26px;
        caption: "R";
        pressed: btn-r;
    }

    // ZL / ZR (smaller, inset — not on classic SNES diagram but on the pad)
    ShoulderBtn {
        x: 40px;
        y: 44px;
        width: 50px;
        height: 11px;
        caption: "ZL";
        pressed: btn-zl;
    }
    ShoulderBtn {
        x: 500px;
        y: 44px;
        width: 50px;
        height: 11px;
        caption: "ZR";
        pressed: btn-zr;
    }

    // D-pad (left)
    Dpad {
        x: 85px;
        y: 60px;
        up: dpad-up;
        down: dpad-down;
        left: dpad-left;
        right: dpad-right;
    }

    // Face buttons (right) — SNES diamond
    FaceCluster {
        x: 390px;
        y: 50px;
        btn-x: btn-x;
        btn-y: btn-y;
        btn-a: btn-a;
        btn-b: btn-b;
    }

    // Center: home / capture (above select / start)
    SysBtn {
        x: 260px;
        y: 77px;
        caption: "Home";
        pressed: btn-home;
    }
    SysBtn {
        x: 310px;
        y: 77px;
        caption: "Capture";
        pressed: btn-capture;
        available: capture-available;
    }

    // Center: select / start
    PillBtn {
        x: 235px;
        y: 105px;
        caption: "SELECT";
        pressed: btn-select;
    }
    PillBtn {
        x: 310px;
        y: 105px;
        caption: "START";
        pressed: btn-start;
    }

    // Analog sticks in bottom lobes
    StickWell {
        x: 77px;
        y: 152px;
        stick-x: left-x;
        stick-y: left-y;
    }
    StickWell {
        x: 447px;
        y: 152px;
        stick-x: right-x;
        stick-y: right-y;
    }
}

export component ControllerPanel inherits Rectangle {
    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: MisterBridge.device-name;
                    color: #e8e0f0;
                    font-size: 13px;
                    font-weight: 700;
                }
                Text {
                    text: "input test";
                    color: #9080a8;
                    font-size: 9px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                spacing: 3px;
                alignment: end;
                Text {
                    text: "USB " + MisterBridge.usb-port;
                    color: #06d6a0;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: right;
                }
                Text {
                    text: MisterBridge.usb-id + "  ·  " + MisterBridge.serial-id;
                    color: #9080a8;
                    font-size: 7px;
                    horizontal-alignment: right;
                }
                Text {
                    text: MisterBridge.js-counts;
                    color: #706080;
                    font-size: 6px;
                    horizontal-alignment: right;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            ControllerBody {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                dpad-up: MisterBridge.dpad-up;
                dpad-down: MisterBridge.dpad-down;
                dpad-left: MisterBridge.dpad-left;
                dpad-right: MisterBridge.dpad-right;
                btn-a: MisterBridge.btn-a;
                btn-b: MisterBridge.btn-b;
                btn-x: MisterBridge.btn-x;
                btn-y: MisterBridge.btn-y;
                btn-l: MisterBridge.btn-l;
                btn-r: MisterBridge.btn-r;
                btn-zl: MisterBridge.btn-zl;
                btn-zr: MisterBridge.btn-zr;
                btn-select: MisterBridge.btn-select;
                btn-start: MisterBridge.btn-start;
                btn-home: MisterBridge.btn-home;
                btn-capture: MisterBridge.btn-capture;
                capture-available: MisterBridge.capture-available;
                left-x: MisterBridge.left-x;
                left-y: MisterBridge.left-y;
                right-x: MisterBridge.right-x;
                right-y: MisterBridge.right-y;
            }
        }

        VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Pressed now:";
                    color: #9080a8;
                    font-size: 8px;
                    font-weight: 600;
                }
                Text {
                    text: MisterBridge.pressed-now;
                    color: #06d6a0;
                    font-size: 8px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: "Last event:";
                    color: #9080a8;
                    font-size: 7px;
                }
                Text {
                    text: MisterBridge.last-event-label;
                    color: #c8b8d8;
                    font-size: 7px;
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: MisterBridge.last-raw-event;
                color: #605068;
                font-size: 6px;
            }
        }
    }
}

export component ControllerTest inherits Window {
    preferred-width: 480px;
    preferred-height: 270px;
    default-font-family: "Press Start 2P";
    title: "MiSTer Controller Test";
    background: #1a1424;

    ControllerPanel {}
}
