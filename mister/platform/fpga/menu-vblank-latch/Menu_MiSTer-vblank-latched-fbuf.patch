+PACKAGE BODY mister_magik_scaler_completion_queue IS
+	FUNCTION completion_queue_next(
+		request_toggle     : std_logic;
+		completion_pending : std_logic;
+		completion_ack     : std_logic;
+		completion         : std_logic)
+		RETURN std_logic_vector IS
+		VARIABLE state_v : std_logic_vector(1 DOWNTO 0);
+	BEGIN
+		state_v:=request_toggle & completion_pending;
+		IF request_toggle=completion_ack THEN
+			IF completion_pending='1' THEN
+				state_v(1):=NOT request_toggle;
+				state_v(0):=completion;
+			ELSIF completion='1' THEN
+				state_v(1):=NOT request_toggle;
+			END IF;
+		ELSIF completion='1' AND completion_pending='0' THEN
+			state_v(0):='1';
+		END IF;
+		RETURN state_v;
+	END FUNCTION completion_queue_next;
+
+	FUNCTION completion_queue_overflow(
+		request_toggle     : std_logic;
+		completion_pending : std_logic;
+		completion_ack     : std_logic;
+		completion         : std_logic)
+		RETURN boolean IS
+	BEGIN
+		RETURN request_toggle/=completion_ack AND
+			completion_pending='1' AND completion='1';
+	END FUNCTION completion_queue_overflow;
+
+	FUNCTION return_credits_next(
+		credits   : natural;
+		phase     : natural;
+		issued    : boolean;
+		returned  : boolean;
+		burst_len : natural)
+		RETURN natural IS
+		VARIABLE credits_v : natural;
+	BEGIN
+		credits_v:=credits;
+		IF returned AND phase=burst_len-1 AND credits_v>0 THEN
+			credits_v:=credits_v-1;
+		END IF;
+		IF issued THEN
+			credits_v:=credits_v+1;
+		END IF;
+		RETURN credits_v;
+	END FUNCTION return_credits_next;
+
+	FUNCTION return_phase_next(
+		phase     : natural;
+		returned  : boolean;
+		burst_len : natural)
+		RETURN natural IS
+	BEGIN
+		IF returned THEN
+			RETURN (phase+1) MOD burst_len;
+		END IF;
+		RETURN phase;
+	END FUNCTION return_phase_next;
+
+	FUNCTION return_words_remaining(
+		credits   : natural;
+		phase     : natural;
+		burst_len : natural)
+		RETURN natural IS
+	BEGIN
+		IF credits=0 THEN
+			RETURN 0;
+		END IF;
+		RETURN credits*burst_len-phase;
+	END FUNCTION return_words_remaining;
+
+	FUNCTION return_accounting_invalid(
+		credits   : natural;
+		phase     : natural;
+		issued    : boolean;
+		returned  : boolean;
+		burst_len : natural;
+		maximum   : natural)
+		RETURN boolean IS
+		VARIABLE remaining_v : natural;
+	BEGIN
+		IF burst_len=0 OR phase>=burst_len OR (credits=0 AND phase/=0) THEN
+			RETURN true;
+		END IF;
+		remaining_v:=return_words_remaining(credits,phase,burst_len);
+		IF returned AND NOT issued AND remaining_v=0 THEN
+			RETURN true;
+		ELSIF issued AND returned THEN
+			RETURN remaining_v+burst_len-1>maximum;
+		ELSIF issued THEN
+			RETURN remaining_v+burst_len>maximum;
+		END IF;
+		RETURN false;
+	END FUNCTION return_accounting_invalid;
+
+	FUNCTION read_obligation_accept(
+		read_asserted : std_logic;
+		read_accepted : std_logic;
+		waitrequest   : std_logic;
+		eligible      : boolean)
+		RETURN boolean IS
+	BEGIN
+		RETURN read_asserted='1' AND read_accepted='0' AND waitrequest='0' AND
+			eligible;
+	END FUNCTION read_obligation_accept;
+
+	FUNCTION return_drain_ready(
+		credits : natural;
+		phase   : natural)
+		RETURN boolean IS
+	BEGIN
+		RETURN credits=0 AND phase=0;
+	END FUNCTION return_drain_ready;
+END PACKAGE BODY mister_magik_scaler_completion_queue;
