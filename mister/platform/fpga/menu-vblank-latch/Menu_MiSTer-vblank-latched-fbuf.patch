+				state_v(3 DOWNTO 2):=std_logic_vector(to_unsigned(o_copylev,2));
+				state_v(4):=avl_magik_bundle(4);
+				state_v(5):=avl_magik_bundle(5);
+				state_v(6):=avl_magik_bundle(6);
+				state_v(7):=o_readdataack_sync2;
+				state_v(8):=avl_magik_bundle(7);
+				state_v(10 DOWNTO 9):=avl_magik_bundle(9 DOWNTO 8);
+				state_v(11):=avl_magik_bundle(10);
+				state_v(12):=o_run;
+				state_v(13):=to_std_logic(o_newres>0);
+				state_v(14):=avl_magik_bundle(11);
+
+				o_magik_diag_state<=state_v(14 DOWNTO 0) & flags_v(9 DOWNTO 0);
+				o_magik_diag_generation<=NOT o_magik_diag_generation;
+				o_magik_capture_pending<='0';
+			END IF;
+		END IF;
+	END PROCESS MagiKScalerPipelineDiagnostic;
