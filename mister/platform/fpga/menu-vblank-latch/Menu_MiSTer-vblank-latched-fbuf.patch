+
+			IF o_vsv(1)='1' AND o_vsv(0)='0' THEN
+				o_magik_completed_flags<=events_v;
+				o_magik_frame_flags<=(OTHERS=>'0');
+				o_magik_frame_valid<='1';
+			ELSE
+				o_magik_frame_flags<=events_v;
+			END IF;
+
+			IF o_magik_generation_sync/=o_magik_generation_seen THEN
+				o_magik_generation_seen<=o_magik_generation_sync;
+				o_magik_capture_pending<='1';
+			ELSIF o_magik_capture_pending='1' THEN
+				flags_v:=(OTHERS=>'0');
+				flags_v(0):=avl_magik_bundle(12) AND o_magik_frame_valid;
+				flags_v(4 DOWNTO 1):=avl_magik_bundle(3 DOWNTO 0);
