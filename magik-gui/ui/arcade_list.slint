import { MisterUi } from "mister_window.slint";
import { MisterBridge } from "mister_bridge.slint";

export component ArcadeListScreen inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <int> count: MisterBridge.active-system-count;
    property <bool> games-loading: MisterBridge.arcade-games-loading;
    property <length> cabinet-width: 336px * s;
    property <length> cabinet-height: 520px * s;
    property <length> cabinet-screen-x: 8px * s;
    property <length> cabinet-screen-y: 92px * s;
    property <length> cabinet-screen-width: 320px * s;
    property <length> cabinet-screen-height: 320px * s;
    property <length> drawer-width: 248px * s;
    property <length> drawer-x: MisterBridge.arcade-filter-open ? 0px : -drawer-width;

    background: #1a1424;

    HorizontalLayout {

        // Left half — scrollable game list
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            visible: MisterBridge.arcade-list-visible;

            Text {
                x: 16px * s;
                y: 16px * s;
                text: MisterBridge.active-system-title;
                color: #e8e0f0;
                font-size: 24px * s;
            }

            Text {
                x: 16px * s;
                y: 44px * s;
                text: count + " games";
                color: #706080;
                font-size: 8px * s;
            }

            // Rust draws the animated game rows into this reserved viewport.
            Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: MisterBridge.arcade-list-y * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: MisterBridge.arcade-list-height * 1px * s;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                clip: true;
            }

            Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: MisterBridge.arcade-list-y * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: MisterBridge.arcade-list-height * 1px * s;
                visible: root.games-loading || self.opacity > 0;
                opacity: root.games-loading ? 1 : 0;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                animate opacity { duration: 180ms; }

                VerticalLayout {
                    alignment: center;
                    spacing: 10px * root.s;

                    Rectangle {
                        width: 180px * root.s;
                        height: 4px * root.s;
                        background: #1a1424;
                        border-width: 1px;
                        border-color: #5c4a72;
                    }
                }
            }

            Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: (MisterBridge.arcade-list-y + MisterBridge.arcade-list-height + 4) * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: parent.height - self.y - 8px * s;
                background: #131018;
                border-width: 1px;
                border-color: #352848;
            }

            Rectangle {
                x: root.drawer-x;
                y: 0px;
                width: root.drawer-width;
                height: parent.height;
                background: #17121f;
                border-width: 1px;
                border-color: #5c4a72;
                clip: true;
                animate x { duration: 140ms; }

                Text {
                    x: 16px * root.s;
                    y: 16px * root.s;
                    text: MisterBridge.arcade-filter-title;
                    color: #fff6ff;
                    font-size: 22px * root.s;
                }

                Text {
                    x: 16px * root.s;
                    y: 44px * root.s;
                    text: MisterBridge.arcade-filter-active-label;
                    color: #06d6a0;
                    font-size: 8px * root.s;
                }

                Rectangle {
                    x: 8px * root.s;
                    y: 56px * root.s;
                    width: parent.width - 16px * root.s;
                    height: 384px * root.s;
                    background: #120d1a;
                    border-width: 1px;
                    border-color: #352848;
                    clip: true;

                    for item[i] in MisterBridge.arcade-filter-items: Rectangle {
                        x: 0px;
                        y: (i * 40 - MisterBridge.arcade-filter-scroll-y) * 1px * root.s;
                        width: parent.width;
                        height: 40px * root.s;
                        background: MisterBridge.arcade-filter-selected == i ? #2a2236 : #120d1a;
                        border-width: MisterBridge.arcade-filter-selected == i ? 2px : 0px;
                        border-color: #06d6a0;

                        Text {
                            x: 10px * root.s;
                            y: 8px * root.s;
                            width: parent.width - 64px * root.s;
                            text: item.label;
                            color: item.active ? #06d6a0 : #e8e0f0;
                            font-size: 13px * root.s;
                            overflow: elide;
                        }

                        Text {
                            x: parent.width - 48px * root.s;
                            y: 10px * root.s;
                            width: 38px * root.s;
                            text: item.count;
                            color: #706080;
                            horizontal-alignment: right;
                            font-size: 9px * root.s;
                        }
                    }
                }
            }
        }

        // Right half — screenshot for highlighted game
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #131018;

            Rectangle {
                x: (parent.width - root.cabinet-width) / 2;
                y: (parent.height - root.cabinet-height) / 2;
                width: root.cabinet-width;
                height: root.cabinet-height;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("art/arcade-cabinet-preview.png");
                }

                Rectangle {
                    x: root.cabinet-screen-x;
                    y: root.cabinet-screen-y;
                    width: root.cabinet-screen-width;
                    height: root.cabinet-screen-height;
                    clip: true;
                }
            }
        }
    }
}
