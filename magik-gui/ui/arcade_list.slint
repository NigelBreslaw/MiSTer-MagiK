import { MisterUi } from "mister_window.slint";
import { MisterBridge, PreviewStatus } from "mister_bridge.slint";

export component ArcadeListScreen inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <int> count: MisterBridge.arcade-games.length;
    property <length> preview-display-width: MisterBridge.arcade-preview-display-width * 1px * s;
    property <length> preview-display-height: MisterBridge.arcade-preview-display-height * 1px * s;

    background: #1a1424;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // Left half — scrollable game list
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #1a1424;

            Text {
                x: 16px * s;
                y: 16px * s;
                text: MisterBridge.active-system-title;
                color: #e8e0f0;
                font-size: 24px * s;
            }

            Text {
                x: 16px * s;
                y: 44px * s;
                text: count + " games";
                color: #706080;
                font-size: 8px * s;
            }

            // Rust draws the animated game rows into this reserved viewport.
            Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: MisterBridge.arcade-list-y * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: MisterBridge.arcade-list-height * 1px * s;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                clip: true;
            }

            Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: (MisterBridge.arcade-list-y + MisterBridge.arcade-list-height + 4) * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: parent.height - self.y - 8px * s;
                background: #131018;
                border-width: 1px;
                border-color: #352848;

                Text {
                    x: 12px * s;
                    y: 13px * s;
                    text: MisterBridge.arcade-games.length > 0
                        ? (MisterBridge.arcade-selected + 1) + " / " + MisterBridge.arcade-games.length
                        : "0 / 0";
                    color: #706080;
                    font-size: 8px * s;
                }
            }
        }

        // Right half — screenshot for highlighted game
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #131018;

            Rectangle {
                x: MisterBridge.arcade-preview-box-x * 1px * s;
                y: MisterBridge.arcade-preview-box-y * 1px * s;
                width: MisterBridge.arcade-preview-box-width * 1px * s;
                height: MisterBridge.arcade-preview-box-height * 1px * s;
                background: #0e0c14;
                border-width: 1px;
                border-color: #5c4a72;

                if MisterBridge.arcade-preview-has-image : Image {
                    x: (parent.width - root.preview-display-width) / 2;
                    y: (parent.height - root.preview-display-height) / 2;
                    width: root.preview-display-width;
                    height: root.preview-display-height;
                    source: MisterBridge.arcade-preview-image;
                }

                if !MisterBridge.arcade-preview-has-image && MisterBridge.arcade-preview-placeholder-visible : Text {
                    width: 100%;
                    height: 100%;
                    text: MisterBridge.arcade-preview-status == PreviewStatus.loading ? "Loading screenshot" : "No screenshot";
                    color: #706080;
                    font-size: 8px * s;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                x: 12px * s;
                y: parent.height - 84px * s;
                width: parent.width - 24px * s;
                text: MisterBridge.arcade-preview-title;
                color: #e8e0f0;
                font-size: 16px * s;
                wrap: word-wrap;
            }

            Text {
                x: 12px * s;
                y: parent.height - 42px * s;
                text: MisterBridge.arcade-preview-has-image
                    ? "ORIGINAL: " + MisterBridge.arcade-preview-source-width + "x" + MisterBridge.arcade-preview-source-height
                    : "";
                color: #7dd3fc;
                font-size: 8px * s;
            }

            Text {
                x: 12px * s;
                y: parent.height - 22px * s;
                text: "D-pad: move  ·  A: launch  ·  B: back";
                color: #706080;
                font-size: 8px * s;
            }
        }
    }
}
