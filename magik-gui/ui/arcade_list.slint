import { MisterUi } from "mister_window.slint";
import { MisterBridge } from "mister_bridge.slint";

component SearchKey inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> keyboard-focused;

    height: 42px * MisterUi.scale;
    background: selected ? (keyboard-focused ? #06d6a0 : #2a2236) : #181220;
    border-width: selected ? 2px : 1px;
    border-color: selected ? (keyboard-focused ? #ffffff : #5c4a72) : #352848;

    Text {
        text: root.label;
        color: root.selected && root.keyboard-focused ? #101420 : #e8e0f0;
        font-size: (root.label == "CLEAR" || root.label == "SPACE") ? 7px * MisterUi.scale : 10px * MisterUi.scale;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SearchKeyboardRow inherits Rectangle {
    in property <int> start-index;
    in property <int> key-count;

    height: 42px * MisterUi.scale;
    background: transparent;

    function search-key-label(index: int) -> string {
        return index == 0 ? "A" : index == 1 ? "B" : index == 2 ? "C" : index == 3 ? "D" :
            index == 4 ? "E" : index == 5 ? "F" : index == 6 ? "G" : index == 7 ? "H" :
            index == 8 ? "I" : index == 9 ? "J" : index == 10 ? "K" : index == 11 ? "L" :
            index == 12 ? "M" : index == 13 ? "N" : index == 14 ? "O" : index == 15 ? "P" :
            index == 16 ? "Q" : index == 17 ? "R" : index == 18 ? "S" : index == 19 ? "T" :
            index == 20 ? "U" : index == 21 ? "V" : index == 22 ? "W" : index == 23 ? "X" :
            index == 24 ? "Y" : index == 25 ? "Z" : index == 26 ? "0" : index == 27 ? "1" :
            index == 28 ? "2" : index == 29 ? "3" : index == 30 ? "4" : index == 31 ? "5" :
            index == 32 ? "6" : index == 33 ? "7" : index == 34 ? "8" : index == 35 ? "9" :
            index == 36 ? "-" : index == 37 ? "." : index == 38 ? "'" : index == 39 ? "&" :
            index == 40 ? "SPACE" : index == 41 ? "DEL" : "CLEAR";
    }

    HorizontalLayout {
        spacing: 6px * MisterUi.scale;

        for key-offset in root.key-count: SearchKey {
            horizontal-stretch: 1;
            label: search-key-label(root.start-index + key-offset);
            selected: MisterBridge.arcade-search-key-selected == root.start-index + key-offset;
            keyboard-focused: MisterBridge.arcade-search-pane == 0;
        }
    }
}

component SearchKeyboard inherits Rectangle {
    property <int> s: MisterUi.scale;

    background: #1a1424;

    VerticalLayout {
        padding: 16px * root.s;
        spacing: 10px * root.s;

        Text {
            text: "Search";
            color: #e8e0f0;
            font-size: 22px * root.s;
        }

        Rectangle {
            height: 46px * root.s;
            background: #120d1a;
            border-width: MisterBridge.arcade-search-pane == 0 ? 2px : 1px;
            border-color: MisterBridge.arcade-search-pane == 0 ? #06d6a0 : #352848;

            Text {
                x: 10px * root.s;
                y: 0px;
                width: parent.width - 20px * root.s;
                height: parent.height;
                text: MisterBridge.arcade-search-query == "" ? "_" : MisterBridge.arcade-search-query;
                color: MisterBridge.arcade-search-query == "" ? #706080 : #d7eef8;
                font-size: 12px * root.s;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        SearchKeyboardRow { start-index: 0; key-count: 8; }
        SearchKeyboardRow { start-index: 8; key-count: 8; }
        SearchKeyboardRow { start-index: 16; key-count: 8; }
        SearchKeyboardRow { start-index: 24; key-count: 8; }
        SearchKeyboardRow { start-index: 32; key-count: 8; }
        SearchKeyboardRow { start-index: 40; key-count: 3; }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

export component ArcadeListScreen inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <int> count: MisterBridge.active-system-count;
    property <bool> games-loading: MisterBridge.arcade-games-loading;
    property <length> cabinet-width: 336px * s;
    property <length> cabinet-height: 520px * s;
    property <length> cabinet-screen-x: 8px * s;
    property <length> cabinet-screen-y: 92px * s;
    property <length> cabinet-screen-width: 320px * s;
    property <length> cabinet-screen-height: 320px * s;
    background: #1a1424;

    HorizontalLayout {

        // Left half — scrollable game list or search keyboard
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            visible: MisterBridge.arcade-list-visible;

            if MisterBridge.arcade-search-active : SearchKeyboard { }

            if !MisterBridge.arcade-search-active : Text {
                x: 16px * s;
                y: 16px * s;
                text: MisterBridge.active-system-title;
                color: #e8e0f0;
                font-size: 24px * s;
            }

            if !MisterBridge.arcade-search-active : Text {
                x: 16px * s;
                y: 44px * s;
                text: count + " games";
                color: #706080;
                font-size: 8px * s;
            }

            // Rust draws the animated game rows into this reserved viewport.
            if !MisterBridge.arcade-search-active : Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: MisterBridge.arcade-list-y * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: MisterBridge.arcade-list-height * 1px * s;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                clip: true;
            }

            if !MisterBridge.arcade-search-active : Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: MisterBridge.arcade-list-y * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: MisterBridge.arcade-list-height * 1px * s;
                visible: root.games-loading || self.opacity > 0;
                opacity: root.games-loading ? 1 : 0;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                animate opacity { duration: 180ms; }

                VerticalLayout {
                    alignment: center;
                    spacing: 10px * root.s;

                    Rectangle {
                        width: 180px * root.s;
                        height: 4px * root.s;
                        background: #1a1424;
                        border-width: 1px;
                        border-color: #5c4a72;
                    }
                }
            }

            if !MisterBridge.arcade-search-active : Rectangle {
                x: MisterBridge.arcade-list-x * 1px * s;
                y: (MisterBridge.arcade-list-y + MisterBridge.arcade-list-height + 4) * 1px * s;
                width: MisterBridge.arcade-list-width * 1px * s;
                height: parent.height - self.y - 8px * s;
                background: #131018;
                border-width: 1px;
                border-color: #352848;
            }
        }

        // Right half — screenshot for highlighted game or search results
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #131018;

            if MisterBridge.arcade-search-active : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #131018;

                Text {
                    x: 16px * root.s;
                    y: 16px * root.s;
                    text: count + " matches";
                    color: MisterBridge.arcade-search-pane == 1 ? #06d6a0 : #706080;
                    font-size: 12px * root.s;
                }

                Rectangle {
                    x: (MisterBridge.arcade-list-x - 480) * 1px * root.s;
                    y: MisterBridge.arcade-list-y * 1px * root.s;
                    width: MisterBridge.arcade-list-width * 1px * root.s;
                    height: MisterBridge.arcade-list-height * 1px * root.s;
                    background: #120d1a;
                    border-width: 1px;
                    border-color: MisterBridge.arcade-search-pane == 1 ? #06d6a0 : #352848;
                    clip: true;
                }
            }

            if !MisterBridge.arcade-search-active : Rectangle {
                x: (parent.width - root.cabinet-width) / 2;
                y: (parent.height - root.cabinet-height) / 2;
                width: root.cabinet-width;
                height: root.cabinet-height;

                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("art/arcade-cabinet-preview.png");
                }

                Rectangle {
                    x: root.cabinet-screen-x;
                    y: root.cabinet-screen-y;
                    width: root.cabinet-screen-width;
                    height: root.cabinet-screen-height;
                    clip: true;
                }
            }
        }
    }
}
