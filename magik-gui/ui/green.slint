import { MisterWindow, MisterUi } from "mister_window.slint";
export { MisterUi }
import "fonts/PressStart2P-Regular.ttf";

export component GreenProof inherits MisterWindow {
    background: #00c853;
    default-font-family: "Press Start 2P";

    property <int> s: MisterUi.scale;
    property <duration> tick: animation-tick();
    property <bool> blink: Math.mod(tick / 1ms, 1000) < 500;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: #00c853;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 6px * s;
        background: #ffffff;
    }

    Rectangle {
        x: 0;
        y: parent.height - 6px * s;
        width: parent.width;
        height: 6px * s;
        background: #ffffff;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: 6px * s;
        height: parent.height;
        background: #ffffff;
    }

    Rectangle {
        x: parent.width - 6px * s;
        y: 0;
        width: 6px * s;
        height: parent.height;
        background: #ffffff;
    }

    Text {
        x: 32px * s;
        y: 28px * s;
        text: "MiSTer MagiK";
        font-size: 24px * s;
        color: #001b0a;
    }

    Text {
        x: 32px * s;
        y: 72px * s;
        text: blink ? "green Slint proof" : " ";
        font-size: 16px * s;
        color: #001b0a;
    }
}
