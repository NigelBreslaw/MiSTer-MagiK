import { MisterWindow, MisterUi } from "mister_window.slint";
export { MisterUi }
import "fonts/PressStart2P-Regular.ttf";

export component DebugUi inherits MisterWindow {
    background: #071018;
    default-font-family: "Press Start 2P";

    property <int> s: MisterUi.scale;
    property <duration> tick: animation-tick();
    property <bool> blink: Math.mod(tick / 1ms, 1000) < 500;

    Text {
        x: 32px * s;
        y: 28px * s;
        text: "MiSTer Magik Debug";
        font-size: 24px * s;
        color: #f4f1de;
    }

    Rectangle {
        x: 32px * s;
        y: 88px * s;
        width: parent.width - 64px * s;
        height: 120px * s;
        background: #13212c;
        border-width: 2px * s;
        border-color: #2a9d8f;

        VerticalLayout {
            padding: 16px * s;
            spacing: 10px * s;

            Text {
                text: "spawned by Main_MiSTer";
                font-size: 16px * s;
                color: #e9c46a;
            }

            Text {
                text: "scene: ui debug";
                font-size: 16px * s;
                color: #a8dadc;
            }

            Text {
                text: "profile: hdmi_1080p experiment";
                font-size: 16px * s;
                color: #a8dadc;
            }
        }
    }

    Rectangle {
        x: 32px * s;
        y: 248px * s;
        width: parent.width - 64px * s;
        height: 88px * s;
        background: #111827;
        border-width: 1px * s;
        border-color: #457b9d;

        Text {
            x: 16px * s;
            y: 16px * s;
            text: "Escape menu: press MiSTer menu/F12";
            font-size: 16px * s;
            color: #f4f1de;
        }

        Text {
            x: 16px * s;
            y: 48px * s;
            text: "Launch IPC: mister_magic_launch <path>";
            font-size: 16px * s;
            color: #f4f1de;
        }
    }

    Text {
        x: 32px * s;
        y: parent.height - 52px * s;
        text: blink ? "Main alive + Slint child running" : " ";
        font-size: 16px * s;
        color: #2a9d8f;
    }
}
