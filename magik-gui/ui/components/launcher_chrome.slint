import { MisterUi } from "../mister_window.slint";
import { MenuItemStatus } from "../launcher_menu.slint";

export component LauncherTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <bool> focused;
    in property <bool> flat-focus-style: false;
    in property <MenuItemStatus> status: MenuItemStatus.ready;
    property <bool> scan-pulse;

    border-width: 2px;
    border-color: status == MenuItemStatus.failed
        ? #a9445b
        : status == MenuItemStatus.partial ? #c58b3a
        : status == MenuItemStatus.scanning
            ? (scan-pulse ? #7b91ad : #52647d)
            : #5a4973;
    background: status == MenuItemStatus.failed
        ? #291820
        : status == MenuItemStatus.partial ? #292318
        : status == MenuItemStatus.scanning ? #172131 : #181829;

    animate border-color {
        duration: status == MenuItemStatus.scanning ? 700ms : 100ms;
    }

    Timer {
        interval: 700ms;
        running: root.status == MenuItemStatus.scanning;
        triggered => { root.scan-pulse = !root.scan-pulse; }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        Text {
            text: label;
            color: focused
                ? #06d6a0
                : status == MenuItemStatus.failed
                    ? #ef8da2
                    : status == MenuItemStatus.partial ? #f0c36e
                    : status == MenuItemStatus.scanning ? #d7eef8 : #9080a8;
            font-size: 16px;
            width: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;

            animate color { duration: 100ms; easing: Easing.ease-in-out; }
        }

        if subtitle != "" : Text {
            text: subtitle;
            color: focused
                ? #d8d4dd
                : status == MenuItemStatus.failed
                    ? #ef8da2
                    : status == MenuItemStatus.partial ? #f0c36e
                    : status == MenuItemStatus.scanning ? #8ca4b5 : #9080a800;
            font-size: 8px;
            horizontal-alignment: center;

            // In the RGB565 software-renderer launcher mock, animating color alpha
            // was slightly faster than animating Text opacity for this subtitle fade.
            animate color { duration: 100ms; easing: Easing.ease-in-out; }
        }
    }
}

component CogIcon inherits Image {
    in property <bool> focused;

    source: @image-url("../icons/settings.svg");
    colorize: white;
    opacity: focused ? 1.0 : 0.5;
}

export component SettingsButton inherits Rectangle {
    in property <bool> focused;

    width: 56px;
    height: 56px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? white : #5c4a72;

    CogIcon {
        width: 24px;
        height: 24px;
        focused: parent.focused;
    }
}

export component OsdSideLabel inherits Rectangle {
    property <int> s: MisterUi.scale;

    width: 56px * s;
    height: 100%;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    VerticalLayout {
        padding-top: 26px * s;
        padding-bottom: 26px * s;
        spacing: 10px * s;
        alignment: center;

        Text { text: "M"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "I"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "S"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "T"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "E"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "R"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
    }
}
