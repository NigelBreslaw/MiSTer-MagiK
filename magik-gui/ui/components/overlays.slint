import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";
import { LauncherTile, OsdSideLabel } from "launcher_chrome.slint";
import { ScreenshotPackProgressRow } from "progress.slint";

export component CatalogScanPopup inherits Rectangle {
    in property <int> s;
    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 1200) / 1200;
    property <bool> determinate: MisterBridge.catalog-scan-percent >= 0;
    property <int> scan-progress: Math.max(0, Math.min(100, MisterBridge.catalog-scan-percent));
    property <length> scan-osd-width: 56px * s;
    property <length> scan-horizontal-padding: 70px * s;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px * s
        ? scan-content-width
        : 560px * s;

    background: #0b0d14;

    HorizontalLayout {
        OsdSideLabel { }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: 82px * s;
            padding-bottom: 76px * s;
            spacing: 18px * s;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Text {
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: #06d6a0;
                font-size: 20px * s;
                horizontal-alignment: center;
            }

            Text {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-message;
                color: #e8e0f0;
                font-size: 16px * s;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-title;
                color: #d7eef8;
                font-size: 10px * s;
                horizontal-alignment: center;
            }

            Text {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-detail;
                color: #9080a8;
                font-size: 8px * s;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                width: root.scan-progress-width;
                height: 16px * s;
                background: #0e0c14;
                border-width: 1px;
                border-color: #5c4a72;
                clip: true;

                if root.determinate : Rectangle {
                    x: 2px * s;
                    y: 2px * s;
                    width: (parent.width - 4px * s) * root.scan-progress / 100;
                    height: parent.height - 4px * s;
                    background: #06d6a0;
                }

                if !root.determinate : Rectangle {
                    width: 96px * s;
                    height: parent.height - 4px * s;
                    y: 2px * s;
                    x: (parent.width - self.width) * root.phase;
                    background: #06d6a0;
                }
            }

            if root.determinate : Text {
                text: root.scan-progress + "%";
                color: #d7eef8;
                font-size: 8px * s;
                horizontal-alignment: center;
            }

            if MisterBridge.media-pack-progresses.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px * s;

                Text {
                    text: MisterBridge.media-pack-summary;
                    color: #d7eef8;
                    font-size: 6px * s;
                    horizontal-alignment: center;
                }

                for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
                    s: root.s;
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {
    in property <int> s;

    width: 560px * s;
    height: 100px * s;
    x: MisterUi.window-width * 1px / 2 - self.width / 2;
    y: MisterUi.window-height * 1px - self.height - 24px * s;
    background: #0b0d14;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px * root.s;
        padding-right: 12px * root.s;
        padding-top: 8px * root.s;
        padding-bottom: 8px * root.s;
        spacing: 5px * root.s;

        Text {
            text: MisterBridge.media-pack-summary;
            color: #d7eef8;
            font-size: 6px * root.s;
            horizontal-alignment: center;
        }

        for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
            s: root.s;
            pack: pack;
        }
    }
}

export component StartupSplash inherits Rectangle {
    property <int> s: MisterUi.scale;

    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px * s;

        Text {
            text: "MiSTer MagiK";
            color: #e8e0f0;
            font-size: 28px * s;
            horizontal-alignment: center;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <duration> tick: animation-tick();
    property <float> phase-ms: Math.mod(tick / 1ms, 1000);

    width: 132px * s;
    height: 28px * s;
    x: MisterUi.window-width * 1px - self.width - 18px * s;
    y: MisterUi.window-height * 1px - self.height - 16px * s;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    Text {
        text: root.phase-ms < 250 ? "scanning" :
            root.phase-ms < 500 ? "scanning." :
            root.phase-ms < 750 ? "scanning.." : "scanning...";
        color: #d7eef8;
        font-size: 8px * root.s;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ConfirmDialog inherits Rectangle {
    background: #000000b0;

    Rectangle {
        width: 680px;
        height: 260px;
        background: #0e0c14;
        border-width: 4px;
        border-color: #06d6a0;

        VerticalLayout {
            padding: 24px;
            spacing: 18px;

            Text {
                text: MisterBridge.confirm-title;
                color: #06d6a0;
                font-size: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.confirm-message;
                color: #e8e0f0;
                font-size: 8px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            HorizontalLayout {
                spacing: 16px;

                if MisterBridge.confirm-left-label != "" : LauncherTile {
                    label: MisterBridge.confirm-left-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 0;
                }

                if MisterBridge.confirm-right-label != "" : LauncherTile {
                    label: MisterBridge.confirm-right-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 1;
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            text: MisterBridge.loading-message;
            color: #e8e0f0;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Text {
            text: MisterBridge.loading-detail != "" ? MisterBridge.loading-detail : "Please wait...";
            color: #9080a8;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}
