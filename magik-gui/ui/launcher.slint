import { MisterWindow, MisterUi } from "mister_window.slint";
import { ListView } from "std-widgets.slint";
export { MisterUi }
import { MisterBridge, ScreenshotPackProgress } from "mister_bridge.slint";
import { ControllerPanel } from "controller_panel.slint";
import { SetupOverlay } from "controller_setup.slint";
import { ArcadeListScreen } from "arcade_list.slint";
export { MisterBridge, ScreenshotPackProgress }
export { ArcadeGame, GameSystem } from "arcade_game.slint";
import "fonts/PressStart2P-Regular.ttf";

component LauncherTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <bool> focused;

    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : #5c4a72;
    border-radius: 0px;
    background: focused ? #2a2236 : #1e1828;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        Text {
            text: label;
            color: focused ? #06d6a0 : #e8e0f0;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Text {
            text: subtitle;
            color: #9080a8;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}

component CogIcon inherits Image {
    in property <bool> focused;

    source: @image-url("icons/settings.svg");
    colorize: white;
    opacity: focused ? 1.0 : 0.5;
}

component SettingsButton inherits Rectangle {
    in property <bool> focused;

    width: 56px;
    height: 56px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? white : #5c4a72;

    CogIcon {
        width: 24px;
        height: 24px;
        focused: parent.focused;
    }
}

component OsdSideLabel inherits Rectangle {
    property <int> s: MisterUi.scale;

    width: 56px * s;
    height: 100%;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    VerticalLayout {
        padding-top: 26px * s;
        padding-bottom: 26px * s;
        spacing: 10px * s;
        alignment: center;

        Text { text: "M"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "I"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "S"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "T"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "E"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "R"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
    }
}

component HomeGrid inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <length> tile-width: 220px * s;
    property <length> tile-gap: 16px * s;
    property <length> content-width: MisterBridge.game-systems.length * tile-width
        + Math.max(0, MisterBridge.game-systems.length - 1) * tile-gap;
    property <length> scroll-x: MisterBridge.home-scroll-x * 1px * s;

    background: #0b0d14;

    HorizontalLayout {
        OsdSideLabel { }

        VerticalLayout {
            padding: 18px * s;
            spacing: 14px * s;

            Rectangle {
                height: 42px * s;
                background: #172131;
                border-width: 1px;
                border-color: #52647d;

                HorizontalLayout {
                    padding-left: 14px * s;
                    padding-right: 10px * s;
                    spacing: 12px * s;
                    cross-axis-alignment: center;

                    Text {
                        text: "MiSTer MagiK";
                        color: #d7eef8;
                        font-size: 16px * s;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: MisterBridge.clock-text;
                        color: #d7eef8;
                        font-size: 16px * s;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    SettingsButton {
                        width: 34px * s;
                        height: 34px * s;
                        focused: MisterBridge.settings-focused;
                    }
                }
            }

            system-list := ListView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                viewport-width: root.content-width;
                viewport-height: self.height;
                viewport-x: -scroll-x;

                for _ in 1: Rectangle {
                    width: root.content-width;
                    height: parent.height;
                    background: transparent;

                    for system[i] in MisterBridge.game-systems: LauncherTile {
                        x: i * (root.tile-width + root.tile-gap);
                        width: root.tile-width;
                        height: parent.height;
                        label: system.title;
                        subtitle: system.count + " games";
                        focused: !MisterBridge.settings-focused && MisterBridge.selected-index == i;
                    }
                }
            }
        }
    }
}

component ScreenshotPackProgressRow inherits Rectangle {
    in property <int> s;
    in property <ScreenshotPackProgress> pack;
    property <int> clamped-percent: Math.max(0, Math.min(100, pack.percent));
    property <bool> determinate: pack.percent >= 0;

    height: 18px * s;
    background: transparent;

    VerticalLayout {
        spacing: 2px * root.s;

        HorizontalLayout {
            spacing: 6px * root.s;

            Text {
                width: 130px * root.s;
                text: root.pack.system + " " + root.pack.image-size;
                color: #d7eef8;
                font-size: 6px * root.s;
            }

            Text {
                width: 86px * root.s;
                text: root.pack.phase;
                color: #06d6a0;
                font-size: 6px * root.s;
            }

            Text {
                horizontal-stretch: 1;
                text: root.pack.pack-position;
                color: #9080a8;
                font-size: 6px * root.s;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            width: parent.width;
            height: 3px * root.s;
            background: #0e0c14;
            border-width: 1px;
            border-color: #5c4a72;
            clip: true;

            if root.determinate : Rectangle {
                x: 0;
                width: parent.width * root.clamped-percent / 100;
                height: parent.height;
                background: #06d6a0;
            }

            if !root.determinate : Rectangle {
                width: 72px * root.s;
                height: parent.height;
                x: (parent.width - self.width) * Math.mod(animation-tick() / 1ms, 900) / 900;
                background: #06d6a0;
            }
        }
    }
}

component CatalogScanPopup inherits Rectangle {
    in property <int> s;
    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 1200) / 1200;
    property <bool> determinate: MisterBridge.catalog-scan-percent >= 0;
    property <int> scan-progress: Math.max(0, Math.min(100, MisterBridge.catalog-scan-percent));

    background: #0b0d14;

    HorizontalLayout {
        OsdSideLabel { }

        VerticalLayout {
            padding-left: 70px * s;
            padding-right: 70px * s;
            padding-top: 82px * s;
            padding-bottom: 76px * s;
            spacing: 18px * s;
            alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Text {
                text: "MiSTer MagiK";
                color: #06d6a0;
                font-size: 20px * s;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.catalog-scan-message;
                color: #e8e0f0;
                font-size: 16px * s;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: MisterBridge.catalog-scan-title;
                color: #d7eef8;
                font-size: 10px * s;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.catalog-scan-detail;
                color: #9080a8;
                font-size: 8px * s;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                width: 560px * s;
                height: 16px * s;
                background: #0e0c14;
                border-width: 1px;
                border-color: #5c4a72;
                clip: true;

                if root.determinate : Rectangle {
                    x: 2px * s;
                    y: 2px * s;
                    width: (parent.width - 4px * s) * root.scan-progress / 100;
                    height: parent.height - 4px * s;
                    background: #06d6a0;
                }

                if !root.determinate : Rectangle {
                    width: 96px * s;
                    height: parent.height - 4px * s;
                    y: 2px * s;
                    x: (parent.width - self.width) * root.phase;
                    background: #06d6a0;
                }
            }

            if root.determinate : Text {
                text: root.scan-progress + "%";
                color: #d7eef8;
                font-size: 8px * s;
                horizontal-alignment: center;
            }

            if MisterBridge.media-pack-progresses.length > 0 : VerticalLayout {
                width: 560px * s;
                spacing: 5px * s;

                Text {
                    text: MisterBridge.media-pack-summary;
                    color: #d7eef8;
                    font-size: 6px * s;
                    horizontal-alignment: center;
                }

                for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
                    s: root.s;
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

component MediaProgressPopup inherits Rectangle {
    in property <int> s;

    width: 560px * s;
    height: 100px * s;
    x: MisterUi.window-width * 1px / 2 - self.width / 2;
    y: MisterUi.window-height * 1px - self.height - 24px * s;
    background: #0b0d14;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px * root.s;
        padding-right: 12px * root.s;
        padding-top: 8px * root.s;
        padding-bottom: 8px * root.s;
        spacing: 5px * root.s;

        Text {
            text: MisterBridge.media-pack-summary;
            color: #d7eef8;
            font-size: 6px * root.s;
            horizontal-alignment: center;
        }

        for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
            s: root.s;
            pack: pack;
        }
    }
}

component StartupSplash inherits Rectangle {
    property <int> s: MisterUi.scale;

    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px * s;

        Text {
            text: "MiSTer MagiK";
            color: #e8e0f0;
            font-size: 28px * s;
            horizontal-alignment: center;
        }
    }
}

component BackgroundScanBadge inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <duration> tick: animation-tick();
    property <float> phase-ms: Math.mod(tick / 1ms, 1000);

    width: 132px * s;
    height: 28px * s;
    x: MisterUi.window-width * 1px - self.width - 18px * s;
    y: MisterUi.window-height * 1px - self.height - 16px * s;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    Text {
        text: root.phase-ms < 250 ? "scanning" :
            root.phase-ms < 500 ? "scanning." :
            root.phase-ms < 750 ? "scanning.." : "scanning...";
        color: #d7eef8;
        font-size: 8px * root.s;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;

    height: 64px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : #5c4a72;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: label;
            color: focused ? #06d6a0 : #e8e0f0;
            font-size: 16px;
        }

        Text {
            text: detail;
            color: #9080a8;
            font-size: 8px;
        }
    }
}

component SettingsScreen inherits Rectangle {
    background: #0b0d14;

    HorizontalLayout {

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "MiSTer MagiK";
                color: #e8e0f0;
                font-size: 24px;
                horizontal-alignment: center;
            }

            SettingsRow {
                label: "Exit to MiSTer";
                detail: "Use the stock MiSTer menu until reboot";
                focused: MisterBridge.settings-selected == 0;
            }

            SettingsRow {
                label: "Controller Test";
                detail: "Open joypad tester";
                focused: MisterBridge.settings-selected == 1;
            }

            SettingsRow {
                label: "Reset Database";
                detail: "Delete library database and reboot";
                focused: MisterBridge.settings-selected == 2;
            }

            SettingsRow {
                label: "Restart";
                detail: "Reboot the MiSTer";
                focused: MisterBridge.settings-selected == 3;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

component ConfirmDialog inherits Rectangle {
    background: #000000b0;

    Rectangle {
        width: 680px;
        height: 260px;
        background: #0e0c14;
        border-width: 4px;
        border-color: #06d6a0;

        VerticalLayout {
            padding: 24px;
            spacing: 18px;

            Text {
                text: MisterBridge.confirm-title;
                color: #06d6a0;
                font-size: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.confirm-message;
                color: #e8e0f0;
                font-size: 8px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            HorizontalLayout {
                spacing: 16px;

                LauncherTile {
                    label: MisterBridge.confirm-left-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 0;
                }

                LauncherTile {
                    label: MisterBridge.confirm-right-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 1;
                }
            }
        }
    }
}

export component Launcher inherits MisterWindow {
    default-font-family: "Press Start 2P";
    title: "MiSTer MagiK Launcher";
    background: #1a1424;

    if MisterBridge.screen-mode == 0 : HomeGrid { }

    if MisterBridge.screen-mode == 1 : ControllerPanel { }

    if MisterBridge.screen-mode == 2 : ArcadeListScreen { }

    if MisterBridge.screen-mode == 3 : SettingsScreen { }

    if MisterBridge.catalog-background-scan-visible : BackgroundScanBadge { }

    if MisterBridge.setup-visible : SetupOverlay {
        phase: MisterBridge.setup-phase;
        title: MisterBridge.setup-title;
        subtitle: MisterBridge.setup-subtitle;
        list-items: MisterBridge.setup-list;
        list-selected: MisterBridge.setup-selected;
        config-labels: MisterBridge.setup-config-labels;
        config-values: MisterBridge.setup-config-values;
        setup-name: MisterBridge.setup-name;
        setup-kind-label: MisterBridge.setup-kind-label;
    }

    if !MisterBridge.catalog-scan-visible && MisterBridge.media-pack-progresses.length > 0 : MediaProgressPopup {
        s: MisterUi.scale;
    }

    if MisterBridge.catalog-scan-visible : CatalogScanPopup {
        s: MisterUi.scale;
    }

    if MisterBridge.confirm-visible : ConfirmDialog { }

    if MisterBridge.loading-message != "": Rectangle {
        background: #1a1424;

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: MisterBridge.loading-message;
                color: #e8e0f0;
                font-size: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.loading-detail != "" ? MisterBridge.loading-detail : "Please wait…";
                color: #9080a8;
                font-size: 8px;
                horizontal-alignment: center;
            }
        }
    }

    if MisterBridge.startup-visible : StartupSplash { }
}
