import { MisterWindow, MisterUi } from "mister_window.slint";
import { ListView } from "std-widgets.slint";
export { MisterUi }
import { MisterBridge } from "mister_bridge.slint";
import { ControllerPanel } from "controller_panel.slint";
import { SetupOverlay } from "controller_setup.slint";
import { ArcadeListScreen } from "arcade_list.slint";
export { MisterBridge }
export { ArcadeGame, GameSystem } from "arcade_game.slint";
import "fonts/PressStart2P-Regular.ttf";

component LauncherTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <bool> focused;

    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : #5c4a72;
    border-radius: 0px;
    background: focused ? #2a2236 : #1e1828;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        Text {
            text: label;
            color: focused ? #06d6a0 : #e8e0f0;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Text {
            text: subtitle;
            color: #9080a8;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}

component CogIcon inherits Rectangle {
    in property <bool> focused;

    background: transparent;

    Rectangle { x: 14px; y: 0px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 14px; y: 28px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 0px; y: 14px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 28px; y: 14px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 6px; y: 6px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 22px; y: 6px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 6px; y: 22px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 22px; y: 22px; width: 8px; height: 8px; background: focused ? #06d6a0 : #9080a8; }
    Rectangle { x: 10px; y: 10px; width: 16px; height: 16px; background: #1e1828; border-width: 4px; border-color: focused ? #06d6a0 : #e8e0f0; }
}

component SettingsButton inherits Rectangle {
    in property <bool> focused;

    width: 72px;
    height: 56px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : #5c4a72;

    CogIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 36px;
        height: 36px;
        focused: parent.focused;
    }
}

component OsdSideLabel inherits Rectangle {
    property <int> s: MisterUi.scale;

    width: 56px * s;
    height: 100%;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    VerticalLayout {
        padding-top: 26px * s;
        padding-bottom: 26px * s;
        spacing: 10px * s;
        alignment: center;

        Text { text: "M"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "I"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "S"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "T"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "E"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
        Text { text: "R"; color: #d7eef8; font-size: 16px * s; horizontal-alignment: center; }
    }
}

component HomeGrid inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <length> tile-width: 220px * s;
    property <length> tile-gap: 16px * s;
    property <length> content-width: MisterBridge.game-systems.length * tile-width
        + Math.max(0, MisterBridge.game-systems.length - 1) * tile-gap;
    property <length> scroll-x: MisterBridge.home-scroll-x * 1px * s;

    background: #0b0d14;

    HorizontalLayout {
        OsdSideLabel { }

        VerticalLayout {
            padding: 18px * s;
            spacing: 14px * s;

            Rectangle {
                height: 42px * s;
                background: #172131;
                border-width: 1px;
                border-color: #52647d;

                HorizontalLayout {
                    padding-left: 14px * s;
                    padding-right: 10px * s;
                    spacing: 12px * s;

                    Text {
                        text: "Magik";
                        color: #d7eef8;
                        font-size: 16px * s;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: MisterBridge.clock-text;
                        color: #d7eef8;
                        font-size: 16px * s;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    SettingsButton {
                        width: 44px * s;
                        height: 34px * s;
                        focused: MisterBridge.settings-focused;
                    }
                }
            }

            system-list := ListView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                viewport-width: root.content-width;
                viewport-height: self.height;
                viewport-x: -scroll-x;

                for _ in 1: Rectangle {
                    width: root.content-width;
                    height: parent.height;
                    background: transparent;

                    for system[i] in MisterBridge.game-systems: LauncherTile {
                        x: i * (root.tile-width + root.tile-gap);
                        width: root.tile-width;
                        height: parent.height;
                        label: system.title;
                        subtitle: system.count + " games";
                        focused: !MisterBridge.settings-focused && MisterBridge.selected-index == i;
                    }
                }
            }
        }
    }
}

component CatalogScanPopup inherits Rectangle {
    in property <int> s;
    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 1200) / 1200;

    background: #00000080;

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 520px * s;
        height: 150px * s;
        background: #1e1828;
        border-width: 2px;
        border-color: #06d6a0;

        VerticalLayout {
            padding: 18px * s;
            spacing: 10px * s;

            Text {
                text: MisterBridge.catalog-scan-title;
                color: #e8e0f0;
                font-size: 16px * s;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.catalog-scan-detail;
                color: #9080a8;
                font-size: 8px * s;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 16px * s;
                background: #0e0c14;
                border-width: 1px;
                border-color: #5c4a72;
                clip: true;

                Rectangle {
                    width: 96px * s;
                    height: 100%;
                    x: (parent.width - self.width) * root.phase;
                    background: #06d6a0;
                }
            }
        }
    }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;

    height: 64px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : #5c4a72;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: label;
            color: focused ? #06d6a0 : #e8e0f0;
            font-size: 16px;
        }

        Text {
            text: detail;
            color: #9080a8;
            font-size: 8px;
        }
    }
}

component SettingsScreen inherits Rectangle {
    background: #0b0d14;

    HorizontalLayout {

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "Magik";
                color: #e8e0f0;
                font-size: 24px;
                horizontal-alignment: center;
            }

            SettingsRow {
                label: "Exit to Mister";
                detail: "Use the stock MiSTer menu until reboot";
                focused: MisterBridge.settings-selected == 0;
            }

            SettingsRow {
                label: "Controller Test";
                detail: "Open joypad tester";
                focused: MisterBridge.settings-selected == 1;
            }

            SettingsRow {
                label: "Reset Database";
                detail: "Delete library database and reboot";
                focused: MisterBridge.settings-selected == 2;
            }

            SettingsRow {
                label: "Restart";
                detail: "Reboot the MiSTer";
                focused: MisterBridge.settings-selected == 3;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

component ConfirmDialog inherits Rectangle {
    background: #000000b0;

    Rectangle {
        width: 680px;
        height: 260px;
        background: #0e0c14;
        border-width: 4px;
        border-color: #06d6a0;

        VerticalLayout {
            padding: 24px;
            spacing: 18px;

            Text {
                text: MisterBridge.confirm-title;
                color: #06d6a0;
                font-size: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.confirm-message;
                color: #e8e0f0;
                font-size: 8px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            HorizontalLayout {
                spacing: 16px;

                LauncherTile {
                    label: MisterBridge.confirm-left-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 0;
                }

                LauncherTile {
                    label: MisterBridge.confirm-right-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 1;
                }
            }
        }
    }
}

export component Launcher inherits MisterWindow {
    default-font-family: "Press Start 2P";
    title: "MiSTer MagiK Launcher";
    background: #1a1424;

    if MisterBridge.screen-mode == 0 : HomeGrid {
        width: 100%;
        height: 100%;
    }

    if MisterBridge.screen-mode == 1 : ControllerPanel { }

    if MisterBridge.screen-mode == 2 : ArcadeListScreen {
        width: 100%;
        height: 100%;
    }

    if MisterBridge.screen-mode == 3 : SettingsScreen {
        width: 100%;
        height: 100%;
    }

    if MisterBridge.setup-visible : SetupOverlay {
        phase: MisterBridge.setup-phase;
        title: MisterBridge.setup-title;
        subtitle: MisterBridge.setup-subtitle;
        list-items: MisterBridge.setup-list;
        list-selected: MisterBridge.setup-selected;
        config-labels: MisterBridge.setup-config-labels;
        config-values: MisterBridge.setup-config-values;
        setup-name: MisterBridge.setup-name;
        setup-kind-label: MisterBridge.setup-kind-label;
    }

    if MisterBridge.catalog-scan-visible : CatalogScanPopup {
        width: 100%;
        height: 100%;
        s: MisterUi.scale;
    }

    if MisterBridge.confirm-visible : ConfirmDialog {
        width: 100%;
        height: 100%;
    }

    if MisterBridge.loading-message != "": Rectangle {
        background: #1a1424;

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: MisterBridge.loading-message;
                color: #e8e0f0;
                font-size: 16px;
                horizontal-alignment: center;
            }

            Text {
                text: MisterBridge.loading-detail != "" ? MisterBridge.loading-detail : "Please wait…";
                color: #9080a8;
                font-size: 8px;
                horizontal-alignment: center;
            }
        }
    }
}
