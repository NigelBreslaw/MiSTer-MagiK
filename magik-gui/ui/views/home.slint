import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";
import { LauncherTile, SettingsButton } from "../components/launcher_chrome.slint";

export component HomeGrid inherits Rectangle {
    property <int> s: MisterUi.scale;
    property <length> tile-width: 220px * s;
    property <length> tile-gap: 16px * s;
    property <length> tile-pitch: tile-width + tile-gap;
    property <length> content-width: MisterBridge.game-systems.length * tile-width
        + Math.max(0, MisterBridge.game-systems.length - 1) * tile-gap;
    property <length> scroll-x: MisterBridge.home-scroll-x * 1px * s;
    property <length> animated-scroll-x: scroll-x;
    property <int> first-visible-index: floor(animated-scroll-x / tile-pitch);
    property <duration> scroll-duration: MisterBridge.home-scroll-repeat-active ? 0ms : 160ms;
    property <easing> scroll-easing: MisterBridge.home-scroll-repeat-active
        ? Easing.linear : Easing.ease-out;

    animate animated-scroll-x { duration: scroll-duration; easing: scroll-easing; }

    background: transparent;

    HorizontalLayout {
        VerticalLayout {
            padding: 18px * s;
            spacing: 14px * s;

            Rectangle {
                height: 42px * s;
                background: #172131;
                border-width: 1px;
                border-color: #52647d;

                HorizontalLayout {
                    padding-left: 14px * s;
                    padding-right: 10px * s;
                    spacing: 12px * s;
                    cross-axis-alignment: center;

                    Text {
                        text: "MiSTer MagiK";
                        color: #d7eef8;
                        font-size: 16px * s;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: MisterBridge.clock-text;
                        color: #d7eef8;
                        font-size: 16px * s;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    SettingsButton {
                        width: 34px * s;
                        height: 34px * s;
                        focused: MisterBridge.settings-focused;
                    }
                }
            }

            system-viewport := Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;

                Rectangle {
                    x: -root.animated-scroll-x;
                    width: root.content-width;
                    height: parent.height;
                    background: transparent;

                    // Five 220px tiles are sufficient to cover the 924px viewport at every
                    // fractional offset. The cyclic slot mapping keeps four delegates stable
                    // when first-visible-index advances and recycles only the fifth.
                    for slot in 5: LauncherTile {
                        property <int> system-index: root.first-visible-index
                            + Math.mod(Math.mod(slot - root.first-visible-index, 5) + 5, 5);

                        visible: system-index < MisterBridge.game-systems.length;
                        x: system-index * root.tile-pitch;
                        width: root.tile-width;
                        height: parent.height;
                        label: MisterBridge.game-systems[system-index].title;
                        subtitle: MisterBridge.game-systems[system-index].count + " games";
                        focused: !MisterBridge.settings-focused
                            && MisterBridge.game-systems[system-index].focused;
                    }
                }
            }
        }
    }
}
