    Banner,
    BannerVariant,
    Button,
    ButtonVariant,
    DataTable,
    DataTableCell,
    DataTableCellAlign,
    DataTableCellKind,
    DataTableCellPadding,
    DataTableColumn,
    DataTableIconTint,
    DataTableRow,
    DataTableSortDirection,
    Icons,
    LabelSize,
    LabelVariant,
    NavList,
    NavListItem,
    Pagination,
    PrimerTreeView,
    PrimerTextInput,
    Select,
    SelectOption,
    Size,
    Spinner,
    TableContainer,
    ToggleSwitch,
    ToggleSwitchSize,
    ToggleSwitchStatusLabelPosition,
    TreeViewRow,
    TreeViewTrailingVisual,
} from "../vendor/github-app/packages/primer-slint/primer.slint";
import { LayoutTokens, PrimerColors } from "../vendor/github-app/packages/primer-slint/tokens.slint";

import "../vendor/github-app/packages/primer-slint/assets/fonts/MonaSans-VariableFont.ttf";
import "../vendor/github-app/packages/primer-slint/assets/fonts/MonaSans-Italic-VariableFont.ttf";
import "../vendor/github-app/packages/primer-slint/assets/fonts/VeraMono.ttf";

export global DeviceState {
    in-out property <string> host: "192.168.1.117";
    in-out property <string> connection-state: "Looking for MiSTer";
    in-out property <string> agent-status: "Not checked yet";
    in-out property <string> token-source: "Not checked yet";
    in-out property <string> agent-version: "-";
    in-out property <string> agent-uptime: "-";
    in-out property <string> network-summary: "ip -; carrier -; state -";
    in-out property <string> mac-address: "-";
    in-out property <string> main-process: "-";
    in-out property <string> launcher-process: "-";
    in-out property <string> launcher-state: "-";
    in-out property <string> visible-owner: "-";
    in-out property <string> slint-status-freshness: "-";
    in-out property <string> catalog-summary: "-";
    in-out property <string> screen-summary: "-";
    in-out property <string> input-summary: "-";
    in-out property <string> last-error: "";
}

export global AppState {
    in-out property <string> selected-page: "debug";
}

export struct DirtyRectOverlay {
    x: int,
    y: int,
    width: int,
    height: int,
    kind: string,
}

export global AnalyticsState {
    in-out property <image> framebuffer-image;
    in-out property <int> framebuffer-width: 0;
    in-out property <int> framebuffer-height: 0;
    in-out property <string> status: "Ready to capture /dev/fb0.";
    in-out property <string> last-error: "";
    in-out property <bool> loading: false;
    in-out property <bool> has-image: false;
    in-out property <bool> can-save-image: false;
    in-out property <bool> live-stream: false;
    in-out property <string> live-stream-summary: "Live stream off.";
    in-out property <bool> show-dirty-rects: true;
    in-out property <[DirtyRectOverlay]> dirty-rects: [];
    in-out property <string> dirty-rect-summary: "Dirty overlay idle.";
}

export global SdCardState {
    in-out property <string> current-path: "/";
    in-out property <string> status: "Ready to browse /media/fat.";
    in-out property <string> last-error: "";
    in-out property <bool> loading: false;
    in-out property <bool> show-hidden: false;
    in-out property <[TreeViewRow]> rows: [
        {
            id: "/",
            label: "SD Card",
            level: 1,
            has-children: true,
            expanded: false,
            current: true,
            leading-is-directory: true,
            has-leading-visual: true,
            trailing: TreeViewTrailingVisual.none,
            has-leading-action: false,
            show-leading-action-icon: false,
            leading-action-icon: Icons.dot_fill,
            leading-file-icon: Icons.file,
            preserve-leading-icon-color: false,
            interactive: true,
            is-skeleton: false,
            has-secondary-actions: false,
            secondary-actions-badge: "",
            loading-children-badge: "",
        },
    ];
}

export global LibraryState {
    in-out property <string> status: "Sync the MiSTer library database to browse games.";
    in-out property <string> warning: "";
    in-out property <string> last-error: "";
    in-out property <bool> loading: false;
    in-out property <bool> updating_controls: false;
    in-out property <string> query: "";
    in-out property <string> system-filter: "";
    in-out property <string> category-filter: "";
    in-out property <string> region-filter: "";
    in-out property <string> manufacturer-filter: "";
    in-out property <string> preview-filter: "";
    in-out property <string> confidence-filter: "";
    in-out property <string> sort-column: "title";
    in-out property <DataTableSortDirection> sort-direction: DataTableSortDirection.ascending;
    in-out property <int> page: 1;
    in-out property <int> page-count: 1;
    in-out property <string> result-summary: "No library loaded.";
    in-out property <[DataTableRow]> rows: [];
    in-out property <[DataTableRow]> compact-rows: [];
    in-out property <[SelectOption]> system-options: [{ value: "", label: "All systems", enabled: true }];
    in-out property <[SelectOption]> category-options: [{ value: "", label: "All categories", enabled: true }];
    in-out property <[SelectOption]> region-options: [{ value: "", label: "All regions", enabled: true }];
    in-out property <[SelectOption]> manufacturer-options: [{ value: "", label: "All manufacturers", enabled: true }];
    in-out property <[SelectOption]> preview-options: [
        { value: "", label: "All previews", enabled: true },
        { value: "with-preview", label: "With preview", enabled: true },
        { value: "missing-preview", label: "Missing preview", enabled: true },
    ];
    in-out property <[SelectOption]> confidence-options: [{ value: "", label: "All confidence", enabled: true }];
    in-out property <int> system-index: 0;
    in-out property <int> category-index: 0;
    in-out property <int> region-index: 0;
    in-out property <int> manufacturer-index: 0;
    in-out property <int> preview-index: 0;
    in-out property <int> confidence-index: 0;
    in-out property <string> selected-game-id: "";
    in-out property <string> detail-title: "No game selected";
    in-out property <string> detail-subtitle: "Select a row to inspect catalog facts.";
    in-out property <[DataTableRow]> detail-overview-rows: [];
    in-out property <[DataTableRow]> detail-system-rows: [];
    in-out property <[DataTableRow]> detail-media-rows: [];
    in-out property <[DataTableRow]> detail-launch-rows: [];
    in-out property <[DataTableRow]> detail-identity-rows: [];
    in-out property <[DataTableRow]> detail-path-rows: [];
}

export global Actions {
    callback refresh-status();
    callback select-page(string);
    callback capture-framebuffer();
    callback save-framebuffer-image();
    callback live-stream-changed(bool);
    callback sd-row-toggle(string);
    callback sd-row-current(string);
    callback sd-refresh-folder();
    callback sd-show-hidden-changed(bool);
    callback sync-library();
    callback library-query-changed(string);
    callback library-filter-changed(string, string);
    callback library-sort-toggled(string, DataTableSortDirection);
    callback library-page-changed(int);
    callback library-row-selected(string);
}

export global WindowActions {
    callback start-window-drag();
}

component AppHeader {
    in property <length> safe-left: 0px;
    in property <length> safe-right: 0px;
    in property <length> safe-top: 0px;
    callback start-window-drag;

    height: max(64px, safe-top + 56px);

    Rectangle {
        background: #24292f;

        TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    root.start-window-drag();
                }
            }
        }

        HorizontalLayout {
            y: safe-top;
            width: parent.width;
            height: parent.height - safe-top;
            padding-left: max(16px, safe-left + 16px);
            padding-right: max(16px, safe-right + 16px);
            spacing: 12px;
            alignment: center;
            cross-axis-alignment: center;

            Text {
                text: "MiSTer MagiK";
                color: #ffffff;
                font-size: LayoutTokens.text-body-size-medium;
                font-weight: LayoutTokens.base-text-weight-semibold;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 32px;
                max-width: 420px;
                border-width: 1px;
                border-color: #57606a;
                border-radius: LayoutTokens.borderRadius-medium;
                background: #24292f;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Image {
                        width: LayoutTokens.iconButton-icon-size-medium;
                        height: LayoutTokens.iconButton-icon-size-medium;
                        source: Icons.search;
                        colorize: #8c959f;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: "Host " + DeviceState.host + " · " + DeviceState.connection-state;
                        color: #c9d1d9;
                        font-size: LayoutTokens.text-body-size-small;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }

        }
    }
}

component Sidebar {
    width: 240px;
    vertical-stretch: 1;

    Rectangle {
        background: PrimerColors.bgColor-inset;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: PrimerColors.borderColor-default;
        }

        VerticalLayout {
            padding-top: LayoutTokens.stack-padding-normal;
            padding-left: LayoutTokens.base-size-8;
            padding-right: LayoutTokens.base-size-8;
            spacing: LayoutTokens.base-size-16;
            alignment: start;

            Text {
                text: "Navigation";
                color: PrimerColors.fgColor-muted;
                font-size: LayoutTokens.text-body-size-small;
                font-weight: LayoutTokens.base-text-weight-semibold;
            }

            NavList {
                width: 100%;
                aria-label: "MiSTer MagiK pages";

                NavListItem {
                    label: "Debug";
                    active: AppState.selected-page == "debug";
                    has-leading-visual: true;
                    leading-icon: Icons.issue_opened;
                    clicked => { Actions.select-page("debug"); }
                }

                NavListItem {
                    label: "SD Card";
                    active: AppState.selected-page == "sd-card";
                    has-leading-visual: true;
                    leading-icon: Icons.file_directory_fill;
                    clicked => { Actions.select-page("sd-card"); }
                }

                NavListItem {
                    label: "Library";
                    active: AppState.selected-page == "library";
                    has-leading-visual: true;
                    leading-icon: Icons.table;
                    clicked => { Actions.select-page("library"); }
                }

                NavListItem {
                    label: "Analytics";
                    active: AppState.selected-page == "analytics";
                    has-leading-visual: true;
                    leading-icon: Icons.eye;
                    clicked => { Actions.select-page("analytics"); }
                }
            }
        }
    }
}

component ViewTitle {
    in property <string> title;
    in property <string> subtitle;

    width: 100%;
    height: 72px;

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        cross-axis-alignment: center;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

            Text {
                text: root.title;
                color: PrimerColors.fgColor-default;
                font-size: 20px;
                font-weight: LayoutTokens.base-text-weight-semibold;
            }

            Text {
                text: root.subtitle;
                color: PrimerColors.fgColor-muted;
                font-size: LayoutTokens.text-body-size-small;
                overflow: elide;
            }
        }
    }
}

component DebugPage {
    property <DataTableCell> empty-cell: {
        kind: DataTableCellKind.text,
        text: "",
        label-variant: LabelVariant.default,
        label-size: LabelSize.small,
        icon: Icons.dot_fill,
        icon-tint: DataTableIconTint.default
    };

    property <[DataTableColumn]> detail-columns: [
        { header: "Area", id: "area", sortable: false, align: DataTableCellAlign.start, row-header: true, cell-kind: DataTableCellKind.iconText, horizontal-stretch: 1, min-width: 150px, width: 0px, monospace: false },
        { header: "Field", id: "field", sortable: false, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 150px, width: 0px, monospace: false },
        { header: "Value", id: "value", sortable: false, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 2, min-width: 220px, width: 0px, monospace: true },
    ];

    property <[DataTableColumn]> runtime-columns: [
        { header: "Process", id: "process", sortable: false, align: DataTableCellAlign.start, row-header: true, cell-kind: DataTableCellKind.iconText, horizontal-stretch: 1, min-width: 160px, width: 0px, monospace: false },
        { header: "State", id: "state", sortable: false, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 2, min-width: 260px, width: 0px, monospace: true },
        { header: "Owner", id: "owner", sortable: false, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 160px, width: 0px, monospace: true },
    ];

    property <[DataTableRow]> connection-rows: [
        { id: "host", cells: [{ kind: DataTableCellKind.iconText, text: "Connection", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.link, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Host", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.host, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "agent", cells: [{ kind: DataTableCellKind.iconText, text: "Connection", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.link, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Agent", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.agent-status, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "token", cells: [{ kind: DataTableCellKind.iconText, text: "Connection", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.shield_check, icon-tint: DataTableIconTint.success }, { kind: DataTableCellKind.text, text: "Token", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.token-source, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
    ];

    property <[DataTableRow]> device-rows: [
        { id: "version", cells: [{ kind: DataTableCellKind.iconText, text: "Device", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.repo, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Agent version", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.agent-version, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "uptime", cells: [{ kind: DataTableCellKind.iconText, text: "Device", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.history, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Agent uptime", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.agent-uptime, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "network", cells: [{ kind: DataTableCellKind.iconText, text: "Device", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.link, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Network", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.network-summary + "; mac " + DeviceState.mac-address, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
    ];

    property <[DataTableRow]> runtime-rows: [
        { id: "main", cells: [{ kind: DataTableCellKind.iconText, text: "Main", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.repo, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.main-process, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.visible-owner, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "launcher", cells: [{ kind: DataTableCellKind.iconText, text: "Launcher", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.layout_grid, icon-tint: DataTableIconTint.done }, { kind: DataTableCellKind.text, text: DeviceState.launcher-process, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.launcher-state, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "slint-status", cells: [{ kind: DataTableCellKind.iconText, text: "Slint status", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.palette, icon-tint: DataTableIconTint.success }, { kind: DataTableCellKind.text, text: DeviceState.slint-status-freshness, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "owner " + DeviceState.visible-owner, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
    ];

    property <[DataTableRow]> library-rows: [
        { id: "catalog", cells: [{ kind: DataTableCellKind.iconText, text: "Library", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.table, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Catalog", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.catalog-summary, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "screen", cells: [{ kind: DataTableCellKind.iconText, text: "Library", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.eye, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Screen", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.screen-summary, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
        { id: "input", cells: [{ kind: DataTableCellKind.iconText, text: "Input", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.checkbox, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: "Controller", label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }, { kind: DataTableCellKind.text, text: DeviceState.input-summary, label-variant: LabelVariant.default, label-size: LabelSize.small, icon: Icons.dot_fill, icon-tint: DataTableIconTint.default }] },
    ];

    VerticalLayout {
        spacing: 16px;
        alignment: start;

        ViewTitle {
            title: "Debug";
            subtitle: "Read-only device, runtime, catalog, and input telemetry.";
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 24px;
            spacing: 16px;
            alignment: start;

            if DeviceState.last-error != "": Banner {
                title: "Connection error";
                description: DeviceState.last-error;
                variant: BannerVariant.critical;
            }

            TableContainer {
                title: "Connection";
                subtitle: "Agent reachability and token source.";
                primary-action-label: "Refresh";
                primary-action-variant: ButtonVariant.default;
                primary-action => { Actions.refresh-status(); }

                DataTable {
                    width: 100%;
                    cell-padding: DataTableCellPadding.normal;
                    columns: detail-columns;
                    rows: connection-rows;
                }
            }

            TableContainer {
                title: "Device";
                subtitle: "Agent build, uptime, and network identity.";

                DataTable {
                    width: 100%;
                    cell-padding: DataTableCellPadding.normal;
                    columns: detail-columns;
                    rows: device-rows;
                }
            }

            TableContainer {
                title: "Runtime";
                subtitle: "Main, launcher, and Slint status ownership.";

                DataTable {
                    width: 100%;
                    cell-padding: DataTableCellPadding.normal;
                    columns: runtime-columns;
                    rows: runtime-rows;
                }
            }

            TableContainer {
                title: "Library and input";
                subtitle: "Catalog, visible scene, and controller summary.";

                DataTable {
                    width: 100%;
                    cell-padding: DataTableCellPadding.normal;
                    columns: detail-columns;
                    rows: library-rows;
                }
            }
        }
    }
}

component LibraryDetailSection {
    in property <string> title;
    in property <[DataTableRow]> rows;
    in property <[DataTableColumn]> columns;

    if rows.length > 0: VerticalLayout {
        spacing: 8px;

        Text {
            text: root.title;
            color: PrimerColors.fgColor-default;
            font-size: LayoutTokens.text-body-size-small;
            font-weight: LayoutTokens.base-text-weight-semibold;
        }

        DataTable {
            width: 100%;
            cell-padding: DataTableCellPadding.condensed;
            columns: root.columns;
            rows: root.rows;
        }
    }
}

component LibraryDetailPanel {
    property <[DataTableColumn]> detail-columns: [
        { header: "Fact", id: "fact", sortable: false, align: DataTableCellAlign.start, row-header: true, cell-kind: DataTableCellKind.text, horizontal-stretch: 0, min-width: 108px, width: 108px, monospace: false },
        { header: "Value", id: "value", sortable: false, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 160px, width: 0px, monospace: false },
    ];

    TableContainer {
        vertical-stretch: 1;
        title: LibraryState.detail-title;
        subtitle: LibraryState.detail-subtitle;

        Rectangle {
            width: 100%;
            vertical-stretch: 1;
            min-height: 360px;
            border-width: 1px;
            border-color: PrimerColors.borderColor-default;
            border-radius: LayoutTokens.borderRadius-medium;
            background: PrimerColors.bgColor-default;
            clip: true;

            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: detail-content.preferred-height;

                detail-content := VerticalLayout {
                    width: parent.width;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 16px;
                    alignment: start;

                    if LibraryState.selected-game-id == "": Text {
                        text: "Select a game row to inspect the local catalog snapshot.";
                        color: PrimerColors.fgColor-muted;
                        font-size: LayoutTokens.text-body-size-small;
                        wrap: word-wrap;
                    }

                    LibraryDetailSection { title: "Overview"; columns: detail-columns; rows: LibraryState.detail-overview-rows; }
                    LibraryDetailSection { title: "System"; columns: detail-columns; rows: LibraryState.detail-system-rows; }
                    LibraryDetailSection { title: "Media"; columns: detail-columns; rows: LibraryState.detail-media-rows; }
                    LibraryDetailSection { title: "Launch"; columns: detail-columns; rows: LibraryState.detail-launch-rows; }
                    LibraryDetailSection { title: "Identity"; columns: detail-columns; rows: LibraryState.detail-identity-rows; }
                    LibraryDetailSection { title: "Paths"; columns: detail-columns; rows: LibraryState.detail-path-rows; }
                }
            }
        }
    }
}

component LibraryTableContent {
    in property <bool> compact-table;
    in property <[DataTableColumn]> library-columns;

    VerticalLayout {
        spacing: 12px;

        if LibraryState.loading: HorizontalLayout {
            height: 32px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            Spinner {
                size: Size.small;
            }

            Text {
                text: "Copying the MagiK library database from " + DeviceState.host + ".";
                color: PrimerColors.fgColor-muted;
                font-size: LayoutTokens.text-body-size-small;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            width: 100%;
            spacing: 10px;

            PrimerTextInput {
                width: 100%;
                text: LibraryState.query;
                placeholder: "Search title, system, maker, genre, region, year, launch ref, identities";
                has-leading-visual: true;
                leading-visual: Icons.search;
                has-trailing-action: true;
                loading: LibraryState.loading;
                edited(value) => {
                    LibraryState.query = value;
                    Actions.library-query-changed(value);
                }
            }

            HorizontalLayout {
                width: 100%;
                spacing: 8px;

                Select {
                    horizontal-stretch: 1;
                    selected-index: LibraryState.system-index;
                    options: LibraryState.system-options;
                    selected-changed(index) => {
                        if !LibraryState.updating_controls {
                            Actions.library-filter-changed("system", LibraryState.system-options[index].value);
                        }
                    }
                }

                Select {
                    horizontal-stretch: 1;
                    selected-index: LibraryState.category-index;
                    options: LibraryState.category-options;
                    selected-changed(index) => {
                        if !LibraryState.updating_controls {
                            Actions.library-filter-changed("category", LibraryState.category-options[index].value);
                        }
                    }
                }

                Select {
                    horizontal-stretch: 1;
                    selected-index: LibraryState.region-index;
                    options: LibraryState.region-options;
                    selected-changed(index) => {
                        if !LibraryState.updating_controls {
                            Actions.library-filter-changed("region", LibraryState.region-options[index].value);
                        }
                    }
                }
            }

            HorizontalLayout {
                width: 100%;
                spacing: 8px;

                Select {
                    horizontal-stretch: 1;
                    selected-index: LibraryState.manufacturer-index;
                    options: LibraryState.manufacturer-options;
                    selected-changed(index) => {
                        if !LibraryState.updating_controls {
                            Actions.library-filter-changed("manufacturer", LibraryState.manufacturer-options[index].value);
                        }
                    }
                }

                Select {
                    horizontal-stretch: 1;
                    selected-index: LibraryState.preview-index;
                    options: LibraryState.preview-options;
                    selected-changed(index) => {
                        if !LibraryState.updating_controls {
                            Actions.library-filter-changed("preview", LibraryState.preview-options[index].value);
                        }
                    }
                }

                Select {
                    horizontal-stretch: 1;
                    selected-index: LibraryState.confidence-index;
                    options: LibraryState.confidence-options;
                    selected-changed(index) => {
                        if !LibraryState.updating_controls {
                            Actions.library-filter-changed("confidence", LibraryState.confidence-options[index].value);
                        }
                    }
                }
            }
        }

        DataTable {
            width: 100%;
            vertical-stretch: 1;
            cell-padding: DataTableCellPadding.normal;
            columns: library-columns;
            rows: compact-table ? LibraryState.compact-rows : LibraryState.rows;
            sorted-column-id: LibraryState.sort-column;
            sort-direction: LibraryState.sort-direction;
            sort-toggled(column, direction) => { Actions.library-sort-toggled(column, direction); }
            row-clicked(id) => { Actions.library-row-selected(id); }
        }

        HorizontalLayout {
            width: 100%;
            height: 36px;
            spacing: 12px;
            alignment: space-between;
            cross-axis-alignment: center;

            Text {
                text: LibraryState.result-summary;
                color: PrimerColors.fgColor-muted;
                font-size: LayoutTokens.text-body-size-small;
                overflow: elide;
                vertical-alignment: center;
            }

            Pagination {
                page-count: LibraryState.page-count;
                current-page: LibraryState.page;
                show-pages: !compact-table;
                page-changed(page-index) => { Actions.library-page-changed(page-index + 1); }
            }
        }
    }
}

component LibraryPage {
    property <bool> compact-table: self.width < 1080px;
    property <bool> stacked-layout: self.width < 1040px;
    property <[DataTableColumn]> library-columns: [
        { header: "Title", id: "title", sortable: true, align: DataTableCellAlign.start, row-header: true, cell-kind: DataTableCellKind.text, horizontal-stretch: 2, min-width: 180px, width: 0px, monospace: false },
        { header: "System", id: "system", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 120px, width: 0px, monospace: false },
        { header: "Year", id: "year", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 0, min-width: 60px, width: 60px, monospace: true },
        { header: "Manufacturer", id: "manufacturer", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 124px, width: 0px, monospace: false },
        { header: "Category", id: "category", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 112px, width: 0px, monospace: false },
        { header: "Preview", id: "preview", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.label, horizontal-stretch: 0, min-width: 92px, width: 92px, monospace: false },
        { header: "Discovered", id: "discovered", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 0, min-width: 112px, width: 112px, monospace: true },
    ];
    property <[DataTableColumn]> compact-columns: [
        { header: "Title", id: "title", sortable: true, align: DataTableCellAlign.start, row-header: true, cell-kind: DataTableCellKind.text, horizontal-stretch: 2, min-width: 170px, width: 0px, monospace: false },
        { header: "System", id: "system", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.text, horizontal-stretch: 1, min-width: 120px, width: 0px, monospace: false },
        { header: "Media", id: "preview", sortable: true, align: DataTableCellAlign.start, row-header: false, cell-kind: DataTableCellKind.label, horizontal-stretch: 0, min-width: 104px, width: 104px, monospace: false },
    ];

    VerticalLayout {
        spacing: 16px;
        alignment: start;

        ViewTitle {
            title: "Library";
            subtitle: LibraryState.status;
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 24px;
            spacing: 16px;
            alignment: start;

            if LibraryState.warning != "": Banner {
                title: "Using cached library";
                description: LibraryState.warning;
                variant: BannerVariant.warning;
            }

            if LibraryState.last-error != "": Banner {
                title: "Library sync error";
                description: LibraryState.last-error;
                variant: BannerVariant.critical;
            }

            if stacked-layout: VerticalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 16px;

                TableContainer {
                    vertical-stretch: 1;
                    title: "Games";
                    subtitle: LibraryState.result-summary;
                    primary-action-label: LibraryState.loading ? "Syncing..." : "Sync library";
                    primary-action-variant: ButtonVariant.default;
                    primary-action => { Actions.sync-library(); }

                    LibraryTableContent { compact-table: true; library-columns: compact-columns; }
                }

                LibraryDetailPanel { width: 100%; }
            }

            if !stacked-layout: HorizontalLayout {
                width: 100%;
                vertical-stretch: 1;
                spacing: 16px;

                TableContainer {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    title: "Games";
                    subtitle: LibraryState.result-summary;
                    primary-action-label: LibraryState.loading ? "Syncing..." : "Sync library";
                    primary-action-variant: ButtonVariant.default;
                    primary-action => { Actions.sync-library(); }

                    LibraryTableContent { compact-table: compact-table; library-columns: compact-table ? compact-columns : library-columns; }
                }

                LibraryDetailPanel {
                    width: 340px;
                    vertical-stretch: 1;
                }
            }
        }
    }
}

component SdCardPage {
    VerticalLayout {
        spacing: 16px;
        alignment: start;

        ViewTitle {
            title: "SD Card";
            subtitle: SdCardState.status;
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 24px;
            spacing: 16px;
            alignment: start;

            if SdCardState.last-error != "": Banner {
                title: "SD Card browse error";
                description: SdCardState.last-error;
                variant: BannerVariant.critical;
            }

            HorizontalLayout {
                width: 100%;
                spacing: LayoutTokens.base-size-8;
                alignment: end;
                cross-axis-alignment: center;

                Text {
                    text: "Hidden files";
                    color: PrimerColors.fgColor-muted;
                    font-size: LayoutTokens.text-body-size-small;
                    vertical-alignment: center;
                }

                ToggleSwitch {
                    checked: SdCardState.show-hidden;
                    size: ToggleSwitchSize.small;
                    status-label-position: ToggleSwitchStatusLabelPosition.end;
                    button-label-on: "On";
                    button-label-off: "Off";
                    changed(show) => { Actions.sd-show-hidden-changed(show); }
                }
            }

            TableContainer {
                vertical-stretch: 1;
                title: "/media/fat";
                subtitle: "Browse-only session cache. Visited folders are reused until refreshed.";
                primary-action-label: "Refresh folder";
                primary-action-variant: ButtonVariant.default;
                primary-action => { Actions.sd-refresh-folder(); }

                Rectangle {
                    width: 100%;
                    vertical-stretch: 1;
                    min-height: 360px;
                    border-width: 1px;
                    border-color: PrimerColors.borderColor-default;
                    border-radius: LayoutTokens.borderRadius-medium;
                    background: PrimerColors.bgColor-default;

                    PrimerTreeView {
                        x: LayoutTokens.base-size-8;
                        y: LayoutTokens.base-size-8;
                        width: parent.width - 2 * LayoutTokens.base-size-8;
                        height: parent.height - 2 * LayoutTokens.base-size-8;
                        rows: SdCardState.rows;
                        virtualized: true;
                        suppress-current-for-directories: true;
                        accessible-name: "SD Card files";
                        row-toggle-requested(id) => { Actions.sd-row-toggle(id); }
                        row-current-requested(id) => { Actions.sd-row-current(id); }
                    }
                }
            }
        }
    }
}

component AnalyticsPage {
    VerticalLayout {
        spacing: 16px;
        alignment: start;

        ViewTitle {
            title: "Analytics";
            subtitle: AnalyticsState.status;
        }

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-bottom: 24px;
            spacing: 16px;
            alignment: start;

            if AnalyticsState.last-error != "": Banner {
                title: "Framebuffer capture error";
                description: AnalyticsState.last-error;
                variant: BannerVariant.critical;
            }

            TableContainer {
                vertical-stretch: 1;
                title: "Framebuffer";
                subtitle: "Current /dev/fb0 frame from the MiSTer agent.";
                primary-action-label: AnalyticsState.loading ? "Capturing..." : "Capture framebuffer";
                primary-action-variant: ButtonVariant.default;
                primary-action => { Actions.capture-framebuffer(); }

                HorizontalLayout {
                    height: 32px;
                    spacing: 16px;
                    alignment: start;

                    Button {
                        width: 132px;
                        height: 32px;
                        label: "Save PNG";
                        disabled: !AnalyticsState.can-save-image || AnalyticsState.loading;
                        variant: ButtonVariant.default;
                        clicked => { Actions.save-framebuffer-image(); }
                    }

                    ToggleSwitch {
                        checked: AnalyticsState.live-stream;
                        size: ToggleSwitchSize.small;
                        button-label-on: "Live stream";
                        button-label-off: "Live stream";
                        changed(checked) => {
                            AnalyticsState.live-stream = checked;
                            Actions.live-stream-changed(checked);
                        }
                    }

                    Text {
                        vertical-stretch: 1;
                        text: AnalyticsState.live-stream-summary;
                        color: PrimerColors.fgColor-muted;
                        font-size: LayoutTokens.text-body-size-small;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 100%;
                    vertical-stretch: 1;
                    min-height: 420px;
                    border-width: 1px;
                    border-color: PrimerColors.borderColor-default;
                    border-radius: LayoutTokens.borderRadius-medium;
                    background: #0d1117;
                    clip: true;

                    if AnalyticsState.has-image: Image {
                        width: parent.width;
                        height: parent.height;
                        source: AnalyticsState.framebuffer-image;
                        image-fit: contain;
                    }

                    if !AnalyticsState.has-image: Text {
                        x: 24px;
                        y: 24px;
                        width: parent.width - 48px;
                        text: AnalyticsState.loading ? "Capturing framebuffer..." : "No framebuffer capture yet.";
                        color: #8c959f;
                        font-size: LayoutTokens.text-body-size-small;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "MiSTer MagiK";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    default-font-family: "Mona Sans";

    Rectangle {
        background: PrimerColors.bgColor-default;

        VerticalLayout {
            AppHeader {
                safe-left: root.safe-area-insets.left;
                safe-right: root.safe-area-insets.right;
                safe-top: root.safe-area-insets.top;
                start-window-drag => { WindowActions.start-window-drag(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar { }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: PrimerColors.bgColor-default;

                    if AppState.selected-page == "debug": Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;
                        viewport-height: content.preferred-height;

                        content := VerticalLayout {
                            width: parent.width;
                            min-height: parent.height;
                            alignment: start;

                            DebugPage { }
                        }
                    }

                    if AppState.selected-page == "sd-card": SdCardPage {
                        width: parent.width;
                        height: parent.height;
                    }

                    if AppState.selected-page == "library": LibraryPage {
                        width: parent.width;
                        height: parent.height;
                    }

                    if AppState.selected-page == "analytics": AnalyticsPage {
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }
    }
}
