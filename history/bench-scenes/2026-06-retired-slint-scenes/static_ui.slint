import { MisterWindow, MisterUi } from "../../../magik-gui/ui/mister_window.slint";
export { MisterUi }
import "../../../magik-gui/ui/fonts/PressStart2P-Regular.ttf";

export component StaticUi inherits MisterWindow {
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <int> s: MisterUi.scale;

    Text {
        x: 32px * s;
        y: 24px * s;
        text: "bench: static_ui";
        font-size: 24px * s;
        color: #e8ecff;
    }

    Rectangle {
        x: 32px * s;
        y: 100px * s;
        width: parent.width - 64px * s;
        height: 48px * s;
        background: #1a2744;
        border-radius: 7px * s;

        Text {
            x: 12px * s;
            y: 12px * s;
            text: "No animation — measures idle repaint / fbcon persistence";
            font-size: 16px * s;
            color: #8b93b8;
        }
    }

    Rectangle {
        x: 32px * s;
        y: 180px * s;
        width: 200px * s;
        height: 200px * s;
        background: #2d6a4f;
        border-radius: 4px * s;
    }

    Rectangle {
        x: 260px * s;
        y: 180px * s;
        width: 200px * s;
        height: 200px * s;
        background: #9d4edd;
        border-radius: 4px * s;
    }
}
