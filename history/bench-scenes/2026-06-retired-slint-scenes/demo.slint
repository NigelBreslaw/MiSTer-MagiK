import { MisterWindow, MisterUi } from "../../../magik-gui/ui/mister_window.slint";
export { MisterUi }
import "../../../magik-gui/ui/fonts/PressStart2P-Regular.ttf";

export component AppWindow inherits MisterWindow {
    background: #0b1020;
    default-font-family: "Press Start 2P";

    property <int> s: MisterUi.scale;
    property <duration> tick: animation-tick();
    property <float> phase: Math.mod(tick / 1ms, 4000) / 4000;
    property <float> bounce: phase < 0.5 ? phase * 2 : 2 - phase * 2;
    property <float> angle: Math.mod(tick / 1ms, 3000) / 3000 * 360;

    Text {
        x: 32px * s;
        y: 24px * s;
        text: "MiSTer · Slint · software renderer";
        font-size: 24px * s;
        color: #e8ecff;
    }

    Rectangle {
        x: 32px * s;
        y: 100px * s;
        width: parent.width - 64px * s;
        height: 48px * s;
        background: #131c33;
        border-radius: 7px * s;
        clip: true;

        Rectangle {
            width: 140px * s;
            height: parent.height - 12px * s;
            y: 6px * s;
            x: 6px * s + (parent.width - 140px * s - 12px * s) * root.bounce;
            border-radius: 5px * s;
            background: @linear-gradient(90deg, #ff5d73 0%, #ffd166 50%, #06d6a0 100%);
        }
    }

    Rectangle {
        x: parent.width / 2 - 110px * s;
        y: 210px * s;
        width: 220px * s;
        height: 220px * s;

        for i in 12: Rectangle {
            property <angle> a: (root.angle + i * 30) * 1deg;
            width: 13px * s;
            height: 13px * s;
            border-radius: 6px * s;
            x: parent.width / 2 - 6px * s + 90px * s * Math.cos(a);
            y: parent.height / 2 - 6px * s + 90px * s * Math.sin(a);
            background: #4cc9f0;
            opacity: 0.4 + 0.6 * (i / 12.0);
        }
    }

    Text {
        x: 32px * s;
        y: parent.height - 48px * s;
        text: "vsync-locked 60fps · fork-free framebuffer";
        font-size: 16px * s;
        color: #8b93b8;
    }
}
