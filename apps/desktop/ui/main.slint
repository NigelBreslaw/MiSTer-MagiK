import {
    Banner,
    BannerVariant,
    Button,
    ButtonVariant,
    DataTable,
    DataTableCell,
    DataTableCellAlign,
    DataTableCellKind,
    DataTableCellPadding,
    DataTableColumn,
    DataTableIconTint,
    DataTableRow,
    DataTableSortDirection,
    Icons,
    LabelSize,
    LabelVariant,
    Pagination,
    PrimerTreeView,
    PrimerTextInput,
    SegmentedControl,
    SegmentedControlSegment,
    SegmentedControlSize,
    Select,
    SelectOption,
    Size,
    Spinner,
    TableContainer,
    ToggleSwitch,
    ToggleSwitchSize,
    ToggleSwitchStatusLabelPosition,
    TreeViewRow,
    TreeViewTrailingVisual,
} from "../vendor/github-app/packages/primer-slint/primer.slint";
import { LayoutTokens, PrimerColors } from "../vendor/github-app/packages/primer-slint/tokens.slint";

import "../vendor/github-app/packages/primer-slint/assets/fonts/MonaSans-VariableFont.ttf";
import "../vendor/github-app/packages/primer-slint/assets/fonts/MonaSans-Italic-VariableFont.ttf";
import "../vendor/github-app/packages/primer-slint/assets/fonts/VeraMono.ttf";

import {
    Actions,
    AnalyticsState,
    AppState,
    DeviceState,
    DirtyRectOverlay,
    LibraryState,
    ProfileFrameBar,
    ProfileFrameSegment,
    ProfileHeatmapCell,
    RealtimeCpuCore,
    RealtimeFramePhase,
    RealtimeHealthTile,
    RealtimePoint,
    RealtimeState,
    SdCardState,
    WindowActions,
} from "api.slint";
import { AppHeader, Sidebar } from "components/chrome.slint";
import { DebugPage } from "views/debug.slint";
import { SdCardPage } from "views/sd_card.slint";
import { LibraryPage } from "views/library.slint";
import { AnalyticsPage } from "views/analytics.slint";

export {
    Actions,
    AnalyticsState,
    AppState,
    DeviceState,
    DirtyRectOverlay,
    LibraryState,
    ProfileFrameBar,
    ProfileFrameSegment,
    ProfileHeatmapCell,
    RealtimeCpuCore,
    RealtimeFramePhase,
    RealtimeHealthTile,
    RealtimePoint,
    RealtimeState,
    SdCardState,
    WindowActions,
}

export component AppWindow inherits Window {
    title: "MiSTer MagiK";
    min-width: 1100px;
    min-height: 760px;
    default-font-family: "Mona Sans";

    Rectangle {
        background: PrimerColors.bgColor-default;
        VerticalLayout {
            height: parent.height;
            AppHeader {
                safe-left: 0px;
                safe-right: root.safe-area-insets.right;
                safe-top: root.safe-area-insets.top;
                start-window-drag => { WindowActions.start-window-drag(); }
            }
            HorizontalLayout {
                Sidebar {
                    
                    safe-top: root.safe-area-insets.top;
                }
    
                VerticalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
    
                    
    
                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        background: PrimerColors.bgColor-default;
    
                        if AppState.selected-page == "debug": Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-width: self.width;
                            viewport-height: content.preferred-height;
    
                            content := VerticalLayout {
                                width: parent.width;
                                min-height: parent.height;
                                alignment: start;
    
                                DebugPage { }
                            }
                        }
    
                        if AppState.selected-page == "sd-card": SdCardPage {
                            width: parent.width;
                            height: parent.height;
                        }
    
                        if AppState.selected-page == "library": LibraryPage {
                            width: parent.width;
                            height: parent.height;
                        }
    
                        if AppState.selected-page == "analytics": AnalyticsPage {
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
        }
    }
}
