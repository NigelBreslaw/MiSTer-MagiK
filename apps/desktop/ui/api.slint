export global AppState {
    in-out property <string> selected-page: "debug";
    in-out property <int> debug-tab-index: 0;
}

export struct DirtyRectOverlay {
    x: int,
    y: int,
    width: int,
    height: int,
    kind: string,
}

export struct ProfileFrameSegment {
    phase: string,
    us: int,
    start-us: int,
}

export struct ProfileFrameBar {
    frame: int,
    wall-us: int,
    over-budget: bool,
    segments: [ProfileFrameSegment],
}

export struct ProfileHeatmapCell {
    x: int,
    y: int,
    hits: int,
    intensity: float,
}

export struct RealtimeCpuCore {
    label: string,
    busy-pct: float,
}

export struct RealtimePoint {
    value: float,
    alert: bool,
}

export struct RealtimeFramePhase {
    label: string,
    us: int,
    start-us: int,
    color-index: int,
}

export struct RealtimeHealthTile {
    title: string,
    value: string,
    detail: string,
    state: string,
}

export struct SdMetadataRow {
    label: string,
    value: string,
    kind: string,
}

