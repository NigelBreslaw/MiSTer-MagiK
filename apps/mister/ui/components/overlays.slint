import { Start2P, Start2PSize } from "start2p.slint";
import { Nocive15, Nocive15Size } from "nocive_15.slint";

import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";
import { OsdSideLabel } from "launcher_chrome.slint";
import { CrtTheme } from "crt_ui.slint";
import { ScreenshotPackProgressRow } from "progress.slint";

export component CatalogScanPopup inherits Rectangle {
    property <length> scan-osd-width: MisterUi.compact-layout ? 0px : 56px;
    property <length> scan-horizontal-padding: MisterUi.compact-layout ? MisterUi.grid : 70px;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px
        ? scan-content-width
        : 560px;

    background: CrtTheme.background;

    HorizontalLayout {
        if !MisterUi.compact-layout : OsdSideLabel { }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: MisterUi.compact-layout ? MisterUi.grid : 82px;
            padding-bottom: MisterUi.compact-layout ? MisterUi.grid : 76px;
            spacing: MisterUi.compact-layout ? MisterUi.grid : 18px;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Start2P {
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: #06d6a0;
                size: MisterUi.crt-heading-font;
                horizontal-alignment: center;
            }

            Start2P {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-message;
                color: #e8e0f0;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Start2P {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-title;
                color: #d7eef8;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
            }

            Start2P {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-detail;
                color: #9080a8;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if MisterBridge.media-pack-progresses.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px;

                Start2P {
                    text: MisterBridge.media-pack-summary;
                    color: #d7eef8;
                    size: Start2PSize.px8;
                    horizontal-alignment: center;
                }

                for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {

    width: min(560px, MisterUi.window-width * 1px - 16px);
    height: min(100px, MisterUi.window-height * 1px - 16px);
    x: MisterUi.window-width * 1px / 2 - self.width / 2;
    y: MisterUi.window-height * 1px - self.height - MisterUi.grid;
    background: CrtTheme.panel;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        Start2P {
            text: MisterBridge.media-pack-summary;
            color: #d7eef8;
            size: Start2PSize.px8;
            horizontal-alignment: center;
        }

        for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
            pack: pack;
        }
    }
}

export component StartupSplash inherits Rectangle {

    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Start2P {
            text: "MiSTer MagiK";
            color: #e8e0f0;
            size: Start2PSize.px32;
            horizontal-alignment: center;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {

    width: t.width + 20px;
    height: 28px;
    x: MisterUi.window-width * 1px - self.width - 18px;
    y: MisterUi.window-height * 1px - self.height - 16px;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;


    t := HorizontalLayout {
        alignment: start;
        width: self.preferred-width;
        Start2P {
            text: "Building library";
            color: #d7eef8;
            size: Start2PSize.px8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Start2P {
            text: ".";
            color: MisterBridge.catalog-scan-dot-visible ? #d7eef8 : transparent;
            size: Start2PSize.px8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

    }
}

component CompactDialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;

    height: 32px;
    background: focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: 1px;
    border-color: focused ? CrtTheme.accent : acknowledged ? #4e8f80 : CrtTheme.border;

    Start2P {
        text: root.label;
        color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
        size: MisterUi.crt-body-font;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ConfirmDialog inherits Rectangle {
    background: #000000b0;

    Rectangle {
        width: MisterUi.compact-layout ? parent.width - 16px : min(640px, parent.width - 32px);
        height: MisterUi.compact-layout ? min(224px, parent.height - 16px) : 224px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: CrtTheme.panel;
        border-width: 1px;
        border-color: CrtTheme.accent;

        VerticalLayout {
            padding: MisterUi.grid;
            spacing: MisterUi.grid;

            Start2P {
                text: MisterBridge.confirm-title;
                color: CrtTheme.accent;
                size: MisterUi.crt-heading-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Start2P {
                text: MisterBridge.confirm-message;
                color: CrtTheme.text;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                height: 32px;
                spacing: MisterUi.grid;

                if MisterBridge.confirm-left-label != "" : CompactDialogButton {
                    label: MisterBridge.confirm-left-label;
                    focused: MisterBridge.confirm-selected == 0;
                    acknowledged: MisterBridge.selection-feedback-query("", "left", MisterBridge.selection-feedback-revision);
                }

                if MisterBridge.confirm-right-label != "" : CompactDialogButton {
                    label: MisterBridge.confirm-right-label;
                    focused: MisterBridge.confirm-selected == 1;
                    acknowledged: MisterBridge.selection-feedback-query("", "right", MisterBridge.selection-feedback-revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Nocive15 {
            text: MisterBridge.loading-message;
            color: #e8e0f0;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }

        Start2P {
            text: MisterBridge.loading-detail != "" ? MisterBridge.loading-detail : "Please wait...";
            color: #9080a8;
            size: Start2PSize.px8;
            horizontal-alignment: center;
        }
    }
}
