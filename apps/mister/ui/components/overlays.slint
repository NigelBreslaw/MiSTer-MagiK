import { Spleen6x12, Spleen6x12Size } from "spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "nocive_15.slint";

import { MisterUi } from "../mister_window.slint";
import { CatalogView, DialogChoice, FeedbackView, MediaView, OverlayView } from "../api.slint";
import { OsdSideLabel } from "launcher_chrome.slint";
import { CrtTheme } from "crt_ui.slint";
import { MediaPackProgressRow } from "progress.slint";

export component CatalogScanPopup inherits Rectangle {
    property <length> scan-osd-width: MisterUi.compact-layout ? 0px : 56px;
    property <length> scan-horizontal-padding: MisterUi.compact-layout ? MisterUi.grid : 70px;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px
        ? scan-content-width
        : 560px;

    background: CrtTheme.background;

    HorizontalLayout {
        if !MisterUi.compact-layout : OsdSideLabel { }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: MisterUi.compact-layout ? MisterUi.grid : 82px;
            padding-bottom: MisterUi.compact-layout ? MisterUi.grid : 76px;
            spacing: MisterUi.compact-layout ? MisterUi.grid : 18px;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Spleen6x12 {
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: #06d6a0;
                size: MisterUi.crt-heading-font;
                horizontal-alignment: center;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.message;
                color: #e8e0f0;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.title;
                color: #d7eef8;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.detail;
                color: #9080a8;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if MediaView.rows.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px;

                Spleen6x12 {
                    text: MediaView.summary;
                    color: #d7eef8;
                    size: Spleen6x12Size.px8;
                    horizontal-alignment: center;
                }

                for pack in MediaView.rows: MediaPackProgressRow {
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {

    width: min(560px, MisterUi.window-width * 1px - 16px);
    height: min(100px, MisterUi.window-height * 1px - 16px);
    x: MisterUi.window-width * 1px / 2 - self.width / 2;
    y: MisterUi.window-height * 1px - self.height - MisterUi.grid;
    background: CrtTheme.panel;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        Spleen6x12 {
            text: MediaView.summary;
            color: #d7eef8;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }

        for pack in MediaView.rows: MediaPackProgressRow {
            pack: pack;
        }
    }
}

export component StartupSplash inherits Rectangle {

    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Spleen6x12 {
            text: "MiSTer MagiK";
            color: #e8e0f0;
            size: Spleen6x12Size.px32;
            horizontal-alignment: center;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {

    width: t.width + 20px;
    height: 28px;
    x: MisterUi.window-width * 1px - self.width - 18px;
    y: MisterUi.window-height * 1px - self.height - 16px;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;


    t := HorizontalLayout {
        alignment: start;
        width: self.preferred-width;
        Spleen6x12 {
            text: CatalogView.title == "" ? "Preparing system update" : CatalogView.title;
            color: #d7eef8;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CompactDialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;

    height: 32px;
    background: focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: 1px;
    border-color: focused ? CrtTheme.accent : acknowledged ? #4e8f80 : CrtTheme.border;

    Spleen6x12 {
        text: root.label;
        color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
        size: MisterUi.crt-body-font;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ConfirmDialog inherits Rectangle {
    background: #000000b0;

    Rectangle {
        width: MisterUi.compact-layout ? parent.width - 16px : min(640px, parent.width - 32px);
        height: MisterUi.compact-layout ? min(224px, parent.height - 16px) : 224px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: CrtTheme.panel;
        border-width: 1px;
        border-color: CrtTheme.accent;

        VerticalLayout {
            padding: MisterUi.grid;
            spacing: MisterUi.grid;

            Spleen6x12 {
                text: OverlayView.confirmation-title;
                color: CrtTheme.accent;
                size: MisterUi.crt-heading-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Spleen6x12 {
                text: OverlayView.confirmation-message;
                color: CrtTheme.text;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                height: 32px;
                spacing: MisterUi.grid;

                if OverlayView.cancel-label != "" : CompactDialogButton {
                    label: OverlayView.cancel-label;
                    focused: OverlayView.selected-choice == DialogChoice.cancel;
                    acknowledged: FeedbackView.acknowledged("", "left", FeedbackView.revision);
                }

                if OverlayView.confirm-label != "" : CompactDialogButton {
                    label: OverlayView.confirm-label;
                    focused: OverlayView.selected-choice == DialogChoice.confirm;
                    acknowledged: FeedbackView.acknowledged("", "right", FeedbackView.revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Nocive15 {
            text: OverlayView.loading-message;
            color: #e8e0f0;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }

        Spleen6x12 {
            text: OverlayView.loading-detail != "" ? OverlayView.loading-detail : "Please wait...";
            color: #9080a8;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }
    }
}
