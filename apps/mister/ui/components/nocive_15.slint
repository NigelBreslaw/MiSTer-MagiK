export enum Nocive15Size {
    px15,
}

export global Nocive15Metrics {
    // The 16px Slint resource size produces exact 15px physical capitals.
    pure public function resolve(size: Nocive15Size) -> length {
        return 16px;
    }
}

export component Nocive15 inherits Text {
    in property <Nocive15Size> size: Nocive15Size.px15;
    color: white;
    font-family: "Nocive 15";
    font-size: Nocive15Metrics.resolve(root.size);
    horizontal-alignment: start;
    vertical-alignment: top;
    overflow: clip;
    wrap: no-wrap;
}
