export enum Terminus8x14Size {
    px8,
    px14,
    px16,
    px24,
    px28,
    px32,
}

export global Terminus8x14Metrics {
    pure public function resolve(size: Terminus8x14Size) -> length {
        return size == Terminus8x14Size.px8 ? 8px
            : size == Terminus8x14Size.px14 ? 14px
            : size == Terminus8x14Size.px16 ? 16px
            : size == Terminus8x14Size.px24 ? 24px
            : size == Terminus8x14Size.px28 ? 28px
            : 32px;
    }
}

// The registered family contains the official native 14px glyphs and the
// doubled 28px glyphs. Small route tokens deliberately scale the native face.
export component Terminus8x14 inherits Text {
    in property <Terminus8x14Size> size: Terminus8x14Size.px14;
    color: white;
    font-family: "Terminus 8x14";
    font-size: Terminus8x14Metrics.resolve(root.size);
    horizontal-alignment: start;
    vertical-alignment: top;
    overflow: clip;
    wrap: no-wrap;
}
