import { MisterBridge } from "../api.slint";

export component ComboBoxOverlay inherits Rectangle {
    property <int> first-visible: (MisterBridge.display-highlighted - 2).clamp(0, (MisterBridge.display-options.length - 5).max(0));
    background: #000000c8;
    Rectangle {
        width: 94%;
        height: 90%;
        background: #0e0c14;
        border-width: 4px;
        border-color: #06d6a0;
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text { text: "Display resolution"; color: #06d6a0; font-size: 16px; horizontal-alignment: center; }
            for option[index] in MisterBridge.display-options : Rectangle {
                visible: index >= root.first-visible && index < root.first-visible + 5;
                height: 34px;
                background: index == MisterBridge.display-highlighted ? #2a2236 : transparent;
                border-width: index == MisterBridge.display-highlighted ? 2px : 0px;
                border-color: #06d6a0;
                Text {
                    text: (index == MisterBridge.display-selected ? "✓ " : "  ") + option;
                    color: index == MisterBridge.display-highlighted ? #06d6a0 : #e8e0f0;
                    font-size: 8px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
