import { Nocive15 } from "nocive_15.slint";
import { Xerxes10 } from "xerxes_10.slint";
import {
    ConfirmationKind,
    DialogChoice,
    DisplayTransactionState,
    OverlayView,
    ScreenOrientation,
    SettingsPopup,
    SettingsView,
} from "../api.slint";

component PickerOption inherits Rectangle {
    in property <string> label;
    in property <bool> highlighted;
    in property <bool> selected;

    height: 28px;
    background: root.highlighted
        ? @linear-gradient(90deg, #221843 0%, #120d24 70%, transparent 100%)
        : transparent;

    if root.highlighted : Rectangle { width: 3px; background: #9c86e7; }
    Xerxes10 {
        x: 16px;
        y: 6px;
        text: root.label.to-uppercase();
        color: root.highlighted ? #eee8d5 : #8f9796;
    }
    if root.selected : Rectangle {
        x: root.width - 20px;
        y: 11px;
        width: 6px;
        height: 6px;
        background: #9c86e7;
    }
}

component PickerButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;

    height: 26px;
    border-width: 1px;
    border-color: root.focused ? #9c86e7 : #3a3350;
    background: root.focused ? #1d1535 : transparent;
    Xerxes10 {
        y: 6px;
        width: parent.width;
        text: root.label.to-uppercase();
        horizontal-alignment: center;
        color: root.focused ? #eee8d5 : #8f9796;
    }
}

export component ComboBoxOverlay inherits Rectangle {
    property <bool> display-picker: SettingsView.popup == SettingsPopup.display-resolution;
    property <bool> orientation-picker: SettingsView.popup == SettingsPopup.screen-orientation;
    property <bool> display-confirmation: OverlayView.confirmation-kind == ConfirmationKind.display-resolution;
    property <bool> orientation-confirmation: OverlayView.confirmation-kind == ConfirmationKind.screen-orientation;
    property <bool> confirmation: root.display-confirmation || root.orientation-confirmation;
    property <bool> orientation: root.orientation-picker || root.orientation-confirmation;
    property <string> selected-id: root.orientation
        ? SettingsView.selected-orientation == ScreenOrientation.normal ? "normal"
        : SettingsView.selected-orientation == ScreenOrientation.monitor-clockwise ? "monitor-clockwise"
        : "monitor-counterclockwise"
        : SettingsView.selected-display.id;
    property <string> highlighted-id: root.orientation
        ? SettingsView.highlighted-orientation == ScreenOrientation.normal ? "normal"
        : SettingsView.highlighted-orientation == ScreenOrientation.monitor-clockwise ? "monitor-clockwise"
        : "monitor-counterclockwise"
        : SettingsView.highlighted-display.id;
    property <string> candidate-label: root.orientation
        ? SettingsView.active-orientation == ScreenOrientation.normal ? "NORMAL"
        : SettingsView.active-orientation == ScreenOrientation.monitor-clockwise ? "MONITOR RIGHT"
        : "MONITOR LEFT"
        : SettingsView.active-display.label.to-uppercase();
    property <bool> busy: root.orientation
        ? SettingsView.orientation-transaction == DisplayTransactionState.persisting
        : SettingsView.display-transaction == DisplayTransactionState.persisting;
    property <bool> failed: root.orientation
        ? SettingsView.orientation-transaction == DisplayTransactionState.failed
        : SettingsView.display-transaction == DisplayTransactionState.failed;

    accessible-role: region;
    accessible-label: root.confirmation ? "Display mode confirmation"
        : root.orientation ? "Screen orientation choices" : "Display resolution choices";
    accessible-description: root.confirmation ? root.candidate-label : root.highlighted-id;
    accessible-enabled: true;
    background: transparent;

    Rectangle {
        x: root.width - 326px;
        y: root.orientation ? 198px : 160px;
        width: 300px;
        height: root.confirmation ? 108px
            : root.orientation ? 86px
            : 22px + 6 * 28px + 22px + 4 * 28px + 2px;
        background: #0b0913;
        border-width: 1px;
        border-color: #4a3d73;

        Rectangle { height: 2px; background: #9c86e7; }

        if !root.confirmation && !root.orientation : Rectangle {
            Xerxes10 { x: 16px; y: 7px; text: "HDMI"; color: #5d6564; }
            for option[index] in SettingsView.display-options : PickerOption {
                x: 0px;
                y: index < 6 ? 22px + index * 28px : 44px + index * 28px;
                width: parent.width;
                label: option.label;
                highlighted: option.id == root.highlighted-id;
                selected: option.id == root.selected-id;
            }
            Xerxes10 { x: 16px; y: 22px + 6 * 28px + 7px; text: "CRT"; color: #5d6564; }
        }

        if !root.confirmation && root.orientation : Rectangle {
            for option[index] in SettingsView.orientation-options : PickerOption {
                x: 0px;
                y: 2px + index * 28px;
                width: parent.width;
                label: option.label;
                highlighted: option.id == root.highlighted-id;
                selected: option.id == root.selected-id;
            }
        }

        if root.confirmation : Rectangle {
            Nocive15 {
                x: 16px;
                y: 12px;
                text: root.busy || root.failed ? OverlayView.confirmation-title.to-uppercase()
                    : root.orientation ? "KEEP THIS ORIENTATION?" : "KEEP THIS DISPLAY MODE?";
                color: #eee8d5;
            }
            Xerxes10 {
                x: 16px;
                y: 38px;
                width: parent.width - 32px;
                text: root.busy || root.failed ? OverlayView.confirmation-message.to-uppercase()
                    : root.candidate-label;
                color: root.failed ? #e86c75 : #9c86e7;
                overflow: elide;
            }
            PickerButton {
                x: 12px;
                y: 68px;
                width: 143px;
                label: OverlayView.confirm-label == "" ? "KEEP" : OverlayView.confirm-label;
                focused: OverlayView.selected-choice == DialogChoice.confirm;
            }
            PickerButton {
                x: 163px;
                y: 68px;
                width: 125px;
                label: OverlayView.cancel-label;
                focused: OverlayView.selected-choice == DialogChoice.cancel;
            }
        }
    }
}
