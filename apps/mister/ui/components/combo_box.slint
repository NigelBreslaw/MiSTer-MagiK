import { Spleen6x12, Spleen6x12Size } from "spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "nocive_15.slint";

import { FeedbackView, ScreenOrientation, SettingsPopup, SettingsView } from "../api.slint";
import { MisterUi } from "../mister_window.slint";

export component ComboBoxOverlay inherits Rectangle {
    property <bool> orientation: SettingsView.popup == SettingsPopup.screen-orientation;
    property <int> option-count: orientation
        ? SettingsView.orientation-options.length : SettingsView.display-options.length;
    property <string> selected-id: orientation
        ? SettingsView.selected-orientation == ScreenOrientation.normal ? "normal"
        : SettingsView.selected-orientation == ScreenOrientation.monitor-clockwise ? "monitor-clockwise"
        : "monitor-counterclockwise"
        : SettingsView.selected-display.id;
    property <string> highlighted-id: orientation
        ? SettingsView.highlighted-orientation == ScreenOrientation.normal ? "normal"
        : SettingsView.highlighted-orientation == ScreenOrientation.monitor-clockwise ? "monitor-clockwise"
        : "monitor-counterclockwise"
        : SettingsView.highlighted-display.id;
    accessible-role: region;
    accessible-label: root.orientation ? "Screen orientation choices" : "Display resolution choices";
    accessible-description: root.highlighted-id;
    accessible-enabled: true;
    background: #000000c8;
    Rectangle {
        width: 94%;
        height: MisterUi.portrait-layout
            ? Math.min((MisterUi.window-height - 32) * 1px, 68px + root.option-count * 38px)
            : parent.height * 90 / 100;
        background: #0e0c14;
        border-width: 4px;
        border-color: #06d6a0;
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Nocive15 { text: root.orientation ? "Screen orientation" : "Display resolution"; color: #06d6a0; size: Nocive15Size.px15; horizontal-alignment: center; }
            for option[index] in root.orientation ? SettingsView.orientation-options : SettingsView.display-options : Rectangle {
                property <bool> acknowledged: FeedbackView.acknowledged(
                    "", "option:" + index, FeedbackView.revision);
                height: 34px;
                background: option.id == root.highlighted-id ? #2a2236 : transparent;
                border-width: option.id == root.highlighted-id ? 2px : acknowledged ? 1px : 0px;
                border-color: acknowledged ? #4e8f80 : #06d6a0;
                accessible-role: list-item;
                accessible-label: option.label;
                accessible-description: option.id == root.selected-id ? "Selected" : "";
                accessible-item-selected: option.id == root.highlighted-id;
                accessible-enabled: true;
                Spleen6x12 {
                    text: (option.id == root.selected-id ? "✓ " : "  ") + option.label;
                    color: option.id == root.highlighted-id ? #06d6a0 : #e8e0f0;
                    size: Spleen6x12Size.px8;
                    vertical-alignment: center;
                }
            }
        }
    }
}
