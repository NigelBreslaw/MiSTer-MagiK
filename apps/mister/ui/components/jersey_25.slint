export enum Jersey25Size {
    px25,
    // Hub sizes follow the prototype's CSS font size, rather than cap height.
    hub48,
    hub52,
    hub64,
    px56,
}

export global Jersey25Metrics {
    // The 41px Slint resource size produces exact 25px physical capitals.
    pure public function resolve(size: Jersey25Size) -> length {
        return size == Jersey25Size.hub48 ? 48px : size == Jersey25Size.hub52 ? 52px : size == Jersey25Size.hub64 ? 64px : size == Jersey25Size.px56 ? 92px : 41px;
    }
}

export component Jersey25 inherits Text {
    in property <Jersey25Size> size: Jersey25Size.px25;
    color: white;
    font-family: "Jersey 25";
    font-size: Jersey25Metrics.resolve(root.size);
    horizontal-alignment: start;
    vertical-alignment: top;
    overflow: clip;
    wrap: no-wrap;
}
