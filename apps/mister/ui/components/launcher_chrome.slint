import { Spleen6x12, Spleen6x12Size } from "spleen_6x12.slint";
import { Spleen5x8, Spleen5x8Size } from "spleen_5x8.slint";
import { Xerxes10, Xerxes10Size } from "xerxes_10.slint";
import { Nocive15, Nocive15Size } from "nocive_15.slint";

import { AccessibleRole, CatalogView, NavigationView } from "../api.slint";
import { MenuItemStatus } from "../launcher_menu.slint";

component ScanningSubtitle inherits VerticalLayout {
    in property <string> detail;

    alignment: center;
    spacing: 2px;
    accessible-role: AccessibleRole.region;
    accessible-label: "Catalog scanning";
    accessible-description: root.detail;

    HorizontalLayout {
        alignment: center;

        Spleen6x12 {
            text: "Scanning";
            color: #8ca4b5;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }

        Spleen6x12 {
            text: ".";
            color: root.detail == "" && CatalogView.progress-dot-visible ? #8ca4b5 : transparent;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }
    }

    if detail != "" : HorizontalLayout {
        alignment: center;

        Spleen6x12 {
            text: root.detail;
            color: #8ca4b5;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }

        Spleen6x12 {
            text: ".";
            color: CatalogView.progress-dot-visible ? #8ca4b5 : transparent;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }
    }
}

component LauncherTileText inherits Nocive15 {
    in property <bool> focused;
    in property <color> selected-color;
    in property <color> unselected-color;

    states [
        selected when root.focused: {
            color: root.selected-color;
        }

        unselected when !root.focused: {
            color: root.unselected-color;
        }
    ]
}

component LauncherTileDetail inherits Xerxes10 {
    in property <bool> focused;
    in property <color> selected-color;
    in property <color> unselected-color;

    states [
        selected when root.focused: {
            color: root.selected-color;
        }

        unselected when !root.focused: {
            color: root.unselected-color;
        }
    ]
}

component LauncherTileFocusOutline inherits Rectangle {
    in property <bool> active;

    background: transparent;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 3px;
        background: root.active ? #06d6a0 : transparent;
    }

    Rectangle {
        x: 0px;
        y: parent.height - 3px;
        width: 100%;
        height: 3px;
        background: root.active ? #06d6a0 : transparent;
    }

    Rectangle {
        x: 0px;
        y: 3px;
        width: 3px;
        height: parent.height - 6px;
        background: root.active ? #06d6a0 : transparent;
    }

    Rectangle {
        x: parent.width - 3px;
        y: 3px;
        width: 3px;
        height: parent.height - 6px;
        background: root.active ? #06d6a0 : transparent;
    }
}

export component LauncherTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> flat-focus-style: false;
    in property <MenuItemStatus> status: MenuItemStatus.ready;

    accessible-role: AccessibleRole.list-item;
    accessible-label: root.label;
    accessible-description: root.subtitle;
    accessible-item-selected: root.focused;

    border-width: 2px;
    border-color: acknowledged ? #4e8f80
        : status == MenuItemStatus.failed
        ? #a9445b
        : status == MenuItemStatus.update-failed ? #c58b3a
        : status == MenuItemStatus.partial ? #c58b3a
        : status == MenuItemStatus.scanning
            ? #7b91ad
            : #5a4973;
    background: status == MenuItemStatus.failed
        ? #291820
        : status == MenuItemStatus.update-failed ? #292318
        : status == MenuItemStatus.partial ? #292318
        : status == MenuItemStatus.scanning ? #172131 : #181829;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        LauncherTileText {
            text: root.label;
            focused: root.focused;
            selected-color: #06d6a0;
            unselected-color: root.status == MenuItemStatus.failed
                ? #ef8da2
                : root.status == MenuItemStatus.update-failed ? #f0c36e
                : root.status == MenuItemStatus.partial ? #f0c36e
                : root.status == MenuItemStatus.scanning ? #d7eef8 : #9080a8;
            size: Nocive15Size.px15;
            width: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        if status == MenuItemStatus.scanning : ScanningSubtitle {
            detail: subtitle;
        }

        if subtitle != "" && status != MenuItemStatus.scanning : LauncherTileDetail {
            text: root.subtitle;
            focused: root.focused;
            selected-color: #d8d4dd;
            unselected-color: root.status == MenuItemStatus.failed
                ? #ef8da2
                : root.status == MenuItemStatus.update-failed ? #f0c36e
                : root.status == MenuItemStatus.partial ? #f0c36e : #9080a800;
            size: Xerxes10Size.px10;
            horizontal-alignment: center;
        }
    }

    LauncherTileFocusOutline {
        active: root.focused;
    }
}

component CogIcon inherits Rectangle {
    in property <bool> focused;

    background: transparent;
    opacity: focused ? 1.0 : 0.5;

    if NavigationView.settings-artwork-available : Image {
        width: root.width;
        height: root.height;
        source: NavigationView.settings-artwork;
        image-fit: contain;
    }

    if !NavigationView.settings-artwork-available : Spleen5x8 {
        width: root.width;
        height: root.height;
        text: "SET";
        size: Spleen5x8Size.px8;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SettingsButton inherits Rectangle {
    in property <bool> focused;
    in property <bool> acknowledged;

    accessible-role: AccessibleRole.button;
    accessible-label: "Settings";
    accessible-item-selected: root.focused;

    width: 56px;
    height: 56px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? white : acknowledged ? #4e8f80 : #5c4a72;

    CogIcon {
        width: 24px;
        height: 24px;
        focused: parent.focused;
    }
}

export component OsdSideLabel inherits Rectangle {

    width: 56px;
    height: 100%;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    VerticalLayout {
        padding-top: 26px;
        padding-bottom: 26px;
        spacing: 10px;
        alignment: center;

        Nocive15 { text: "M"; color: #d7eef8; size: Nocive15Size.px15; horizontal-alignment: center; }
        Nocive15 { text: "I"; color: #d7eef8; size: Nocive15Size.px15; horizontal-alignment: center; }
        Nocive15 { text: "S"; color: #d7eef8; size: Nocive15Size.px15; horizontal-alignment: center; }
        Nocive15 { text: "T"; color: #d7eef8; size: Nocive15Size.px15; horizontal-alignment: center; }
        Nocive15 { text: "E"; color: #d7eef8; size: Nocive15Size.px15; horizontal-alignment: center; }
        Nocive15 { text: "R"; color: #d7eef8; size: Nocive15Size.px15; horizontal-alignment: center; }
    }
}
