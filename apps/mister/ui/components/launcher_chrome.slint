import { PixelText8, PixelTextSize } from "pixel_text_8.slint";

import { MisterBridge } from "../api.slint";
import { MenuItemStatus } from "../launcher_menu.slint";

component ScanningSubtitle inherits VerticalLayout {
    in property <string> detail;
    property <bool> dot-visible: Math.mod(floor(animation-tick() / 1ms / 500), 2) == 0;

    alignment: center;
    spacing: 2px;

    HorizontalLayout {
        alignment: center;

        PixelText8 {
            text: "Scanning";
            color: #8ca4b5;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }

        PixelText8 {
            text: ".";
            color: root.detail == "" && root.dot-visible ? #8ca4b5 : transparent;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }
    }

    if detail != "" : HorizontalLayout {
        alignment: center;

        PixelText8 {
            text: root.detail;
            color: #8ca4b5;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }

        PixelText8 {
            text: ".";
            color: root.dot-visible ? #8ca4b5 : transparent;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }
    }
}

component LauncherTileText inherits PixelText8 {
    in property <bool> focused;
    in property <color> selected-color;
    in property <color> unselected-color;

    states [
        selected when root.focused: {
            color: root.selected-color;
        }

        unselected when !root.focused: {
            color: root.unselected-color;
        }
    ]
}

export component LauncherTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> flat-focus-style: false;
    in property <MenuItemStatus> status: MenuItemStatus.ready;

    border-width: focused ? 3px : 2px;
    border-color: focused ? #06d6a0
        : acknowledged ? #4e8f80
        : status == MenuItemStatus.failed
        ? #a9445b
        : status == MenuItemStatus.update-failed ? #c58b3a
        : status == MenuItemStatus.partial ? #c58b3a
        : status == MenuItemStatus.scanning
            ? #7b91ad
            : #5a4973;
    background: status == MenuItemStatus.failed
        ? #291820
        : status == MenuItemStatus.update-failed ? #292318
        : status == MenuItemStatus.partial ? #292318
        : status == MenuItemStatus.scanning ? #172131 : #181829;

    VerticalLayout {
        padding: 16px;
        spacing: 6px;
        alignment: center;

        LauncherTileText {
            text: root.label;
            focused: root.focused;
            selected-color: #06d6a0;
            unselected-color: root.status == MenuItemStatus.failed
                ? #ef8da2
                : root.status == MenuItemStatus.update-failed ? #f0c36e
                : root.status == MenuItemStatus.partial ? #f0c36e
                : root.status == MenuItemStatus.scanning ? #d7eef8 : #9080a8;
            size: PixelTextSize.px16;
            width: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        if status == MenuItemStatus.scanning : ScanningSubtitle {
            detail: subtitle;
        }

        if subtitle != "" && status != MenuItemStatus.scanning : LauncherTileText {
            text: root.subtitle;
            focused: root.focused;
            selected-color: #d8d4dd;
            unselected-color: root.status == MenuItemStatus.failed
                ? #ef8da2
                : root.status == MenuItemStatus.update-failed ? #f0c36e
                : root.status == MenuItemStatus.partial ? #f0c36e : #9080a800;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }
    }
}

component CogIcon inherits Image {
    in property <bool> focused;

    source: @image-url("../icons/settings.svg");
    colorize: white;
    opacity: focused ? 1.0 : 0.5;
}

export component SettingsButton inherits Rectangle {
    in property <bool> focused;
    in property <bool> acknowledged;

    width: 56px;
    height: 56px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? white : acknowledged ? #4e8f80 : #5c4a72;

    CogIcon {
        width: 24px;
        height: 24px;
        focused: parent.focused;
    }
}

export component OsdSideLabel inherits Rectangle {

    width: 56px;
    height: 100%;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;

    VerticalLayout {
        padding-top: 26px;
        padding-bottom: 26px;
        spacing: 10px;
        alignment: center;

        PixelText8 { text: "M"; color: #d7eef8; size: PixelTextSize.px16; horizontal-alignment: center; }
        PixelText8 { text: "I"; color: #d7eef8; size: PixelTextSize.px16; horizontal-alignment: center; }
        PixelText8 { text: "S"; color: #d7eef8; size: PixelTextSize.px16; horizontal-alignment: center; }
        PixelText8 { text: "T"; color: #d7eef8; size: PixelTextSize.px16; horizontal-alignment: center; }
        PixelText8 { text: "E"; color: #d7eef8; size: PixelTextSize.px16; horizontal-alignment: center; }
        PixelText8 { text: "R"; color: #d7eef8; size: PixelTextSize.px16; horizontal-alignment: center; }
    }
}
