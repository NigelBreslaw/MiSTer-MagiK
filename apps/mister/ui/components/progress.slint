import { Xerxes10 } from "xerxes_10.slint";
import { PageTheme } from "page_chrome.slint";

import { MediaPackRow, MediaPackState } from "../api.slint";

// Static 2px track. Callers hide it instead of animating unknown progress, so
// long scans and downloads never force continuous redraws.
export component ProgressTrack inherits Rectangle {
    in property <int> percent;
    in property <color> fill: PageTheme.settings-accent;
    property <int> clamped-percent: Math.max(0, Math.min(100, root.percent));

    height: 2px;
    background: PageTheme.rule;
    clip: true;

    Rectangle {
        x: 0px;
        width: parent.width * root.clamped-percent / 100;
        height: parent.height;
        background: root.fill;
    }
}

// One screenshot pack: Xerxes caps share a baseline, the track sits beneath.
export component MediaPackProgressRow inherits Rectangle {
    in property <MediaPackRow> pack;
    property <bool> active: pack.state == MediaPackState.downloading;
    property <bool> failed: pack.state == MediaPackState.failed;
    property <bool> complete: pack.state == MediaPackState.complete;

    height: 26px;
    background: transparent;
    accessible-role: progress-indicator;
    accessible-label: root.pack.system;
    accessible-description: root.pack.phase-label;
    accessible-value: root.active ? root.pack.percent + "%" : root.pack.phase-label;

    status := Xerxes10 {
        x: parent.width - self.preferred-width;
        y: 0px;
        text: root.active ? root.pack.percent + "%" : root.pack.phase-label.to-uppercase();
        color: root.failed ? PageTheme.danger
            : root.active ? PageTheme.settings-accent
            : root.complete ? PageTheme.cream : PageTheme.muted;
    }

    if root.active && root.pack.bytes-label != "" : Xerxes10 {
        x: status.x - 14px - self.preferred-width;
        y: 0px;
        text: root.pack.bytes-label.to-uppercase();
        color: PageTheme.muted;
    }

    Xerxes10 {
        x: 0px;
        y: 0px;
        width: parent.width - status.preferred-width - 160px;
        text: root.pack.system.to-uppercase();
        color: root.active || root.complete ? PageTheme.cream : PageTheme.muted;
        overflow: elide;
    }

    ProgressTrack {
        y: 20px;
        width: parent.width;
        percent: root.complete ? 100 : root.active ? root.pack.percent : 0;
        fill: root.failed ? PageTheme.danger
            : root.complete ? PageTheme.settings-accent-deep : PageTheme.settings-accent;
    }
}
