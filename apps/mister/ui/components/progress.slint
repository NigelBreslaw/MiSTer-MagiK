import { PixelText8, PixelTextSize } from "pixel_text_8.slint";

import { ScreenshotPackProgress } from "../api.slint";

export component ScreenshotPackProgressRow inherits Rectangle {
    in property <ScreenshotPackProgress> pack;
    property <int> clamped-percent: Math.max(0, Math.min(100, pack.percent));
    property <bool> determinate: pack.percent >= 0;

    height: 24px;
    background: transparent;

    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            spacing: 6px;

            PixelText8 {
                width: 160px;
                text: root.pack.system;
                color: #d7eef8;
                size: PixelTextSize.body12;
            }

            PixelText8 {
                width: 86px;
                text: root.pack.phase;
                color: #06d6a0;
                size: PixelTextSize.body12;
            }

            PixelText8 {
                horizontal-stretch: 1;
                text: root.pack.pack-position;
                color: #9080a8;
                size: PixelTextSize.body12;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            width: parent.width;
            height: 3px;
            background: #0e0c14;
            border-width: 1px;
            border-color: #5c4a72;
            clip: true;

            if root.determinate : Rectangle {
                x: 0;
                width: parent.width * root.clamped-percent / 100;
                height: parent.height;
                background: #06d6a0;
            }

            if !root.determinate : Rectangle {
                width: 72px;
                height: parent.height;
                x: (parent.width - self.width) * Math.mod(animation-tick() / 1ms, 900) / 900;
                background: #06d6a0;
            }
        }
    }
}
