// Spleen 6x12 with each row doubled (6x24 cells), registered at runtime for
// native 240p/288p portrait CRT text that matches the card launcher.
export enum Spleen6x12TallSize {
    px24,
}

export component Spleen6x12Tall inherits Text {
    in property <Spleen6x12TallSize> size: Spleen6x12TallSize.px24;
    color: white;
    font-family: "Spleen 6x12 Tall";
    font-size: 24px;
    horizontal-alignment: start;
    vertical-alignment: top;
    overflow: clip;
}
