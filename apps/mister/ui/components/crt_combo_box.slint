import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";
import { CrtTheme, CrtHeader, CrtFooter } from "crt_ui.slint";

component CrtResolutionRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;

    background: root.focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: root.focused ? CrtTheme.accent : CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        Text {
            width: MisterUi.body-font;
            text: root.focused ? ">" : "";
            font-family: MisterUi.crt-font-family;
            color: CrtTheme.accent-text;
            font-size: MisterUi.body-font;
        }
        Text {
            text: root.label;
            font-family: MisterUi.crt-font-family;
            color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
            font-size: MisterUi.body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.detail;
            font-family: MisterUi.crt-font-family;
            color: root.focused ? CrtTheme.accent-text : CrtTheme.muted;
            font-size: MisterUi.body-font;
            horizontal-alignment: right;
        }
    }
}

export component CrtComboBoxOverlay inherits Rectangle {
    property <int> visible-count: 7;
    property <int> first-visible: (MisterBridge.display-highlighted - 3).clamp(
        0,
        (MisterBridge.display-options.length - root.visible-count).max(0),
    );
    property <bool> more-above: root.first-visible > 0;
    property <bool> more-below: root.first-visible + root.visible-count
        < MisterBridge.display-options.length;

    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: "Resolution"; subtitle: ""; status: ""; }

        Text {
            height: MisterUi.body-font;
            text: root.more-above ? "▲" : "";
            font-family: MisterUi.crt-font-family;
            color: CrtTheme.text;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            vertical-stretch: 1;
            background: CrtTheme.background;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                for option[index] in MisterBridge.display-options : CrtResolutionRow {
                    visible: index >= root.first-visible
                        && index < root.first-visible + root.visible-count;
                    vertical-stretch: 1;
                    label: option;
                    detail: index == MisterBridge.display-selected ? "Selected" : "";
                    focused: index == MisterBridge.display-highlighted;
                }
            }
        }

        Text {
            height: MisterUi.body-font;
            text: root.more-below ? "▼" : "";
            font-family: MisterUi.crt-font-family;
            color: CrtTheme.text;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        CrtFooter { left-hint: "UP/DOWN Choose   A Apply"; right-hint: "B Cancel"; }
    }
}
