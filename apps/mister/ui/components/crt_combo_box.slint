import { Spleen6x12, Spleen6x12Size } from "spleen_6x12.slint";

import { MisterUi } from "../mister_window.slint";
import { FeedbackView, ScreenOrientation, SettingsPopup, SettingsView } from "../api.slint";
import { CrtTheme, CrtHeader, CrtFooter } from "crt_ui.slint";

component CrtResolutionRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;

    background: root.focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: root.focused ? CrtTheme.accent
        : root.acknowledged ? #4e8f80 : CrtTheme.border;

    if !MisterUi.portrait-layout : HorizontalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        Spleen6x12 {
            width: MisterUi.body-font;
            text: root.focused ? ">" : "";
            color: CrtTheme.accent-text;
            size: MisterUi.crt-body-font;
        }
        Spleen6x12 {
            text: root.label;
            color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
            size: MisterUi.crt-body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Spleen6x12 {
            text: root.detail;
            color: root.focused ? CrtTheme.accent-text : CrtTheme.muted;
            size: MisterUi.crt-body-font;
            horizontal-alignment: right;
        }
    }

    if MisterUi.portrait-layout : VerticalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        padding-top: MisterUi.grid-y;
        padding-bottom: MisterUi.grid-y;
        spacing: MisterUi.grid-y;
        alignment: center;

        Spleen6x12 {
            text: root.label;
            color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.detail != "" : Spleen6x12 {
            text: root.detail;
            color: root.focused ? CrtTheme.accent-text : CrtTheme.muted;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }
    }
}

export component CrtComboBoxOverlay inherits Rectangle {
    property <bool> orientation: SettingsView.popup == SettingsPopup.screen-orientation;
    property <string> selected-id: orientation
        ? SettingsView.selected-orientation == ScreenOrientation.normal ? "normal"
        : SettingsView.selected-orientation == ScreenOrientation.monitor-clockwise ? "monitor-clockwise"
        : "monitor-counterclockwise"
        : SettingsView.selected-display.id;
    property <string> highlighted-id: orientation
        ? SettingsView.highlighted-orientation == ScreenOrientation.normal ? "normal"
        : SettingsView.highlighted-orientation == ScreenOrientation.monitor-clockwise ? "monitor-clockwise"
        : "monitor-counterclockwise"
        : SettingsView.highlighted-display.id;
    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: root.orientation ? "Orientation" : "Resolution"; subtitle: ""; status: ""; }

        Rectangle {
            vertical-stretch: 1;
            background: CrtTheme.background;
            clip: true;
            VerticalLayout {
                spacing: 0px;
                for option[index] in root.orientation ? SettingsView.orientation-options : SettingsView.display-options : CrtResolutionRow {
                    vertical-stretch: 1;
                    label: option.label;
                    detail: option.id == root.selected-id ? "Selected" : "";
                    focused: option.id == root.highlighted-id;
                    acknowledged: FeedbackView.acknowledged(
                        "", "option:" + index, FeedbackView.revision);
                }
            }
        }

        CrtFooter {
            left-hint: MisterUi.portrait-layout ? "UP/DN Choose A Apply" : "UP/DOWN Choose   A Apply";
            right-hint: "B Cancel";
        }
    }
}
