import { MisterUi } from "../mister_window.slint";

export global CrtTheme {
    in-out property <color> background: #020817;
    in-out property <color> panel: #050d23;
    in-out property <color> panel-alt: #06122b;
    in-out property <color> border: #5e59aa;
    in-out property <color> text: #aaa5ff;
    in-out property <color> muted: #8b94f8;
    in-out property <color> accent: #40e5e7;
    in-out property <color> accent-text: #03132d;
    in-out property <color> warning: #ffd166;
    in-out property <color> danger: #ff5d73;
}

export component CrtHeader inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <string> subtitle;

    height: MisterUi.header-height;
    background: CrtTheme.background;
    border-width: MisterUi.border;
    border-color: CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid;
        padding-right: MisterUi.grid;
        spacing: MisterUi.grid;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            Text {
                text: root.title;
                font-family: "W95FA";
                color: CrtTheme.text;
                font-size: MisterUi.heading-font;
                overflow: elide;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-family: "W95FA";
                color: CrtTheme.warning;
                font-size: MisterUi.body-font;
                overflow: elide;
            }
        }

        Text {
            text: root.status;
            font-family: "W95FA";
            color: CrtTheme.text;
            font-size: MisterUi.body-font;
            horizontal-alignment: right;
        }
    }
}

export component CrtFooter inherits Rectangle {
    in property <string> left-hint;
    in property <string> right-hint;

    height: MisterUi.footer-height;
    background: CrtTheme.background;
    border-width: MisterUi.border;
    border-color: CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid;
        padding-right: MisterUi.grid;
        spacing: MisterUi.grid;
        cross-axis-alignment: center;

        Text {
            text: root.left-hint;
            font-family: "W95FA";
            color: CrtTheme.muted;
            font-size: MisterUi.body-font;
            horizontal-stretch: 1;
        }

        Text {
            text: root.right-hint;
            font-family: "W95FA";
            color: CrtTheme.muted;
            font-size: MisterUi.body-font;
            horizontal-alignment: right;
        }
    }
}

export component CrtMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> enabled: true;

    min-height: MisterUi.footer-height;
    background: root.focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: root.focused ? CrtTheme.accent : CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid;
        padding-right: MisterUi.grid;
        spacing: MisterUi.grid;
        cross-axis-alignment: center;

        Text {
            text: (root.focused ? "> " : "  ") + root.label;
            font-family: "W95FA";
            color: !root.enabled ? CrtTheme.muted
                : root.focused ? CrtTheme.accent-text : CrtTheme.text;
            font-size: MisterUi.body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Text {
            text: root.detail;
            font-family: "W95FA";
            color: !root.enabled ? CrtTheme.muted
                : root.focused ? CrtTheme.accent-text : CrtTheme.muted;
            font-size: MisterUi.body-font;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component CrtCard inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> show-marker: true;

    background: root.focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: root.focused ? CrtTheme.accent : CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid * 2;
        padding-right: MisterUi.grid * 2;
        spacing: MisterUi.grid;
        cross-axis-alignment: center;

        Text {
            width: MisterUi.card-title-font;
            text: root.focused && root.show-marker ? ">" : "";
            font-family: "W95FA";
            color: CrtTheme.accent-text;
            font-size: MisterUi.card-title-font;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 0px;
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                font-family: "W95FA";
                color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
                font-size: MisterUi.card-title-font;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.detail != "" : Text {
                text: root.detail;
                font-family: "W95FA";
                color: root.focused ? #17304a : CrtTheme.muted;
                font-size: MisterUi.card-detail-font;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

export component CrtNavHint inherits HorizontalLayout {
    in property <string> button;
    in property <string> label;

    spacing: MisterUi.grid;
    cross-axis-alignment: center;

    Rectangle {
        width: root.button == "HOME" ? MisterUi.body-font * 3 : MisterUi.body-font * 3 / 2;
        height: MisterUi.body-font * 3 / 2;
        background: CrtTheme.accent;

        Text {
            text: root.button;
            font-family: "W95FA";
            color: CrtTheme.accent-text;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.label;
        font-family: "W95FA";
        color: CrtTheme.text;
        font-size: MisterUi.body-font;
        vertical-alignment: center;
    }
}
