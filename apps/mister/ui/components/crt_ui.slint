import { Spleen6x12, Spleen6x12Size } from "spleen_6x12.slint";
import { Spleen5x8, Spleen5x8Size } from "spleen_5x8.slint";
import { Jersey15 } from "jersey_15.slint";
import { Jersey25 } from "jersey_25.slint";

import { MisterUi } from "../mister_window.slint";
import { MenuItemStatus } from "../launcher_menu.slint";

export global CrtTheme {
    in-out property <color> background: #020817;
    in-out property <color> panel: #050d23;
    in-out property <color> panel-alt: #06122b;
    in-out property <color> border: #5e59aa;
    in-out property <color> text: #aaa5ff;
    in-out property <color> muted: #8b94f8;
    in-out property <color> accent: #40e5e7;
    in-out property <color> accent-text: #03132d;
    in-out property <color> warning: #ffd166;
    in-out property <color> danger: #ff5d73;
}

export component CrtHeader inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <string> subtitle;

    height: MisterUi.header-height;
    background: CrtTheme.background;
    border-width: MisterUi.border;
    border-color: CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: MisterUi.grid-x;

                if MisterUi.crt-body-font == Spleen6x12Size.px16 : Jersey15 {
                    text: root.title;
                    color: CrtTheme.text;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if MisterUi.crt-body-font != Spleen6x12Size.px16
                    && MisterUi.heading-font >= 32px : Jersey25 {
                    text: root.title;
                    color: CrtTheme.text;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if MisterUi.crt-body-font != Spleen6x12Size.px16
                    && MisterUi.heading-font < 32px : Spleen6x12 {
                    text: root.title;
                    color: CrtTheme.text;
                    size: MisterUi.crt-heading-font;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                if root.status != "" : Spleen6x12 {
                    text: root.status;
                    color: CrtTheme.text;
                    size: MisterUi.crt-body-font;
                    horizontal-alignment: left;
                }
            }

            if root.subtitle != "" : Spleen6x12 {
                text: root.subtitle;
                color: CrtTheme.warning;
                size: MisterUi.crt-body-font;
                overflow: elide;
            }
        }
    }
}

export component CrtFooter inherits Rectangle {
    in property <string> left-hint;
    in property <string> right-hint;

    height: MisterUi.footer-height;
    clip: true;
    background: CrtTheme.background;
    border-width: MisterUi.border;
    border-color: CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        Spleen5x8 {
            text: root.left-hint;
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font == Spleen6x12Size.px24
                ? Spleen5x8Size.px16 : Spleen5x8Size.px8;
            horizontal-stretch: 1;
        }

        Spleen5x8 {
            text: root.right-hint;
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font == Spleen6x12Size.px24
                ? Spleen5x8Size.px16 : Spleen5x8Size.px8;
            horizontal-alignment: right;
        }
    }
}

export component CrtMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> enabled: true;

    min-height: MisterUi.footer-height;
    background: root.focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: root.focused ? CrtTheme.accent
        : root.acknowledged ? #4e8f80 : CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        Spleen6x12 {
            text: (root.focused ? "> " : "  ") + root.label;
            color: !root.enabled ? CrtTheme.muted
                : root.focused ? CrtTheme.accent-text : CrtTheme.text;
            size: MisterUi.crt-body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Spleen6x12 {
            text: root.detail;
            color: !root.enabled ? CrtTheme.muted
                : root.focused ? CrtTheme.accent-text : CrtTheme.muted;
            size: MisterUi.crt-body-font;
            horizontal-alignment: right;
            overflow: elide;
        }
    }
}

export component CrtCard inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> show-marker: true;
    in property <MenuItemStatus> status: MenuItemStatus.ready;

    background: root.focused ? CrtTheme.accent
        : root.status == MenuItemStatus.failed ? #250918
        : root.status == MenuItemStatus.update-failed ? #211807
        : root.status == MenuItemStatus.scanning ? #071b2f
        : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: root.focused ? CrtTheme.accent
        : root.acknowledged ? #4e8f80
        : root.status == MenuItemStatus.failed ? CrtTheme.danger
        : root.status == MenuItemStatus.update-failed ? CrtTheme.warning
        : root.status == MenuItemStatus.scanning ? CrtTheme.accent
        : CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        Spleen6x12 {
            width: MisterUi.portrait-layout ? MisterUi.body-font : MisterUi.card-title-font;
            text: root.focused && root.show-marker ? ">" : "";
            color: CrtTheme.accent-text;
            size: MisterUi.portrait-layout ? MisterUi.crt-body-font : MisterUi.crt-card-title-font;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 0px;
            alignment: center;
            horizontal-stretch: 1;

            if MisterUi.card-title-font >= 24px
                && MisterUi.crt-body-font == Spleen6x12Size.px16 : Jersey15 {
                text: root.label;
                color: root.focused ? CrtTheme.accent-text
                    : root.status == MenuItemStatus.failed ? CrtTheme.danger
                    : root.status == MenuItemStatus.update-failed ? CrtTheme.warning
                    : root.status == MenuItemStatus.scanning ? CrtTheme.accent
                    : CrtTheme.text;
                overflow: elide;
                vertical-alignment: center;
            }
            if MisterUi.card-title-font >= 24px
                && MisterUi.crt-body-font != Spleen6x12Size.px16 : Jersey25 {
                text: root.label;
                color: root.focused ? CrtTheme.accent-text
                    : root.status == MenuItemStatus.failed ? CrtTheme.danger
                    : root.status == MenuItemStatus.update-failed ? CrtTheme.warning
                    : root.status == MenuItemStatus.scanning ? CrtTheme.accent
                    : CrtTheme.text;
                overflow: elide;
                vertical-alignment: center;
            }
            if MisterUi.card-title-font < 24px : Spleen6x12 {
                text: root.label;
                color: root.focused ? CrtTheme.accent-text
                    : root.status == MenuItemStatus.failed ? CrtTheme.danger
                    : root.status == MenuItemStatus.update-failed ? CrtTheme.warning
                    : root.status == MenuItemStatus.scanning ? CrtTheme.accent
                    : CrtTheme.text;
                size: MisterUi.crt-card-title-font;
                overflow: elide;
                vertical-alignment: center;
            }

            if root.detail != "" : Spleen6x12 {
                text: root.detail;
                color: root.focused ? #17304a
                    : root.status == MenuItemStatus.failed ? CrtTheme.danger
                    : root.status == MenuItemStatus.update-failed ? CrtTheme.warning
                    : root.status == MenuItemStatus.scanning ? CrtTheme.accent
                    : CrtTheme.muted;
                size: MisterUi.crt-card-detail-font;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}

export component CrtNavHint inherits HorizontalLayout {
    in property <string> button;
    in property <string> label;

    spacing: MisterUi.grid-x;
    cross-axis-alignment: center;

    Rectangle {
        width: root.button == "HOME" ? MisterUi.body-font * 3 : MisterUi.body-font * 3 / 2;
        height: MisterUi.body-font * 3 / 2;
        background: CrtTheme.accent;

        Spleen5x8 {
            text: root.button;
            color: CrtTheme.accent-text;
            size: MisterUi.crt-body-font == Spleen6x12Size.px24
                ? Spleen5x8Size.px16 : Spleen5x8Size.px8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Spleen5x8 {
        text: root.label;
        color: CrtTheme.text;
        size: MisterUi.crt-body-font == Spleen6x12Size.px24
            ? Spleen5x8Size.px16 : Spleen5x8Size.px8;
        vertical-alignment: center;
    }
}
