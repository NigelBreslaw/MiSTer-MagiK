import { MisterUi } from "../mister_window.slint";
import { NavigationView } from "../api.slint";
import { CrtPageMetrics, CrtLauncherText } from "crt_page_chrome.slint";
import { Xerxes10 } from "xerxes_10.slint";

export global ConnectionStatusGeometry {
    out property <int> sx: MisterUi.crt-layout ? CrtPageMetrics.sx : 1;
    out property <int> sy: MisterUi.crt-layout ? CrtPageMetrics.sy : 1;
    out property <length> height: (MisterUi.crt-layout ? 12 * sy : 15) * 1px;
    out property <length> globe-width: (MisterUi.crt-layout ? 12 * sx : 15) * 1px;
    out property <length> badge-width: (MisterUi.crt-layout ? 24 * sx : 32) * 1px;
    out property <length> gap: (MisterUi.crt-layout ? 6 * sx : 8) * 1px;
    out property <length> width: globe-width + (NavigationView.usb-connected ? badge-width + gap : 0px);
    out property <length> clock-left: MisterUi.crt-layout
        ? (MisterUi.window-width - CrtPageMetrics.margin-x - 30 * sx) * 1px
        : MisterUi.portrait-layout ? (MisterUi.window-width - Math.floor(MisterUi.window-width * 6 / 100) - 45) * 1px : 875px;
    out property <length> left: clock-left - gap - width;
    // HDMI capitals start four pixels below the clock's Text element.
    out property <length> top: MisterUi.crt-layout ? CrtPageMetrics.margin-y * 1px
        : MisterUi.portrait-layout ? Math.floor(MisterUi.window-height * 5 / 100) * 1px + 4px : 26px;
}

export component LauncherConnectionStatus inherits Rectangle {
    x: ConnectionStatusGeometry.left;
    y: ConnectionStatusGeometry.top;
    width: ConnectionStatusGeometry.width;
    height: ConnectionStatusGeometry.height;
    background: transparent;

    if NavigationView.usb-connected : Rectangle {
        x: 0px;
        y: 0px;
        width: ConnectionStatusGeometry.badge-width;
        height: parent.height;
        border-width: 1px;
        border-color: #eae8d1;
        background: transparent;
        accessible-role: image;
        accessible-label: "USB storage connected";
        if !MisterUi.crt-layout : Xerxes10 {
            width: 100%; height: 100%;
            text: "USB";
            color: #eae8d1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if MisterUi.crt-layout : CrtLauncherText {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            text: "USB";
        }
    }
    Rectangle {
        x: parent.width - self.width;
        y: 0px;
        width: ConnectionStatusGeometry.globe-width;
        height: parent.height;
        background: transparent;
        accessible-role: image;
        accessible-label: "Internet";
        accessible-description: NavigationView.internet-connected ? "Connected" : "Offline";
        property <color> ink: NavigationView.internet-connected ? #eae8d1 : #57615e;
        property <length> line: MisterUi.crt-layout ? 1px : 1.2px;
        Rectangle {
            width: 100%; height: 100%;
            border-radius: self.height / 2;
            border-width: parent.line;
            border-color: parent.ink;
            background: transparent;
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            width: parent.width * 0.4;
            height: parent.height;
            border-radius: self.width / 2;
            border-width: parent.line;
            border-color: parent.ink;
            background: transparent;
        }
        Rectangle {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: 100%; height: parent.line;
            background: parent.ink;
        }
    }
}
