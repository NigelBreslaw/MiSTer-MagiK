export enum PixelTextSize {
    body12,
    px8,
    px16,
    px24,
    px32,
}

export global PixelText8Metrics {
    pure public function resolve(size: PixelTextSize) -> length {
        // Xerxes 10 is compiled on its native grid: 16 Slint px produce 10px capitals.
        return size == PixelTextSize.body12 ? 16px
            : size == PixelTextSize.px8 ? 8px
            : size == PixelTextSize.px16 ? 16px
            : size == PixelTextSize.px24 ? 24px
            : 32px;
    }
}

export component PixelText8 inherits Text {
    in property <PixelTextSize> size: PixelTextSize.px8;
    color: white;
    font-family: root.size == PixelTextSize.body12 ? "Xerxes 10" : "Press Start 2P";
    font-size: PixelText8Metrics.resolve(root.size);
    horizontal-alignment: start;
    vertical-alignment: top;
    overflow: clip;
    wrap: no-wrap;
}
