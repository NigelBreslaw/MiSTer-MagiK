export enum Jersey15Size {
    px15,
}

export global Jersey15Metrics {
    // The 27px Slint resource size produces exact 15px physical capitals.
    pure public function resolve(size: Jersey15Size) -> length {
        return 27px;
    }
}

export component Jersey15 inherits Text {
    in property <Jersey15Size> size: Jersey15Size.px15;
    color: white;
    font-family: "Jersey 15";
    font-size: Jersey15Metrics.resolve(root.size);
    horizontal-alignment: start;
    vertical-alignment: top;
    overflow: clip;
    wrap: no-wrap;
}
