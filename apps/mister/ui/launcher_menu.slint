export enum MenuItemKind {
    group,
    collection,
}

export enum MenuItemStatus {
    ready,
    scanning,
    partial,
    update-failed,
    failed,
}

export struct MenuItem {
    id: string,
    label: string,
    subtitle: string,
    available: bool,
    node-kind: MenuItemKind,
    status: MenuItemStatus,
}
