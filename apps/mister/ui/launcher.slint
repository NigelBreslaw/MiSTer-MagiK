import { MisterWindow, MisterUi } from "mister_window.slint";
import { Start2P, Start2PSize } from "components/start2p.slint";
export { Start2PSize } from "components/start2p.slint";
import { Terminus8x14, Terminus8x14Size } from "components/terminus_8x14.slint";
export { Terminus8x14Size } from "components/terminus_8x14.slint";
import { MisterBridge, PreviewStatus, ScreenshotPackProgress } from "api.slint";
import { CrtLauncherUi } from "variants/crt_ui.slint";
import { HdmiLauncherUi } from "variants/hdmi_ui.slint";
import "fonts/PressStart2P-Regular.ttf";

export { MisterUi }
export { MisterBridge, PreviewStatus, ScreenshotPackProgress }
export { ArcadeGame } from "arcade_game.slint";
export { MenuItem, MenuItemKind, MenuItemPresentation } from "launcher_menu.slint";

export component Launcher inherits MisterWindow {
    default-font-family: "Press Start 2P";
    title: "MiSTer MagiK Launcher";
    background: black;

    if MisterUi.crt-layout : CrtLauncherUi { }
    if !MisterUi.crt-layout : HdmiLauncherUi { }

    if MisterBridge.input-fault-notice != "" : Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: 48px;
        background: #b00020;
        border-width: 2px;
        border-color: white;

        if !MisterUi.crt-layout : Start2P {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: MisterBridge.input-fault-notice;
            color: white;
            size: Start2PSize.px8;
            vertical-alignment: center;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if MisterUi.crt-layout : Terminus8x14 {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: MisterBridge.input-fault-notice;
            color: white;
            vertical-alignment: center;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
