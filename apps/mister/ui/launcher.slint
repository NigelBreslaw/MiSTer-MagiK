import { MisterWindow, MisterUi } from "mister_window.slint";
import { PixelText8, PixelTextSize } from "components/pixel_text_8.slint";
export { PixelTextSize } from "components/pixel_text_8.slint";
import { MisterBridge, PreviewStatus, ScreenshotPackProgress } from "api.slint";
import { CrtLauncherUi } from "variants/crt_ui.slint";
import { HdmiLauncherUi } from "variants/hdmi_ui.slint";
import "fonts/PressStart2P-Regular.ttf";
import "fonts/Jersey10-Regular.ttf";
import "fonts/Jersey25-Regular.ttf";

export { MisterUi }
export { MisterBridge, PreviewStatus, ScreenshotPackProgress }
export { ArcadeGame } from "arcade_game.slint";
export { MenuItem, MenuItemKind } from "launcher_menu.slint";

export component Launcher inherits MisterWindow {
    default-font-family: "Press Start 2P";
    title: "MiSTer MagiK Launcher";
    background: black;

    if MisterUi.crt-layout : CrtLauncherUi { }
    if !MisterUi.crt-layout : HdmiLauncherUi { }

    if MisterBridge.input-fault-notice != "" : Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: 48px;
        background: #b00020;
        border-width: 2px;
        border-color: white;

        PixelText8 {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: MisterBridge.input-fault-notice;
            color: white;
            size: PixelTextSize.px8;
            vertical-alignment: center;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
