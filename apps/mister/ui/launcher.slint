export { MenuItem, MenuItemKind, MenuItemPresentation } from "launcher_menu.slint";

export component Launcher inherits MisterWindow {
    default-font-family: "Press Start 2P";
    title: "MiSTer MagiK Launcher";
    background: black;

    if MisterUi.crt-layout : CrtLauncherUi { }
    if !MisterUi.crt-layout : HdmiLauncherUi { }

    if InputView.input-availability == InputAvailability.unavailable : Rectangle {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: 48px;
        background: #b00020;
        border-width: 2px;
        border-color: white;

        if !MisterUi.crt-layout : Start2P {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: InputView.fault-notice;
            color: white;
            size: Start2PSize.px8;
            vertical-alignment: center;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if MisterUi.crt-layout : Spleen6x12 {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text: InputView.fault-notice;
            color: white;
            size: MisterUi.crt-body-font;
            vertical-alignment: center;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
