import { Start2P, Start2PSize } from "../components/start2p.slint";
import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";

// Controller setup overlay — new pad detection and USB port change rebinding.
component ConfigRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    padding: 3px;

    Start2P {
        text: label;
        color: #9080a8;
        size: Start2PSize.px16;
        min-width: 130px;
        horizontal-alignment: left;
    }

    Start2P {
        text: value;
        color: #e8e0f0;
        size: Start2PSize.px16;
        horizontal-alignment: left;
        wrap: word-wrap;
    }
}

export component SetupOverlay inherits Rectangle {
    in property <int> phase;
    // 1=detected, 2=new-or-existing, 3=pick-existing, 4=configure, 5=name-kind
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> list-items;
    in property <int> list-selected;
    in property <[string]> config-labels;
    in property <[string]> config-values;
    in property <string> setup-name;
    in property <string> setup-kind-label;

    background: #1a1424e0;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: center;

        Start2P {
            text: title;
            color: #e8e0f0;
            size: MisterUi.portrait-layout ? Start2PSize.px16 : Start2PSize.px24;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        if phase != 4 && phase != 5 : Start2P {
            text: subtitle;
            color: #9080a8;
            size: Start2PSize.px16;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if phase == 2 : HorizontalLayout {
            spacing: 24px;
            alignment: center;

            Rectangle {
                property <bool> acknowledged: MisterBridge.selection-feedback-query(
                    "", "new", MisterBridge.selection-feedback-revision);
                width: 180px;
                height: 60px;
                border-radius: 8px;
                border-width: 2px;
                border-color: list-selected == 0 ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
                background: list-selected == 0 ? #2a2236 : #1e1828;

                Start2P {
                    text: "New controller";
                    color: list-selected == 0 ? #06d6a0 : #e8e0f0;
                    size: Start2PSize.px16;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                property <bool> acknowledged: MisterBridge.selection-feedback-query(
                    "", "existing", MisterBridge.selection-feedback-revision);
                width: 180px;
                height: 60px;
                border-radius: 8px;
                border-width: 2px;
                border-color: list-selected == 1 ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
                background: list-selected == 1 ? #2a2236 : #1e1828;

                Start2P {
                    text: "Existing controller";
                    color: list-selected == 1 ? #06d6a0 : #e8e0f0;
                    size: Start2PSize.px16;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if phase == 3 : VerticalLayout {
            spacing: 6px;
            alignment: center;

            for item[i] in list-items : Rectangle {
                property <bool> acknowledged: MisterBridge.selection-feedback-query(
                    "", "saved:" + i, MisterBridge.selection-feedback-revision);
                width: 450px;
                height: 36px;
                border-radius: 6px;
                border-width: list-selected == i ? 2px : 1px;
                border-color: list-selected == i ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
                background: list-selected == i ? #2a2236 : #1e1828;

                Start2P {
                    text: item;
                    color: list-selected == i ? #06d6a0 : #e8e0f0;
                    size: Start2PSize.px16;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if phase == 4 : VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            Start2P {
                text: subtitle;
                color: #06d6a0;
                size: Start2PSize.px16;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                width: MisterUi.portrait-layout ? MisterUi.window-width * 1px - 48px : 700px;
                vertical-stretch: 1;
                border-radius: 6px;
                border-width: 1px;
                border-color: #5c4a72;
                background: #1e1828;

                Flickable {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 1px;

                        for label[i] in config-labels : ConfigRow {
                            label: label;
                            value: config-values[i];
                        }
                    }
                }
            }
        }

        if phase == 5 : VerticalLayout {
            spacing: 12px;
            alignment: center;

            Start2P {
                text: subtitle;
                color: #9080a8;
                size: Start2PSize.px16;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Start2P {
                    text: "Name";
                    color: #9080a8;
                    size: Start2PSize.px8;
                    horizontal-alignment: left;
                }

                Rectangle {
                    width: 450px;
                    height: 36px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #5c4a72;
                    background: #1e1828;

                    Start2P {
                        text: setup-name;
                        color: #e8e0f0;
                        size: Start2PSize.px16;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Start2P {
                    text: "Type";
                    color: #9080a8;
                    size: Start2PSize.px8;
                    horizontal-alignment: left;
                }

                Rectangle {
                    width: 450px;
                    height: 36px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: #06d6a0;
                    background: #2a2236;

                    Start2P {
                        text: setup-kind-label;
                        color: #06d6a0;
                        size: Start2PSize.px16;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Start2P {
            text: phase == 1 ? "Press any button to continue"
                : phase == 2 ? "D-pad: choose  ·  A: confirm"
                : phase == 3 ? "D-pad: choose  ·  A: confirm"
                : phase == 4 ? "A: continue to naming"
                : phase == 5 ? "D-pad: change type  ·  A: save"
                : "";
            color: #706080;
            size: Start2PSize.px8;
            horizontal-alignment: center;
        }
    }
}
