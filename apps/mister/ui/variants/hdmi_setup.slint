import { Spleen6x12, Spleen6x12Size } from "../components/spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "../components/nocive_15.slint";
import { MisterUi } from "../mister_window.slint";
import { FeedbackView, SetupEntry, SetupField, SetupPhase, SetupView } from "../api.slint";

// Controller setup overlay — new pad detection and USB port change rebinding.
component ConfigRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    padding: 3px;

    Nocive15 {
        text: label;
        color: #9080a8;
        size: Nocive15Size.px15;
        min-width: 130px;
        horizontal-alignment: left;
    }

    Nocive15 {
        text: value;
        color: #e8e0f0;
        size: Nocive15Size.px15;
        horizontal-alignment: left;
        wrap: word-wrap;
    }
}

export component SetupOverlay inherits Rectangle {
    property <SetupPhase> phase: SetupView.phase;
    // 1=detected, 2=new-or-existing, 3=pick-existing, 4=configure, 5=name-kind
    property <string> title: SetupView.title;
    property <string> subtitle: SetupView.subtitle;
    property <[SetupEntry]> list-items: SetupView.entries;
    property <int> list-selected: SetupView.selected-entry-index;
    property <[SetupField]> fields: SetupView.fields;
    property <string> setup-name: SetupView.name;
    property <string> setup-kind-label: SetupView.kind-label;

    accessible-role: region;
    accessible-label: "Controller setup";
    accessible-description: root.subtitle;

    background: #1a1424e0;

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: center;

        if MisterUi.portrait-layout : Nocive15 {
            text: title;
            color: #e8e0f0;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        if !MisterUi.portrait-layout : Spleen6x12 {
            text: title;
            color: #e8e0f0;
            size: Spleen6x12Size.px24;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }

        if phase != SetupPhase.configure && phase != SetupPhase.name-kind : Nocive15 {
            text: subtitle;
            color: #9080a8;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if phase == SetupPhase.new-or-existing : HorizontalLayout {
            spacing: 24px;
            alignment: center;

            Rectangle {
                property <bool> acknowledged: FeedbackView.acknowledged(
                    "", "new", FeedbackView.revision);
                width: 180px;
                height: 60px;
                border-radius: 8px;
                border-width: 2px;
                border-color: list-selected == 0 ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
                background: list-selected == 0 ? #2a2236 : #1e1828;

                Nocive15 {
                    text: "New controller";
                    color: list-selected == 0 ? #06d6a0 : #e8e0f0;
                    size: Nocive15Size.px15;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                property <bool> acknowledged: FeedbackView.acknowledged(
                    "", "existing", FeedbackView.revision);
                width: 180px;
                height: 60px;
                border-radius: 8px;
                border-width: 2px;
                border-color: list-selected == 1 ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
                background: list-selected == 1 ? #2a2236 : #1e1828;

                Nocive15 {
                    text: "Existing controller";
                    color: list-selected == 1 ? #06d6a0 : #e8e0f0;
                    size: Nocive15Size.px15;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if phase == SetupPhase.pick-existing : VerticalLayout {
            spacing: 6px;
            alignment: center;

            for item[i] in list-items : Rectangle {
                property <bool> acknowledged: FeedbackView.acknowledged(
                    "", "saved:" + i, FeedbackView.revision);
                width: 450px;
                height: 36px;
                border-radius: 6px;
                border-width: list-selected == i ? 2px : 1px;
                border-color: list-selected == i ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
                background: list-selected == i ? #2a2236 : #1e1828;

                Nocive15 {
                    text: item.label;
                    color: list-selected == i ? #06d6a0 : #e8e0f0;
                    size: Nocive15Size.px15;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if phase == SetupPhase.configure : VerticalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            Nocive15 {
                text: subtitle;
                color: #06d6a0;
                size: Nocive15Size.px15;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                width: MisterUi.portrait-layout ? MisterUi.window-width * 1px - 48px : 700px;
                vertical-stretch: 1;
                border-radius: 6px;
                border-width: 1px;
                border-color: #5c4a72;
                background: #1e1828;

                Flickable {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 1px;

                        for field in fields : ConfigRow {
                            label: field.label;
                            value: field.value;
                        }
                    }
                }
            }
        }

        if phase == SetupPhase.name-kind : VerticalLayout {
            spacing: 12px;
            alignment: center;

            Nocive15 {
                text: subtitle;
                color: #9080a8;
                size: Nocive15Size.px15;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Spleen6x12 {
                    text: "Name";
                    color: #9080a8;
                    size: Spleen6x12Size.px8;
                    horizontal-alignment: left;
                }

                Rectangle {
                    width: 450px;
                    height: 36px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #5c4a72;
                    background: #1e1828;

                    Nocive15 {
                        text: setup-name;
                        color: #e8e0f0;
                        size: Nocive15Size.px15;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            VerticalLayout {
                spacing: 4px;
                alignment: center;

                Spleen6x12 {
                    text: "Type";
                    color: #9080a8;
                    size: Spleen6x12Size.px8;
                    horizontal-alignment: left;
                }

                Rectangle {
                    width: 450px;
                    height: 36px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: #06d6a0;
                    background: #2a2236;

                    Nocive15 {
                        text: setup-kind-label;
                        color: #06d6a0;
                        size: Nocive15Size.px15;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Spleen6x12 {
            text: phase == SetupPhase.detected ? "Press any button to continue"
                : phase == SetupPhase.new-or-existing ? "D-pad: choose  ·  A: confirm"
                : phase == SetupPhase.pick-existing ? "D-pad: choose  ·  A: confirm"
                : phase == SetupPhase.configure ? "A: continue to naming"
                : phase == SetupPhase.name-kind ? "D-pad: change type  ·  A: save"
                : "";
            color: #706080;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }
    }
}
