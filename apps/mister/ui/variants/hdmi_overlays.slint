// HDMI overlays share the page chrome vocabulary: black ground, cream Nocive
// headings, Xerxes caps for detail, and the violet Settings accent. Floating
// panels match the Settings pickers (1px frame, 2px accent cap).

import { Nocive15 } from "../components/nocive_15.slint";
import { Xerxes10 } from "../components/xerxes_10.slint";
import {
    LandscapePageChrome,
    LibraryStripe,
    OutlineButton,
    PageTheme,
    PortraitPageChrome,
} from "../components/page_chrome.slint";

import { MisterUi } from "../mister_window.slint";
import {
    CatalogView,
    DialogChoice,
    FeedbackView,
    MediaPackRow,
    MediaPackState,
    MediaView,
    OverlayView,
    ProgressMode,
} from "../api.slint";
import { MediaPackProgressRow, ProgressTrack } from "../components/progress.slint";

component OverlayPanel inherits Rectangle {
    background: PageTheme.panel-background;
    border-width: 1px;
    border-color: PageTheme.panel-border;
    clip: true;

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: PageTheme.settings-accent; }
    @children
}

// Foreground scan: shown only while no usable catalog exists, so it owns the
// whole screen but keeps the persistent header and footer rules.
export component CatalogScanPopup inherits Rectangle {
    property <bool> portrait: MisterUi.portrait-layout;
    property <length> content-top: root.portrait ? 120px : 77px;
    property <length> content-bottom: root.portrait ? root.height - 68px : 500px;
    property <length> column-width: Math.min(440px, root.width - 64px);
    property <bool> determinate: CatalogView.progress-mode == ProgressMode.determinate;

    accessible-role: progress-indicator;
    accessible-label: "Catalog scan";
    accessible-description: CatalogView.message;

    background: PageTheme.background;

    if !root.portrait : LandscapePageChrome { hint-a: ""; hint-b: ""; hint-right: ""; }
    if root.portrait : PortraitPageChrome { section: "LIBRARY"; hint-a: ""; hint-b: ""; }

    VerticalLayout {
        x: (root.width - root.column-width) / 2;
        y: root.content-top;
        width: root.column-width;
        height: root.content-bottom - root.content-top;
        alignment: center;

        HorizontalLayout {
            alignment: start;
            LibraryStripe { }
        }
        Rectangle { height: 22px; }

        Xerxes10 {
            text: (CatalogView.title == "" ? "Building game library" : CatalogView.title).to-uppercase();
            color: PageTheme.muted;
        }
        Rectangle { height: 8px; }
        Nocive15 {
            text: CatalogView.message.to-uppercase();
            color: PageTheme.cream;
            wrap: word-wrap;
        }
        Rectangle { height: 20px; }

        if root.determinate : ProgressTrack { percent: CatalogView.percent; }
        if root.determinate : Rectangle { height: 10px; }

        HorizontalLayout {
            spacing: 12px;
            Xerxes10 {
                horizontal-stretch: 1;
                text: CatalogView.detail.to-uppercase();
                color: PageTheme.muted;
                wrap: word-wrap;
            }
            if root.determinate : Xerxes10 {
                text: Math.max(0, Math.min(100, CatalogView.percent)) + "%";
                color: PageTheme.settings-accent;
            }
        }

        if MediaView.rows.length > 0 : VerticalLayout {
            padding-top: 40px;
            spacing: 10px;

            Xerxes10 {
                text: MediaView.summary.to-uppercase();
                color: PageTheme.muted;
            }
            for pack in MediaView.rows : MediaPackProgressRow { pack: pack; }
        }
    }
}

// Background activity lives in the page header: every HDMI page keeps that
// strip clear, and the Rust Arcade list and preview renderers never paint
// over it.
component HeaderPill inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: PageTheme.settings-accent;
    in property <int> percent: -1;
    in property <color> accent: PageTheme.settings-accent;
    // Width granted by HeaderActivity; the label elides to fit it.
    in property <length> budget: 10000px;
    property <length> value-part: root.value == "" ? 0px : 8px + value-text.preferred-width;
    out property <length> natural-width: 28px + label-text.preferred-width + root.value-part;
    property <length> label-width: Math.max(0px, root.width - 28px - root.value-part);

    width: Math.min(root.natural-width, root.budget);
    height: 18px;
    background: PageTheme.panel-background;
    border-width: 1px;
    border-color: PageTheme.panel-border;
    clip: true;

    Rectangle { x: 7px; y: 6px; width: 6px; height: 6px; background: root.accent; }
    label-text := Xerxes10 {
        x: 19px;
        y: -1px;
        width: root.label-width;
        text: root.label;
        color: PageTheme.cream;
        overflow: elide;
    }
    value-text := Xerxes10 {
        x: 19px + root.label-width + 8px;
        y: -1px;
        text: root.value;
        color: root.value-color;
    }
    if root.percent >= 0 : ProgressTrack {
        x: 1px;
        y: root.height - 3px;
        width: root.width - 2px;
        percent: root.percent;
        fill: root.accent;
        background: transparent;
    }
}

component MediaProgressPill inherits HeaderPill {
    in property <bool> compact;
    // At most three rows are published. Indexing past the end yields a
    // default row, so absent rows are treated as complete.
    property <MediaPackState> s0: MediaView.rows.length > 0 ? MediaView.rows[0].state : MediaPackState.complete;
    property <MediaPackState> s1: MediaView.rows.length > 1 ? MediaView.rows[1].state : MediaPackState.complete;
    property <MediaPackState> s2: MediaView.rows.length > 2 ? MediaView.rows[2].state : MediaPackState.complete;
    property <int> active-index: root.s0 == MediaPackState.downloading ? 0
        : root.s1 == MediaPackState.downloading ? 1
        : root.s2 == MediaPackState.downloading ? 2 : -1;
    property <bool> downloading: root.active-index >= 0;
    property <bool> failed: root.s0 == MediaPackState.failed
        || root.s1 == MediaPackState.failed
        || root.s2 == MediaPackState.failed;
    property <bool> queued: root.s0 == MediaPackState.queued
        || root.s1 == MediaPackState.queued
        || root.s2 == MediaPackState.queued;
    property <int> pending: (root.s0 == MediaPackState.queued || root.s0 == MediaPackState.downloading ? 1 : 0)
        + (root.s1 == MediaPackState.queued || root.s1 == MediaPackState.downloading ? 1 : 0)
        + (root.s2 == MediaPackState.queued || root.s2 == MediaPackState.downloading ? 1 : 0);
    // Packs still waiting behind the one shown.
    property <int> others: root.pending - (root.downloading ? 1 : 0);
    property <MediaPackRow> active: MediaView.rows[Math.max(0, root.active-index)];

    accessible-role: progress-indicator;
    accessible-label: "Media download progress";
    accessible-description: MediaView.summary;

    label: !root.downloading ? "SCREENSHOTS"
        : root.compact ? root.active.system.to-uppercase()
        : (root.active.system + " screenshots").to-uppercase();
    value: root.downloading
        ? root.active.percent + "%" + (root.others > 0 && !root.compact ? "  +" + root.others : "")
        : root.failed ? "FAILED" : root.queued ? "QUEUED" : "DONE";
    value-color: root.downloading ? PageTheme.settings-accent
        : root.failed ? PageTheme.danger
        : root.queued ? PageTheme.muted : PageTheme.cream;
    percent: root.downloading ? root.active.percent : -1;
    accent: root.failed && !root.downloading ? PageTheme.danger : PageTheme.settings-accent;
}

component BackgroundScanPill inherits HeaderPill {
    accessible-role: progress-indicator;
    accessible-label: "Background scan";
    accessible-description: CatalogView.title;

    label: (CatalogView.title == "" ? "Discovering systems" : CatalogView.title).to-uppercase();
}

// Right-aligned left of the clock and kept clear of the page title. Both
// pills share the space between, shrinking the longer one first.
export component HeaderActivity inherits Rectangle {
    in property <bool> media-progress-shown;
    in property <bool> background-scan-shown;
    property <bool> portrait: MisterUi.portrait-layout;
    property <bool> both: root.media-progress-shown && root.background-scan-shown;
    // The title ends near x=152 in both orientations.
    property <length> title-clearance: 168px;
    property <length> right-edge: root.portrait ? MisterUi.window-width * 1px - 104px : 857px;
    property <length> available: root.right-edge - root.title-clearance - (root.both ? 8px : 0px);
    property <length> media-width: !root.media-progress-shown ? 0px
        : !root.both ? Math.min(media.natural-width, root.available)
        : Math.min(media.natural-width, Math.max(root.available / 2, root.available - scan.natural-width));
    property <length> scan-width: !root.background-scan-shown ? 0px
        : Math.min(scan.natural-width, root.available - root.media-width);

    width: root.media-width + root.scan-width + (root.both ? 8px : 0px);
    height: 18px;
    x: root.right-edge - self.width;
    // Pinned by header_activity_clears_title_clock_and_arcade_layers:
    // portrait Arcade search starts its Rust list at y=56.
    y: root.portrait ? 38px : 24px;

    media := MediaProgressPill {
        x: 0px;
        y: 0px;
        visible: root.media-progress-shown;
        compact: root.portrait;
        budget: root.media-width;
    }
    scan := BackgroundScanPill {
        x: root.width - self.width;
        y: 0px;
        visible: root.background-scan-shown;
        budget: root.scan-width;
    }
}

export component ConfirmDialog inherits Rectangle {
    accessible-role: region;
    accessible-label: "Confirmation";
    accessible-description: OverlayView.confirmation-message;
    background: PageTheme.panel-scrim;

    panel := OverlayPanel {
        // Two buttons share the row inside 20px side padding and an 8px gap.
        property <length> button-width: Math.min(124px, (self.width - 48px) / 2);
        width: Math.min(440px, root.width - 32px);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        content := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 10px;

            Nocive15 {
                text: OverlayView.confirmation-title.to-uppercase();
                color: PageTheme.cream;
                wrap: word-wrap;
            }

            Xerxes10 {
                text: OverlayView.confirmation-message.to-uppercase();
                color: PageTheme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-top: 10px;
                spacing: 8px;
                alignment: end;

                if OverlayView.cancel-label != "" : OutlineButton {
                    width: panel.button-width;
                    label: OverlayView.cancel-label;
                    focused: OverlayView.selected-choice == DialogChoice.cancel;
                    acknowledged: FeedbackView.acknowledged("", "left", FeedbackView.revision);
                }

                if OverlayView.confirm-label != "" : OutlineButton {
                    width: panel.button-width;
                    label: OverlayView.confirm-label;
                    focused: OverlayView.selected-choice == DialogChoice.confirm;
                    acknowledged: FeedbackView.acknowledged("", "right", FeedbackView.revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    accessible-role: progress-indicator;
    accessible-label: OverlayView.loading-message;
    accessible-description: OverlayView.loading-detail;
    background: PageTheme.background;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            padding-bottom: 10px;
            LibraryStripe { segment: 24px; }
        }

        Nocive15 {
            text: OverlayView.loading-message.to-uppercase();
            color: PageTheme.cream;
            horizontal-alignment: center;
        }

        Xerxes10 {
            text: (OverlayView.loading-detail != "" ? OverlayView.loading-detail : "Please wait").to-uppercase();
            color: PageTheme.muted;
            horizontal-alignment: center;
        }
    }
}
