import { PixelText8, PixelTextSize } from "../components/pixel_text_8.slint";

import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";
import { LauncherTile, OsdSideLabel } from "../components/launcher_chrome.slint";
import { ScreenshotPackProgressRow } from "../components/progress.slint";

export component CatalogScanPopup inherits Rectangle {
    property <length> scan-osd-width: 56px;
    property <length> scan-horizontal-padding: 70px;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px
        ? scan-content-width
        : 560px;

    background: black;

    HorizontalLayout {
        OsdSideLabel { }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: 82px;
            padding-bottom: 76px;
            spacing: 18px;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            PixelText8 {
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: #06d6a0;
                size: PixelTextSize.px24;
                horizontal-alignment: center;
            }

            PixelText8 {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-message;
                color: #e8e0f0;
                size: PixelTextSize.px16;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            PixelText8 {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-title;
                color: #d7eef8;
                size: PixelTextSize.body12;
                horizontal-alignment: center;
            }

            PixelText8 {
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-detail;
                color: #9080a8;
                size: PixelTextSize.body12;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if MisterBridge.media-pack-progresses.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px;

                PixelText8 {
                    text: MisterBridge.media-pack-summary;
                    color: #d7eef8;
                    size: PixelTextSize.body12;
                    horizontal-alignment: center;
                }

                for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {

    width: MisterUi.portrait-layout ? MisterUi.window-width * 1px - 32px : 560px;
    height: 100px;
    x: MisterUi.window-width * 1px / 2 - self.width / 2;
    y: MisterUi.window-height * 1px - self.height - 24px;
    background: black;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        PixelText8 {
            text: MisterBridge.media-pack-summary;
            color: #d7eef8;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }

        for pack in MisterBridge.media-pack-progresses: ScreenshotPackProgressRow {
            pack: pack;
        }
    }
}

export component StartupSplash inherits Rectangle {

    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        PixelText8 {
            text: "MiSTer MagiK";
            color: #e8e0f0;
            size: PixelTextSize.px24;
            horizontal-alignment: center;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {

    width: t.width + 20px;
    height: 28px;
    x: MisterUi.window-width * 1px - self.width - 18px;
    y: MisterUi.window-height * 1px - self.height - 16px;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;


    t := HorizontalLayout {
        alignment: start;
        width: self.preferred-width;
        PixelText8 {
            text: "Building library";
            color: #d7eef8;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        PixelText8 {
            text: ".";
            color: #d7eef8;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

    }
}

component CompactDialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;

    height: 42px;
    background: focused ? #2a2236 : #181829;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : acknowledged ? #4e8f80 : #5a4973;

    PixelText8 {
        text: root.label;
        color: root.focused ? #06d6a0 : #e8e0f0;
        size: PixelTextSize.body12;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ConfirmDialog inherits Rectangle {
    property <bool> compact: MisterUi.window-height <= 288;
    property <bool> portrait: MisterUi.portrait-layout;
    property <bool> condensed: compact || portrait;
    background: #000000b0;

    Rectangle {
        width: root.portrait ? (MisterUi.window-width - 24) * 1px
            : root.compact ? (MisterUi.window-width - 16) * 1px : 680px;
        height: root.portrait ? 250px
            : root.compact ? (MisterUi.window-height - 12) * 1px : 260px;
        background: #0e0c14;
        border-width: root.condensed ? 2px : 4px;
        border-color: #06d6a0;

        if !root.condensed : VerticalLayout {
            padding: 24px;
            spacing: 18px;

            PixelText8 {
                text: MisterBridge.confirm-title;
                color: #06d6a0;
                size: PixelTextSize.px16;
                horizontal-alignment: center;
            }

            PixelText8 {
                text: MisterBridge.confirm-message;
                color: #e8e0f0;
                size: PixelTextSize.body12;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            HorizontalLayout {
                spacing: 16px;

                if MisterBridge.confirm-left-label != "" : LauncherTile {
                    label: MisterBridge.confirm-left-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 0;
                    acknowledged: MisterBridge.selection-feedback-query("", "left", MisterBridge.selection-feedback-revision);
                }

                if MisterBridge.confirm-right-label != "" : LauncherTile {
                    label: MisterBridge.confirm-right-label;
                    subtitle: "";
                    focused: MisterBridge.confirm-selected == 1;
                    acknowledged: MisterBridge.selection-feedback-query("", "right", MisterBridge.selection-feedback-revision);
                }
            }
        }

        if root.condensed : VerticalLayout {
            padding: 10px;
            spacing: 8px;

            PixelText8 {
                text: MisterBridge.confirm-title;
                color: #06d6a0;
                size: PixelTextSize.body12;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            PixelText8 {
                text: MisterBridge.confirm-message;
                color: #e8e0f0;
                size: PixelTextSize.body12;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                height: 42px;
                spacing: 8px;

                if MisterBridge.confirm-left-label != "" : CompactDialogButton {
                    label: MisterBridge.confirm-left-label;
                    focused: MisterBridge.confirm-selected == 0;
                    acknowledged: MisterBridge.selection-feedback-query("", "left", MisterBridge.selection-feedback-revision);
                }

                if MisterBridge.confirm-right-label != "" : CompactDialogButton {
                    label: MisterBridge.confirm-right-label;
                    focused: MisterBridge.confirm-selected == 1;
                    acknowledged: MisterBridge.selection-feedback-query("", "right", MisterBridge.selection-feedback-revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        PixelText8 {
            text: MisterBridge.loading-message;
            color: #e8e0f0;
            size: PixelTextSize.px16;
            horizontal-alignment: center;
        }

        PixelText8 {
            text: MisterBridge.loading-detail != "" ? MisterBridge.loading-detail : "Please wait...";
            color: #9080a8;
            size: PixelTextSize.body12;
            horizontal-alignment: center;
        }
    }
}
