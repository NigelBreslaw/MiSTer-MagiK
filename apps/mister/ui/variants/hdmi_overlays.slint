import { Spleen6x12, Spleen6x12Size } from "../components/spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "../components/nocive_15.slint";

import { MisterUi } from "../mister_window.slint";
import { CatalogView, DialogChoice, FeedbackView, MediaView, OverlayView } from "../api.slint";
import { LauncherTile, OsdSideLabel } from "../components/launcher_chrome.slint";
import { MediaPackProgressRow } from "../components/progress.slint";

export component CatalogScanPopup inherits Rectangle {
    property <length> scan-osd-width: 56px;
    property <length> scan-horizontal-padding: 70px;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px
        ? scan-content-width
        : 560px;

    accessible-role: progress-indicator;
    accessible-label: "Catalog scan";
    accessible-description: CatalogView.message;

    background: black;

    HorizontalLayout {
        OsdSideLabel { }

        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: 82px;
            padding-bottom: 76px;
            spacing: 18px;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Spleen6x12 {
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: #06d6a0;
                size: Spleen6x12Size.px24;
                horizontal-alignment: center;
            }

            Nocive15 {
                width: root.scan-content-width;
                text: CatalogView.message;
                color: #e8e0f0;
                size: Nocive15Size.px15;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.title;
                color: #d7eef8;
                size: Spleen6x12Size.px8;
                horizontal-alignment: center;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.detail;
                color: #9080a8;
                size: Spleen6x12Size.px8;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if MediaView.rows.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px;

                Spleen6x12 {
                    text: MediaView.summary;
                    color: #d7eef8;
                    size: Spleen6x12Size.px8;
                    horizontal-alignment: center;
                }

                for pack in MediaView.rows: MediaPackProgressRow {
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {

    width: MisterUi.portrait-layout ? MisterUi.window-width * 1px - 32px : 560px;
    height: 100px;
    x: MisterUi.window-width * 1px / 2 - self.width / 2;
    y: MisterUi.window-height * 1px - self.height - 24px;
    background: black;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: "Media download progress";
    accessible-description: MediaView.summary;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        Spleen6x12 {
            text: MediaView.summary;
            color: #d7eef8;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }

        for pack in MediaView.rows: MediaPackProgressRow {
            pack: pack;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {

    width: t.width + 20px;
    height: 28px;
    x: MisterUi.window-width * 1px - self.width - 18px;
    y: MisterUi.window-height * 1px - self.height - 16px;
    background: #101420;
    border-width: 1px;
    border-color: #52647d;
    accessible-role: progress-indicator;
    accessible-label: "Background scan";
    accessible-description: CatalogView.title;


    t := HorizontalLayout {
        alignment: start;
        width: self.preferred-width;
        Spleen6x12 {
            text: CatalogView.title == "" ? "Discovering systems" : CatalogView.title;
            color: #d7eef8;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CompactDialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;
    accessible-role: button;
    accessible-label: root.label;
    accessible-item-selected: root.focused;
    accessible-enabled: true;

    height: 42px;
    background: focused ? #2a2236 : #181829;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : acknowledged ? #4e8f80 : #5a4973;

    Spleen6x12 {
        text: root.label;
        color: root.focused ? #06d6a0 : #e8e0f0;
        size: Spleen6x12Size.px8;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ConfirmDialog inherits Rectangle {
    property <bool> compact: MisterUi.window-height <= 288;
    property <bool> portrait: MisterUi.portrait-layout;
    property <bool> condensed: compact || portrait;
    accessible-role: region;
    accessible-label: "Confirmation";
    accessible-description: OverlayView.confirmation-message;
    background: #000000b0;

    Rectangle {
        width: root.portrait ? (MisterUi.window-width - 24) * 1px
            : root.compact ? (MisterUi.window-width - 16) * 1px : 680px;
        height: root.portrait ? 250px
            : root.compact ? (MisterUi.window-height - 12) * 1px : 260px;
        background: #0e0c14;
        border-width: root.condensed ? 2px : 4px;
        border-color: #06d6a0;

        if !root.condensed : VerticalLayout {
            padding: 24px;
            spacing: 18px;

            Nocive15 {
                text: OverlayView.confirmation-title;
                color: #06d6a0;
                size: Nocive15Size.px15;
                horizontal-alignment: center;
            }

            Spleen6x12 {
                text: OverlayView.confirmation-message;
                color: #e8e0f0;
                size: Spleen6x12Size.px8;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            HorizontalLayout {
                spacing: 16px;

                if OverlayView.cancel-label != "" : LauncherTile {
                    label: OverlayView.cancel-label;
                    subtitle: "";
                    focused: OverlayView.selected-choice == DialogChoice.cancel;
                    acknowledged: FeedbackView.acknowledged("", "left", FeedbackView.revision);
                }

                if OverlayView.confirm-label != "" : LauncherTile {
                    label: OverlayView.confirm-label;
                    subtitle: "";
                    focused: OverlayView.selected-choice == DialogChoice.confirm;
                    acknowledged: FeedbackView.acknowledged("", "right", FeedbackView.revision);
                }
            }
        }

        if root.condensed : VerticalLayout {
            padding: 10px;
            spacing: 8px;

            Spleen6x12 {
                text: OverlayView.confirmation-title;
                color: #06d6a0;
                size: Spleen6x12Size.px8;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Spleen6x12 {
                text: OverlayView.confirmation-message;
                color: #e8e0f0;
                size: Spleen6x12Size.px8;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                height: 42px;
                spacing: 8px;

                if OverlayView.cancel-label != "" : CompactDialogButton {
                    label: OverlayView.cancel-label;
                    focused: OverlayView.selected-choice == DialogChoice.cancel;
                    acknowledged: FeedbackView.acknowledged("", "left", FeedbackView.revision);
                }

                if OverlayView.confirm-label != "" : CompactDialogButton {
                    label: OverlayView.confirm-label;
                    focused: OverlayView.selected-choice == DialogChoice.confirm;
                    acknowledged: FeedbackView.acknowledged("", "right", FeedbackView.revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    accessible-role: progress-indicator;
    accessible-label: OverlayView.loading-message;
    accessible-description: OverlayView.loading-detail;
    background: #1a1424;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Nocive15 {
            text: OverlayView.loading-message;
            color: #e8e0f0;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }

        Spleen6x12 {
            text: OverlayView.loading-detail != "" ? OverlayView.loading-detail : "Please wait...";
            color: #9080a8;
            size: Spleen6x12Size.px8;
            horizontal-alignment: center;
        }
    }
}
