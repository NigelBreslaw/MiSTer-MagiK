// HDMI overlays share the page chrome vocabulary: black ground, cream Nocive
// headings, Xerxes caps for detail, and the violet Settings accent. Floating
// panels match the Settings pickers (1px frame, 2px accent cap).

import { Nocive15 } from "../components/nocive_15.slint";
import { Xerxes10 } from "../components/xerxes_10.slint";
import {
    LandscapePageChrome,
    LibraryStripe,
    PageTheme,
    PortraitPageChrome,
} from "../components/page_chrome.slint";

import { MisterUi } from "../mister_window.slint";
import {
    CatalogView,
    DialogChoice,
    FeedbackView,
    MediaPackRow,
    MediaPackState,
    MediaView,
    OverlayView,
    ProgressMode,
} from "../api.slint";
import { MediaPackProgressRow, ProgressTrack } from "../components/progress.slint";

component OverlayPanel inherits Rectangle {
    background: PageTheme.panel-background;
    border-width: 1px;
    border-color: PageTheme.panel-border;
    clip: true;

    Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: PageTheme.settings-accent; }
    @children
}

// Foreground scan: shown only while no usable catalog exists, so it owns the
// whole screen but keeps the persistent header and footer rules.
export component CatalogScanPopup inherits Rectangle {
    property <bool> portrait: MisterUi.portrait-layout;
    property <length> content-top: root.portrait ? 120px : 77px;
    property <length> content-bottom: root.portrait ? root.height - 68px : 500px;
    property <length> column-width: Math.min(440px, root.width - 64px);
    property <bool> determinate: CatalogView.progress-mode == ProgressMode.determinate;

    accessible-role: progress-indicator;
    accessible-label: "Catalog scan";
    accessible-description: CatalogView.message;

    background: PageTheme.background;

    if !root.portrait : LandscapePageChrome { hint-a: ""; hint-b: ""; hint-right: ""; }
    if root.portrait : PortraitPageChrome { section: "LIBRARY"; hint-a: ""; hint-b: ""; }

    VerticalLayout {
        x: (root.width - root.column-width) / 2;
        y: root.content-top;
        width: root.column-width;
        height: root.content-bottom - root.content-top;
        alignment: center;

        HorizontalLayout {
            alignment: start;
            LibraryStripe { }
        }
        Rectangle { height: 22px; }

        Xerxes10 {
            text: (CatalogView.title == "" ? "Building game library" : CatalogView.title).to-uppercase();
            color: PageTheme.muted;
        }
        Rectangle { height: 8px; }
        Nocive15 {
            text: CatalogView.message.to-uppercase();
            color: PageTheme.cream;
            wrap: word-wrap;
        }
        Rectangle { height: 20px; }

        if root.determinate : ProgressTrack { percent: CatalogView.percent; }
        if root.determinate : Rectangle { height: 10px; }

        HorizontalLayout {
            spacing: 12px;
            Xerxes10 {
                horizontal-stretch: 1;
                text: CatalogView.detail.to-uppercase();
                color: PageTheme.muted;
                wrap: word-wrap;
            }
            if root.determinate : Xerxes10 {
                text: Math.max(0, Math.min(100, CatalogView.percent)) + "%";
                color: PageTheme.settings-accent;
            }
        }

        if MediaView.rows.length > 0 : VerticalLayout {
            padding-top: 40px;
            spacing: 10px;

            Xerxes10 {
                text: MediaView.summary.to-uppercase();
                color: PageTheme.muted;
            }
            for pack in MediaView.rows : MediaPackProgressRow { pack: pack; }
        }
    }
}

// Background activity lives in the page header, left of the clock: every
// HDMI page keeps that strip clear, and the Rust Arcade list and preview
// renderers never paint over it.
component HeaderPill inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: PageTheme.settings-accent;
    in property <int> percent: -1;
    in property <color> accent: PageTheme.settings-accent;
    property <length> label-width: Math.min(label-text.preferred-width, 300px);

    width: 19px + root.label-width
        + (root.value == "" ? 0px : 8px + value-text.preferred-width) + 9px;
    height: 18px;
    background: PageTheme.panel-background;
    border-width: 1px;
    border-color: PageTheme.panel-border;
    clip: true;

    Rectangle { x: 7px; y: 6px; width: 6px; height: 6px; background: root.accent; }
    label-text := Xerxes10 {
        x: 19px;
        y: -1px;
        width: root.label-width;
        text: root.label;
        color: PageTheme.cream;
        overflow: elide;
    }
    value-text := Xerxes10 {
        x: 19px + root.label-width + 8px;
        y: -1px;
        text: root.value;
        color: root.value-color;
    }
    if root.percent >= 0 : ProgressTrack {
        x: 1px;
        y: root.height - 3px;
        width: root.width - 2px;
        percent: root.percent;
        fill: root.accent;
        background: transparent;
    }
}

export component MediaProgressPopup inherits HeaderPill {
    // At most three rows are published; follow the first one downloading.
    property <int> active-index: MediaView.rows[0].state == MediaPackState.downloading ? 0
        : MediaView.rows[1].state == MediaPackState.downloading ? 1
        : MediaView.rows[2].state == MediaPackState.downloading ? 2 : -1;
    property <bool> failed: MediaView.rows[0].state == MediaPackState.failed
        || MediaView.rows[1].state == MediaPackState.failed
        || MediaView.rows[2].state == MediaPackState.failed;
    property <MediaPackRow> active: MediaView.rows[Math.max(0, root.active-index)];
    property <int> others: MediaView.rows.length - 1;

    accessible-role: progress-indicator;
    accessible-label: "Media download progress";
    accessible-description: MediaView.summary;

    label: root.active-index >= 0
        ? (root.active.system + " screenshots").to-uppercase() : "SCREENSHOTS";
    value: root.active-index >= 0
        ? root.active.percent + "%" + (root.others > 0 ? "  +" + root.others : "")
        : root.failed ? "FAILED" : "QUEUED";
    value-color: root.failed && root.active-index < 0 ? PageTheme.danger
        : root.active-index >= 0 ? PageTheme.settings-accent : PageTheme.muted;
    percent: root.active-index >= 0 ? root.active.percent : -1;
    accent: root.failed && root.active-index < 0 ? PageTheme.danger : PageTheme.settings-accent;
}

export component BackgroundScanBadge inherits HeaderPill {
    accessible-role: progress-indicator;
    accessible-label: "Background scan";
    accessible-description: CatalogView.title;

    label: (CatalogView.title == "" ? "Discovering systems" : CatalogView.title).to-uppercase();
}

export component HeaderActivity inherits Rectangle {
    in property <bool> media-progress-shown;
    in property <bool> background-scan-shown;
    property <bool> portrait: MisterUi.portrait-layout;

    width: strip.preferred-width;
    height: 18px;
    // Keep within the band pinned by visual_composition's
    // header_activity_band_clears_arcade_direct_layers: portrait Arcade
    // search starts its Rust list at y=56.
    x: (root.portrait ? MisterUi.window-width * 1px - 104px : 857px) - self.width;
    y: root.portrait ? 38px : 24px;

    strip := HorizontalLayout {
        spacing: 8px;
        if root.media-progress-shown : MediaProgressPopup { }
        if root.background-scan-shown : BackgroundScanBadge { }
    }
}

component DialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;
    accessible-role: button;
    accessible-label: root.label;
    accessible-item-selected: root.focused;
    accessible-enabled: true;

    height: 28px;
    border-width: 1px;
    border-color: root.focused ? PageTheme.settings-accent
        : root.acknowledged ? PageTheme.settings-accent-deep : PageTheme.button-border;
    background: root.focused ? PageTheme.button-focus : transparent;

    Xerxes10 {
        y: 7px;
        width: parent.width;
        text: root.label.to-uppercase();
        horizontal-alignment: center;
        color: root.focused ? PageTheme.cream : PageTheme.muted;
    }
}

export component ConfirmDialog inherits Rectangle {
    accessible-role: region;
    accessible-label: "Confirmation";
    accessible-description: OverlayView.confirmation-message;
    background: PageTheme.panel-scrim;

    OverlayPanel {
        width: Math.min(440px, root.width - 32px);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        content := VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 10px;

            Nocive15 {
                text: OverlayView.confirmation-title.to-uppercase();
                color: PageTheme.cream;
                wrap: word-wrap;
            }

            Xerxes10 {
                text: OverlayView.confirmation-message.to-uppercase();
                color: PageTheme.muted;
                wrap: word-wrap;
            }

            HorizontalLayout {
                padding-top: 10px;
                spacing: 8px;
                alignment: end;

                if OverlayView.cancel-label != "" : DialogButton {
                    width: 124px;
                    label: OverlayView.cancel-label;
                    focused: OverlayView.selected-choice == DialogChoice.cancel;
                    acknowledged: FeedbackView.acknowledged("", "left", FeedbackView.revision);
                }

                if OverlayView.confirm-label != "" : DialogButton {
                    width: 124px;
                    label: OverlayView.confirm-label;
                    focused: OverlayView.selected-choice == DialogChoice.confirm;
                    acknowledged: FeedbackView.acknowledged("", "right", FeedbackView.revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    accessible-role: progress-indicator;
    accessible-label: OverlayView.loading-message;
    accessible-description: OverlayView.loading-detail;
    background: PageTheme.background;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            padding-bottom: 10px;
            LibraryStripe { segment: 24px; }
        }

        Nocive15 {
            text: OverlayView.loading-message.to-uppercase();
            color: PageTheme.cream;
            horizontal-alignment: center;
        }

        Xerxes10 {
            text: (OverlayView.loading-detail != "" ? OverlayView.loading-detail : "Please wait").to-uppercase();
            color: PageTheme.muted;
            horizontal-alignment: center;
        }
    }
}
