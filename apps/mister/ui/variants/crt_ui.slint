import { MisterUi } from "../mister_window.slint";
import { CatalogActivity, CatalogView, ConfirmationKind, LauncherScreen, LoadingState, MediaView, NavigationView, OverlayView, SettingsPopup, SettingsView, SetupPhase, SetupView } from "../api.slint";
import { CrtTheme } from "../components/crt_ui.slint";
import { CrtSettingsBackdrop } from "../components/crt_settings_page.slint";
import { CrtControllerPanel } from "../views/crt/controller_panel.slint";
import { SetupOverlay } from "crt_setup.slint";
import { ArcadeListScreen } from "../views/crt/arcade_list.slint";
import { HomeGrid } from "../views/crt/home.slint";
import { SettingsScreen } from "../views/crt/settings.slint";
import { LicensesScreen } from "../views/crt/licenses.slint";
import { LicenseTextScreen } from "../views/crt/license_text.slint";
import { AboutScreen } from "../views/crt/about.slint";
import { SystemHubScreen } from "../views/crt/system_hub.slint";
import { CrtComboBoxOverlay } from "../components/crt_combo_box.slint";
import {
    BackgroundScanBadge,
    CatalogScanPopup,
    ConfirmDialog,
    LoadingOverlay,
    MediaProgressPopup,
} from "crt_overlays.slint";

export component CrtLauncherUi inherits Rectangle {
    property <bool> settings-family: NavigationView.screen == LauncherScreen.settings
        || NavigationView.screen == LauncherScreen.about
        || NavigationView.screen == LauncherScreen.licenses
        || NavigationView.screen == LauncherScreen.license-text;
    property <bool> settings-overlay-active: NavigationView.screen == LauncherScreen.settings
        && (SettingsView.popup != SettingsPopup.none
            || OverlayView.confirmation-kind == ConfirmationKind.display-resolution
            || OverlayView.confirmation-kind == ConfirmationKind.screen-orientation);

    // Launcher already paints black when there is no custom native home base.
    // Paint it here only when that base makes the Launcher transparent, so the
    // Settings family always has one edge-to-edge black scene background.
    background: root.settings-family
        ? (MisterUi.custom-home-base ? #000000 : transparent)
        : MisterUi.custom-home-base ? transparent : CrtTheme.background;

    if root.settings-family : CrtSettingsBackdrop {
        opacity: root.settings-overlay-active ? 0.18 : 0.3;
    }

    content := Rectangle {
        x: MisterUi.content-x;
        y: MisterUi.content-y;
        width: MisterUi.content-width;
        height: MisterUi.content-height;
        background: transparent;
        clip: true;

        if NavigationView.screen == LauncherScreen.home && !MisterUi.custom-home-base : HomeGrid { }
        if NavigationView.screen == LauncherScreen.controller : CrtControllerPanel { width: 100%; height: 100%; }
        if NavigationView.screen == LauncherScreen.arcade : ArcadeListScreen { }
        if NavigationView.screen == LauncherScreen.settings : SettingsScreen { }
        if NavigationView.screen == LauncherScreen.about : AboutScreen { }
        if NavigationView.screen == LauncherScreen.licenses : LicensesScreen { }
        if NavigationView.screen == LauncherScreen.license-text : LicenseTextScreen { }
        if NavigationView.screen == LauncherScreen.system-hub : SystemHubScreen { }

        if CatalogView.background-activity-visible : BackgroundScanBadge { }
        if SetupView.phase != SetupPhase.none : SetupOverlay { }
        if CatalogView.activity != CatalogActivity.foreground && MediaView.rows.length > 0 : MediaProgressPopup {
        }
        if CatalogView.activity == CatalogActivity.foreground : CatalogScanPopup { }
        if OverlayView.confirmation-kind != ConfirmationKind.none : ConfirmDialog { }
        if SettingsView.popup != SettingsPopup.none : CrtComboBoxOverlay { }
        if OverlayView.loading-state == LoadingState.active : LoadingOverlay { }
    }
}
