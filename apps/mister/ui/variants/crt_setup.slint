import { Spleen6x12 } from "../components/spleen_6x12.slint";

import { MisterUi } from "../mister_window.slint";
import { FeedbackView, SetupEntry, SetupField, SetupPhase, SetupView } from "../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../components/crt_ui.slint";

export component SetupOverlay inherits Rectangle {
    property <SetupPhase> phase: SetupView.phase;
    property <string> title: SetupView.title;
    property <string> subtitle: SetupView.subtitle;
    property <[SetupEntry]> list-items: SetupView.entries;
    property <int> list-selected: SetupView.selected-entry-index;
    property <[SetupField]> fields: SetupView.fields;
    property <string> setup-name: SetupView.name;
    property <string> setup-kind-label: SetupView.kind-label;
    property <int> setup-visible-rows: 7;
    property <int> setup-first-visible: (root.list-selected - 3).clamp(
        0,
        (root.list-items.length - root.setup-visible-rows).max(0),
    );

    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: root.title; subtitle: "Controller setup"; status: ""; }

        if root.phase != SetupPhase.configure : Spleen6x12 {
            text: root.subtitle;
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.phase == SetupPhase.new-or-existing : CrtMenuRow {
            label: "New controller";
            detail: "Create";
            focused: root.list-selected == 0;
            acknowledged: FeedbackView.acknowledged("", "new", FeedbackView.revision);
        }
        if root.phase == SetupPhase.new-or-existing : CrtMenuRow {
            label: "Existing controller";
            detail: "Rebind";
            focused: root.list-selected == 1;
            acknowledged: FeedbackView.acknowledged("", "existing", FeedbackView.revision);
        }

        if root.phase == SetupPhase.pick-existing : Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            for item[i] in root.list-items : CrtMenuRow {
                y: (i - root.setup-first-visible) * parent.height / root.setup-visible-rows;
                width: parent.width;
                height: parent.height / root.setup-visible-rows;
                label: item.label;
                detail: "";
                focused: root.list-selected == i;
                acknowledged: FeedbackView.acknowledged("", "saved:" + i, FeedbackView.revision);
            }
        }

        if root.phase == SetupPhase.configure : Spleen6x12 {
            text: root.subtitle;
            color: CrtTheme.accent;
            size: MisterUi.crt-body-font;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.phase == SetupPhase.configure : Rectangle {
            vertical-stretch: 1;
            background: CrtTheme.panel;
            border-width: MisterUi.border;
            border-color: CrtTheme.border;
            clip: true;
            Flickable {
                width: 100%;
                height: 100%;
                VerticalLayout {
                    for field in root.fields : CrtMenuRow {
                        label: field.label;
                        detail: field.value;
                        focused: false;
                    }
                }
            }
        }

        if root.phase == SetupPhase.name-kind : CrtMenuRow {
            label: "Name";
            detail: root.setup-name;
            focused: false;
        }
        if root.phase == SetupPhase.name-kind : CrtMenuRow {
            label: "Type";
            detail: root.setup-kind-label;
            focused: true;
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
        CrtFooter {
            left-hint: root.phase == SetupPhase.detected ? "BUTTON Continue"
                : root.phase == SetupPhase.configure ? "A Continue"
                : root.phase == SetupPhase.name-kind ? "DPAD Type   A Save" : "DPAD Choose   A Confirm";
            right-hint: "";
        }
    }
}
