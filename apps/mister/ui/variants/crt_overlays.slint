import { MisterUi } from "../mister_window.slint";
import { MisterBridge, ScreenshotPackProgress } from "../api.slint";
import { CrtTheme } from "../components/crt_ui.slint";

component CrtProgressRow inherits Rectangle {
    in property <ScreenshotPackProgress> pack;
    height: MisterUi.footer-height;
    background: CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;
        Text {
            font-family: MisterUi.crt-font-family;
            text: root.pack.system + "  " + root.pack.phase;
            color: CrtTheme.text;
            font-size: MisterUi.body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            font-family: MisterUi.crt-font-family;
            text: root.pack.percent < 0 ? "..." : root.pack.percent + "%";
            color: CrtTheme.muted;
            font-size: MisterUi.body-font;
        }
    }
}

export component DisplayDegradedBanner inherits Rectangle {
    height: MisterUi.footer-height;
    background: #241a20ee;
    border-width: MisterUi.border;
    border-color: #ffd166;

    HorizontalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;

        Text {
            font-family: MisterUi.crt-font-family;
            text: "COMPATIBILITY DISPLAY";
            color: #ffd166;
            font-size: MisterUi.body-font;
        }

        Text {
            font-family: MisterUi.crt-font-family;
            text: MisterBridge.compatibility-reason;
            color: CrtTheme.text;
            font-size: MisterUi.body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

export component CatalogScanPopup inherits Rectangle {
    property <length> scan-osd-width: 0px;
    property <length> scan-horizontal-padding: MisterUi.grid-x;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px
        ? scan-content-width
        : 560px;

    background: CrtTheme.background;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: MisterUi.grid-y;
            padding-bottom: MisterUi.grid-y;
            spacing: MisterUi.grid-y;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Text {
            font-family: MisterUi.crt-font-family;
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: CrtTheme.accent;
                font-size: MisterUi.heading-font;
                horizontal-alignment: center;
            }

            Text {
            font-family: MisterUi.crt-font-family;
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-message;
                color: CrtTheme.text;
                font-size: MisterUi.body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
            font-family: MisterUi.crt-font-family;
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-title;
                color: #d7eef8;
                font-size: MisterUi.body-font;
                horizontal-alignment: center;
            }

            Text {
            font-family: MisterUi.crt-font-family;
                width: root.scan-content-width;
                text: MisterBridge.catalog-scan-detail;
                color: CrtTheme.muted;
                font-size: MisterUi.body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if MisterBridge.media-pack-progresses.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px;

                Text {
            font-family: MisterUi.crt-font-family;
                    text: MisterBridge.media-pack-summary;
                    color: #d7eef8;
                    font-size: MisterUi.body-font;
                    horizontal-alignment: center;
                }

                for pack in MisterBridge.media-pack-progresses: CrtProgressRow {
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {

    width: min(560px, MisterUi.content-width - 16px);
    height: min(100px, MisterUi.content-height - 16px);
    x: MisterUi.content-width / 2 - self.width / 2;
    y: MisterUi.content-height - self.height - MisterUi.grid-y;
    background: CrtTheme.panel;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        Text {
            font-family: MisterUi.crt-font-family;
            text: MisterBridge.media-pack-summary;
            color: #d7eef8;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
        }

        for pack in MisterBridge.media-pack-progresses: CrtProgressRow {
            pack: pack;
        }
    }
}

export component StartupSplash inherits Rectangle {

    background: CrtTheme.background;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            font-family: MisterUi.crt-font-family;
            text: "MiSTer MagiK";
            color: CrtTheme.text;
            font-size: MisterUi.heading-font;
            horizontal-alignment: center;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {
    property <bool> dot-visible: Math.mod(floor(animation-tick() / 1ms / 500), 2) == 0;

    width: t.width + 20px;
    height: 28px;
    x: MisterUi.content-width - self.width - 18px;
    y: MisterUi.content-height - self.height - 16px;
    background: #101420;
    border-width: MisterUi.border;
    border-color: #52647d;


    t := HorizontalLayout {
        alignment: start;
        width: self.preferred-width;
        Text {
            font-family: MisterUi.crt-font-family;
            text: "Building library";
            color: #d7eef8;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            font-family: MisterUi.crt-font-family;
            text: ".";
            color: root.dot-visible ? #d7eef8 : transparent;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

    }
}

component CompactDialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;

    height: 32px;
    background: focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: 1px;
    border-color: focused ? CrtTheme.accent : CrtTheme.border;

    Text {
            font-family: MisterUi.crt-font-family;
        text: root.label;
        color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
        font-size: MisterUi.body-font;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ConfirmDialog inherits Rectangle {
    background: #000000b0;

    Rectangle {
        width: parent.width - 16px;
        height: min(160px, parent.height - 16px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: CrtTheme.panel;
        border-width: 1px;
        border-color: CrtTheme.accent;

        VerticalLayout {
            padding-left: MisterUi.grid-x;
            padding-right: MisterUi.grid-x;
            padding-top: MisterUi.grid-y;
            padding-bottom: MisterUi.grid-y;
            spacing: MisterUi.grid-y;

            Text {
            font-family: MisterUi.crt-font-family;
                text: MisterBridge.confirm-title;
                color: CrtTheme.accent;
                font-size: MisterUi.heading-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
            font-family: MisterUi.crt-font-family;
                text: MisterBridge.confirm-message;
                color: CrtTheme.text;
                font-size: MisterUi.body-font;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                height: 32px;
                spacing: MisterUi.grid-x;

                if MisterBridge.confirm-left-label != "" : CompactDialogButton {
                    label: MisterBridge.confirm-left-label;
                    focused: MisterBridge.confirm-selected == 0;
                }

                if MisterBridge.confirm-right-label != "" : CompactDialogButton {
                    label: MisterBridge.confirm-right-label;
                    focused: MisterBridge.confirm-selected == 1;
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            font-family: MisterUi.crt-font-family;
            text: MisterBridge.loading-message;
            color: CrtTheme.text;
            font-size: MisterUi.heading-font;
            horizontal-alignment: center;
        }

        Text {
            font-family: MisterUi.crt-font-family;
            text: MisterBridge.loading-detail != "" ? MisterBridge.loading-detail : "Please wait...";
            color: CrtTheme.muted;
            font-size: MisterUi.body-font;
            horizontal-alignment: center;
        }
    }
}
