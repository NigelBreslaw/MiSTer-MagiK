import { Spleen6x12, Spleen6x12Size } from "../components/spleen_6x12.slint";
import { Jersey25 } from "../components/jersey_25.slint";

import { MisterUi } from "../mister_window.slint";
import { CatalogView, DialogChoice, FeedbackView, MediaPackRow, MediaPackState, MediaView, OverlayView } from "../api.slint";
import { CrtTheme } from "../components/crt_ui.slint";

component CrtProgressRow inherits Rectangle {
    in property <MediaPackRow> pack;
    height: MisterUi.footer-height;
    background: CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: CrtTheme.border;

    HorizontalLayout {
        padding-left: MisterUi.grid-x;
        padding-right: MisterUi.grid-x;
        spacing: MisterUi.grid-x;
        cross-axis-alignment: center;
        Spleen6x12 {
            text: root.pack.system + "  " + root.pack.phase-label;
            color: CrtTheme.text;
            size: MisterUi.crt-body-font;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Spleen6x12 {
            text: root.pack.state == MediaPackState.queued ? "..." : root.pack.percent + "%";
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font;
        }
    }
}

export component CatalogScanPopup inherits Rectangle {
    property <length> scan-osd-width: 0px;
    property <length> scan-horizontal-padding: MisterUi.grid-x;
    property <length> scan-column-width: root.width > scan-osd-width
        ? root.width - scan-osd-width
        : 0px;
    property <length> scan-content-width: scan-column-width > scan-horizontal-padding * 2
        ? scan-column-width - scan-horizontal-padding * 2
        : 0px;
    property <length> scan-progress-width: scan-content-width < 560px
        ? scan-content-width
        : 560px;

    background: CrtTheme.background;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: root.scan-horizontal-padding;
            padding-right: root.scan-horizontal-padding;
            padding-top: MisterUi.grid-y;
            padding-bottom: MisterUi.grid-y;
            spacing: MisterUi.grid-y;
            alignment: center;
            cross-axis-alignment: center;

            Rectangle { vertical-stretch: 1; background: transparent; }

            Jersey25 {
                width: root.scan-content-width;
                text: "MiSTer MagiK";
                color: CrtTheme.accent;
                horizontal-alignment: center;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.message;
                color: CrtTheme.text;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.title;
                color: #d7eef8;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
            }

            Spleen6x12 {
                width: root.scan-content-width;
                text: CatalogView.detail;
                color: CrtTheme.muted;
                size: MisterUi.crt-body-font;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            if MediaView.rows.length > 0 : VerticalLayout {
                width: root.scan-progress-width;
                spacing: 5px;

                Spleen6x12 {
                    text: MediaView.summary;
                    color: #d7eef8;
                    size: MisterUi.crt-body-font;
                    horizontal-alignment: center;
                }

                for pack in MediaView.rows: CrtProgressRow {
                    pack: pack;
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

export component MediaProgressPopup inherits Rectangle {

    width: min(560px, MisterUi.content-width - 16px);
    height: min(100px, MisterUi.content-height - 16px);
    x: MisterUi.content-width / 2 - self.width / 2;
    y: MisterUi.content-height - self.height - MisterUi.grid-y;
    background: CrtTheme.panel;
    border-width: 1px;
    border-color: #5c4a72;
    clip: true;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 5px;

        Spleen6x12 {
            text: MediaView.summary;
            color: #d7eef8;
            size: MisterUi.crt-body-font;
            horizontal-alignment: center;
        }

        for pack in MediaView.rows: CrtProgressRow {
            pack: pack;
        }
    }
}

export component BackgroundScanBadge inherits Rectangle {

    width: t.width + 20px;
    height: 28px;
    x: MisterUi.content-width - self.width - 18px;
    y: MisterUi.content-height - self.height - 16px;
    background: #101420;
    border-width: MisterUi.border;
    border-color: #52647d;


    t := HorizontalLayout {
        alignment: start;
        width: self.preferred-width;
        Spleen6x12 {
            text: CatalogView.title == "" ? "Discovering systems" : CatalogView.title;
            color: #d7eef8;
            size: MisterUi.crt-body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component CompactDialogButton inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;

    height: 32px;
    background: focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: 1px;
    border-color: focused ? CrtTheme.accent : acknowledged ? #4e8f80 : CrtTheme.border;

    Spleen6x12 {
        text: root.label;
        color: root.focused ? CrtTheme.accent-text : CrtTheme.text;
        size: MisterUi.portrait-layout && MisterUi.window-width < 400
            ? Spleen6x12Size.px8
            : MisterUi.crt-body-font;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
}

export component ConfirmDialog inherits Rectangle {
    property <bool> narrow-portrait: MisterUi.portrait-layout && MisterUi.window-width < 400;
    background: #000000b0;

    Rectangle {
        width: parent.width - 16px;
        height: min(224px, parent.height - 16px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: CrtTheme.panel;
        border-width: 1px;
        border-color: CrtTheme.accent;

        VerticalLayout {
            padding-left: MisterUi.grid-x;
            padding-right: MisterUi.grid-x;
            padding-top: MisterUi.grid-y;
            padding-bottom: MisterUi.grid-y;
            spacing: MisterUi.grid-y;

            if !root.narrow-portrait : Jersey25 {
                text: OverlayView.confirmation-title;
                color: CrtTheme.accent;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.narrow-portrait : Spleen6x12 {
                text: OverlayView.confirmation-title;
                color: CrtTheme.accent;
                size: Spleen6x12Size.px8;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Spleen6x12 {
                text: OverlayView.confirmation-message;
                color: CrtTheme.text;
                size: root.narrow-portrait ? Spleen6x12Size.px8 : MisterUi.crt-body-font;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 1;
            }

            HorizontalLayout {
                height: 32px;
                spacing: MisterUi.grid-x;

                if OverlayView.cancel-label != "" : CompactDialogButton {
                    label: OverlayView.cancel-label;
                    focused: OverlayView.selected-choice == DialogChoice.cancel;
                    acknowledged: FeedbackView.acknowledged("", "left", FeedbackView.revision);
                }

                if OverlayView.confirm-label != "" : CompactDialogButton {
                    label: OverlayView.confirm-label;
                    focused: OverlayView.selected-choice == DialogChoice.confirm;
                    acknowledged: FeedbackView.acknowledged("", "right", FeedbackView.revision);
                }
            }
        }
    }
}

export component LoadingOverlay inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        if !MisterUi.portrait-layout : Jersey25 {
            text: OverlayView.loading-message;
            color: CrtTheme.text;
            horizontal-alignment: center;
        }
        if MisterUi.portrait-layout : Spleen6x12 {
            text: OverlayView.loading-message;
            color: CrtTheme.text;
            size: MisterUi.window-width < 400 ? Spleen6x12Size.px8 : Spleen6x12Size.px16;
            horizontal-alignment: center;
        }

        Spleen6x12 {
            text: OverlayView.loading-detail != "" ? OverlayView.loading-detail : "Please wait...";
            color: CrtTheme.muted;
            size: MisterUi.portrait-layout ? Spleen6x12Size.px8 : MisterUi.crt-body-font;
            horizontal-alignment: center;
        }
    }
}
