import { CatalogActivity, CatalogView, ConfirmationKind, LauncherScreen, LoadingState, MediaView, NavigationView, OverlayView, SettingsPopup, SettingsView, SetupPhase, SetupView } from "../api.slint";
import { ControllerPanel } from "../controller_panel.slint";
import { SetupOverlay } from "hdmi_setup.slint";
import { ArcadeListScreen } from "../views/hdmi/arcade_list.slint";
import { HomeGrid } from "../views/hdmi/home.slint";
import { SettingsScreen } from "../views/hdmi/settings.slint";
import { ScreensaverSettingsScreen } from "../views/hdmi/screensaver_settings.slint";
import { LicensesScreen } from "../views/hdmi/licenses.slint";
import { AboutScreen } from "../views/hdmi/about.slint";
import { InfoScreen } from "../views/hdmi/info.slint";
import { SystemHubScreen } from "../views/hdmi/system_hub.slint";
import { ComboBoxOverlay } from "../components/combo_box.slint";
import {
    BackgroundScanBadge,
    CatalogScanPopup,
    ConfirmDialog,
    LoadingOverlay,
    MediaProgressPopup,
    StartupSplash,
} from "hdmi_overlays.slint";

export component HdmiLauncherUi inherits Rectangle {

    if NavigationView.screen == LauncherScreen.home : HomeGrid { }
    if NavigationView.screen == LauncherScreen.controller : ControllerPanel { width: 100%; height: 100%; }
    if NavigationView.screen == LauncherScreen.arcade : ArcadeListScreen { }
    if NavigationView.screen == LauncherScreen.settings : SettingsScreen { }
    if NavigationView.screen == LauncherScreen.about : AboutScreen { }
    if NavigationView.screen == LauncherScreen.licenses : LicensesScreen { }
    if NavigationView.screen == LauncherScreen.info : InfoScreen { }
    if NavigationView.screen == LauncherScreen.screensaver-settings : ScreensaverSettingsScreen { }
    if NavigationView.screen == LauncherScreen.system-hub : SystemHubScreen { }

    if CatalogView.background-activity-visible : BackgroundScanBadge { }
    if SetupView.phase != SetupPhase.none : SetupOverlay { }
    if CatalogView.activity != CatalogActivity.foreground && MediaView.rows.length > 0 : MediaProgressPopup {
    }
    if CatalogView.activity == CatalogActivity.foreground : CatalogScanPopup { }
    if OverlayView.confirmation-kind != ConfirmationKind.none : ConfirmDialog { }
    if SettingsView.popup != SettingsPopup.none : ComboBoxOverlay { }
    if OverlayView.loading-state == LoadingState.active : LoadingOverlay { }
    if OverlayView.startup-state == LoadingState.active : StartupSplash { }
}
