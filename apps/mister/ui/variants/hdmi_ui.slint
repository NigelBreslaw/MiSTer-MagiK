import { MisterBridge } from "../api.slint";
import { ControllerPanel } from "../controller_panel.slint";
import { SetupOverlay } from "hdmi_setup.slint";
import { ArcadeListScreen } from "../views/hdmi/arcade_list.slint";
import { HomeGrid } from "../views/hdmi/home.slint";
import { SettingsScreen } from "../views/hdmi/settings.slint";
import { ScreensaverSettingsScreen } from "../views/hdmi/screensaver_settings.slint";
import { LicensesScreen } from "../views/hdmi/licenses.slint";
import { AboutScreen } from "../views/hdmi/about.slint";
import { InfoScreen } from "../views/hdmi/info.slint";
import { SystemHubScreen } from "../views/hdmi/system_hub.slint";
import { ComboBoxOverlay } from "../components/combo_box.slint";
import {
    BackgroundScanBadge,
    CatalogScanPopup,
    ConfirmDialog,
    LoadingOverlay,
    MediaProgressPopup,
    StartupSplash,
} from "hdmi_overlays.slint";

export component HdmiLauncherUi inherits Rectangle {

    if MisterBridge.screen-mode == 0 : HomeGrid { }
    if MisterBridge.screen-mode == 1 : ControllerPanel { width: 100%; height: 100%; }
    if MisterBridge.screen-mode == 2 : ArcadeListScreen { }
    if MisterBridge.screen-mode == 3 : SettingsScreen { }
    if MisterBridge.screen-mode == 4 : AboutScreen { }
    if MisterBridge.screen-mode == 5 : LicensesScreen { }
    if MisterBridge.screen-mode == 6 : InfoScreen { }
    if MisterBridge.screen-mode == 7 : ScreensaverSettingsScreen { }
    if MisterBridge.screen-mode == 8 : SystemHubScreen { }

    if MisterBridge.catalog-background-scan-visible : BackgroundScanBadge { }
    if MisterBridge.setup-visible : SetupOverlay {
        phase: MisterBridge.setup-phase;
        title: MisterBridge.setup-title;
        subtitle: MisterBridge.setup-subtitle;
        list-items: MisterBridge.setup-list;
        list-selected: MisterBridge.setup-selected;
        config-labels: MisterBridge.setup-config-labels;
        config-values: MisterBridge.setup-config-values;
        setup-name: MisterBridge.setup-name;
        setup-kind-label: MisterBridge.setup-kind-label;
    }
    if !MisterBridge.catalog-scan-visible && MisterBridge.media-pack-progresses.length > 0 : MediaProgressPopup {
    }
    if MisterBridge.catalog-scan-visible : CatalogScanPopup { }
    if MisterBridge.confirm-visible : ConfirmDialog { }
    if MisterBridge.display-combo-open || MisterBridge.orientation-combo-open : ComboBoxOverlay { }
    if MisterBridge.loading-message != "" : LoadingOverlay { }
    if MisterBridge.startup-visible : StartupSplash { }
}
