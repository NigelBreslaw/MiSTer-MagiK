import { Start2P, Start2PSize } from "../components/start2p.slint";
import { Nocive15, Nocive15Size } from "../components/nocive_15.slint";
import { MisterWindow, MisterUi } from "../mister_window.slint";
export { MisterUi }
export { Start2PSize }
import "../fonts/PressStart2P-Regular.ttf";

export component EffectHud inherits MisterWindow {
    default-font-family: "Press Start 2P";

    in property <string> effect-name: "effect";
    in property <string> mode-label: "raw";
    in property <string> fps-label: "fps --";
    in property <string> timing-label: "--";
    in property <int> frame-phase: 0;


    Rectangle {
        x: 24px;
        y: 22px;
        width: 620px;
        height: 112px;
        background: #07101f;
        border-color: #5df2ff;
        border-width: 2px;
    }

    Start2P {
        x: 44px;
        y: 40px;
        text: "MiSTer MagiK FX";
        size: Start2PSize.px24;
        color: #fff2a8;
    }

    Nocive15 {
        x: 44px;
        y: 76px;
        text: root.effect-name + " / " + root.mode-label;
        size: Nocive15Size.px15;
        color: #e8ecff;
    }

    Nocive15 {
        x: 44px;
        y: 104px;
        text: root.fps-label + "  " + root.timing-label;
        size: Nocive15Size.px15;
        color: #8fffd2;
    }

    for bar[i] in 16: Rectangle {
        x: (700px + i * 34px);
        y: 44px;
        width: 20px;
        height: (24px + Math.mod(i + root.frame-phase, 8) * 8px);
        background: Math.mod(i, 3) == 0 ? #ff5d73 : Math.mod(i, 3) == 1 ? #5df2ff : #fff06a;
    }
}
