import { MisterBridge } from "../api.slint";

component AboutRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;

    height: 52px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : #5c4a72;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Text { text: label; color: focused ? #06d6a0 : #e8e0f0; font-size: 16px; }
        Text { text: detail; color: #9080a8; font-size: 8px; }
    }
}

export component AboutScreen inherits Rectangle {
    background: #0b0d14;
    VerticalLayout {
        padding: 48px;
        spacing: 24px;
        Text {
            text: "About";
            color: #06d6a0;
            font-size: 24px;
            horizontal-alignment: center;
        }
        Text {
            text: "MiSTer MagiK is an Unintuitive.com software production. Crafted with love in Finland by Nigel Breslaw.";
            color: #e8e0f0;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Text {
            text: "Thanks to the MiSTer project for making all of this possible";
            color: #b8acc8;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Text {
            text: "Made with Slint. Delivering beautiful UI's on the most challenging of hardware www.slint.dev";
            color: #70e1f5;
            font-size: 16px;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { vertical-stretch: 1; background: transparent; }

        AboutRow {
            label: "Info";
            detail: "Build, display, database, and kernel details";
            focused: MisterBridge.about-selected == 0;
        }
        AboutRow {
            label: "Licenses";
            detail: "Open source licenses and acknowledgements";
            focused: MisterBridge.about-selected == 1;
        }

        Text { text: "B: back"; color: #6f8198; font-size: 8px; horizontal-alignment: center; }
    }

}
