import { MisterUi } from "../../mister_window.slint";
import { InputView } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component CrtControllerPanel inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: "Controller"; subtitle: "Input test"; status: ""; }
        if !MisterUi.portrait-layout : VerticalLayout {
            spacing: MisterUi.grid-y;
            vertical-stretch: 1;
            CrtMenuRow { vertical-stretch: 1; label: "Device"; detail: InputView.device-name; focused: false; }
            CrtMenuRow { vertical-stretch: 1; label: "USB"; detail: InputView.usb-port; focused: false; }
            CrtMenuRow { vertical-stretch: 1; label: "Pressed"; detail: InputView.pressed-now; focused: InputView.pressed-now != ""; }
            CrtMenuRow { vertical-stretch: 1; label: "Last event"; detail: InputView.last-event-label; focused: false; }
        }
        if MisterUi.portrait-layout : VerticalLayout {
            spacing: MisterUi.grid-y;
            vertical-stretch: 1;
            CrtMenuRow { vertical-stretch: 1; label: "Device"; detail: InputView.device-name; focused: false; }
            CrtMenuRow { vertical-stretch: 1; label: "D-pad"; detail: (InputView.dpad-up ? "U " : "") + (InputView.dpad-down ? "D " : "") + (InputView.dpad-left ? "L " : "") + (InputView.dpad-right ? "R" : ""); focused: InputView.dpad-up || InputView.dpad-down || InputView.dpad-left || InputView.dpad-right; }
            CrtMenuRow { vertical-stretch: 1; label: "Face"; detail: (InputView.button-a ? "A " : "") + (InputView.button-b ? "B " : "") + (InputView.button-x ? "X " : "") + (InputView.button-y ? "Y" : ""); focused: InputView.button-a || InputView.button-b || InputView.button-x || InputView.button-y; }
            CrtMenuRow { vertical-stretch: 1; label: "Shoulders"; detail: (InputView.button-l ? "L " : "") + (InputView.button-r ? "R " : "") + (InputView.button-zl ? "ZL " : "") + (InputView.button-zr ? "ZR" : ""); focused: InputView.button-l || InputView.button-r || InputView.button-zl || InputView.button-zr; }
            CrtMenuRow { vertical-stretch: 1; label: "Left stick"; detail: round(InputView.left-x * 100) + "," + round(InputView.left-y * 100); focused: false; }
            CrtMenuRow { vertical-stretch: 1; label: "Right stick"; detail: round(InputView.right-x * 100) + "," + round(InputView.right-y * 100); focused: false; }
            CrtMenuRow { vertical-stretch: 1; label: "Pressed"; detail: InputView.pressed-now; focused: InputView.pressed-now != ""; }
            CrtMenuRow { vertical-stretch: 1; label: "Last event"; detail: InputView.last-event-label; focused: false; }
        }
        CrtFooter { left-hint: "Test controls"; right-hint: "B Back   HOME Launcher"; }
    }
}
