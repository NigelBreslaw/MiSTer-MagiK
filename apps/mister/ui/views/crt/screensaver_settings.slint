import { MisterUi } from "../../mister_window.slint";
import { FeedbackView, ScreensaverSetting, SettingsView } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component ScreensaverSettingsScreen inherits Rectangle {
    accessible-role: main;
    accessible-label: "Screensaver settings";
    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: "Screensaver"; subtitle: ""; status: ""; }
        CrtMenuRow {
            vertical-stretch: 1;
            label: "Enabled";
            detail: SettingsView.screensaver-enabled ? "Yes" : "No";
            focused: SettingsView.screensaver-setting == ScreensaverSetting.enabled;
            acknowledged: FeedbackView.acknowledged("screensaver-settings", "enabled", FeedbackView.revision);
        }
        CrtMenuRow {
            vertical-stretch: 1;
            label: "Start after";
            detail: SettingsView.screensaver-delay-minutes == 1
                ? "1 minute" : SettingsView.screensaver-delay-minutes + " minutes";
            focused: SettingsView.screensaver-setting == ScreensaverSetting.delay;
            acknowledged: FeedbackView.acknowledged("screensaver-settings", "delay", FeedbackView.revision);
            enabled: SettingsView.screensaver-enabled;
        }
        CrtMenuRow {
            vertical-stretch: 1;
            label: "Preview";
            detail: "Show now";
            focused: SettingsView.screensaver-setting == ScreensaverSetting.preview;
            acknowledged: FeedbackView.acknowledged("screensaver-settings", "preview", FeedbackView.revision);
        }
        CrtFooter { left-hint: "A Change   B Back"; right-hint: "HOME Launcher"; }
    }
}
