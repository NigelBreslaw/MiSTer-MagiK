import { Spleen6x12 } from "../../components/spleen_6x12.slint";
import { Jersey25 } from "../../components/jersey_25.slint";
import { SettingsView } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { CrtTheme, CrtHeader, CrtFooter } from "../../components/crt_ui.slint";

export component LicenseTextScreen inherits Rectangle {
    accessible-role: main;
    accessible-label: "License text";
    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;
        CrtHeader {
            title: SettingsView.license-titles[SettingsView.selected-license-index];
            subtitle: SettingsView.license-kinds[SettingsView.selected-license-index];
            status: "";
        }
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            for line[index] in SettingsView.license-lines : Spleen6x12 {
                y: index * MisterUi.body-font - SettingsView.license-scroll-y * 1px;
                width: parent.width;
                height: MisterUi.body-font;
                text: line;
                color: CrtTheme.text;
                size: MisterUi.crt-body-font;
                overflow: clip;
                vertical-alignment: top;
            }
        }
        CrtFooter { left-hint: "UP/DOWN Scroll"; right-hint: "A/B Back"; }
    }
}
