import { CrtLauncherText, CrtPageMetrics } from "../../components/crt_page_chrome.slint";
import { MisterUi } from "../../mister_window.slint";
import { PageTheme } from "../../components/page_chrome.slint";
import { NavigationView, SystemHubSection, DeviceKind, ArcadeView } from "../../api.slint";

export component SystemHubScreen inherits Rectangle {
    background: transparent;
    accessible-role: main;
    accessible-label: NavigationView.system-title;
    CrtLauncherText {
        x: CrtPageMetrics.px-x(MisterUi.window-width - CrtPageMetrics.margin-x) - self.preferred-width;
        y: CrtPageMetrics.px-y(CrtPageMetrics.header-bottom + 8);
        text: NavigationView.system-subtitle; text-color: PageTheme.muted;
    }
    CrtLauncherText {
        x: CrtPageMetrics.px-x(CrtPageMetrics.margin-x);
        y: CrtPageMetrics.px-y(CrtPageMetrics.header-bottom + 8);
        text: NavigationView.system-title.character-count > 26 ? ArcadeView.collection-title : NavigationView.system-title; text-color: PageTheme.cream;
    }
    for i in 3 : Rectangle {
        x: CrtPageMetrics.px-x(CrtPageMetrics.margin-x);
        y: CrtPageMetrics.px-y(CrtPageMetrics.header-bottom + 26 * CrtPageMetrics.sy + i * 16 * CrtPageMetrics.sy);
        width: (MisterUi.window-width - 2 * CrtPageMetrics.margin-x) * 1px; height: CrtPageMetrics.len-y(16);
        property <bool> focused: i == (NavigationView.system-hub-section == SystemHubSection.games ? 0 : NavigationView.system-hub-section == SystemHubSection.recent ? 1 : 2);
        property <color> accent: NavigationView.system-device == DeviceKind.monitor ? #e6c23a
            : NavigationView.system-device == DeviceKind.handheld ? #35c48f : NavigationView.system-device == DeviceKind.cabinet ? #e7695a : #5a71e7;
        background: self.focused ? @linear-gradient(90deg, self.accent.with-alpha(0.6) 0%, self.accent.with-alpha(0.24) 60%, transparent 100%) : transparent;
        if self.focused : Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: parent.accent; }
        accessible-role: list-item;
        accessible-label: i == 0 ? "GAMES" : i == 1 ? "RECENT" : "FAVOURITES";
        accessible-item-selected: self.focused;
        CrtLauncherText {
            x: 8px; y: CrtPageMetrics.len-y(2);
            text: i == 0 ? "GAMES" : i == 1 ? "RECENT" : "FAVOURITES";
            text-color: parent.focused ? parent.accent : PageTheme.cream;
        }
        CrtLauncherText {
            x: parent.width - self.preferred-width - 24px; y: CrtPageMetrics.len-y(2);
            text: i == 0 ? NavigationView.system-hub-games-count + " TITLES" : i == 1 ? NavigationView.system-hub-recent-count + " PLAYED" : NavigationView.system-hub-favourites-count + " SAVED";
            text-color: parent.focused ? PageTheme.cream : PageTheme.muted;
        }
        CrtLauncherText {
            x: parent.width - self.preferred-width; y: CrtPageMetrics.len-y(2);
            text: ">";
            text-color: parent.focused ? parent.accent : PageTheme.muted;
        }
    }
}
