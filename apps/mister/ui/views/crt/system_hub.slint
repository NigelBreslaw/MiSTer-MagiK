import { AccessibleRole, FeedbackView, NavigationView, SystemHubSection } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { Spleen6x12 } from "../../components/spleen_6x12.slint";
import { CrtTheme, CrtFooter } from "../../components/crt_ui.slint";
import { Jersey25 } from "../../components/jersey_25.slint";

component HubCard inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> enabled: true;
    accessible-role: AccessibleRole.list-item;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-enabled: root.enabled;
    accessible-item-selectable: true;
    accessible-item-selected: root.focused;
    background: focused ? CrtTheme.panel-alt : CrtTheme.panel;
    border-width: focused ? MisterUi.border * 2 : MisterUi.border;
    border-color: focused ? CrtTheme.accent : acknowledged ? #4e8f80 : CrtTheme.border;
    Spleen6x12 { x: MisterUi.grid-x; y: MisterUi.grid-y; width: 32px; text: root.glyph; color: root.focused ? CrtTheme.accent : CrtTheme.muted; size: MisterUi.crt-heading-font; horizontal-alignment: center; }
    Jersey25 { x: 48px; y: MisterUi.grid-y; width: parent.width - 56px; text: root.label; color: root.enabled ? (root.focused ? CrtTheme.accent : CrtTheme.text) : CrtTheme.muted; }
    Rectangle { x: MisterUi.grid-x; y: parent.height / 2 + 4px; width: parent.width - MisterUi.grid-x * 2; height: MisterUi.border; background: root.focused ? CrtTheme.accent : CrtTheme.border; }
    Spleen6x12 { x: MisterUi.grid-x; y: parent.height - 24px; width: parent.width - MisterUi.grid-x * 2; text: root.detail; color: CrtTheme.muted; size: MisterUi.crt-body-font; horizontal-alignment: center; }
}

export component SystemHubScreen inherits Rectangle {
    background: CrtTheme.background;
    property <length> card-width: (root.width - MisterUi.grid-x * 5) / 2;
    property <length> card-height: (root.height - 150px - MisterUi.footer-height - MisterUi.grid-y * 3) / 2;
    Jersey25 { x: MisterUi.grid-x * 2; y: 0px; width: 300px; height: 41px; text: "SUPER NINTENDO"; color: CrtTheme.text; }
    Spleen6x12 { x: MisterUi.grid-x * 2; y: 50px; text: "1990 / 16-BIT CONSOLE"; size: MisterUi.crt-body-font; color: CrtTheme.warning; }
    Image { x: parent.width - 185px - MisterUi.grid-x * 2; y: MisterUi.grid-y; visible: NavigationView.system-artwork-available; source: NavigationView.system-artwork; width: 185px; height: 82px; }
    HubCard { x: MisterUi.grid-x * 2; y: 104px; width: card-width; height: card-height; glyph: "+"; label: "GAMES"; detail: NavigationView.system-hub-games-count + " TITLES"; focused: NavigationView.system-hub-section == SystemHubSection.games; acknowledged: FeedbackView.acknowledged("system-hub", "games", FeedbackView.revision); }
    HubCard { x: MisterUi.grid-x * 3 + card-width; y: 104px; width: card-width; height: card-height; glyph: "@"; label: "RECENT"; detail: NavigationView.system-hub-recent-count + " PLAYED"; focused: NavigationView.system-hub-section == SystemHubSection.recent; acknowledged: FeedbackView.acknowledged("system-hub", "recent", FeedbackView.revision); }
    HubCard { x: MisterUi.grid-x * 2; y: 104px + card-height + MisterUi.grid-y; width: card-width; height: card-height; glyph: "*"; label: "FAVORITES"; detail: NavigationView.system-hub-favourites-count + " SAVED"; focused: NavigationView.system-hub-section == SystemHubSection.favourites; acknowledged: FeedbackView.acknowledged("system-hub", "favorites", FeedbackView.revision); }
    HubCard { x: MisterUi.grid-x * 3 + card-width; y: 104px + card-height + MisterUi.grid-y; width: card-width; height: card-height; glyph: "i"; label: "INFO"; detail: "COMING SOON"; enabled: false; focused: NavigationView.system-hub-section == SystemHubSection.information; acknowledged: FeedbackView.acknowledged("system-hub", "info", FeedbackView.revision); }
    CrtFooter { x: MisterUi.grid-x * 2; y: parent.height - MisterUi.footer-height - MisterUi.grid-y; width: parent.width - MisterUi.grid-x * 4; left-hint: "A Open   B Back"; right-hint: "HOME Launcher"; }
}
