import { MisterBridge } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { Start2P, Start2PSize } from "../../components/start2p.slint";
import { CrtTheme, CrtFooter } from "../../components/crt_ui.slint";
import { Jersey25 } from "../../components/jersey_25.slint";

component HubCard inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> enabled: true;
    background: focused ? CrtTheme.panel-alt : CrtTheme.panel;
    border-width: focused ? MisterUi.border * 2 : MisterUi.border;
    border-color: focused ? CrtTheme.accent : acknowledged ? #4e8f80 : CrtTheme.border;
    Start2P { x: MisterUi.grid-x; y: MisterUi.grid-y; width: 32px; text: root.glyph; color: root.focused ? CrtTheme.accent : CrtTheme.muted; size: MisterUi.crt-heading-font; horizontal-alignment: center; }
    Start2P { x: 48px; y: MisterUi.grid-y; width: parent.width - 56px; text: root.label; color: root.enabled ? (root.focused ? CrtTheme.accent : CrtTheme.text) : CrtTheme.muted; size: MisterUi.crt-heading-font; }
    Rectangle { x: MisterUi.grid-x; y: parent.height / 2 + 4px; width: parent.width - MisterUi.grid-x * 2; height: MisterUi.border; background: root.focused ? CrtTheme.accent : CrtTheme.border; }
    Start2P { x: MisterUi.grid-x; y: parent.height - 24px; width: parent.width - MisterUi.grid-x * 2; text: root.detail; color: CrtTheme.muted; size: MisterUi.crt-body-font; horizontal-alignment: center; }
}

export component SystemHubScreen inherits Rectangle {
    background: CrtTheme.background;
    property <length> card-width: (root.width - MisterUi.grid-x * 5) / 2;
    property <length> card-height: (root.height - 150px - MisterUi.footer-height - MisterUi.grid-y * 3) / 2;
    Jersey25 { x: MisterUi.grid-x * 2; y: 0px; width: 300px; height: 41px; text: "SUPER NINTENDO"; color: CrtTheme.text; }
    Start2P { x: MisterUi.grid-x * 2; y: 50px; text: "1990 / 16-BIT CONSOLE"; size: MisterUi.crt-body-font; color: CrtTheme.warning; }
    Image { x: parent.width - 185px - MisterUi.grid-x * 2; y: MisterUi.grid-y; visible: MisterBridge.snes-artwork-visible; source: MisterBridge.snes-artwork; width: 185px; height: 82px; }
    HubCard { x: MisterUi.grid-x * 2; y: 104px; width: card-width; height: card-height; glyph: "+"; label: "GAMES"; detail: MisterBridge.system-hub-games-count + " TITLES"; focused: MisterBridge.system-hub-selected == 0; acknowledged: MisterBridge.selection-feedback-query("system-hub", "games", MisterBridge.selection-feedback-revision); }
    HubCard { x: MisterUi.grid-x * 3 + card-width; y: 104px; width: card-width; height: card-height; glyph: "@"; label: "RECENT"; detail: MisterBridge.system-hub-recent-count + " PLAYED"; focused: MisterBridge.system-hub-selected == 1; acknowledged: MisterBridge.selection-feedback-query("system-hub", "recent", MisterBridge.selection-feedback-revision); }
    HubCard { x: MisterUi.grid-x * 2; y: 104px + card-height + MisterUi.grid-y; width: card-width; height: card-height; glyph: "*"; label: "FAVORITES"; detail: MisterBridge.system-hub-favourites-count + " SAVED"; focused: MisterBridge.system-hub-selected == 2; acknowledged: MisterBridge.selection-feedback-query("system-hub", "favorites", MisterBridge.selection-feedback-revision); }
    HubCard { x: MisterUi.grid-x * 3 + card-width; y: 104px + card-height + MisterUi.grid-y; width: card-width; height: card-height; glyph: "i"; label: "INFO"; detail: "COMING SOON"; enabled: false; focused: MisterBridge.system-hub-selected == 3; acknowledged: MisterBridge.selection-feedback-query("system-hub", "info", MisterBridge.selection-feedback-revision); }
    CrtFooter { x: MisterUi.grid-x * 2; y: parent.height - MisterUi.footer-height - MisterUi.grid-y; width: parent.width - MisterUi.grid-x * 4; left-hint: "A Open   B Back"; right-hint: "HOME Launcher"; }
}
