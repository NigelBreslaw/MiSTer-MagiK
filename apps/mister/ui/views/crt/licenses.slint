import { Spleen6x12 } from "../../components/spleen_6x12.slint";
import { Jersey25 } from "../../components/jersey_25.slint";

import { MisterBridge } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";
import { ListView } from "std-widgets.slint";

export component LicensesScreen inherits Rectangle {
    background: CrtTheme.background;

    if !MisterBridge.licenses-expanded : VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;
        CrtHeader { title: "Licenses"; subtitle: "Open source software"; status: ""; }
        CrtMenuRow { label: "MiSTer MagiK"; detail: ">"; focused: MisterBridge.licenses-selected == 0; acknowledged: MisterBridge.selection-feedback-query("licenses", "mister-magik", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "FFmpeg"; detail: ">"; focused: MisterBridge.licenses-selected == 1; acknowledged: MisterBridge.selection-feedback-query("licenses", "ffmpeg", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Press Start 2P"; detail: ">"; focused: MisterBridge.licenses-selected == 2; acknowledged: MisterBridge.selection-feedback-query("licenses", "press-start-2p", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Commercial Fonts"; detail: ">"; focused: MisterBridge.licenses-selected == 3; acknowledged: MisterBridge.selection-feedback-query("licenses", "commercial-fonts", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Jersey 25"; detail: ">"; focused: MisterBridge.licenses-selected == 4; acknowledged: MisterBridge.selection-feedback-query("licenses", "jersey-25", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Terminus Font"; detail: ">"; focused: MisterBridge.licenses-selected == 5; acknowledged: MisterBridge.selection-feedback-query("licenses", "terminus-font", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Spleen"; detail: ">"; focused: MisterBridge.licenses-selected == 6; acknowledged: MisterBridge.selection-feedback-query("licenses", "spleen", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Arcade Cabinet"; detail: ">"; focused: MisterBridge.licenses-selected == 7; acknowledged: MisterBridge.selection-feedback-query("licenses", "arcade-cabinet", MisterBridge.selection-feedback-revision); }
        CrtMenuRow { label: "Slint"; detail: ">"; focused: MisterBridge.licenses-selected == 8; acknowledged: MisterBridge.selection-feedback-query("licenses", "slint", MisterBridge.selection-feedback-revision); }
        CrtFooter { left-hint: "A Open   B Back"; right-hint: "HOME Launcher"; }
    }

    if MisterBridge.licenses-expanded : VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;
        Jersey25 {
            text: MisterBridge.licenses-selected == 0 ? "MiSTer MagiK  v" :
                  MisterBridge.licenses-selected == 1 ? "FFmpeg  v" :
                  MisterBridge.licenses-selected == 2 ? "Press Start 2P  v" :
                  MisterBridge.licenses-selected == 3 ? "Commercial Fonts  v" :
                  MisterBridge.licenses-selected == 4 ? "Jersey 25  v" :
                  MisterBridge.licenses-selected == 5 ? "Terminus Font  v" :
                  MisterBridge.licenses-selected == 6 ? "Spleen  v" :
                  MisterBridge.licenses-selected == 7 ? "Arcade Cabinet  v" : "Slint  v";
            color: CrtTheme.accent;
            horizontal-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
            background: CrtTheme.panel;
            border-width: MisterUi.border;
            border-color: CrtTheme.border;
            ListView {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                viewport-y: -MisterBridge.licenses-scroll-y * 1px;
                for line in MisterBridge.license-lines : Spleen6x12 {
                    text: line;
                    color: CrtTheme.text;
                    size: MisterUi.crt-body-font;
                    height: MisterUi.body-font;
                    overflow: clip;
                    vertical-alignment: top;
                }
            }
        }
        CrtFooter { left-hint: "UP/DOWN Scroll"; right-hint: "A/B Close"; }
    }
}
