import { PixelText8, PixelTextSize } from "../../components/pixel_text_8.slint";

import { MisterBridge } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";
import { ListView } from "std-widgets.slint";

export component LicensesScreen inherits Rectangle {
    background: CrtTheme.background;

    if !MisterBridge.licenses-expanded : VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;
        CrtHeader { title: "Licenses"; subtitle: "Open source software"; status: ""; }
        CrtMenuRow { label: "MiSTer MagiK"; detail: ">"; focused: MisterBridge.licenses-selected == 0; }
        CrtMenuRow { label: "FFmpeg"; detail: ">"; focused: MisterBridge.licenses-selected == 1; }
        CrtMenuRow { label: "Press Start 2P"; detail: ">"; focused: MisterBridge.licenses-selected == 2; }
        CrtMenuRow { label: "Jersey 10"; detail: ">"; focused: MisterBridge.licenses-selected == 3; }
        CrtMenuRow { label: "Jersey 25"; detail: ">"; focused: MisterBridge.licenses-selected == 4; }
        CrtMenuRow { label: "Arcade Cabinet"; detail: ">"; focused: MisterBridge.licenses-selected == 5; }
        CrtMenuRow { label: "Slint"; detail: ">"; focused: MisterBridge.licenses-selected == 6; }
        CrtFooter { left-hint: "A Open   B Back"; right-hint: "HOME Launcher"; }
    }

    if MisterBridge.licenses-expanded : VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;
        PixelText8 {
            text: MisterBridge.licenses-selected == 0 ? "MiSTer MagiK  v" :
                  MisterBridge.licenses-selected == 1 ? "FFmpeg  v" :
                  MisterBridge.licenses-selected == 2 ? "Press Start 2P  v" :
                  MisterBridge.licenses-selected == 3 ? "Jersey 10  v" :
                  MisterBridge.licenses-selected == 4 ? "Jersey 25  v" :
                  MisterBridge.licenses-selected == 5 ? "Arcade Cabinet  v" : "Slint  v";
            color: CrtTheme.accent;
            size: MisterUi.crt-heading-font;
            horizontal-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
            background: CrtTheme.panel;
            border-width: MisterUi.border;
            border-color: CrtTheme.border;
            ListView {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                viewport-y: -MisterBridge.licenses-scroll-y * 1px;
                for line in MisterBridge.license-lines : PixelText8 {
                    text: line;
                    color: CrtTheme.text;
                    size: MisterUi.crt-body-font;
                    height: MisterUi.body-font;
                    overflow: clip;
                    vertical-alignment: top;
                }
            }
        }
        CrtFooter { left-hint: "UP/DOWN Scroll"; right-hint: "A/B Close"; }
    }
}
