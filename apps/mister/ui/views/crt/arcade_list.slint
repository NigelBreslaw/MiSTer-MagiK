import { CrtLauncherText, CrtPageChrome, CrtPageMetrics } from "../../components/crt_page_chrome.slint";
import { PageTheme } from "../../components/page_chrome.slint";
import { MisterUi } from "../../mister_window.slint";
import { ArcadeLoadState, ArcadeSearchMode, ArcadeSearchPane, ArcadeSearchStatus, ArcadeView, NavigationView, SystemPageMode, FeedbackView, LauncherLayout } from "../../api.slint";

component SearchKey inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> keyboard-focused;
    in property <bool> acknowledged;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: "Search keyboard key";
    accessible-item-selected: root.selected;
    accessible-enabled: true;
    background: root.selected && root.keyboard-focused ? #3a1511 : #0b0b0d;
    border-width: 1px;
    border-color: root.selected && root.keyboard-focused ? #e7695a
        : root.acknowledged ? #744038 : PageTheme.rule;
    CrtLauncherText {
        text: root.label;
        text-color: root.selected && root.keyboard-focused ? #ffffff : PageTheme.cream;
        x: (parent.width - self.preferred-width) / 2;
        y: (parent.height - self.preferred-height) / 2;
    }
}

component SearchKeyboardRow inherits Rectangle {
    in property <int> start-index;
    in property <int> key-count;
    height: CrtPageMetrics.len-y(16);
    HorizontalLayout {
        spacing: CrtPageMetrics.len-x(2);
        for key-offset in root.key-count : SearchKey {
            horizontal-stretch: 1;
            label: ArcadeView.search-keys[root.start-index + key-offset];
            selected: ArcadeView.selected-search-key-index == root.start-index + key-offset;
            keyboard-focused: ArcadeView.search-pane == ArcadeSearchPane.keyboard;
            acknowledged: FeedbackView.acknowledged("", "key:" + (root.start-index + key-offset), FeedbackView.revision);
        }
    }
}

component SearchKeyboard inherits Rectangle {
    accessible-role: region;
    accessible-label: "Search keyboard";
    accessible-description: "Use the keyboard to enter an arcade search";
    accessible-enabled: true;
    background: transparent;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: CrtPageMetrics.len-y(16);
        background: #0b0b0d;
        border-width: 1px;
        border-color: ArcadeView.search-pane == ArcadeSearchPane.keyboard ? #e7695a : PageTheme.rule;
        accessible-role: text-input;
        accessible-label: "Search query";
        accessible-value: ArcadeView.search-query;
        accessible-enabled: true;
        CrtLauncherText {
            x: CrtPageMetrics.len-x(4); y: CrtPageMetrics.len-y(2);
            text: ArcadeView.search-query == "" ? "_" : ArcadeView.search-query + "_";
            text-color: ArcadeView.search-query == "" ? PageTheme.muted : PageTheme.cream;
        }
    }
    VerticalLayout {
        x: 0px; y: CrtPageMetrics.len-y(18); width: parent.width;
        height: parent.height - self.y;
        spacing: CrtPageMetrics.len-y(2);
        SearchKeyboardRow { start-index: 0; key-count: 8; }
        SearchKeyboardRow { start-index: 8; key-count: 8; }
        SearchKeyboardRow { start-index: 16; key-count: 8; }
        SearchKeyboardRow { start-index: 24; key-count: 8; }
        SearchKeyboardRow { start-index: 32; key-count: 8; }
        SearchKeyboardRow { start-index: 40; key-count: 3; }
    }
}

export component ArcadeListScreen inherits Rectangle {
    property <bool> hub: NavigationView.system-page-mode == SystemPageMode.hub;
    property <int> count: ArcadeView.active-count;
    property <bool> search: ArcadeView.search-mode == ArcadeSearchMode.active;
    property <bool> ready: ArcadeView.load-state == ArcadeLoadState.ready;
    background: transparent;

    if !root.hub && ArcadeView.drawer-open : Rectangle {
        accessible-role: list;
        accessible-label: ArcadeView.drawer-title;
        accessible-description: ArcadeView.active-filter-label;
        accessible-enabled: true;
        for item[index] in ArcadeView.drawer-items : Rectangle {
            accessible-role: list-item;
            accessible-label: item;
            accessible-item-selected: index == ArcadeView.drawer-selected-index;
            accessible-enabled: true;
        }
    }

    CrtPageChrome {
        section: root.hub ? "" : root.search ? ArcadeView.collection-title + " / SEARCH" : ArcadeView.collection-title;
        hint-a: root.hub ? "A OPEN" : root.ready ? "A PLAY" : "";
        hint-b: "B BACK";
    }

    if !root.hub : CrtLauncherText {
        x: CrtPageMetrics.px-x(MisterUi.window-width - CrtPageMetrics.margin-x) - self.preferred-width;
        y: CrtPageMetrics.px-y(CrtPageMetrics.header-bottom + 8 * CrtPageMetrics.sy);
        text: root.search
            ? (ArcadeView.search-status == ArcadeSearchStatus.searching ? "SEARCHING"
                : root.count + (root.count == 1 ? " MATCH" : " MATCHES"))
            : (ArcadeView.selected-game-index + 1) + " / " + root.count;
        text-color: PageTheme.muted;
    }

    if !root.hub && root.search : SearchKeyboard {
        x: (LauncherLayout.crt-keyboard.x - MisterUi.crt-content-x) * 1px;
        y: (LauncherLayout.crt-keyboard.y - MisterUi.crt-content-y) * 1px;
        width: LauncherLayout.crt-keyboard.width * 1px;
        height: LauncherLayout.crt-keyboard.height * 1px;
    }

    if !root.hub : Rectangle {
        x: (LauncherLayout.arcade-list.x - MisterUi.crt-content-x) * 1px;
        y: (LauncherLayout.arcade-list.y - MisterUi.crt-content-y) * 1px;
        width: LauncherLayout.arcade-list.width * 1px;
        height: LauncherLayout.arcade-list.height * 1px;
        background: transparent;
        clip: true;
        accessible-role: list;
        accessible-label: root.search ? "Search results" : "Arcade games";
        accessible-value: "" + (ArcadeView.selected-game-index + 1);
        accessible-description: root.count + (root.search ? " matches" : " games");
        accessible-enabled: true;
    }

    if !root.hub && (!root.ready || (root.search && root.count == 0)) : Rectangle {
        x: (LauncherLayout.arcade-list.x - MisterUi.crt-content-x) * 1px;
        y: (LauncherLayout.arcade-list.y - MisterUi.crt-content-y) * 1px;
        width: LauncherLayout.arcade-list.width * 1px;
        height: LauncherLayout.arcade-list.height * 1px;
        background: #000000aa;
        CrtLauncherText {
            text: !root.ready
                ? (ArcadeView.load-state == ArcadeLoadState.loading ? "LOADING ARCADE GAMES" : "ARCADE LIBRARY UNAVAILABLE")
                : "NO MATCHES";
            text-color: PageTheme.muted;
            x: CrtPageMetrics.len-x(4); y: CrtPageMetrics.len-y(4);
        }
    }

    CrtLauncherText {
        x: CrtPageMetrics.px-x(MisterUi.window-width - CrtPageMetrics.margin-x) - self.preferred-width;
        y: CrtPageMetrics.px-y(CrtPageMetrics.footer-rule + 5 * CrtPageMetrics.sy);
        text: root.hub ? "SELECT GAME LIST" : root.search ? "Y CLOSE" : "SELECT OVERVIEW   Y SEARCH";
        text-color: PageTheme.cream;
    }
}
