import { Spleen6x12 } from "../../components/spleen_6x12.slint";

import { MisterUi } from "../../mister_window.slint";
import { ArcadeLoadState, ArcadeSearchMode, ArcadeSearchPane, ArcadeSearchStatus, ArcadeView, FeedbackView, LauncherLayout } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter } from "../../components/crt_ui.slint";

component SearchKey inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> keyboard-focused;
    in property <bool> acknowledged;

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: "Search keyboard key";
    accessible-item-selected: root.selected;
    accessible-enabled: true;

    height: MisterUi.footer-height;
    background: selected && keyboard-focused ? CrtTheme.accent : CrtTheme.panel-alt;
    border-width: MisterUi.border;
    border-color: selected ? CrtTheme.accent : acknowledged ? #4e8f80 : CrtTheme.border;

    Spleen6x12 {
        text: root.label;
        color: root.selected && root.keyboard-focused ? CrtTheme.accent-text : CrtTheme.text;
        size: MisterUi.crt-body-font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SearchKeyboardRow inherits Rectangle {
    in property <int> start-index;
    in property <int> key-count;
    height: MisterUi.footer-height;

    HorizontalLayout {
        spacing: 0px;

        for key-offset in root.key-count : SearchKey {
            horizontal-stretch: 1;
            label: ArcadeView.search-keys[root.start-index + key-offset];
            selected: ArcadeView.selected-search-key-index == root.start-index + key-offset;
            keyboard-focused: ArcadeView.search-pane == ArcadeSearchPane.keyboard;
            acknowledged: FeedbackView.acknowledged(
                "", "key:" + (root.start-index + key-offset),
                FeedbackView.revision);
        }
    }
}

component SearchKeyboard inherits Rectangle {
    accessible-role: region;
    accessible-label: "Search keyboard";
    accessible-description: "Use the keyboard to enter an arcade search";
    background: CrtTheme.background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: MisterUi.footer-height;
            background: CrtTheme.panel-alt;
            border-width: MisterUi.border;
            border-color: ArcadeView.search-pane == ArcadeSearchPane.keyboard ? CrtTheme.accent : CrtTheme.border;
            accessible-role: text-input;
            accessible-label: "Search query";
            accessible-value: ArcadeView.search-query;
            accessible-enabled: true;

            Spleen6x12 {
                x: MisterUi.grid-x;
                width: parent.width - 16px;
                height: parent.height;
                text: ArcadeView.search-query == "" ? "_" : ArcadeView.search-query;
                color: CrtTheme.text;
                size: MisterUi.crt-body-font;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        SearchKeyboardRow { start-index: 0; key-count: 8; }
        SearchKeyboardRow { start-index: 8; key-count: 8; }
        SearchKeyboardRow { start-index: 16; key-count: 8; }
        SearchKeyboardRow { start-index: 24; key-count: 8; }
        SearchKeyboardRow { start-index: 32; key-count: 8; }
        SearchKeyboardRow { start-index: 40; key-count: 3; }
    }
}

export component ArcadeListScreen inherits Rectangle {
    property <int> count: ArcadeView.active-count;
    background: CrtTheme.background;

    if ArcadeView.drawer-open : Rectangle {
        accessible-role: list;
        accessible-label: ArcadeView.drawer-title;
        accessible-description: ArcadeView.active-filter-label;
        for item[index] in ArcadeView.drawer-items : Rectangle {
            accessible-role: list-item;
            accessible-label: item;
            accessible-item-selected: index == ArcadeView.drawer-selected-index;
            accessible-enabled: true;
        }
    }

    CrtHeader {
        x: LauncherLayout.crt-header.x * 1px;
        y: LauncherLayout.crt-header.y * 1px;
        width: LauncherLayout.crt-header.width * 1px;
        background: transparent;
        border-width: 0px;
        border-color: transparent;
        title: ArcadeView.search-mode == ArcadeSearchMode.active ? "Search" : ArcadeView.active-title;
        subtitle: "";
        status: ArcadeView.search-mode == ArcadeSearchMode.active
            ? (ArcadeView.search-status == ArcadeSearchStatus.searching ? "Searching..." :
                (ArcadeView.search-status == ArcadeSearchStatus.failed ? "Search unavailable" :
                (root.count == 0 && ArcadeView.search-status == ArcadeSearchStatus.ready
                    ? "No matches" : root.count + " matches")))
            : root.count + " games";
    }

    if ArcadeView.search-mode == ArcadeSearchMode.active : SearchKeyboard {
        x: LauncherLayout.crt-keyboard.x * 1px;
        y: LauncherLayout.crt-keyboard.y * 1px;
        width: LauncherLayout.crt-keyboard.width * 1px;
        height: LauncherLayout.crt-keyboard.height * 1px;
    }

    Rectangle {
        x: (LauncherLayout.arcade-list.x - MisterUi.crt-content-x) * 1px;
        y: (LauncherLayout.arcade-list.y - MisterUi.crt-content-y) * 1px;
        width: LauncherLayout.arcade-list.width * 1px;
        height: LauncherLayout.arcade-list.height * 1px;
        background: CrtTheme.panel-alt;
        border-width: MisterUi.border;
        border-color: ArcadeView.search-pane == ArcadeSearchPane.results ? CrtTheme.accent : CrtTheme.border;
        clip: true;
        accessible-role: list;
        accessible-label: ArcadeView.search-mode == ArcadeSearchMode.active ? "Search results" : "Arcade games";
        accessible-description: root.count + (ArcadeView.search-mode == ArcadeSearchMode.active ? " matches" : " games");

        Spleen6x12 {
            width: parent.width;
            height: parent.height;
            visible: ArcadeView.search-mode == ArcadeSearchMode.active
                && (ArcadeView.search-status != ArcadeSearchStatus.ready || root.count == 0);
            text: ArcadeView.search-status == ArcadeSearchStatus.searching ? "Searching..." :
                (ArcadeView.search-status == ArcadeSearchStatus.failed ? "Search unavailable" :
                (root.count == 0 ? "No matches" : ""));
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if ArcadeView.load-state == ArcadeLoadState.loading : Rectangle {
        x: (LauncherLayout.arcade-list.x - MisterUi.crt-content-x) * 1px;
        y: (LauncherLayout.arcade-list.y - MisterUi.crt-content-y) * 1px;
        width: LauncherLayout.arcade-list.width * 1px;
        height: LauncherLayout.arcade-list.height * 1px;
        background: CrtTheme.panel-alt;
        accessible-role: progress-indicator;
        accessible-label: "Loading games";
        accessible-description: "Loading arcade list";

        Spleen6x12 {
            text: "Loading list...";
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    CrtFooter {
        x: LauncherLayout.crt-footer.x * 1px;
        y: LauncherLayout.crt-footer.y * 1px;
        width: LauncherLayout.crt-footer.width * 1px;
        background: transparent;
        border-width: 0px;
        border-color: transparent;
        left-hint: "A Launch   X Options   Y Search";
        right-hint: "B Back   HOME Launcher";
    }
}
