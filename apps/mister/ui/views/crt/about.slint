import { Spleen6x12 } from "../../components/spleen_6x12.slint";

import { MisterUi } from "../../mister_window.slint";
import { AboutSection, FeedbackView, SettingsView } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component AboutScreen inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: "About"; subtitle: "MiSTer MagiK"; status: ""; }

        Spleen6x12 {
            text: "An Unintuitive.com production, crafted in Finland by Nigel Breslaw.";
            color: CrtTheme.text;
            size: MisterUi.crt-body-font;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Spleen6x12 {
            text: "Thanks to the MiSTer project. Made with Slint.";
            color: CrtTheme.muted;
            size: MisterUi.crt-body-font;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        CrtMenuRow {
            vertical-stretch: 1;
            label: "Info";
            detail: "Build and display";
            focused: SettingsView.about-section == AboutSection.information;
            acknowledged: FeedbackView.acknowledged("about", "info", FeedbackView.revision);
        }
        CrtMenuRow {
            vertical-stretch: 1;
            label: "Licenses";
            detail: "Open source";
            focused: SettingsView.about-section == AboutSection.licenses;
            acknowledged: FeedbackView.acknowledged("about", "licenses", FeedbackView.revision);
        }
        CrtFooter { left-hint: "A Open   B Back"; right-hint: "HOME Launcher"; }
    }
}
