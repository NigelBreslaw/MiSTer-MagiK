import { FeedbackView, InformationView } from "../../api.slint";
import { CrtLauncherText, CrtPageChrome, CrtPageMetrics } from "../../components/crt_page_chrome.slint";
import { CrtGroupRule, CrtSettingsRow } from "../../components/crt_settings_page.slint";
import { PageTheme } from "../../components/page_chrome.slint";
import { MisterUi } from "../../mister_window.slint";

export component AboutScreen inherits Rectangle {
    property <int> left: CrtPageMetrics.margin-x;
    property <int> top: CrtPageMetrics.header-bottom + 26 * CrtPageMetrics.sy;
    property <int> row-h: 16 * CrtPageMetrics.sy;
    property <int> gap: 6 * CrtPageMetrics.sy;
    property <length> list-x: CrtPageMetrics.px-x(root.left);
    property <length> list-width: (MisterUi.window-width - 2 * root.left) * 1px;

    accessible-role: main;
    accessible-label: "About screen";
    accessible-enabled: true;
    background: transparent;

    CrtPageChrome { section: "SETTINGS / ABOUT"; hint-a: "A OPEN"; hint-b: "B BACK"; }

    Rectangle {
        x: root.list-x;
        y: CrtPageMetrics.px-y(root.top);
        width: root.list-width;
        height: CrtPageMetrics.px-y(CrtPageMetrics.footer-rule) - self.y;
        accessible-role: list;
        accessible-label: "About";

        CrtSettingsRow {
            y: 0px; width: parent.width;
            label: "BUILD";
            value: InformationView.build-label.to-uppercase();
            detail: InformationView.build-label;
        }
        CrtSettingsRow {
            y: root.row-h * 1px; width: parent.width;
            label: "GAME DATABASE";
            value: InformationView.database-build.to-uppercase();
            detail: InformationView.database-build;
        }
        CrtSettingsRow {
            y: 2 * root.row-h * 1px; width: parent.width;
            label: "KERNEL";
            value: InformationView.kernel-version.to-uppercase();
            detail: InformationView.kernel-version;
        }
        CrtGroupRule { y: (3 * root.row-h + root.gap / 2 - 1) * 1px; width: parent.width - self.x; }
        CrtSettingsRow {
            y: (3 * root.row-h + root.gap) * 1px; width: parent.width;
            label: "LICENSES";
            accessible-name: "Licenses";
            detail: "Open source licenses";
            link: true;
            focused: true;
            acknowledged: FeedbackView.acknowledged("about", "licenses", FeedbackView.revision);
        }

        CrtLauncherText {
            x: CrtPageMetrics.len-x(4); y: CrtPageMetrics.len-y(84);
            text: "AN UNINTUITIVE.COM PRODUCTION"; text-color: PageTheme.cream;
        }
        CrtLauncherText {
            x: CrtPageMetrics.len-x(4); y: CrtPageMetrics.len-y(98);
            text: "CRAFTED IN FINLAND BY NIGEL BRESLAW"; text-color: #c9c3b3;
        }
        CrtLauncherText {
            x: CrtPageMetrics.len-x(4); y: CrtPageMetrics.len-y(112);
            text: "THANKS TO THE MISTER PROJECT"; text-color: PageTheme.muted;
        }
        CrtLauncherText {
            x: CrtPageMetrics.len-x(4); y: CrtPageMetrics.len-y(126);
            text: "MADE WITH SLINT"; text-color: PageTheme.muted;
        }
    }
}
