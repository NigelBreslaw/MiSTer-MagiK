import { MisterUi } from "../../mister_window.slint";
import { MisterBridge } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component AboutScreen inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        padding: MisterUi.grid * 2;
        spacing: MisterUi.grid;

        CrtHeader { title: "About"; subtitle: "MiSTer MagiK"; status: ""; }

        Text {
            font-family: "W95FA";
            text: "An Unintuitive.com production, crafted in Finland by Nigel Breslaw.";
            color: CrtTheme.text;
            font-size: MisterUi.body-font;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Text {
            font-family: "W95FA";
            text: "Thanks to the MiSTer project. Made with Slint.";
            color: CrtTheme.muted;
            font-size: MisterUi.body-font;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        CrtMenuRow {
            vertical-stretch: 1;
            label: "Info";
            detail: "Build and display";
            focused: MisterBridge.about-selected == 0;
        }
        CrtMenuRow {
            vertical-stretch: 1;
            label: "Licenses";
            detail: "Open source";
            focused: MisterBridge.about-selected == 1;
        }
        CrtFooter { left-hint: "A Open   B Back"; right-hint: "HOME Launcher"; }
    }
}
