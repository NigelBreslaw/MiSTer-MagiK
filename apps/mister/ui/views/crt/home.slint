import { MisterUi } from "../../mister_window.slint";
import { MisterBridge } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component HomeGrid inherits Rectangle {
    // The selected row is always kept inside the clipped vertical viewport.
    property <length> outer-padding: MisterUi.grid;
    property <length> row-gap: MisterUi.grid;
    property <length> row-height: 32px;
    property <length> row-pitch: row-height + row-gap;
    property <int> visible-rows: max(1, floor(menu-viewport.height / row-pitch));
    property <int> first-visible-row: MisterBridge.selected-index < visible-rows
        ? 0
        : MisterBridge.selected-index - visible-rows + 1;

    background: CrtTheme.background;

    VerticalLayout {
        padding: root.outer-padding;
        spacing: root.row-gap;

        CrtHeader {
            title: MisterBridge.menu-title;
            subtitle: MisterBridge.menu-breadcrumb != "" ? MisterBridge.menu-breadcrumb
                : MisterBridge.dev-mode ? "DEV MODE"
                : MisterBridge.update-available ? "Update Available" : "";
            status: MisterBridge.clock-text;
        }

        menu-viewport := Rectangle {
            vertical-stretch: 1;
            background: transparent;
            clip: true;

            Rectangle {
                y: -root.first-visible-row * root.row-pitch;
                width: parent.width;
                height: MisterBridge.menu-items.length * root.row-pitch;
                background: transparent;

                for item[index] in MisterBridge.menu-items : CrtMenuRow {
                    y: index * root.row-pitch;
                    width: parent.width;
                    height: root.row-height;
                    label: item.label;
                    detail: item.subtitle;
                    focused: item.focused;
                }
            }
        }

        CrtFooter {
            left-hint: MisterBridge.menu-breadcrumb == "" ? "A Select" : "A Select   B Back";
            right-hint: MisterBridge.menu-breadcrumb == "" ? "HOME Settings" : "HOME Launcher";
        }
    }
}
