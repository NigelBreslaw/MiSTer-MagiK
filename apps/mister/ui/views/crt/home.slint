import { MisterUi } from "../../mister_window.slint";
import { MisterBridge } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtCard } from "../../components/crt_ui.slint";
import { MenuItemStatus } from "../../launcher_menu.slint";

export component HomeGrid inherits Rectangle {
    property <bool> root-menu: MisterBridge.menu-breadcrumb == "";
    property <length> card-gap: MisterUi.grid-y;
    property <int> root-card-count: MisterUi.portrait-layout
        ? max(1, MisterBridge.menu-items.length)
        : 4;
    property <length> card-height: root.root-menu
        ? (menu-viewport.height - root.card-gap * (root.root-card-count - 1))
            / root.root-card-count
        : (menu-viewport.height - root.card-gap * 4) / 4.5;
    property <length> card-pitch: root.card-height + root.card-gap;
    property <bool> bottom-window: !root.root-menu
        && MisterBridge.menu-items.length > 4
        && MisterBridge.selected-index >= MisterBridge.menu-items.length - 2;
    property <int> first-visible-row: root.root-menu ? 0
        : root.bottom-window ? MisterBridge.menu-items.length - 5
        : (MisterBridge.selected-index - 2).clamp(0, (MisterBridge.menu-items.length - 5).max(0));
    property <length> leading-clip: root.bottom-window ? root.card-pitch / 2 : 0px;

    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader {
            title: MisterBridge.menu-title;
            subtitle: MisterBridge.menu-breadcrumb != "" ? MisterBridge.menu-breadcrumb
                : MisterBridge.dev-mode ? "DEV MODE"
                : MisterBridge.update-available ? "Update Available" : "";
            status: MisterBridge.clock-text;
        }

        menu-viewport := Rectangle {
            vertical-stretch: 1;
            background: CrtTheme.background;
            clip: true;

            for state[index] in MisterBridge.menu-item-presentation : CrtCard {
                y: (index - root.first-visible-row) * root.card-pitch - root.leading-clip;
                width: parent.width;
                height: root.card-height;
                label: MisterBridge.menu-items[index].label;
                detail: root.root-menu
                    && MisterBridge.menu-items[index].status == MenuItemStatus.ready
                    ? "" : MisterBridge.menu-items[index].subtitle;
                focused: state.selected;
                acknowledged: state.acknowledged && !state.selected;
                status: MisterBridge.menu-items[index].status;
            }
        }

        CrtFooter {
            left-hint: root.root-menu ? "A Select" : "B Back   A Open";
            right-hint: root.root-menu ? "HOME/F12 Settings" : "HOME/F12 Launcher";
        }
    }
}
