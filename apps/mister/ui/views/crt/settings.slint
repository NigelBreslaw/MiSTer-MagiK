import { MisterUi } from "../../mister_window.slint";
import { MisterBridge } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component SettingsScreen inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        padding: MisterUi.grid * 2;
        spacing: MisterUi.grid;

        CrtHeader { title: "Settings"; subtitle: ""; status: ""; }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            CrtMenuRow { vertical-stretch: 1; label: "Resolution"; detail: MisterBridge.display-active-label; focused: MisterBridge.settings-selected == 0; }
            CrtMenuRow { vertical-stretch: 1; label: "Screensaver"; detail: "Configure"; focused: MisterBridge.settings-selected == 1; }
            CrtMenuRow { vertical-stretch: 1; label: "Exit to MiSTer"; detail: "Until reboot"; focused: MisterBridge.settings-selected == 2; }
            CrtMenuRow { vertical-stretch: 1; label: "Reset Database"; detail: "Delete and reboot"; focused: MisterBridge.settings-selected == 3; }
            CrtMenuRow { vertical-stretch: 1; label: "About"; detail: "MiSTer MagiK"; focused: MisterBridge.settings-selected == 4; }
        }

        CrtFooter { left-hint: "A Change"; right-hint: "B Back"; }
    }
}
