import {
    ConfirmationKind,
    FeedbackView,
    NavigationTransitionState,
    NavigationView,
    OverlayView,
    ScreenOrientation,
    SettingsPopup,
    SettingsSection,
    SettingsView,
} from "../../api.slint";
import { CrtPageChrome, CrtPageMetrics } from "../../components/crt_page_chrome.slint";
import { CrtGroupRule, CrtSettingsRow } from "../../components/crt_settings_page.slint";
import { MisterUi } from "../../mister_window.slint";

export component SettingsScreen inherits Rectangle {
    property <bool> overlay-active: SettingsView.popup != SettingsPopup.none
        || OverlayView.confirmation-kind == ConfirmationKind.display-resolution
        || OverlayView.confirmation-kind == ConfirmationKind.screen-orientation;
    property <int> left: CrtPageMetrics.margin-x;
    property <int> top: CrtPageMetrics.header-bottom + 26 * CrtPageMetrics.sy;
    property <int> row-h: 16 * CrtPageMetrics.sy;
    property <int> gap: 6 * CrtPageMetrics.sy;
    property <length> list-x: CrtPageMetrics.px-x(root.left);
    property <length> list-width: (MisterUi.window-width - 2 * root.left) * 1px;

    accessible-role: main;
    accessible-label: "Settings";
    accessible-description: NavigationView.transition-state == NavigationTransitionState.idle ? "Ready" : "Transitioning";
    background: transparent;

    CrtPageChrome {
        section: "SETTINGS";
        hint-a: root.overlay-active ? "A SELECT" : "A CHANGE";
        hint-b: root.overlay-active ? "B CANCEL" : "B BACK";
    }

    Rectangle {
        x: root.list-x;
        y: CrtPageMetrics.px-y(root.top);
        width: root.list-width;
        height: CrtPageMetrics.px-y(CrtPageMetrics.footer-rule) - self.y;
        accessible-role: list;
        accessible-label: "Settings";
        opacity: root.overlay-active ? 0.35 : 1;

        CrtSettingsRow {
            y: 0px; width: parent.width;
            label: "DISPLAY RESOLUTION";
            accessible-name: "Display resolution";
            detail: SettingsView.active-display.label;
            value: SettingsView.active-display.label.to-uppercase();
            focused: SettingsView.section == SettingsSection.display;
            acknowledged: FeedbackView.acknowledged("settings", "display", FeedbackView.revision);
        }
        CrtSettingsRow {
            y: root.row-h * 1px; width: parent.width;
            label: "SCREEN ORIENTATION";
            accessible-name: "Screen orientation";
            detail: SettingsView.active-orientation == ScreenOrientation.normal ? "Normal"
                : SettingsView.active-orientation == ScreenOrientation.monitor-clockwise
                ? "Monitor right (clockwise)" : "Monitor left (counterclockwise)";
            value: SettingsView.active-orientation == ScreenOrientation.normal ? "NORMAL"
                : SettingsView.active-orientation == ScreenOrientation.monitor-clockwise ? "MONITOR RIGHT" : "MONITOR LEFT";
            focused: SettingsView.section == SettingsSection.orientation;
            acknowledged: FeedbackView.acknowledged("settings", "orientation", FeedbackView.revision);
        }
        CrtSettingsRow {
            y: 2 * root.row-h * 1px; width: parent.width;
            label: "REDUCE MOTION";
            accessible-name: "Reduce motion";
            detail: SettingsView.reduce-motion ? "On" : "Off";
            value: SettingsView.reduce-motion ? "ON" : "OFF";
            value-accent: SettingsView.reduce-motion;
            focused: SettingsView.section == SettingsSection.reduce-motion;
            acknowledged: FeedbackView.acknowledged("settings", "reduce-motion", FeedbackView.revision);
        }

        CrtGroupRule { y: (3 * root.row-h + root.gap / 2 - 1) * 1px; width: parent.width - self.x; }
        CrtSettingsRow {
            y: (3 * root.row-h + root.gap) * 1px; width: parent.width;
            label: "START AFTER";
            accessible-name: "Screensaver start delay";
            detail: "Screensaver idle delay";
            value: (SettingsView.section == SettingsSection.screensaver-delay ? "<  " : "")
                + (SettingsView.screensaver-delay-minutes == 0 ? "OFF" : SettingsView.screensaver-delay-minutes + " MIN")
                + (SettingsView.section == SettingsSection.screensaver-delay ? "  >" : "");
            focused: SettingsView.section == SettingsSection.screensaver-delay;
            acknowledged: FeedbackView.acknowledged("settings", "screensaver-delay", FeedbackView.revision);
        }
        CrtSettingsRow {
            y: (4 * root.row-h + root.gap) * 1px; width: parent.width;
            label: "PREVIEW SCREENSAVER";
            accessible-name: "Preview screensaver";
            detail: "Start the screensaver now";
            value: "SHOW NOW";
            link: true;
            focused: SettingsView.section == SettingsSection.screensaver-preview;
            acknowledged: FeedbackView.acknowledged("settings", "screensaver-preview", FeedbackView.revision);
        }

        CrtGroupRule { y: (5 * root.row-h + 3 * root.gap / 2 - 1) * 1px; width: parent.width - self.x; }
        CrtSettingsRow {
            y: (5 * root.row-h + 2 * root.gap) * 1px; width: parent.width;
            label: "EXIT TO MISTER";
            accessible-name: "Exit to MiSTer";
            detail: "Use the stock MiSTer menu until reboot";
            value: "UNTIL REBOOT";
            focused: SettingsView.section == SettingsSection.exit;
            acknowledged: FeedbackView.acknowledged("settings", "exit", FeedbackView.revision);
        }
        CrtSettingsRow {
            y: (6 * root.row-h + 2 * root.gap) * 1px; width: parent.width;
            label: "REFRESH DATABASE";
            accessible-name: "Refresh database";
            detail: "Hold A 7s: delete catalog + packs, reboot";
            value: "HOLD A 7S: RESET";
            focused: SettingsView.section == SettingsSection.refresh;
            acknowledged: FeedbackView.acknowledged("settings", "refresh", FeedbackView.revision);
        }
        CrtSettingsRow {
            y: (7 * root.row-h + 2 * root.gap) * 1px; width: parent.width;
            label: "ABOUT";
            accessible-name: "About";
            detail: "MiSTer MagiK and Slint";
            value: "MAGIK";
            link: true;
            focused: SettingsView.section == SettingsSection.about;
            acknowledged: FeedbackView.acknowledged("settings", "about", FeedbackView.revision);
        }
    }
}
