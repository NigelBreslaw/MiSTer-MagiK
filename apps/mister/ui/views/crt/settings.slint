import { MisterUi } from "../../mister_window.slint";
import { MisterBridge } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component SettingsScreen inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        padding: MisterUi.grid;
        spacing: 0px;

        CrtHeader { title: "Settings"; subtitle: ""; status: ""; }
        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                spacing: MisterUi.grid;
                CrtMenuRow { label: "Resolution"; detail: MisterBridge.display-active-label; focused: MisterBridge.settings-selected == 0; }
                CrtMenuRow { label: "Screensaver"; detail: "Configure"; focused: MisterBridge.settings-selected == 1; }
            }
            HorizontalLayout {
                spacing: MisterUi.grid;
                CrtMenuRow { label: "Exit to MiSTer"; detail: "Until reboot"; focused: MisterBridge.settings-selected == 2; }
                CrtMenuRow { label: "Reset Database"; detail: "Delete and reboot"; focused: MisterBridge.settings-selected == 3; }
            }
            HorizontalLayout {
                spacing: MisterUi.grid;
                CrtMenuRow { label: "About"; detail: "MagiK and Slint"; focused: MisterBridge.settings-selected == 4; }
                Rectangle { background: transparent; }
            }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        CrtFooter { left-hint: "A Change   B Back"; right-hint: "HOME Launcher"; }
    }
}
