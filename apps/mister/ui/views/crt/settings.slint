import { MisterUi } from "../../mister_window.slint";
import { FeedbackView, ScreenOrientation, SettingsSection, SettingsView } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component SettingsScreen inherits Rectangle {
    background: CrtTheme.background;

    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;

        CrtHeader { title: "Settings"; subtitle: ""; status: ""; }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            CrtMenuRow { vertical-stretch: 1; label: "Resolution"; detail: SettingsView.active-display.label; focused: SettingsView.section == SettingsSection.display; acknowledged: FeedbackView.acknowledged("settings", "display", FeedbackView.revision); }
            CrtMenuRow { vertical-stretch: 1; label: "Orientation"; detail: SettingsView.active-orientation == ScreenOrientation.normal ? "Normal" : SettingsView.active-orientation == ScreenOrientation.monitor-clockwise ? "Monitor right" : "Monitor left"; focused: SettingsView.section == SettingsSection.orientation; acknowledged: FeedbackView.acknowledged("settings", "orientation", FeedbackView.revision); }
            CrtMenuRow { vertical-stretch: 1; label: "Screensaver"; detail: "Configure"; focused: SettingsView.section == SettingsSection.screensaver; acknowledged: FeedbackView.acknowledged("settings", "screensaver", FeedbackView.revision); }
            CrtMenuRow { vertical-stretch: 1; label: "Reduce motion"; detail: SettingsView.reduce-motion ? "On" : "Off"; focused: SettingsView.section == SettingsSection.reduce-motion; acknowledged: FeedbackView.acknowledged("settings", "reduce-motion", FeedbackView.revision); }
            CrtMenuRow { vertical-stretch: 1; label: "Exit to MiSTer"; detail: "Until reboot"; focused: SettingsView.section == SettingsSection.exit; acknowledged: FeedbackView.acknowledged("settings", "exit", FeedbackView.revision); }
            CrtMenuRow { vertical-stretch: 1; label: "Rebuild DB"; detail: "Rebuild library only"; focused: SettingsView.section == SettingsSection.rebuild; acknowledged: FeedbackView.acknowledged("settings", "rebuild", FeedbackView.revision); }
            CrtMenuRow { vertical-stretch: 1; label: "About"; detail: "MiSTer MagiK"; focused: SettingsView.section == SettingsSection.about; acknowledged: FeedbackView.acknowledged("settings", "about", FeedbackView.revision); }
        }

        CrtFooter { left-hint: "A Change"; right-hint: "B Back"; }
    }
}
