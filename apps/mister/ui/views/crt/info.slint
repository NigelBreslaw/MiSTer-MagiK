import { MisterUi } from "../../mister_window.slint";
import { MisterBridge, NavigationView } from "../../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../../components/crt_ui.slint";

export component InfoScreen inherits Rectangle {
    background: CrtTheme.background;
    VerticalLayout {
        padding-left: MisterUi.grid-x * 2;
        padding-right: MisterUi.grid-x * 2;
        padding-top: MisterUi.grid-y * 2;
        padding-bottom: MisterUi.grid-y * 2;
        spacing: MisterUi.grid-y;
        CrtHeader { title: "Info"; subtitle: "System details"; status: ""; }
        CrtMenuRow { vertical-stretch: 1; label: "Build"; detail: NavigationView.build-label; focused: false; }
        CrtMenuRow { vertical-stretch: 1; label: "Display"; detail: NavigationView.present-mode-label; focused: false; }
        CrtMenuRow { vertical-stretch: 1; label: "Database"; detail: MisterBridge.info-database-build; focused: false; }
        CrtMenuRow { vertical-stretch: 1; label: "Kernel"; detail: MisterBridge.info-kernel-version; focused: false; }
        CrtFooter { left-hint: "B Back"; right-hint: "HOME Launcher"; }
    }
}
