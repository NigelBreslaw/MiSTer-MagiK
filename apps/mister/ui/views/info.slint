import { MisterUi } from "../mister_window.slint";
import { MisterBridge } from "../api.slint";
import { CrtTheme, CrtHeader, CrtFooter, CrtMenuRow } from "../components/crt_ui.slint";

export component InfoScreen inherits Rectangle {
    background: CrtTheme.background;
    VerticalLayout {
        padding: MisterUi.grid;
        spacing: MisterUi.compact-layout ? 0px : MisterUi.grid;
        CrtHeader { title: "Info"; subtitle: "System details"; status: ""; }
        CrtMenuRow { label: "Build"; detail: MisterBridge.build-label; focused: false; }
        CrtMenuRow { label: "Display"; detail: MisterBridge.present-mode-label; focused: false; }
        CrtMenuRow { label: "Database"; detail: MisterBridge.info-database-build; focused: false; }
        CrtMenuRow { label: "Kernel"; detail: MisterBridge.info-kernel-version; focused: false; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        CrtFooter { left-hint: "B Back"; right-hint: "HOME Launcher"; }
    }
}
