import { Start2P, Start2PSize } from "../../components/start2p.slint";

import { MisterBridge } from "../../api.slint";

component AboutRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;

    height: 52px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Start2P { text: label; color: focused ? #06d6a0 : #e8e0f0; size: Start2PSize.px16; }
        Start2P { text: detail; color: #9080a8; size: Start2PSize.px8; }
    }
}

export component AboutScreen inherits Rectangle {
    VerticalLayout {
        padding: 48px;
        spacing: 24px;
        Start2P {
            text: "About";
            color: #06d6a0;
            size: Start2PSize.px24;
            horizontal-alignment: center;
        }
        Start2P {
            text: "MiSTer MagiK is an Unintuitive.com software production. Crafted with love in Finland by Nigel Breslaw.";
            color: #e8e0f0;
            size: Start2PSize.px16;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Start2P {
            text: "Thanks to the MiSTer project for making all of this possible";
            color: #b8acc8;
            size: Start2PSize.px16;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Start2P {
            text: "Made with Slint. Delivering beautiful UI's on the most challenging of hardware www.slint.dev";
            color: #70e1f5;
            size: Start2PSize.px16;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        Rectangle { vertical-stretch: 1; background: transparent; }

        AboutRow {
            label: "Info";
            detail: "Build, display, database, and kernel details";
            focused: MisterBridge.about-selected == 0;
            acknowledged: MisterBridge.selection-feedback-query("about", "info", MisterBridge.selection-feedback-revision);
        }
        AboutRow {
            label: "Licenses";
            detail: "Open source licenses and acknowledgements";
            focused: MisterBridge.about-selected == 1;
            acknowledged: MisterBridge.selection-feedback-query("about", "licenses", MisterBridge.selection-feedback-revision);
        }

        Start2P { text: "B: back"; color: #6f8198; size: Start2PSize.px8; horizontal-alignment: center; }
    }

}
