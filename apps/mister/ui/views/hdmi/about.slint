import { Jersey25, Jersey25Size } from "../../components/jersey_25.slint";
import { Nocive15 } from "../../components/nocive_15.slint";
import { Xerxes10 } from "../../components/xerxes_10.slint";
import { LandscapePageChrome, PageRule, PageTheme, PortraitPageChrome, SettingsFocusHighlight } from "../../components/page_chrome.slint";
import { FeedbackView, InformationView, SettingsView } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";

component InformationRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> separator: true;
    height: 36px;

    Nocive15 { x: 12px; y: 7px; text: root.label; color: #c9c3b3; }
    Xerxes10 {
        x: root.width - 14px - self.preferred-width;
        y: 11px;
        text: root.value.to-uppercase();
        color: PageTheme.muted;
    }
    if root.separator : PageRule { x: 12px; y: root.height - 1px; width: root.width - 12px; }
}

component LicensesRow inherits Rectangle {
    in property <bool> acknowledged;
    height: 36px;
    accessible-role: list-item;
    accessible-label: "Licenses";
    accessible-description: "Open source licenses";
    accessible-item-selected: true;
    accessible-enabled: true;
    SettingsFocusHighlight {
        source: MisterUi.portrait-layout
            ? SettingsView.focus-highlight-portrait
            : SettingsView.focus-highlight-wide;
    }
    Nocive15 { x: 12px; y: 7px; text: "LICENSES"; color: PageTheme.settings-accent; }
    Xerxes10 {
        x: root.width - 14px - self.preferred-width;
        y: 11px;
        text: ">";
        color: PageTheme.cream;
    }
}

export component AboutScreen inherits Rectangle {
    accessible-role: main;
    accessible-label: "About";
    accessible-enabled: true;
    background: PageTheme.background;

    if !MisterUi.portrait-layout : Rectangle {
        LandscapePageChrome { hint-a: "A  OPEN"; hint-b: "B  BACK"; hint-right: ""; }

        Xerxes10 { x: 29px; y: 101px; text: "SETTINGS / ABOUT"; color: PageTheme.muted; }
        Jersey25 {
            x: 27px;
            y: 121px;
            text: InformationView.version-label;
            size: Jersey25Size.px56;
            color: PageTheme.cream;
        }
        Xerxes10 { x: 29px; y: 205px; text: "MISTER MAGIK VERSION"; color: PageTheme.muted; }
        PageRule { x: 28px; y: 239px; width: 213px; }
        Xerxes10 {
            x: 29px; y: 258px; width: 220px;
            text: "AN UNINTUITIVE.COM\nPRODUCTION, CRAFTED\nIN FINLAND BY\nNIGEL BRESLAW";
            color: #c9c3b3;
            wrap: word-wrap;
        }
        PageRule { x: 28px; y: 352px; width: 213px; }
        Xerxes10 {
            x: 29px; y: 370px; width: 220px;
            text: "THANKS TO THE MISTER\nPROJECT. MADE WITH\nSLINT: SLINT.DEV";
            color: PageTheme.muted;
            wrap: word-wrap;
        }
        PageRule { x: 265px; y: 95px; width: 1px; height: 384px; }

        Xerxes10 { x: 308px; y: 101px; text: "SYSTEM"; color: PageTheme.muted; }
        InformationRow { x: 296px; y: 121px; width: 638px; label: "BUILD"; value: InformationView.build-label; }
        InformationRow { x: 296px; y: 157px; width: 638px; label: "GAME DATABASE"; value: InformationView.database-build; }
        InformationRow { x: 296px; y: 193px; width: 638px; label: "KERNEL"; value: InformationView.kernel-version; separator: false; }
        Xerxes10 { x: 308px; y: 247px; text: "LEGAL"; color: PageTheme.muted; }
        LicensesRow {
            x: 296px; y: 267px; width: 638px;
            acknowledged: FeedbackView.acknowledged("about", "licenses", FeedbackView.revision);
        }
    }

    if MisterUi.portrait-layout : Rectangle {
        PortraitPageChrome { section: "SETTINGS / ABOUT"; hint-a: "A OPEN"; hint-b: "B BACK"; }
        VerticalLayout {
            x: 32px; y: 120px; width: root.width - 64px; height: root.height - 220px;
            spacing: 12px;
            Jersey25 { text: InformationView.version-label; size: Jersey25Size.px56; color: PageTheme.cream; }
            Xerxes10 { text: "MISTER MAGIK VERSION"; color: PageTheme.muted; }
            InformationRow { label: "BUILD"; value: InformationView.build-label; }
            InformationRow { label: "GAME DATABASE"; value: InformationView.database-build; }
            InformationRow { label: "KERNEL"; value: InformationView.kernel-version; }
            LicensesRow { acknowledged: FeedbackView.acknowledged("about", "licenses", FeedbackView.revision); }
        }
    }
}
