import { FeedbackView, NavigationView, SystemHubSection } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { Start2P, Start2PSize } from "../../components/start2p.slint";
import { Jersey25 } from "../../components/jersey_25.slint";
import { Xerxes10, Xerxes10Size } from "../../components/xerxes_10.slint";
import { Nocive15, Nocive15Size } from "../../components/nocive_15.slint";

component HubIcon inherits Rectangle {
    in property <int> kind;
    in property <color> ink;
    background: transparent;

    if root.kind == 0 : Rectangle {
        x: 4px; y: 12px; width: 52px; height: 25px;
        background: transparent;
        border-width: 2px;
        border-color: root.ink;
        border-radius: 8px;
        Rectangle { x: 10px; y: 8px; width: 16px; height: 4px; background: root.ink; }
        Rectangle { x: 16px; y: 2px; width: 4px; height: 16px; background: root.ink; }
        Rectangle { x: 35px; y: 7px; width: 6px; height: 6px; background: root.ink; border-radius: 3px; }
        Rectangle { x: 43px; y: 12px; width: 6px; height: 6px; background: root.ink; border-radius: 3px; }
    }

    if root.kind == 1 : Rectangle {
        x: 10px; y: 2px; width: 40px; height: 40px;
        background: transparent;
        border-width: 2px;
        border-color: root.ink;
        border-radius: 20px;
        Rectangle { x: 18px; y: 8px; width: 3px; height: 14px; background: root.ink; }
        Rectangle { x: 18px; y: 19px; width: 12px; height: 3px; background: root.ink; }
        Rectangle { x: -4px; y: 25px; width: 10px; height: 2px; background: root.ink; }
        Rectangle { x: -1px; y: 31px; width: 9px; height: 2px; background: root.ink; }
    }

    if root.kind == 2 : Start2P {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: "*";
        color: root.ink;
        size: Start2PSize.px32;
        horizontal-alignment: center;
    }

    if root.kind == 3 : Rectangle {
        x: 10px; y: 2px; width: 40px; height: 40px;
        background: transparent;
        border-width: 2px;
        border-color: root.ink;
        border-radius: 20px;
        Start2P {
            x: 0px; y: 5px; width: parent.width; height: 30px;
            text: "i";
            color: root.ink;
            size: Start2PSize.px24;
            horizontal-alignment: center;
        }
    }
}

component HubCard inherits Rectangle {
    in property <int> kind;
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> enabled: true;
    property <color> ink: !enabled ? #665574 : focused ? #06d6a0 : #9b88ae;

    background: focused ? #1d1728 : #100d18;
    border-width: focused ? 3px : 1px;
    border-color: focused ? #06d6a0 : acknowledged ? #4e8f80 : #57466b;

    Rectangle { x: 8px; y: 8px; width: 18px; height: 2px; background: root.ink; }
    Rectangle { x: 8px; y: 8px; width: 2px; height: 18px; background: root.ink; }
    Rectangle { x: parent.width - 26px; y: parent.height - 10px; width: 18px; height: 2px; background: root.ink; }
    Rectangle { x: parent.width - 10px; y: parent.height - 26px; width: 2px; height: 18px; background: root.ink; }

    Rectangle {
        x: 14px; y: 62px; width: parent.width - 28px; height: 26px;
        Nocive15 {
            text: root.label;
            color: root.enabled ? (root.focused ? #f8f5fa : #e7dfec) : #71617f;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        x: 18px; y: 101px; width: parent.width - 36px; height: 1px;
        background: root.focused ? #477a70 : #493b59;
    }
    Xerxes10 {
        x: 18px;
        y: MisterUi.portrait-layout ? 104px : 116px;
        width: parent.width - 36px;
        height: 22px;
        text: root.detail;
        color: root.ink;
        size: Xerxes10Size.px10;
        horizontal-alignment: center;
    }
}

export component SystemHubScreen inherits Rectangle {
    background: #080710;
    property <length> card-width: MisterUi.portrait-layout ? (root.width - 54px) / 2 : 248px;
    property <length> card-height: MisterUi.portrait-layout ? 130px : 146px;
    property <length> cards-x: MisterUi.portrait-layout ? 20px : 28px;
    property <length> cards-y: MisterUi.portrait-layout ? 300px : 150px;
    property <length> art-x: MisterUi.portrait-layout ? (root.width - 380px) / 2 : 552px;
    property <length> art-y: MisterUi.portrait-layout ? 112px : 150px;

    Rectangle { x: 0px; y: 0px; width: 8px; height: parent.height; background: #120e1c; }
    Rectangle { x: 8px; y: 20px; width: 2px; height: parent.height - 40px; background: #3c2d4b; }
    Rectangle { x: 18px; y: 24px; width: 48px; height: 2px; background: #6f5287; }

    Jersey25 {
        x: 28px; y: 28px; width: 300px; height: 41px;
        text: "SUPER NINTENDO";
        color: #f8f5fa;
    }
    Xerxes10 {
        x: 30px; y: 78px; width: 360px; height: 22px;
        text: "1990  /  16-BIT CONSOLE";
        color: #a56dd1;
        size: Xerxes10Size.px10;
    }
    Nocive15 {
        x: 30px; y: 104px; width: 300px; height: 18px;
        text: NavigationView.system-hub-games-count + " GAMES";
        color: #ddd4e4;
        size: Nocive15Size.px15;
    }
    Xerxes10 {
        visible: !MisterUi.portrait-layout;
        x: 740px; y: 46px; width: 190px; height: 22px;
        text: "SYSTEM  /  SNES";
        color: #766486;
        size: Xerxes10Size.px10;
        horizontal-alignment: right;
    }

    Rectangle {
        x: art-x; y: art-y; width: 380px; height: 216px;
        background: #0e0b14;
        border-width: 1px;
        border-color: #57466b;
        Rectangle { x: 7px; y: 7px; width: 16px; height: 2px; background: #766486; }
        Rectangle { x: 7px; y: 7px; width: 2px; height: 16px; background: #766486; }
        Rectangle { x: parent.width - 23px; y: parent.height - 9px; width: 16px; height: 2px; background: #766486; }
        Rectangle { x: parent.width - 9px; y: parent.height - 23px; width: 2px; height: 16px; background: #766486; }
        Image {
            x: 5px; y: 18px;
            visible: NavigationView.system-artwork-available;
            source: NavigationView.system-artwork;
            width: 370px; height: 164px;
            image-fit: fill;
            image-rendering: pixelated;
        }
        Xerxes10 {
            x: 0px; y: 194px; width: parent.width; height: 22px;
            text: "SUPER FAMICOM  /  SUPER NINTENDO";
            color: #8d779d;
            size: Xerxes10Size.px10;
            horizontal-alignment: center;
        }
    }

    if !MisterUi.portrait-layout : Rectangle {
        x: 552px; y: 382px; width: 380px; height: 74px;
        background: #100d18;
        border-width: 1px;
        border-color: #493b59;
        Nocive15 {
            x: 18px; y: 18px; width: parent.width - 36px; height: 18px;
            text: "16-BIT";
            color: #a58bb5;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }
        Rectangle { x: 18px; y: 45px; width: parent.width - 36px; height: 1px; background: #493b59; }
        Xerxes10 {
            x: 18px; y: 48px; width: parent.width - 36px; height: 22px;
            text: "CARTRIDGE     /     2 CONTROLLER PORTS";
            color: #766486;
            size: Xerxes10Size.px10;
            horizontal-alignment: center;
        }
    }

    HubCard { x: cards-x; y: cards-y; width: card-width; height: card-height; kind: 0; label: "GAMES"; detail: NavigationView.system-hub-games-count + " TITLES"; focused: NavigationView.system-hub-section == SystemHubSection.games; acknowledged: FeedbackView.acknowledged("system-hub", "games", FeedbackView.revision); }
    HubCard { x: cards-x + card-width + 14px; y: cards-y; width: card-width; height: card-height; kind: 1; label: "RECENT"; detail: NavigationView.system-hub-recent-count + " PLAYED"; focused: NavigationView.system-hub-section == SystemHubSection.recent; acknowledged: FeedbackView.acknowledged("system-hub", "recent", FeedbackView.revision); }
    HubCard { x: cards-x; y: cards-y + card-height + 14px; width: card-width; height: card-height; kind: 2; label: "FAVORITES"; detail: NavigationView.system-hub-favourites-count + " SAVED"; focused: NavigationView.system-hub-section == SystemHubSection.favourites; acknowledged: FeedbackView.acknowledged("system-hub", "favorites", FeedbackView.revision); }
    // HubCard { x: cards-x + card-width + 14px; y: cards-y + card-height + 14px; width: card-width; height: card-height; kind: 3; label: "INFO"; detail: "COMING SOON"; enabled: false; focused: NavigationView.system-hub-section == SystemHubSection.information; acknowledged: FeedbackView.acknowledged("system-hub", "info", FeedbackView.revision); }

    Rectangle {
        x: 28px; y: parent.height - 50px; width: parent.width - 56px; height: 1px;
        background: #33283e;
    }
    Xerxes10 {
        x: 28px; y: parent.height - 31px; width: parent.width - 56px; height: 22px;
        text: "A OPEN          B BACK          HOME LAUNCHER";
        color: #8f819e;
        size: Xerxes10Size.px10;
        horizontal-alignment: center;
    }
}
