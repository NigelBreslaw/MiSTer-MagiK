// A system's own page, shared by every console, computer and handheld: the
// system's identity on the left, Games / Recent / Favourites as three tiles,
// and its generic device (TV, monitor or handheld) as the hero on the right.
// The device is the same 483x519 image at the same position as the game list,
// so its screen stays put when a tile opens the list.

import { DeviceKind, FeedbackView, NavigationView, ArcadeView, SystemHubSection } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { Jersey25, Jersey25Size } from "../../components/jersey_25.slint";
import { Xerxes10 } from "../../components/xerxes_10.slint";
import { Nocive15 } from "../../components/nocive_15.slint";
import { LandscapePageChrome, PageTheme, PortraitPageChrome } from "../../components/page_chrome.slint";

global HubTheme {
    // Each collection's neon colour: TV blue, monitor yellow, handheld green.
    out property <color> accent: NavigationView.system-device == DeviceKind.monitor ? #e6c23a
        : NavigationView.system-device == DeviceKind.handheld ? #35c48f : NavigationView.system-device == DeviceKind.cabinet ? #e7695a : #5a71e7;
}

component HubTile inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <bool> focused;
    in property <bool> acknowledged;

    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.count + "";
    accessible-item-selectable: true;
    accessible-item-selected: root.focused;

    border-radius: 10px;
    border-width: 2px;
    border-color: root.focused ? HubTheme.accent
        : root.acknowledged ? HubTheme.accent.mix(#000000, 0.7) : HubTheme.accent.mix(#000000, 0.42);
    background: root.focused ? HubTheme.accent.mix(#0a0e18, 0.24) : HubTheme.accent.mix(#0a0e18, 0.12);

    Jersey25 {
        x: 14px; y: 8px; width: parent.width - 28px; height: 60px;
        text: root.count;
        size: Jersey25Size.px56;
        color: root.count == 0 ? PageTheme.muted : PageTheme.cream;
    }
    Nocive15 {
        x: 14px; y: parent.height - 30px; width: parent.width - 28px;
        text: root.label;
        color: root.focused ? PageTheme.cream : PageTheme.muted;
        overflow: elide;
    }
    if root.focused : Rectangle {
        x: 14px; y: parent.height - 6px; width: parent.width - 28px; height: 3px;
        background: HubTheme.accent;
    }
}

export component SystemHubScreen inherits Rectangle {
    property <SystemHubSection> section: NavigationView.system-hub-section;
    property <int> games: NavigationView.system-hub-games-count;
    property <int> recent: NavigationView.system-hub-recent-count;
    property <int> favourites: NavigationView.system-hub-favourites-count;
    background: transparent;

    if !MisterUi.portrait-layout : Rectangle {
        Xerxes10 {
            x: 30px; y: 104px; width: 440px;
            text: NavigationView.system-subtitle;
            color: HubTheme.accent;
            overflow: elide;
        }
        title := Jersey25 {
            x: 28px; y: 126px; width: 440px; height: self.preferred-height;
            text: NavigationView.system-title;
            size: NavigationView.system-title-wraps ? Jersey25Size.hub48 : Jersey25Size.hub64;
            wrap: word-wrap;
            color: PageTheme.cream;
        }
        Xerxes10 {
            x: 30px; y: title.y + title.height + 10px; width: 440px;
            text: root.games + " GAMES READY TO PLAY";
            color: PageTheme.cream;
        }

        HubTile {
            x: 30px; y: root.section == SystemHubSection.games ? 310px : 318px;
            width: 140px; height: 128px;
            label: "GAMES"; count: root.games;
            focused: root.section == SystemHubSection.games;
            acknowledged: FeedbackView.acknowledged("system-hub", "games", FeedbackView.revision);
        }
        HubTile {
            x: 180px; y: root.section == SystemHubSection.recent ? 310px : 318px;
            width: 140px; height: 128px;
            label: "RECENT"; count: root.recent;
            focused: root.section == SystemHubSection.recent;
            acknowledged: FeedbackView.acknowledged("system-hub", "recent", FeedbackView.revision);
        }
        HubTile {
            x: 330px; y: root.section == SystemHubSection.favourites ? 310px : 318px;
            width: 140px; height: 128px;
            label: "FAVOURITES"; count: root.favourites;
            focused: root.section == SystemHubSection.favourites;
            acknowledged: FeedbackView.acknowledged("system-hub", "favorites", FeedbackView.revision);
        }
        Xerxes10 {
            x: 30px; y: 470px; width: 440px;
            text: NavigationView.system-hub-caption;
            color: #c9c3b3;
            overflow: elide;
        }
    }

    if MisterUi.portrait-layout : Rectangle {
        PortraitPageChrome {
            section: NavigationView.system-title;
            hint-a: "A OPEN";
            hint-b: "B BACK";
        }
        Jersey25 {
            x: 32px; y: 130px; width: parent.width - 64px; height: 60px;
            text: NavigationView.system-title;
            size: Jersey25Size.px56;
            color: PageTheme.cream;
        }
        Xerxes10 {
            x: 34px; y: 104px; width: parent.width - 68px;
            text: NavigationView.system-subtitle;
            color: HubTheme.accent;
            overflow: elide;
        }
        HubTile {
            x: 32px; y: 230px; width: parent.width - 64px; height: 110px;
            label: "GAMES"; count: root.games;
            focused: root.section == SystemHubSection.games;
            acknowledged: FeedbackView.acknowledged("system-hub", "games", FeedbackView.revision);
        }
        HubTile {
            x: 32px; y: 350px; width: parent.width - 64px; height: 110px;
            label: "RECENT"; count: root.recent;
            focused: root.section == SystemHubSection.recent;
            acknowledged: FeedbackView.acknowledged("system-hub", "recent", FeedbackView.revision);
        }
        HubTile {
            x: 32px; y: 470px; width: parent.width - 64px; height: 110px;
            label: "FAVOURITES"; count: root.favourites;
            focused: root.section == SystemHubSection.favourites;
            acknowledged: FeedbackView.acknowledged("system-hub", "favorites", FeedbackView.revision);
        }
        Xerxes10 {
            x: 34px; y: 600px; width: parent.width - 68px;
            text: NavigationView.system-hub-caption;
            color: #c9c3b3;
            overflow: elide;
        }
    }
}
