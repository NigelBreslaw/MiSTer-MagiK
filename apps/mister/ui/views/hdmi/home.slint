import { Spleen6x12, Spleen6x12Size } from "../../components/spleen_6x12.slint";
import { Xerxes10, Xerxes10Size } from "../../components/xerxes_10.slint";
import { Nocive15, Nocive15Size } from "../../components/nocive_15.slint";

import { AccessibleRole, FeedbackView, HomeFocus, MenuHierarchy, NavigationView } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { LauncherTile, SettingsButton } from "../../components/launcher_chrome.slint";

component HomeFooter inherits Rectangle {
    in property <bool> portrait-layout;
    in property <bool> root-menu;

    height: 30px;
    background: #172131;
    border-width: 1px;
    border-color: #52647d;

    Xerxes10 {
        text: root.portrait-layout
            ? root.root-menu ? "UP/DOWN Move    A Select    HOME Settings"
                : "UP/DOWN Move    A Open    B Back    HOME Launcher"
            : root.root-menu ? "LEFT/RIGHT Move    A Select    UP Settings"
                : "LEFT/RIGHT Move    A Open    B Back    HOME Launcher";
        color: #8ca4b5;
        size: Xerxes10Size.px10;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component HomeGrid inherits Rectangle {
    property <bool> root-menu: NavigationView.menu-hierarchy == MenuHierarchy.root;
    property <float> nested-rail-scale: (root.width - 36px) / 924px;
    property <length> tile-gap: root-menu ? 16px : 16px * nested-rail-scale;
    // Nested Home always exposes four full cards and half of the next card.
    // Scale the complete canonical rail so its first and final edges remain exact.
    property <length> narrow-tile-width: 191px * nested-rail-scale;
    property <length> tile-width: root-menu
        ? (root.width - 36px - 3 * tile-gap) / 4
        : narrow-tile-width;
    property <length> tile-pitch: tile-width + tile-gap;
    property <float> canonical-scroll-scale: root-menu ? 1 : nested-rail-scale;
    property <int> layout-item-count: root-menu ? Math.max(4, NavigationView.menu-items.length)
        : NavigationView.menu-items.length;
    property <length> content-width: layout-item-count * tile-width
        + Math.max(0, layout-item-count - 1) * tile-gap;
    property <length> scroll-x: NavigationView.home-scroll-x * 1px * canonical-scroll-scale;

    background: transparent;

    if !MisterUi.portrait-layout : HorizontalLayout {
        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            Rectangle {
                height: 42px;
                background: #172131;
                border-width: 1px;
                border-color: #52647d;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 12px;
                    cross-axis-alignment: center;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;

                            Nocive15 {
                                width: 100%;
                                text: NavigationView.menu-title;
                                color: #d7eef8;
                                size: Nocive15Size.px15;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if (NavigationView.development-build || NavigationView.update-available)
                                && NavigationView.menu-hierarchy == MenuHierarchy.root : Xerxes10 {
                                width: 100%;
                                text: NavigationView.development-build ? "DEV MODE" : "Update Available";
                                color: NavigationView.development-build ? #ffb347 : #06d6a0;
                                size: Xerxes10Size.px10;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if NavigationView.menu-hierarchy == MenuHierarchy.nested : Xerxes10 {
                                width: 100%;
                                text: NavigationView.menu-breadcrumb;
                                color: #8ca4b5;
                                size: Xerxes10Size.px10;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Nocive15 {
                        text: NavigationView.clock-text;
                        color: #d7eef8;
                        size: Nocive15Size.px15;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    SettingsButton {
                        width: 34px;
                        height: 34px;
                        focused: NavigationView.home-focus == HomeFocus.settings;
                        acknowledged: FeedbackView.acknowledged(
                            "", "__settings", FeedbackView.revision);
                    }
                }
            }

            system-viewport := Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;
                accessible-role: AccessibleRole.list;
                accessible-label: NavigationView.menu-title;

                Rectangle {
                    x: -root.scroll-x;
                    width: root.content-width;
                    height: parent.height;
                    background: transparent;

                    // Menus are bounded and retained by Rust. Direct delegates preserve Slint's
                    // row identity, so changing selection or acknowledgement repaints only the
                    // rows whose derived presentation state changed.
                    for state[index] in NavigationView.menu-item-presentation : LauncherTile {
                        x: index * root.tile-pitch;
                        width: root.tile-width;
                        height: parent.height;
                        label: NavigationView.menu-items[index].label;
                        subtitle: NavigationView.menu-items[index].subtitle;
                        status: NavigationView.menu-items[index].status;
                        focused: NavigationView.home-focus == HomeFocus.menu && state.selected;
                        acknowledged: state.acknowledged && !state.selected;
                        flat-focus-style: true;
                    }
                }
            }

            HomeFooter {
                portrait-layout: false;
                root-menu: root.root-menu;
            }
        }
    }

    if MisterUi.portrait-layout : VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            height: 52px;
            background: #172131;
            border-width: 1px;
            border-color: #52647d;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                cross-axis-alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Nocive15 {
                        text: NavigationView.menu-title;
                        color: #d7eef8;
                        size: Nocive15Size.px15;
                        overflow: elide;
                    }
                    Xerxes10 {
                        text: NavigationView.menu-hierarchy == MenuHierarchy.nested ? NavigationView.menu-breadcrumb
                            : NavigationView.development-build ? "DEV MODE"
                            : NavigationView.update-available ? "Update Available" : "";
                        color: NavigationView.development-build ? #ffb347 : #8ca4b5;
                        size: Xerxes10Size.px10;
                        overflow: elide;
                    }
                }
                Xerxes10 {
                    text: NavigationView.clock-text;
                    color: #d7eef8;
                    size: Xerxes10Size.px10;
                    horizontal-alignment: right;
                }
                SettingsButton {
                    width: 36px;
                    height: 36px;
                    focused: false;
                    acknowledged: FeedbackView.acknowledged(
                        "", "__settings", FeedbackView.revision);
                }
            }
        }

        portrait-viewport := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;
            accessible-role: AccessibleRole.list;
            accessible-label: NavigationView.menu-title;
            property <length> gap: 12px;
            property <length> card-height: (self.height - gap * 3.5) / 4.5;
            property <length> pitch: card-height + gap;
            property <int> first-row: (NavigationView.home-selected-index - 2).clamp(
                0, (NavigationView.menu-items.length - 5).max(0));

            for state[index] in NavigationView.menu-item-presentation : LauncherTile {
                x: 0px;
                y: (index - portrait-viewport.first-row) * portrait-viewport.pitch;
                width: parent.width;
                height: portrait-viewport.card-height;
                label: NavigationView.menu-items[index].label;
                subtitle: NavigationView.menu-items[index].subtitle;
                status: NavigationView.menu-items[index].status;
                focused: state.selected;
                acknowledged: state.acknowledged && !state.selected;
                flat-focus-style: true;
            }
        }

        HomeFooter {
            portrait-layout: true;
            root-menu: root.root-menu;
        }
    }
}
