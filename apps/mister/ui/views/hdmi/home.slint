import { Start2P, Start2PSize } from "../../components/start2p.slint";
import { Xerxes10, Xerxes10Size } from "../../components/xerxes_10.slint";
import { Nocive15, Nocive15Size } from "../../components/nocive_15.slint";

import { MisterBridge } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";
import { LauncherTile, SettingsButton } from "../../components/launcher_chrome.slint";

export component HomeGrid inherits Rectangle {
    property <bool> root-menu: MisterBridge.menu-breadcrumb == "";
    property <length> narrow-tile-width: 191px;
    property <length> tile-gap: 16px;
    property <length> tile-width: root-menu
        ? (root.width - 36px - 3 * tile-gap) / 4
        : narrow-tile-width;
    property <length> tile-pitch: tile-width + tile-gap;
    property <int> layout-item-count: root-menu ? Math.max(4, MisterBridge.menu-items.length)
        : MisterBridge.menu-items.length;
    property <length> content-width: layout-item-count * tile-width
        + Math.max(0, layout-item-count - 1) * tile-gap;
    property <length> scroll-x: MisterBridge.home-scroll-x * 1px;

    background: transparent;

    if !MisterUi.portrait-layout : HorizontalLayout {
        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            Rectangle {
                height: 42px;
                background: #172131;
                border-width: 1px;
                border-color: #52647d;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 12px;
                    cross-axis-alignment: center;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;

                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;

                            Nocive15 {
                                width: 100%;
                                text: MisterBridge.menu-title;
                                color: #d7eef8;
                                size: Nocive15Size.px15;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if (MisterBridge.dev-mode || MisterBridge.update-available)
                                && MisterBridge.menu-breadcrumb == "" : Xerxes10 {
                                width: 100%;
                                text: MisterBridge.dev-mode ? "DEV MODE" : "Update Available";
                                color: MisterBridge.dev-mode ? #ffb347 : #06d6a0;
                                size: Xerxes10Size.px10;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            if MisterBridge.menu-breadcrumb != "" : Xerxes10 {
                                width: 100%;
                                text: MisterBridge.menu-breadcrumb;
                                color: #8ca4b5;
                                size: Xerxes10Size.px10;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Nocive15 {
                        text: MisterBridge.clock-text;
                        color: #d7eef8;
                        size: Nocive15Size.px15;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    SettingsButton {
                        width: 34px;
                        height: 34px;
                        focused: MisterBridge.settings-focused;
                        acknowledged: MisterBridge.selection-feedback-query(
                            "", "__settings", MisterBridge.selection-feedback-revision);
                    }
                }
            }

            system-viewport := Rectangle {
                vertical-stretch: 1;
                background: transparent;
                clip: true;

                Rectangle {
                    x: -root.scroll-x;
                    width: root.content-width;
                    height: parent.height;
                    background: transparent;

                    // Menus are bounded and retained by Rust. Direct delegates preserve Slint's
                    // row identity, so changing selection or acknowledgement repaints only the
                    // rows whose derived presentation state changed.
                    for item[index] in MisterBridge.menu-items : LauncherTile {
                        x: index * root.tile-pitch;
                        width: root.tile-width;
                        height: parent.height;
                        label: item.label;
                        subtitle: item.subtitle;
                        status: item.status;
                        focused: !MisterBridge.settings-focused
                            && MisterBridge.menu-item-presentation[index].selected;
                        acknowledged: MisterBridge.menu-item-presentation[index].acknowledged
                            && !MisterBridge.menu-item-presentation[index].selected;
                        flat-focus-style: true;
                    }
                }
            }
        }
    }

    if MisterUi.portrait-layout : VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            height: 52px;
            background: #172131;
            border-width: 1px;
            border-color: #52647d;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 10px;
                spacing: 8px;
                cross-axis-alignment: center;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 3px;
                    Nocive15 {
                        text: MisterBridge.menu-title;
                        color: #d7eef8;
                        size: Nocive15Size.px15;
                        overflow: elide;
                    }
                    Xerxes10 {
                        text: MisterBridge.menu-breadcrumb != "" ? MisterBridge.menu-breadcrumb
                            : MisterBridge.dev-mode ? "DEV MODE"
                            : MisterBridge.update-available ? "Update Available" : "";
                        color: MisterBridge.dev-mode ? #ffb347 : #8ca4b5;
                        size: Xerxes10Size.px10;
                        overflow: elide;
                    }
                }
                Xerxes10 {
                    text: MisterBridge.clock-text;
                    color: #d7eef8;
                    size: Xerxes10Size.px10;
                    horizontal-alignment: right;
                }
                SettingsButton {
                    width: 36px;
                    height: 36px;
                    focused: false;
                    acknowledged: MisterBridge.selection-feedback-query(
                        "", "__settings", MisterBridge.selection-feedback-revision);
                }
            }
        }

        portrait-viewport := Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: transparent;
            property <length> gap: 12px;
            property <length> card-height: (self.height - gap * 3.5) / 4.5;
            property <length> pitch: card-height + gap;
            property <int> first-row: (MisterBridge.selected-index - 2).clamp(
                0, (MisterBridge.menu-items.length - 5).max(0));

            for item[index] in MisterBridge.menu-items : LauncherTile {
                x: 0px;
                y: (index - portrait-viewport.first-row) * portrait-viewport.pitch;
                width: parent.width;
                height: portrait-viewport.card-height;
                label: item.label;
                subtitle: item.subtitle;
                status: item.status;
                focused: MisterBridge.menu-item-presentation[index].selected;
                acknowledged: MisterBridge.menu-item-presentation[index].acknowledged
                    && !MisterBridge.menu-item-presentation[index].selected;
                flat-focus-style: true;
            }
        }

        Rectangle {
            height: 30px;
            background: #172131;
            border-width: 1px;
            border-color: #52647d;
            Xerxes10 {
                text: root.root-menu ? "UP/DOWN Move    A Select    HOME Settings"
                    : "UP/DOWN Move    A Open    B Back    HOME Launcher";
                color: #8ca4b5;
                size: Xerxes10Size.px10;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
