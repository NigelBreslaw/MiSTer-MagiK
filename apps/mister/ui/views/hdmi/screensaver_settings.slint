import { PixelText8, PixelTextSize } from "../../components/pixel_text_8.slint";

import { MisterBridge } from "../../api.slint";

component SaverRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> enabled: true;
    height: 70px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: !enabled ? #3c3448 : (focused ? #06d6a0 : #5c4a72);
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        PixelText8 { text: label; color: !enabled ? #686070 : (focused ? #06d6a0 : #e8e0f0); size: PixelTextSize.px16; }
        PixelText8 { text: detail; color: enabled ? #a898b8 : #585060; size: PixelTextSize.px8; }
    }
}

export component ScreensaverSettingsScreen inherits Rectangle {
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        PixelText8 { text: "Screensaver"; color: #e8e0f0; size: PixelTextSize.px24; horizontal-alignment: center; }
        SaverRow {
            label: "Screensaver enabled";
            detail: MisterBridge.screensaver-enabled ? "Yes" : "No";
            focused: MisterBridge.screensaver-settings-selected == 0;
        }
        SaverRow {
            label: "Show screensaver after";
            detail: MisterBridge.screensaver-delay-minutes == 1 ? "1 minute" : MisterBridge.screensaver-delay-minutes + " minutes";
            focused: MisterBridge.screensaver-settings-selected == 1;
            enabled: MisterBridge.screensaver-enabled;
        }
        SaverRow {
            label: "Preview screensaver";
            detail: "Show it now";
            focused: MisterBridge.screensaver-settings-selected == 2;
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

