import { Spleen6x12, Spleen6x12Size } from "../../components/spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "../../components/nocive_15.slint";

import { FeedbackView, ScreensaverSetting, SettingsView } from "../../api.slint";

component SaverRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> focused;
    in property <bool> acknowledged;
    in property <bool> enabled: true;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-item-selected: root.focused;
    accessible-enabled: root.enabled;
    height: 70px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: !enabled ? #3c3448 : (focused ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72);
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Nocive15 { text: label; color: !enabled ? #686070 : (focused ? #06d6a0 : #e8e0f0); size: Nocive15Size.px15; }
        Spleen6x12 { text: detail; color: enabled ? #a898b8 : #585060; size: Spleen6x12Size.px8; }
    }
}

export component ScreensaverSettingsScreen inherits Rectangle {
    accessible-role: main;
    accessible-label: "Screensaver settings";
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Spleen6x12 { text: "Screensaver"; color: #e8e0f0; size: Spleen6x12Size.px24; horizontal-alignment: center; }
        SaverRow {
            label: "Screensaver enabled";
            detail: SettingsView.screensaver-enabled ? "Yes" : "No";
            focused: SettingsView.screensaver-setting == ScreensaverSetting.enabled;
            acknowledged: FeedbackView.acknowledged("screensaver-settings", "enabled", FeedbackView.revision);
        }
        SaverRow {
            label: "Show screensaver after";
            detail: SettingsView.screensaver-delay-minutes == 1 ? "1 minute" : SettingsView.screensaver-delay-minutes + " minutes";
            focused: SettingsView.screensaver-setting == ScreensaverSetting.delay;
            acknowledged: FeedbackView.acknowledged("screensaver-settings", "delay", FeedbackView.revision);
            enabled: SettingsView.screensaver-enabled;
        }
        SaverRow {
            label: "Preview screensaver";
            detail: "Show it now";
            focused: SettingsView.screensaver-setting == ScreensaverSetting.preview;
            acknowledged: FeedbackView.acknowledged("screensaver-settings", "preview", FeedbackView.revision);
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
