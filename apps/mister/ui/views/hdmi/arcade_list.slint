import { PixelText8, PixelTextSize } from "../../components/pixel_text_8.slint";

import { MisterUi } from "../../mister_window.slint";
import { MisterBridge } from "../../api.slint";

component SearchKey inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> keyboard-focused;

    height: 42px;
    background: selected ? (keyboard-focused ? #06d6a0 : #2a2236) : #181220;
    border-width: selected ? 2px : 1px;
    border-color: selected ? (keyboard-focused ? #ffffff : #5c4a72) : #352848;

    PixelText8 {
        text: root.label;
        color: root.selected && root.keyboard-focused ? #101420 : #e8e0f0;
        size: PixelTextSize.px8;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SearchKeyboardRow inherits Rectangle {
    in property <int> start-index;
    in property <int> key-count;

    height: 42px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;

        for key-offset in root.key-count: SearchKey {
            horizontal-stretch: 1;
            label: MisterBridge.arcade-search-keys[root.start-index + key-offset];
            selected: MisterBridge.arcade-search-key-selected == root.start-index + key-offset;
            keyboard-focused: MisterBridge.arcade-search-pane == 0;
        }
    }
}

component SearchKeyboard inherits Rectangle {

    background: #1a1424;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        PixelText8 {
            text: "Search";
            color: #e8e0f0;
            size: PixelTextSize.px24;
        }

        Rectangle {
            height: 46px;
            background: #120d1a;
            border-width: MisterBridge.arcade-search-pane == 0 ? 2px : 1px;
            border-color: MisterBridge.arcade-search-pane == 0 ? #06d6a0 : #352848;

            PixelText8 {
                x: 10px;
                y: 0px;
                width: parent.width - 20px;
                height: parent.height;
                text: MisterBridge.arcade-search-query == "" ? "_" : MisterBridge.arcade-search-query;
                color: MisterBridge.arcade-search-query == "" ? #706080 : #d7eef8;
                size: PixelTextSize.px8;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            height: 30px;
            background: MisterBridge.arcade-search-suggestion == "" ? #15101d : #211a2b;
            border-width: 1px;
            border-color: MisterBridge.arcade-search-suggestion == "" ? #2a2236 : #5c4a72;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Rectangle {
                    width: 26px;
                    height: 18px;
                    background: MisterBridge.arcade-search-suggestion == "" ? #20182a : #06d6a0;
                    border-width: 1px;
                    border-color: MisterBridge.arcade-search-suggestion == "" ? #352848 : #ffffff;

                    PixelText8 {
                        text: "Y";
                        color: MisterBridge.arcade-search-suggestion == "" ? #706080 : #101420;
                        size: PixelTextSize.px8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                PixelText8 {
                    text: MisterBridge.arcade-search-status == 1 ? "Searching..." :
                        (MisterBridge.arcade-search-status == 3 ? "Search unavailable" :
                        (MisterBridge.arcade-search-suggestion == "" ? "" : MisterBridge.arcade-search-suggestion));
                    color: MisterBridge.arcade-search-suggestion == "" ? #706080 : #d7eef8;
                    size: PixelTextSize.px8;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        SearchKeyboardRow { start-index: 0; key-count: 8; }
        SearchKeyboardRow { start-index: 8; key-count: 8; }
        SearchKeyboardRow { start-index: 16; key-count: 8; }
        SearchKeyboardRow { start-index: 24; key-count: 8; }
        SearchKeyboardRow { start-index: 32; key-count: 8; }
        SearchKeyboardRow { start-index: 40; key-count: 3; }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}

export component ArcadeListScreen inherits Rectangle {
    property <int> count: MisterBridge.active-system-count;
    property <bool> games-loading: MisterBridge.arcade-games-loading;
    background: #1a1424;

    HorizontalLayout {

        // Left half - scrollable game list or search keyboard
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            visible: MisterBridge.arcade-list-visible;

            if MisterBridge.arcade-search-active : SearchKeyboard { }

            // Rust draws the animated game rows into this reserved viewport.
            if !MisterBridge.arcade-search-active : Rectangle {
                x: MisterBridge.arcade-list-x * 1px;
                y: MisterBridge.arcade-list-y * 1px;
                width: MisterBridge.arcade-list-width * 1px;
                height: MisterBridge.arcade-list-height * 1px;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                clip: true;
            }

            if !MisterBridge.arcade-search-active : Rectangle {
                x: MisterBridge.arcade-list-x * 1px;
                y: MisterBridge.arcade-list-y * 1px;
                width: MisterBridge.arcade-list-width * 1px;
                height: MisterBridge.arcade-list-height * 1px;
                visible: root.games-loading || self.opacity > 0;
                opacity: root.games-loading ? 1 : 0;
                background: #120d1a;
                border-width: 1px;
                border-color: #352848;
                animate opacity { duration: 180ms; }

                VerticalLayout {
                    alignment: center;
                    spacing: 10px;

                    Rectangle {
                        width: 180px;
                        height: 4px;
                        background: #1a1424;
                        border-width: 1px;
                        border-color: #5c4a72;
                    }
                }
            }

        }

        // Right half - screenshot for highlighted game or search results
        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            background: #131018;

            if MisterBridge.arcade-search-active : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: #131018;

                PixelText8 {
                    x: 16px;
                    y: 16px;
                    text: MisterBridge.arcade-search-status == 1 ? "Searching..." :
                        (MisterBridge.arcade-search-status == 3 ? "Search unavailable" :
                        (count == 0 && MisterBridge.arcade-search-status == 2 ? "No matches" :
                        count + " matches"));
                    color: MisterBridge.arcade-search-pane == 1 ? #06d6a0 : #706080;
                    size: PixelTextSize.px8;
                }

                Rectangle {
                    x: (MisterBridge.arcade-list-x - MisterUi.window-width / 2) * 1px;
                    y: MisterBridge.arcade-list-y * 1px;
                    width: MisterBridge.arcade-list-width * 1px;
                    height: MisterBridge.arcade-list-height * 1px;
                    background: #120d1a;
                    border-width: 1px;
                    border-color: MisterBridge.arcade-search-pane == 1 ? #06d6a0 : #352848;
                    clip: true;

                    PixelText8 {
                        width: parent.width;
                        height: parent.height;
                        visible: MisterBridge.arcade-search-status != 2 || count == 0;
                        text: MisterBridge.arcade-search-status == 1 ? "Searching..." :
                            (MisterBridge.arcade-search-status == 3 ? "Search unavailable" :
                            (count == 0 ? "No matches" : ""));
                        color: #706080;
                        size: PixelTextSize.px8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if !MisterBridge.arcade-search-active : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: MisterBridge.arcade-list-y * 1px;
        background: #1a1424;

        PixelText8 {
            x: 16px;
            y: 16px;
            width: parent.width - 32px;
            text: MisterBridge.active-system-title;
            color: #e8e0f0;
            size: PixelTextSize.px24;
            overflow: elide;
        }

        PixelText8 {
            x: 16px;
            y: 44px;
            text: root.count + " games";
            color: #706080;
            size: PixelTextSize.px8;
        }
    }

    if !MisterBridge.arcade-search-active : Rectangle {
        x: MisterBridge.arcade-list-x * 1px;
        y: (MisterBridge.arcade-list-y + MisterBridge.arcade-list-height + 4) * 1px;
        width: parent.width > self.x * 2 ? parent.width - self.x * 2 : 0px;
        height: parent.height > self.y + 8px ? parent.height - self.y - 8px : 0px;
        background: #131018;
        border-width: 1px;
        border-color: #352848;
    }
}
