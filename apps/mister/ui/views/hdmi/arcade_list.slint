import { Xerxes10 } from "../../components/xerxes_10.slint";
import { FocusHighlight, LandscapePageChrome, PageTheme, PortraitPageChrome } from "../../components/page_chrome.slint";
import { MisterUi } from "../../mister_window.slint";
import { ArcadeLoadState, ArcadeSearchMode, ArcadeSearchPane, ArcadeSearchStatus, ArcadeView, FeedbackView, LauncherLayout } from "../../api.slint";

component SearchKey inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> keyboard-focused;
    in property <bool> acknowledged;

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: "Search keyboard key";
    accessible-item-selected: root.selected;
    accessible-enabled: true;
    height: 30px;
    background: root.selected && root.keyboard-focused ? #3a1511 : #0b0b0d;
    border-width: 1px;
    border-color: root.selected && root.keyboard-focused ? #e7695a
        : root.acknowledged ? #744038 : PageTheme.rule;

    Xerxes10 {
        text: root.label;
        color: root.selected && root.keyboard-focused ? #ffffff : PageTheme.cream;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SearchKeyboardRow inherits Rectangle {
    in property <int> start-index;
    in property <int> key-count;
    height: 30px;

    HorizontalLayout {
        spacing: 6px;
        for key-offset in root.key-count : SearchKey {
            horizontal-stretch: 1;
            label: ArcadeView.search-keys[root.start-index + key-offset];
            selected: ArcadeView.selected-search-key-index == root.start-index + key-offset;
            keyboard-focused: ArcadeView.search-pane == ArcadeSearchPane.keyboard;
            acknowledged: FeedbackView.acknowledged("", "key:" + (root.start-index + key-offset), FeedbackView.revision);
        }
    }
}

component SearchKeyboard inherits Rectangle {
    accessible-role: region;
    accessible-label: "Search keyboard";
    accessible-description: "Use the keyboard to enter an arcade search";
    accessible-enabled: true;
    background: transparent;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 18px;
        background: transparent;
        accessible-role: text-input;
        accessible-label: "Search query";
        accessible-value: ArcadeView.search-query;
        accessible-enabled: true;
        Xerxes10 {
            x: 4px; y: -1px; width: parent.width - 8px; height: parent.height;
            text: ArcadeView.search-query == "" ? "_" : ArcadeView.search-query + "_";
            color: ArcadeView.search-query == "" ? PageTheme.muted : PageTheme.cream;
            overflow: elide;
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #e7695a; }
    }

    VerticalLayout {
        x: 0px; y: 26px; width: parent.width; height: 174px;
        spacing: 6px;
        SearchKeyboardRow { start-index: 0; key-count: 8; }
        SearchKeyboardRow { start-index: 8; key-count: 8; }
        SearchKeyboardRow { start-index: 16; key-count: 8; }
        SearchKeyboardRow { start-index: 24; key-count: 8; }
        SearchKeyboardRow { start-index: 32; key-count: 8; }
    }
    SearchKeyboardRow { x: 0px; y: 206px; width: parent.width; start-index: 40; key-count: 3; }
}

export component ArcadeListScreen inherits Rectangle {
    property <int> count: ArcadeView.active-count;
    property <bool> search: ArcadeView.search-mode == ArcadeSearchMode.active;
    property <bool> ready: ArcadeView.load-state == ArcadeLoadState.ready;
    background: PageTheme.background;

    if ArcadeView.drawer-open : Rectangle {
        accessible-role: list;
        accessible-label: ArcadeView.drawer-title;
        accessible-description: ArcadeView.active-filter-label;
        accessible-enabled: true;
        for item[index] in ArcadeView.drawer-items : Rectangle {
            accessible-role: list-item;
            accessible-label: item;
            accessible-item-selected: index == ArcadeView.drawer-selected-index;
            accessible-enabled: true;
        }
    }

    if !MisterUi.portrait-layout : Rectangle {
        Rectangle {
            x: 490px; y: 77px; width: 483px; height: 423px;
            clip: true;

            Image {
                x: 0px; y: -42px; width: 483px; height: 519px;
                source: ArcadeView.cabinet-backdrop;
                image-fit: fill;
                image-rendering: pixelated;
                accessible-role: none;
            }
            Rectangle { x: 82px; y: 19px; width: 320px; height: 320px; background: black; }
        }

        LandscapePageChrome {
            hint-a: root.ready ? "A  PLAY" : "";
            hint-b: "B  BACK";
            hint-right: root.search ? "UP DOWN MOVE   Y CLOSE" : "UP DOWN MOVE   Y SEARCH";
        }

        Xerxes10 {
            x: 26px; y: 52px;
            text: root.search ? "ARCADE / SEARCH" : "ARCADE";
            color: PageTheme.muted;
        }
        Xerxes10 {
            x: 368px; y: 52px; width: 120px;
            text: root.search
                ? (ArcadeView.search-status == ArcadeSearchStatus.searching ? "SEARCHING..."
                    : root.count + (root.count == 1 ? " MATCH" : " MATCHES"))
                : root.count + " GAMES";
            color: PageTheme.muted;
            horizontal-alignment: right;
        }

        if root.search : SearchKeyboard { x: 26px; y: 124px; width: 462px; height: 230px; }

        if !root.search && root.ready : FocusHighlight {
            x: 26px;
            y: 196px;
            width: 462px;
            height: 36px;
            source: ArcadeView.focus-highlight;
            accent: #e7695a;
        }

        Rectangle {
            x: LauncherLayout.arcade-list.x * 1px;
            y: LauncherLayout.arcade-list.y * 1px;
            width: LauncherLayout.arcade-list.width * 1px;
            height: LauncherLayout.arcade-list.height * 1px;
            background: transparent;
            clip: true;
            accessible-role: list;
            accessible-label: root.search ? "Search results" : "Arcade games";
            accessible-value: "" + (ArcadeView.selected-game-index + 1);
            accessible-description: root.count + (root.search ? " matches" : " games");
            accessible-enabled: true;
        }

        if !root.ready || (root.search && root.count == 0) : Rectangle {
            x: LauncherLayout.arcade-list.x * 1px;
            y: LauncherLayout.arcade-list.y * 1px;
            width: LauncherLayout.arcade-list.width * 1px;
            height: LauncherLayout.arcade-list.height * 1px;
            background: black;
            Xerxes10 {
                width: parent.width; height: parent.height;
                text: !root.ready
                    ? (ArcadeView.load-state == ArcadeLoadState.loading ? "LOADING ARCADE GAMES..." : "ARCADE LIBRARY UNAVAILABLE")
                    : "NO MATCHES";
                color: PageTheme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if MisterUi.portrait-layout : Rectangle {
        PortraitPageChrome {
            section: root.search ? "ARCADE / SEARCH" : "ARCADE";
            hint-a: root.ready ? "A PLAY" : "";
            hint-b: "B BACK";
        }
        Rectangle {
            x: LauncherLayout.arcade-preview.x * 1px;
            y: LauncherLayout.arcade-preview.y * 1px;
            width: LauncherLayout.arcade-preview.width * 1px;
            height: LauncherLayout.arcade-preview.height * 1px;
            background: black;
        }
        Rectangle {
            x: LauncherLayout.arcade-list.x * 1px;
            y: LauncherLayout.arcade-list.y * 1px;
            width: LauncherLayout.arcade-list.width * 1px;
            height: LauncherLayout.arcade-list.height * 1px;
            background: black;
            accessible-role: list;
            accessible-label: root.search ? "Search results" : "Arcade games";
            accessible-enabled: true;
        }
    }
}
