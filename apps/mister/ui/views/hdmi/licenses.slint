import { Nocive15 } from "../../components/nocive_15.slint";
import { Xerxes10 } from "../../components/xerxes_10.slint";
import { LandscapePageChrome, PageRule, PageTheme, PortraitPageChrome, SettingsFocusHighlight } from "../../components/page_chrome.slint";
import { FeedbackView, SettingsView } from "../../api.slint";
import { MisterUi } from "../../mister_window.slint";

component LicenseRow inherits Rectangle {
    in property <string> label;
    in property <string> kind;
    in property <bool> focused;
    in property <bool> acknowledged;
    height: 36px;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-description: root.kind;
    accessible-item-selected: root.focused;
    accessible-enabled: true;

    if root.focused : SettingsFocusHighlight {
        source: MisterUi.portrait-layout
            ? SettingsView.focus-highlight-portrait
            : SettingsView.focus-highlight-wide;
    }
    Nocive15 { x: 12px; y: 7px; text: root.label.to-uppercase(); color: root.focused ? PageTheme.settings-accent : PageTheme.cream; }
    Xerxes10 {
        x: root.width - 14px - self.preferred-width;
        y: 11px;
        text: root.kind + "  >";
        color: root.focused ? PageTheme.cream : PageTheme.muted;
    }
    if !root.focused : PageRule { x: 12px; y: root.height - 1px; width: root.width - 12px; }
}

export component LicensesScreen inherits Rectangle {
    accessible-role: main;
    accessible-label: "Licenses";
    accessible-enabled: true;
    background: PageTheme.background;

    if !MisterUi.portrait-layout : Rectangle {
        LandscapePageChrome {
            hint-a: "A  READ";
            hint-b: "B  BACK";
            hint-right: "UP  DOWN   MOVE";
        }
        Xerxes10 { x: 29px; y: 101px; text: "ABOUT / LICENSES"; color: PageTheme.muted; }
        Xerxes10 { x: 29px; y: 205px; text: "OPEN SOURCE LICENSES"; color: PageTheme.muted; }
        PageRule { x: 28px; y: 239px; width: 213px; }
        PageRule { x: 265px; y: 95px; width: 1px; height: 384px; }

        for title[index] in SettingsView.license-titles : LicenseRow {
            x: 296px;
            y: 101px + index * 36px;
            width: 638px;
            label: title;
            kind: SettingsView.license-kinds[index];
            focused: SettingsView.selected-license-index == index;
            acknowledged: FeedbackView.acknowledged("licenses", "license:" + index, FeedbackView.revision);
        }
    }

    if MisterUi.portrait-layout : Rectangle {
        PortraitPageChrome { section: "ABOUT / LICENSES"; hint-a: "A READ"; hint-b: "B BACK"; }
        Rectangle {
            x: 32px; y: 130px; width: root.width - 64px; height: root.height - 240px;
            for title[index] in SettingsView.license-titles : LicenseRow {
                y: index * 42px;
                width: parent.width;
                label: title;
                kind: SettingsView.license-kinds[index];
                focused: SettingsView.selected-license-index == index;
                acknowledged: FeedbackView.acknowledged("licenses", "license:" + index, FeedbackView.revision);
            }
        }
    }
}
