import { Start2P, Start2PSize } from "../../components/start2p.slint";
import { Nocive15, Nocive15Size } from "../../components/nocive_15.slint";

import { MisterBridge } from "../../api.slint";
import { ListView } from "std-widgets.slint";

component LicenseRow inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;

    height: 64px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;

    HorizontalLayout {
        padding: 12px;
        Nocive15 {
            text: label;
            color: focused ? #06d6a0 : #e8e0f0;
            size: Nocive15Size.px15;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Nocive15 {
            text: ">";
            color: focused ? #06d6a0 : #9080a8;
            size: Nocive15Size.px15;
            vertical-alignment: center;
        }
    }
}

export component LicensesScreen inherits Rectangle {

    if !MisterBridge.licenses-expanded : VerticalLayout {
        padding: 24px;
        spacing: 12px;

        HorizontalLayout {
            height: license-title.preferred-height;
            padding-left: 12px;
            license-title := Start2P {
                text: "Licenses";
                color: #e8e0f0;
                size: Start2PSize.px24;
                horizontal-alignment: left;
            }
        }
        LicenseRow { label: "MiSTer MagiK"; focused: MisterBridge.licenses-selected == 0; acknowledged: MisterBridge.selection-feedback-query("licenses", "mister-magik", MisterBridge.selection-feedback-revision); }
        LicenseRow { label: "FFmpeg"; focused: MisterBridge.licenses-selected == 1; acknowledged: MisterBridge.selection-feedback-query("licenses", "ffmpeg", MisterBridge.selection-feedback-revision); }
        LicenseRow { label: "Press Start 2P"; focused: MisterBridge.licenses-selected == 2; acknowledged: MisterBridge.selection-feedback-query("licenses", "press-start-2p", MisterBridge.selection-feedback-revision); }
        LicenseRow { label: "Commercial Fonts"; focused: MisterBridge.licenses-selected == 3; acknowledged: MisterBridge.selection-feedback-query("licenses", "commercial-fonts", MisterBridge.selection-feedback-revision); }
        LicenseRow { label: "Jersey 25"; focused: MisterBridge.licenses-selected == 4; acknowledged: MisterBridge.selection-feedback-query("licenses", "jersey-25", MisterBridge.selection-feedback-revision); }
        LicenseRow { label: "Arcade Cabinet"; focused: MisterBridge.licenses-selected == 5; acknowledged: MisterBridge.selection-feedback-query("licenses", "arcade-cabinet", MisterBridge.selection-feedback-revision); }
        LicenseRow { label: "Slint"; focused: MisterBridge.licenses-selected == 6; acknowledged: MisterBridge.selection-feedback-query("licenses", "slint", MisterBridge.selection-feedback-revision); }
        Rectangle { vertical-stretch: 1; background: transparent; }
        Start2P {
            text: "A: open    B: back";
            color: #6f8198;
            size: Start2PSize.px8;
            horizontal-alignment: center;
        }
    }

    if MisterBridge.licenses-expanded : VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Nocive15 {
            text: MisterBridge.licenses-selected == 0 ? "MiSTer MagiK  v" :
                  MisterBridge.licenses-selected == 1 ? "FFmpeg  v" :
                  MisterBridge.licenses-selected == 2 ? "Press Start 2P  v" :
                  MisterBridge.licenses-selected == 3 ? "Commercial Fonts  v" :
                  MisterBridge.licenses-selected == 4 ? "Jersey 25  v" :
                  MisterBridge.licenses-selected == 5 ? "Arcade Cabinet  v" : "Slint  v";
            color: #06d6a0;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
            background: #12101a;
            border-width: 1px;
            border-color: #5c4a72;
            ListView {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                viewport-y: -MisterBridge.licenses-scroll-y * 1px;
                for line in MisterBridge.license-lines : Start2P {
                    text: line;
                    color: #d8d0e0;
                    size: Start2PSize.px8;
                    height: 22px;
                    overflow: clip;
                    vertical-alignment: top;
                }
            }
        }
        Start2P {
            text: "Up/Down: scroll    A/B: close";
            color: #6f8198;
            size: Start2PSize.px8;
            horizontal-alignment: center;
        }
    }
}
