import { Spleen6x12, Spleen6x12Size } from "../../components/spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "../../components/nocive_15.slint";
import { FeedbackView, SettingsView } from "../../api.slint";

component LicenseRow inherits Rectangle {
    in property <string> label;
    in property <bool> focused;
    in property <bool> acknowledged;
    accessible-role: list-item;
    accessible-label: root.label;
    accessible-item-selected: root.focused;
    accessible-enabled: true;
    height: 64px;
    background: focused ? #2a2236 : #1e1828;
    border-width: focused ? 2px : 1px;
    border-color: focused ? #06d6a0 : acknowledged ? #4e8f80 : #5c4a72;
    HorizontalLayout {
        padding: 12px;
        Nocive15 { text: label; color: focused ? #06d6a0 : #e8e0f0; size: Nocive15Size.px15; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        Nocive15 { text: ">"; color: focused ? #06d6a0 : #9080a8; size: Nocive15Size.px15; vertical-alignment: center; }
    }
}

export component LicensesScreen inherits Rectangle {
    accessible-role: main;
    accessible-label: "Licenses screen";
    accessible-enabled: true;
    if !SettingsView.license-expanded : VerticalLayout {
        padding: 24px;
        spacing: 12px;
        HorizontalLayout {
            height: license-title.preferred-height;
            padding-left: 12px;
            license-title := Spleen6x12 { text: "Licenses"; color: #e8e0f0; size: Spleen6x12Size.px24; horizontal-alignment: left; }
        }
        for title[index] in SettingsView.license-titles : LicenseRow {
            label: title;
            focused: SettingsView.selected-license-index == index;
            acknowledged: FeedbackView.acknowledged("licenses", index == 0 ? "mister-magik" : index == 1 ? "ffmpeg" : index == 2 ? "press-start-2p" : index == 3 ? "commercial-fonts" : index == 4 ? "jersey-25" : index == 5 ? "jersey-15" : index == 6 ? "terminus-font" : index == 7 ? "spleen" : index == 8 ? "arcade-cabinet" : "slint", FeedbackView.revision);
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        Spleen6x12 { text: "A: open    B: back"; color: #6f8198; size: Spleen6x12Size.px8; horizontal-alignment: center; }
    }

    if SettingsView.license-expanded : VerticalLayout {
        padding: 24px;
        spacing: 12px;
        Nocive15 {
            text: SettingsView.license-titles[SettingsView.selected-license-index] + "  v";
            color: #06d6a0;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
        }
        Rectangle {
            vertical-stretch: 1;
            background: #12101a;
            border-width: 1px;
            border-color: #5c4a72;
            accessible-role: region;
            accessible-label: "License text";
            accessible-description: SettingsView.license-titles[SettingsView.selected-license-index];
            accessible-enabled: true;
            Flickable {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                content-y: -SettingsView.license-scroll-y * 1px;
                VerticalLayout {
                    for line in SettingsView.license-lines : Spleen6x12 {
                        text: line;
                        color: #d8d0e0;
                        size: Spleen6x12Size.px8;
                        height: 22px;
                        overflow: clip;
                        vertical-alignment: top;
                    }
                }
            }
        }
        Spleen6x12 { text: "Up/Down: scroll    A/B: close"; color: #6f8198; size: Spleen6x12Size.px8; horizontal-alignment: center; }
    }
}
