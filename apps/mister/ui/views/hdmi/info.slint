import { Spleen6x12, Spleen6x12Size } from "../../components/spleen_6x12.slint";

import { InformationView } from "../../api.slint";

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 54px;
    background: #1e1828;
    border-width: 1px;
    border-color: #5c4a72;
    VerticalLayout {
        padding: 10px;
        spacing: 5px;
        Spleen6x12 { text: label; color: #06d6a0; size: Spleen6x12Size.px8; }
        Spleen6x12 { text: value; color: #e8e0f0; size: Spleen6x12Size.px8; overflow: elide; }
    }
}

export component InfoScreen inherits Rectangle {
    VerticalLayout {
        padding: 32px;
        spacing: 12px;
        Spleen6x12 { text: "Info"; color: #06d6a0; size: Spleen6x12Size.px24; horizontal-alignment: center; }
        InfoRow { label: "Build"; value: InformationView.build-label; }
        InfoRow { label: "Display mode"; value: InformationView.present-mode-label; }
        InfoRow { label: "Database build"; value: InformationView.database-build; }
        InfoRow { label: "MiSTer kernel"; value: InformationView.kernel-version; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        Spleen6x12 { text: "B: back"; color: #6f8198; size: Spleen6x12Size.px8; horizontal-alignment: center; }
    }
}
