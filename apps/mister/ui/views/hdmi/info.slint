import { PixelText8, PixelTextSize } from "../../components/pixel_text_8.slint";

import { MisterBridge } from "../../api.slint";

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 54px;
    background: #1e1828;
    border-width: 1px;
    border-color: #5c4a72;
    VerticalLayout {
        padding: 10px;
        spacing: 5px;
        PixelText8 { text: label; color: #06d6a0; size: PixelTextSize.px8; }
        PixelText8 { text: value; color: #e8e0f0; size: PixelTextSize.px8; overflow: elide; }
    }
}

export component InfoScreen inherits Rectangle {
    VerticalLayout {
        padding: 32px;
        spacing: 12px;
        PixelText8 { text: "Info"; color: #06d6a0; size: PixelTextSize.px24; horizontal-alignment: center; }
        InfoRow { label: "Build"; value: MisterBridge.build-label; }
        InfoRow { label: "Display mode"; value: MisterBridge.present-mode-label; }
        InfoRow { label: "Database build"; value: MisterBridge.info-database-build; }
        InfoRow { label: "MiSTer kernel"; value: MisterBridge.info-kernel-version; }
        Rectangle { vertical-stretch: 1; background: transparent; }
        PixelText8 { text: "B: back"; color: #6f8198; size: PixelTextSize.px8; horizontal-alignment: center; }
    }
}

