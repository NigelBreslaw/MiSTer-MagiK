// Rust sets the root window dimensions before show. Defaults preserve the
// current launcher/benchmark design size when a caller does not override them.
export global MisterUi {
    in-out property <int> window-width: 960;
    in-out property <int> window-height: 540;
    in-out property <bool> crt-layout: false;
    out property <bool> compact-layout: crt-layout;
    // Defaults preserve the HDMI contract; Rust overrides them for CRT routes.
    in-out property <int> crt-grid-x: 8;
    in-out property <int> crt-grid-y: 8;
    in-out property <int> crt-border-x: 1;
    in-out property <int> crt-border-y: 1;
    in-out property <string> crt-font-family: "Press Start 2P";
    in-out property <int> crt-body-font: 8;
    in-out property <int> crt-heading-font: 16;
    in-out property <int> crt-card-title-font: 24;
    in-out property <int> crt-card-detail-font: 16;
    in-out property <int> crt-header-height: 48;
    in-out property <int> crt-footer-height: 40;
    in-out property <int> crt-game-row-height: 48;
    in-out property <int> crt-content-x: 0;
    in-out property <int> crt-content-y: 0;
    in-out property <int> crt-content-width: window-width;
    in-out property <int> crt-content-height: window-height;
    out property <length> grid-x: crt-grid-x * 1px;
    out property <length> grid-y: crt-grid-y * 1px;
    out property <length> border-x: crt-border-x * 1px;
    out property <length> border-y: crt-border-y * 1px;
    // Transitional aliases remain for non-layout consumers. CRT layout code
    // uses explicit axes.
    out property <length> grid: grid-y;
    out property <length> border: border-x;
    out property <length> body-font: crt-body-font * 1px;
    out property <length> heading-font: crt-heading-font * 1px;
    out property <length> card-title-font: crt-card-title-font * 1px;
    out property <length> card-detail-font: crt-card-detail-font * 1px;
    out property <length> header-height: crt-header-height * 1px;
    out property <length> footer-height: crt-footer-height * 1px;
    out property <length> game-row-height: crt-game-row-height * 1px;
    out property <length> content-x: crt-content-x * 1px;
    out property <length> content-y: crt-content-y * 1px;
    out property <length> content-width: crt-content-width * 1px;
    out property <length> content-height: crt-content-height * 1px;
}

export component MisterWindow inherits Window {
    width: MisterUi.window-width * 1px;
    height: MisterUi.window-height * 1px;
}
