// Rust <-> Slint bridge for MiSTer input and app state.
import { ArcadeGame } from "arcade_game.slint";
import { MenuItem, MenuItemPresentation } from "launcher_menu.slint";

export enum PreviewStatus {
    empty,
    loading,
    ready,
}

// Shared semantic vocabulary. Finite launcher state crosses the Rust/Slint
// boundary as enums; integers remain reserved for counts, geometry, timing,
// percentages, and indices into dynamic models.
export enum LauncherScreen { home, system-hub, controller, arcade, settings, screensaver-settings, about, licenses, info }
export enum SystemHubSection { games, recent, favourites, information }
export enum HomeFocus { menu, settings }
export enum HomeScrollPhase { idle, held, repeating }
export enum NavigationTransitionState { idle, active }
export enum SettingsSection { display, orientation, screensaver, reduce-motion, exit, rebuild, about }
export enum SettingsPopup { none, display-resolution, screen-orientation }
export enum DisplayTransactionState { idle, provisional, persisting, failed }
export enum ScreenOrientation { normal, monitor-clockwise, monitor-counterclockwise }
export enum ScreensaverSetting { enabled, delay, preview }
export enum AboutSection { information, licenses }
export enum InputAvailability { available, unavailable }
export enum SetupPhase { none, detected, new-or-existing, pick-existing, configure, name-kind }
export enum ArcadeListMode { games, recent, favourites }
export enum ArcadeLoadState { ready, loading }
export enum ArcadeSearchMode { inactive, active }
export enum ArcadeSearchStatus { idle, searching, ready, failed }
export enum ArcadeSearchPane { keyboard, results }
export enum PreviewState { empty, loading, ready, unavailable }
export enum CatalogActivity { idle, background, foreground }
export enum ProgressMode { indeterminate, determinate }
export enum MediaPackState { queued, downloading, complete, failed }
export enum ConfirmationKind {
    none,
    exit-to-mister,
    rebuild-database,
    restart,
    library-changed,
    library-update-failed,
    display-resolution,
    display-resolution-error,
    screen-orientation,
    add-favourite,
    remove-favourite,
}
export enum DialogChoice { cancel, confirm }
export enum LoadingState { idle, active }
export enum NavigationDirection { up, down, left, right }

export struct ChoiceOption { id: string, label: string }
export struct SetupEntry { id: string, label: string }
export struct SetupField { label: string, value: string }
export struct MediaPackRow {
    system: string,
    image-size: string,
    state: MediaPackState,
    phase-label: string,
    percent: int,
    bytes-label: string,
    pack-position: string,
}
export struct LayoutRect { x: int, y: int, width: int, height: int }

export struct ScreenshotPackProgress {
    system: string,
    image-size: string,
    phase: string,
    percent: int,
    bytes-label: string,
    pack-position: string,
}

// Host-owned launcher navigation shared by the independent CRT and HDMI
// presentation trees. Models preserve their Rust-owned retained identity.
export global NavigationView {
    in property <LauncherScreen> screen;
    in property <string> menu-title: "MiSTer MagiK";
    in property <string> menu-breadcrumb;
    in property <SystemHubSection> system-hub-section;
    in property <int> system-hub-games-count;
    in property <int> system-hub-recent-count;
    in property <int> system-hub-favourites-count;
    in property <image> system-artwork;
    in property <bool> system-artwork-available;
    in property <HomeFocus> home-focus;
    in property <int> home-selected-index;
    in property <HomeScrollPhase> home-scroll-phase;
    in property <int> home-scroll-x;
    in property <NavigationTransitionState> transition-state;
    in property <bool> update-available;
    in property <bool> development-build;
    in property <string> clock-text;
    in property <string> build-label;
    in property <string> present-mode-label;
    in property <[MenuItem]> menu-items;
    in property <[MenuItemPresentation]> menu-item-presentation;
}

export global FeedbackView {
    in property <int> revision;
    pure callback acknowledged(string, string, int) -> bool;
}

export global SettingsView {
    in property <SettingsSection> section;
    in property <SettingsPopup> popup;
    in property <[ChoiceOption]> display-options;
    in property <ChoiceOption> active-display;
    in property <ChoiceOption> selected-display;
    in property <ChoiceOption> highlighted-display;
    in property <DisplayTransactionState> display-transaction;
    in property <int> display-confirm-remaining;
    in property <[ChoiceOption]> orientation-options;
    in property <ScreenOrientation> active-orientation;
    in property <ScreenOrientation> selected-orientation;
    in property <ScreenOrientation> highlighted-orientation;
    in property <DisplayTransactionState> orientation-transaction;
    in property <int> orientation-confirm-remaining;
    in property <bool> simple-joystick-handling;
    in property <bool> reduce-motion;
    in property <ScreensaverSetting> screensaver-setting;
    in property <bool> screensaver-enabled;
    in property <int> screensaver-delay-minutes;
    in property <AboutSection> about-section;
    in property <int> selected-license-index;
    in property <[string]> license-titles;
    in property <bool> license-expanded;
    in property <int> license-scroll-y;
    in property <[string]> license-lines;
}

export global InformationView {
    in property <string> build-label;
    in property <string> present-mode-label;
    in property <string> kernel-version;
    in property <string> database-build;
}

export global InputView {
    in property <bool> dpad-up;
    in property <bool> dpad-down;
    in property <bool> dpad-left;
    in property <bool> dpad-right;
    in property <bool> button-a;
    in property <bool> button-b;
    in property <bool> button-x;
    in property <bool> button-y;
    in property <bool> button-l;
    in property <bool> button-r;
    in property <bool> button-zl;
    in property <bool> button-zr;
    in property <bool> button-select;
    in property <bool> button-start;
    in property <bool> button-l3;
    in property <bool> button-r3;
    in property <bool> button-home;
    in property <bool> button-capture;
    in property <InputAvailability> capture-availability;
    in property <float> left-x;
    in property <float> left-y;
    in property <float> right-x;
    in property <float> right-y;
    in property <string> device-label;
    in property <string> device-name;
    in property <string> usb-port;
    in property <string> usb-id;
    in property <string> serial-id;
    in property <string> js-counts;
    in property <string> pressed-now;
    in property <string> last-event-label;
    in property <string> last-raw-event;
    in property <InputAvailability> input-availability;
    in property <string> fault-notice;
}

export global SetupView {
    in property <SetupPhase> phase;
    in property <string> title;
    in property <string> subtitle;
    in property <[SetupEntry]> entries;
    in property <int> selected-entry-index;
    in property <[SetupField]> fields;
    in property <string> name;
    in property <string> kind-label;
}

// Semantic Arcade state shared by the independent CRT and HDMI render trees.
// Dynamic list indices remain numeric; stable game selection crosses the
// boundary as the MRA path in selected-game-id.
export global ArcadeView {
    in property <ArcadeListMode> list-mode;
    in property <ArcadeLoadState> load-state;
    in property <string> active-title;
    in property <int> active-count;
    in property <[ArcadeGame]> games;
    in property <int> selected-game-index;
    in property <string> selected-game-id;
    in property <bool> list-visible: true;
    in property <ArcadeSearchMode> search-mode;
    in property <string> search-query;
    in property <string> search-suggestion;
    in property <ArcadeSearchStatus> search-status;
    in property <[string]> search-keys;
    in property <int> selected-search-key-index;
    in property <ArcadeSearchPane> search-pane;
    in property <PreviewState> preview-state;
    in property <string> preview-title;
    in property <string> preview-run-label;
    in property <int> preview-source-width;
    in property <int> preview-source-height;
    in property <int> preview-display-width;
    in property <int> preview-display-height;
}

export global MisterBridge {
    // Full-screen boot splash, cleared after the first launcher state sync.
    in-out property <bool> startup-visible;
    // Rust-owned physically confirmed focus acknowledgements. The revision is
    // an explicit Slint dependency; the callback resolves stable surface/item IDs.
    in-out property <int> selection-feedback-revision;
    pure callback selection-feedback-query(string, string, int) -> bool;
    // Confirmation dialog.
    in-out property <bool> confirm-visible;
    in-out property <string> confirm-title;
    in-out property <string> confirm-message;
    in-out property <string> confirm-left-label;
    in-out property <string> confirm-right-label;
    // Dialog focus: 0=cancel, 1=confirm.
    in-out property <int> confirm-selected;
    in-out property <string> active-system-title;
    in-out property <int> active-system-count;
    in-out property <[ArcadeGame]> arcade-games;
    in-out property <int> arcade-selected;
    // Rust-painted arcade list geometry, in logical pixels.
    in-out property <int> arcade-list-x;
    in-out property <int> arcade-list-y;
    in-out property <int> arcade-list-width;
    in-out property <int> arcade-list-height;
    // CRT chrome geometry relative to the route-owned content rectangle.
    in-out property <int> arcade-crt-header-x;
    in-out property <int> arcade-crt-header-y;
    in-out property <int> arcade-crt-header-width;
    in-out property <int> arcade-crt-footer-x;
    in-out property <int> arcade-crt-footer-y;
    in-out property <int> arcade-crt-footer-width;
    in-out property <int> arcade-crt-keyboard-x;
    in-out property <int> arcade-crt-keyboard-y;
    in-out property <int> arcade-crt-keyboard-width;
    in-out property <int> arcade-crt-keyboard-height;
    in-out property <bool> arcade-list-visible: true;
    in-out property <bool> arcade-games-loading;
    in-out property <bool> arcade-search-active;
    in-out property <string> arcade-search-query;
    in-out property <string> arcade-search-suggestion;
    // 0 idle, 1 searching, 2 ready, 3 failed.
    in-out property <int> arcade-search-status;
    in-out property <[string]> arcade-search-keys;
    in-out property <int> arcade-search-key-selected;
    // 0=keyboard, 1=results.
    in-out property <int> arcade-search-pane;
    in-out property <string> arcade-preview-title;
    in-out property <string> arcade-preview-run-label;
    in-out property <bool> arcade-preview-placeholder-visible: true;
    in-out property <PreviewStatus> arcade-preview-status: PreviewStatus.empty;
    in-out property <int> arcade-preview-source-width;
    in-out property <int> arcade-preview-source-height;
    in-out property <int> arcade-preview-display-width;
    in-out property <int> arcade-preview-display-height;
    // Screenshot box geometry, in logical pixels.
    in-out property <int> arcade-preview-box-x;
    in-out property <int> arcade-preview-box-y;
    in-out property <int> arcade-preview-box-width;
    in-out property <int> arcade-preview-box-height;
    // Background startup catalog scan.
    in-out property <bool> catalog-scan-visible;
    in-out property <string> catalog-scan-message;
    in-out property <string> catalog-scan-title;
    in-out property <string> catalog-scan-detail;
    // -1 means indeterminate.
    in-out property <int> catalog-scan-percent: -1;
    in-out property <[ScreenshotPackProgress]> media-pack-progresses;
    in-out property <string> media-pack-summary;
    // Small global badge for background catalog validation while cached UI is usable.
    in-out property <bool> catalog-background-scan-visible;
    // Rust-owned 500 ms blink phase shared by catalog scan indicators.
    in-out property <bool> catalog-scan-dot-visible: true;
    // Non-empty while launching a game - full-screen loading overlay.
    in-out property <string> loading-message;
    in-out property <string> loading-detail;
    callback quit-requested();
}
