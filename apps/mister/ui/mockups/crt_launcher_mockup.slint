import { Start2P, Start2PSize } from "../components/start2p.slint";
import "../fonts/PressStart2P-Regular.ttf";

component LauncherRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;

    height: 72px;
    background: selected ? #113954 : #06152f;
    border-width: 2px;
    border-color: selected ? #40e5e7 : #8b94f8;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;

        Start2P {
            width: 32px;
            text: selected ? ">" : "";
            color: #40e5e7;
            size: Start2PSize.px32;
            vertical-alignment: center;
        }

        Start2P {
            text: label;
            color: selected ? #40e5e7 : #aab0ff;
            size: Start2PSize.px32;
            vertical-alignment: center;
        }
    }
}

export component CrtLauncherMockup inherits Window {
    width: 640px;
    height: 480px;
    title: "MiSTer MagiK CRT Launcher Mockup";
    background: #020817;
    default-font-family: "Press Start 2P";

    Rectangle {
        x: 16px;
        y: 16px;
        width: 608px;
        height: 448px;
        background: #020817;
        border-width: 2px;
        border-color: #8b94f8;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 56px;
            background: #050d23;
            border-width: 2px;
            border-color: #8b94f8;

            Start2P {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: "MiSTer MagiK";
                color: #aab0ff;
                size: Start2PSize.px32;
                vertical-alignment: center;
            }

            Start2P {
                x: parent.width - 112px;
                width: 96px;
                height: parent.height;
                text: "21:14";
                color: #aab0ff;
                size: Start2PSize.px24;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            x: 16px;
            y: 80px;
            width: parent.width - 32px;
            height: 328px;
            spacing: 8px;

            LauncherRow { label: "Arcade"; selected: true; }
            LauncherRow { label: "Consoles"; }
            LauncherRow { label: "Computers"; }
            LauncherRow { label: "Handhelds"; }
        }
    }
}
