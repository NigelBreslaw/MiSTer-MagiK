import { Start2P, Start2PSize } from "../components/start2p.slint";
import { Nocive15, Nocive15Size } from "../components/nocive_15.slint";
import "../fonts/PressStart2P-Regular.ttf";

export component CrtResolutionComboMockup inherits Window {
    width: 640px;
    height: 480px;
    title: "MiSTer MagiK CRT Resolution Combo Mockup";
    background: #020817;
    default-font-family: "Press Start 2P";
    forward-focus: focus-scope;

    in-out property <[string]> resolutions: [
        "1280x720 (16:9)",
        "1366x768 (16:9)",
        "1920x1080 (16:9)",
        "1920x1200 (16:10)",
        "2048x1536 (4:3)",
        "CRT 240p 60hz NTSC",
        "CRT 288p 50hz PAL",
    ];
    in-out property <int> selected-index: 2;
    in-out property <int> highlighted-index: 5;
    property <length> row-height: 30px;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.DownArrow && root.highlighted-index < root.resolutions.length - 1) {
                root.highlighted-index += 1;
                return accept;
            }
            if (event.text == Key.UpArrow && root.highlighted-index > 0) {
                root.highlighted-index -= 1;
                return accept;
            }
            if (event.text == Key.Return) {
                root.selected-index = root.highlighted-index;
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 16px;
            y: 16px;
            width: 608px;
            height: 448px;
            background: #020817;
            border-width: 2px;
            border-color: #8b94f8;

            Start2P {
                x: 16px;
                y: 8px;
                width: parent.width - 32px;
                height: 48px;
                text: "Display resolution";
                color: #aaa5ff;
                size: Start2PSize.px32;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Rectangle {
                x: 16px;
                y: 64px;
                width: parent.width - 32px;
                height: 2px;
                background: #756bd4;
            }

            list-viewport := Rectangle {
                x: 24px;
                y: 72px;
                width: parent.width - 48px;
                height: root.resolutions.length * root.row-height;
                background: #06122b;
                border-width: 2px;
                border-color: #5e59aa;
                clip: true;

                for resolution[index] in root.resolutions : Rectangle {
                    y: index * root.row-height;
                    width: parent.width;
                    height: root.row-height;
                    background: index == root.highlighted-index ? #40e5e7 : #06122b;
                    border-width: 1px;
                    border-color: index == root.highlighted-index ? #40e5e7 : #5e59aa;

                    Start2P {
                        x: 8px;
                        width: 24px;
                        height: parent.height;
                        text: index == root.highlighted-index ? ">" : "";
                        color: #03132d;
                        size: Start2PSize.px24;
                        vertical-alignment: center;
                    }

                    Nocive15 {
                        x: 40px;
                        width: parent.width - 80px;
                        height: parent.height;
                        text: resolution;
                        color: index == root.highlighted-index ? #03132d : #aaa5ff;
                        size: Nocive15Size.px15;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    Start2P {
                        x: parent.width - 40px;
                        width: 24px;
                        height: parent.height;
                        text: index == root.selected-index ? "*" : "";
                        color: index == root.highlighted-index ? #03132d : #40e5e7;
                        size: Start2PSize.px24;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                x: 16px;
                y: 408px;
                width: parent.width - 32px;
                height: 2px;
                background: #756bd4;
            }

            Nocive15 {
                x: 24px;
                y: 416px;
                width: parent.width - 48px;
                height: 24px;
                text: "UP/DOWN Move     A Select     B Cancel     * Current";
                color: #aaa5ff;
                size: Nocive15Size.px15;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
