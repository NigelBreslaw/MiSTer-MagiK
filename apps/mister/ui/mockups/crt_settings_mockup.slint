import { Start2P, Start2PSize } from "../components/start2p.slint";
import "../fonts/PressStart2P-Regular.ttf";

component SettingsCell inherits Rectangle {
    in property <string> value;
    in property <bool> selected: false;
    in property <bool> right-aligned: false;

    background: selected ? #40e5e7 : #06122b;
    border-width: 2px;
    border-color: selected ? #40e5e7 : #5e59aa;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        cross-axis-alignment: center;

        Start2P {
            text: value;
            color: selected ? #03132d : #aaa5ff;
            size: Start2PSize.px24;
            horizontal-alignment: right-aligned ? right : left;
            vertical-alignment: center;
        }
    }
}

export component CrtSettingsMockup inherits Window {
    width: 640px;
    height: 480px;
    title: "MiSTer MagiK CRT Settings Mockup";
    background: #020817;
    default-font-family: "Press Start 2P";

    Start2P {
        x: 0;
        y: 16px;
        width: parent.width;
        height: 48px;
        text: "Settings";
        color: #aaa5ff;
        size: Start2PSize.px32;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: 24px;
        y: 72px;
        width: parent.width - 48px;
        height: 2px;
        background: #756bd4;
    }

    GridLayout {
        x: 24px;
        y: 104px;
        width: parent.width - 48px;
        height: 280px;
        spacing: 0px;

        Row {
            SettingsCell { value: "Resolution"; selected: true; }
            SettingsCell { value: "640x480 60Hz"; selected: true; right-aligned: true; }
        }
        Row {
            SettingsCell { value: "Video output"; }
            SettingsCell { value: "HDMI"; }
        }
        Row {
            SettingsCell { value: "Theme"; }
            SettingsCell { value: "MagiK Dark"; }
        }
        Row {
            SettingsCell { value: "Screensaver"; }
            SettingsCell { value: "5 min"; }
        }
        Row {
            SettingsCell { value: "About"; }
            SettingsCell { value: ""; }
        }
    }

    Rectangle {
        x: 24px;
        y: 408px;
        width: parent.width - 48px;
        height: 2px;
        background: #756bd4;
    }

    Start2P {
        x: 88px;
        y: 424px;
        width: 208px;
        height: 40px;
        text: "Change";
        color: #aaa5ff;
        size: Start2PSize.px24;
        vertical-alignment: center;
    }

    Start2P {
        x: parent.width - 200px;
        y: 424px;
        width: 160px;
        height: 40px;
        text: "Back";
        color: #aaa5ff;
        size: Start2PSize.px24;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        x: 40px;
        y: 428px;
        width: 32px;
        height: 32px;
        background: #40e5e7;

        Start2P {
            width: parent.width;
            height: parent.height;
            text: "A";
            color: #03132d;
            size: Start2PSize.px24;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: parent.width - 248px;
        y: 428px;
        width: 32px;
        height: 32px;
        background: #40e5e7;

        Start2P {
            width: parent.width;
            height: parent.height;
            text: "B";
            color: #03132d;
            size: Start2PSize.px24;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
