import { Spleen6x12, Spleen6x12Size } from "../components/spleen_6x12.slint";
import { Nocive15, Nocive15Size } from "../components/nocive_15.slint";

component NavHint inherits HorizontalLayout {
    in property <string> button;
    in property <string> label;

    spacing: 8px;
    cross-axis-alignment: center;

    Rectangle {
        width: 24px;
        height: 24px;
        background: #aaa5ff;

        Nocive15 {
            width: parent.width;
            height: parent.height;
            text: root.button;
            color: #03132d;
            size: Nocive15Size.px15;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Nocive15 {
        text: root.label;
        color: #aaa5ff;
        size: Nocive15Size.px15;
        vertical-alignment: center;
    }
}

export component CrtArcadeListMockup inherits Window {
    width: 640px;
    height: 480px;
    title: "MiSTer MagiK CRT Arcade List Mockup";
    background: #020817;
    forward-focus: focus-scope;

    in-out property <[string]> games: [
        "1941: Counter Attack",
        "1942 (Revision B)",
        "Bubble Bobble",
        "Cadillacs and Dinosaurs",
        "DoDonPachi",
        "Metal Slug 3",
        "Out Run",
        "Street Fighter II",
        "The Simpsons",
        "Wonder Boy",
        "X-Men",
        "Zero Wing",
        "Raiden II",
        "R-Type",
        "Shinobi",
    ];
    in-out property <int> highlighted-index: 5;
    property <int> visible-count: 10;
    property <int> first-visible: (highlighted-index - 5).clamp(
        0,
        (games.length - visible-count).max(0),
    );
    property <length> row-height: 32px;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.DownArrow && root.highlighted-index < root.games.length - 1) {
                root.highlighted-index += 1;
                return accept;
            }
            if (event.text == Key.UpArrow && root.highlighted-index > 0) {
                root.highlighted-index -= 1;
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 16px;
            y: 16px;
            width: 608px;
            height: 448px;
            background: #020817;
            border-width: 2px;
            border-color: #8b94f8;

            VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                min-height: parent.height;
                max-height: parent.height;
                spacing: 0px;

                Rectangle {
                    height: 48px;
                    background: #020817;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        cross-axis-alignment: center;

                        Rectangle { width: 136px; background: transparent; }

                        Spleen6x12 {
                            text: "Arcade";
                            color: #aaa5ff;
                            size: Spleen6x12Size.px32;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        Spleen6x12 {
                            width: 136px;
                            text: "245 / 915";
                            color: #aaa5ff;
                            size: Spleen6x12Size.px24;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    max-height: 1000px;
                    background: #020817;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        cross-axis-alignment: start;

                        list-viewport := Rectangle {
                            height: root.visible-count * root.row-height;
                            horizontal-stretch: 1;
                            background: #06122b;
                            border-width: 2px;
                            border-color: #8b94f8;
                            clip: true;

                            for game[index] in root.games : Rectangle {
                                y: (index - root.first-visible) * root.row-height;
                                width: parent.width;
                                height: root.row-height;
                                visible: index >= root.first-visible
                                    && index < root.first-visible + root.visible-count;
                                background: index == root.highlighted-index ? #40e5e7 : #06122b;
                                border-width: 1px;
                                border-color: index == root.highlighted-index ? #40e5e7 : #5e59aa;

                                Spleen6x12 {
                                    x: 8px;
                                    width: 24px;
                                    height: parent.height;
                                    text: index == root.highlighted-index ? ">" : "";
                                    color: #03132d;
                                    size: Spleen6x12Size.px24;
                                    vertical-alignment: center;
                                }

                                Nocive15 {
                                    x: 40px;
                                    width: parent.width - 56px;
                                    height: parent.height;
                                    text: game;
                                    color: index == root.highlighted-index ? #03132d : #aaa5ff;
                                    size: Nocive15Size.px15;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            width: 16px;
                            height: list-viewport.height;
                            background: #0b0d25;
                            border-width: 2px;
                            border-color: #8b94f8;

                            Rectangle {
                                y: root.first-visible * (parent.height - self.height)
                                    / (root.games.length - root.visible-count);
                                width: parent.width;
                                height: parent.height * root.visible-count / root.games.length;
                                background: #8b94f8;
                            }
                        }
                    }
                }

                Rectangle {
                    min-height: 40px;
                    max-height: 40px;
                    background: #020817;
                    border-width: 2px;
                    border-color: #8b94f8;

                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        spacing: 16px;
                        cross-axis-alignment: center;

                        NavHint { button: "B"; label: "Back"; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        NavHint { button: "A"; label: "Launch"; }
                        NavHint { button: "Y"; label: "Search"; }
                    }
                }
            }
        }
    }
}
