import { Start2P, Start2PSize } from "../components/start2p.slint";
import { Nocive15, Nocive15Size } from "../components/nocive_15.slint";
import { MisterWindow, MisterUi } from "../mister_window.slint";
export { MisterUi }
export { Start2PSize }
import "../fonts/PressStart2P-Regular.ttf";

export component VideoPlayback inherits MisterWindow {
    background: #090b10;
    default-font-family: "Press Start 2P";

    in-out property <image> frame;


    Rectangle {
        x: 0px;
        y: 0px;
        width: 704px;
        height: parent.height;
        background: #05070a;
    }

    Image {
        x: 40px;
        y: 30px;
        width: 640px;
        height: 480px;
        source: root.frame;
        image-fit: contain;
    }

    Rectangle {
        x: 704px;
        y: 72px;
        width: 216px;
        height: 396px;
        background: #121722;
        border-radius: 6px;
    }

    Start2P {
        x: 724px;
        y: 104px;
        text: "bench:";
        size: Start2PSize.px8;
        color: #8fb6ff;
    }

    Nocive15 {
        x: 724px;
        y: 136px;
        width: 176px;
        text: "video_playback";
        size: Nocive15Size.px15;
        color: #f2f6ff;
        wrap: word-wrap;
    }

    Start2P {
        x: 724px;
        y: 210px;
        width: 172px;
        text: "H.264/AAC MP4 snaps";
        size: Start2PSize.px8;
        color: #b7c1d6;
        wrap: word-wrap;
    }
}
