import { PixelText8, PixelTextSize } from "../components/pixel_text_8.slint";
import { MisterWindow, MisterUi } from "../mister_window.slint";
export { MisterUi }
export { PixelTextSize }
import "../fonts/MagikPixel-Regular.ttf";

export component VideoPlayback inherits MisterWindow {
    background: #090b10;
    default-font-family: "MagiK Pixel";

    in-out property <image> frame;


    Rectangle {
        x: 0px;
        y: 0px;
        width: 704px;
        height: parent.height;
        background: #05070a;
    }

    Image {
        x: 40px;
        y: 30px;
        width: 640px;
        height: 480px;
        source: root.frame;
        image-fit: contain;
    }

    Rectangle {
        x: 704px;
        y: 72px;
        width: 216px;
        height: 396px;
        background: #121722;
        border-radius: 6px;
    }

    PixelText8 {
        x: 724px;
        y: 104px;
        text: "bench:";
        size: PixelTextSize.px8;
        color: #8fb6ff;
    }

    PixelText8 {
        x: 724px;
        y: 136px;
        width: 176px;
        text: "video_playback";
        size: PixelTextSize.px16;
        color: #f2f6ff;
        wrap: word-wrap;
        line-capacity: 2;
    }

    PixelText8 {
        x: 724px;
        y: 210px;
        width: 172px;
        text: "H.264/AAC MP4 snaps";
        size: PixelTextSize.px8;
        color: #b7c1d6;
        wrap: word-wrap;
        line-capacity: 2;
    }
}
