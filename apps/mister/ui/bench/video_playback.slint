import { MisterWindow, MisterUi } from "../mister_window.slint";
export { MisterUi }
import "../fonts/PressStart2P-Regular.ttf";

export component VideoPlayback inherits MisterWindow {
    background: #090b10;
    default-font-family: "Press Start 2P";

    in-out property <image> frame;

    property <int> s: MisterUi.scale;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 704px * s;
        height: parent.height;
        background: #05070a;
    }

    Image {
        x: 40px * s;
        y: 30px * s;
        width: 640px * s;
        height: 480px * s;
        source: root.frame;
        image-fit: contain;
    }

    Rectangle {
        x: 704px * s;
        y: 72px * s;
        width: 216px * s;
        height: 396px * s;
        background: #121722;
        border-radius: 6px * s;
    }

    Text {
        x: 724px * s;
        y: 104px * s;
        text: "bench:";
        font-size: 12px * s;
        color: #8fb6ff;
    }

    Text {
        x: 724px * s;
        y: 136px * s;
        width: 176px * s;
        text: "video_playback";
        font-size: 16px * s;
        color: #f2f6ff;
        wrap: word-wrap;
    }

    Text {
        x: 724px * s;
        y: 210px * s;
        width: 172px * s;
        text: "H.264/AAC MP4 snaps";
        font-size: 12px * s;
        color: #b7c1d6;
        wrap: word-wrap;
    }
}
