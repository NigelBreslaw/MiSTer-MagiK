set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONTAINER_BIN="${MISTER_LINUX_VERIFY_CONTAINER_BIN:-container}"
IMAGE="${MISTER_LINUX_VERIFY_IMAGE:-mister-magik-cross-armv7:ubuntu20-arm64}"
CACHE_ROOT="${MISTER_LINUX_VERIFY_CACHE_ROOT:-/private/tmp/mister-magik-linux-verify}"
CPUS="${MISTER_LINUX_VERIFY_CPUS:-8}"
MEMORY="${MISTER_LINUX_VERIFY_MEMORY:-8g}"

if [[ "$(uname -s)" != Darwin || "$(uname -m)" != arm64 ]]; then
  echo "agent-linux-verify requires Apple Silicon macOS" >&2
  exit 2
fi
if ! command -v "$CONTAINER_BIN" >/dev/null 2>&1; then
  echo "agent-linux-verify requires Apple container" >&2
  exit 2
fi

mkdir -p "$CACHE_ROOT/cargo" "$CACHE_ROOT/rustup" "$CACHE_ROOT/target"

exec "$CONTAINER_BIN" run \
  --arch arm64 \
  --rm \
  --cpus "$CPUS" \
  --memory "$MEMORY" \
  --env CARGO_HOME=/linux-cargo \
  --env RUSTUP_HOME=/linux-rustup \
  --env CARGO_TARGET_DIR=/target \
  --env RUSTC_WRAPPER= \
  --env MISTER_AGENT_CLI_PROFILE=debug \
  --volume "$CACHE_ROOT/cargo:/linux-cargo" \
  --volume "$CACHE_ROOT/rustup:/linux-rustup" \
  --volume "$CACHE_ROOT/target:/target" \
  --volume "$ROOT:/project" \
  --workdir /project \
  "$IMAGE" \
  sh -lc '
    set -eu
    apt-get update >/dev/null
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
      ca-certificates curl git libssl-dev pkg-config ripgrep >/dev/null
    if [ ! -x /linux-cargo/bin/rustup ]; then
      curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs |
        sh -s -- -y --profile minimal --default-toolchain 1.97.1 \
          --component clippy --component rustfmt
    fi
    export PATH="/linux-cargo/bin:$PATH"
    rustup component add clippy rustfmt --toolchain 1.97.1 >/dev/null
    exec scripts/agent verify "$@"
  ' sh "$@"
