#!/usr/bin/env python3
"""Attended platform delivery using MiSTer MagiK 2.0."""

import os
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root))
if len(sys.argv) > 1 and sys.argv[1] == "fpga":
    from scripts.magik_ci.platform import main

    raise SystemExit(main(root, sys.argv[2:]))
entrypoint = str(root / "scripts/magik2")
os.execv(entrypoint, [entrypoint, "platform", *sys.argv[1:]])
