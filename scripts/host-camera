#!/usr/bin/env bash
# Copyright (C) 2026 Nigel Breslaw
# SPDX-License-Identifier: GPL-3.0-or-later

# Capture still images or short videos from a macOS USB camera via FFmpeg.
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "host-camera: only macOS/avfoundation is supported by this helper" >&2
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "host-camera: ffmpeg not found; install it with Homebrew or another package manager" >&2
  exit 1
fi

command="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

device="${HOST_CAMERA_DEVICE:-0}"
size="${HOST_CAMERA_SIZE:-}"
pixel_format="${HOST_CAMERA_PIXEL_FORMAT:-}"
framerate="${HOST_CAMERA_FRAMERATE:-30}"
duration="${HOST_CAMERA_DURATION:-5}"
output=""
show_command=0

usage() {
  cat <<'EOF'
Usage:
  scripts/host-camera list
  scripts/host-camera frame [--device DEVICE] [--size WxH] [--pixel-format FMT] [--framerate N] [--output PATH]
  scripts/host-camera video [--device DEVICE] [--size WxH] [--pixel-format FMT] [--framerate N] [--duration SECS] [--output PATH]

Examples:
  scripts/host-camera list
  scripts/host-camera frame --device 0
  scripts/host-camera frame --device "USB Camera" --output /tmp/usb-camera.jpg
  scripts/host-camera video --device 0 --duration 10 --output /tmp/usb-camera.mp4

Environment defaults:
  HOST_CAMERA_DEVICE       default: 0
  HOST_CAMERA_SIZE         optional, for example 1280x720
  HOST_CAMERA_PIXEL_FORMAT optional, for example uyvy422
  HOST_CAMERA_FRAMERATE    default: 30
  HOST_CAMERA_DURATION     default: 5

On first use, macOS may ask for Camera permission for the terminal/Codex app.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --device) device="${2:?}"; shift 2 ;;
    --size) size="${2:?}"; shift 2 ;;
    --pixel-format) pixel_format="${2:?}"; shift 2 ;;
    --framerate) framerate="${2:?}"; shift 2 ;;
    --duration) duration="${2:?}"; shift 2 ;;
    --output) output="${2:?}"; shift 2 ;;
    --show-command) show_command=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) echo "unexpected argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"

ffmpeg_base_args=(-hide_banner -loglevel warning -f avfoundation -framerate "$framerate")
if [[ -n "$size" ]]; then
  ffmpeg_base_args+=(-video_size "$size")
fi
if [[ -n "$pixel_format" ]]; then
  ffmpeg_base_args+=(-pixel_format "$pixel_format")
fi
ffmpeg_base_args+=(-i "$device")

run_ffmpeg() {
  if [[ "$show_command" -eq 1 ]]; then
    printf 'ffmpeg'
    printf ' %q' "$@"
    printf '\n'
  fi
  ffmpeg "$@"
}

case "$command" in
  list)
    ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 || true
    ;;
  frame)
    if [[ -z "$output" ]]; then
      output="/tmp/host-camera-$timestamp.jpg"
    fi
    mkdir -p "$(dirname "$output")"
    run_ffmpeg -y "${ffmpeg_base_args[@]}" -frames:v 1 -update 1 "$output"
    echo "$output"
    ;;
  video)
    if [[ -z "$output" ]]; then
      output="/tmp/host-camera-$timestamp.mp4"
    fi
    if [[ ! "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
      echo "duration must be a positive number of seconds" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$output")"
    run_ffmpeg -y "${ffmpeg_base_args[@]}" -t "$duration" -c:v libx264 -pix_fmt yuv420p "$output"
    echo "$output"
    ;;
  ""|-h|--help)
    usage
    ;;
  *)
    echo "unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac
