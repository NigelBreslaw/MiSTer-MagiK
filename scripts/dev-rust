#!/usr/bin/env bash
# Copyright (C) 2026 Nigel Breslaw
# SPDX-License-Identifier: GPL-3.0-or-later

# Fast Rust dev commands for host-side checks and tests.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUST_DIR="$ROOT/apps/mister"
export RUSTC_WRAPPER=""

usage() {
  cat <<'EOF'
Usage: scripts/dev-rust <command>

Commands:
  fmt       Run cargo fmt --check
  fmt-fix   Run cargo fmt
  test      Run fast host logic tests without Slint/UI
  check     Compile the host-testable library without Slint/UI
  host-tools  Run cheap host-side script/Rust checks
  host-tools-fast  Run pre-commit-safe static host checks
  check-arm-lib      Cross-check host-testable library for ARM, without Slint/UI
  check-arm-ui       Cross-check launcher/controller Slint UI for ARM
  check-ui           Alias for check-arm-ui
  check-arm-arcade-ui Cross-check launcher-backed arcade UI for ARM
  check-arm-ui-full  Cross-check all Slint UI scenes and experiments for ARM
  check-ui-full      Alias for check-arm-ui-full
  build-arm-debug       Cross-build launcher/controller ARM debug binary
  build-arm-arcade-debug Cross-build launcher-backed arcade ARM debug binary
  build-arm-debug-full  Cross-build all-scene ARM debug binary
  build-ui  Build the optimized ARM Slint binary via apps/mister/build-arm.sh
EOF
}

need_component_hint() {
  local component="$1" toolchain
  toolchain="$(
    sed -n 's/^channel = "\([^"]*\)"$/\1/p' "$RUST_DIR/rust-toolchain.toml"
  )"
  echo "Hint: this repo declares Rust components in apps/mister/rust-toolchain.toml." >&2
  echo "      If rustup did not install $component automatically, run:" >&2
  echo "      rustup component add $component --toolchain ${toolchain:-<pinned-channel>}" >&2
}

cross_env() {
  if [ "${MISTER_ARM_BUILD_BACKEND:-auto}" != cross ] &&
    [ "$(uname -s)" = Darwin ] &&
    [ "$(uname -m)" = arm64 ]; then
    echo "ERROR: local Apple-Silicon ARM builds use Apple's container runtime, not cross/Docker." >&2
    echo "       Use apps/mister/build-arm.sh for device builds, or set MISTER_ARM_BUILD_BACKEND=cross explicitly for a comparison." >&2
    exit 1
  fi
  export DOCKER_DEFAULT_PLATFORM=linux/amd64
  export SLINT_FONT_SIZES="${SLINT_FONT_SIZES:-8,16,24,32,48}"
}

cross_ui_env() {
  cross_env
  bash "$RUST_DIR/scripts/build-minimal-ffmpeg.sh"
  export FFMPEG_DIR=/target/ffmpeg-minimal/armv7/dist
  export PKG_CONFIG_PATH=/target/ffmpeg-minimal/armv7/dist/lib/pkgconfig
  export PKG_CONFIG_ALLOW_CROSS=1
  export CFLAGS="${CFLAGS:+$CFLAGS }-I/target/ffmpeg-minimal/armv7/dist/include"
  export HOST_CFLAGS="${HOST_CFLAGS:+$HOST_CFLAGS }-I/target/ffmpeg-minimal/armv7/dist/include"
  export CFLAGS_x86_64_unknown_linux_gnu="${CFLAGS_x86_64_unknown_linux_gnu:+$CFLAGS_x86_64_unknown_linux_gnu }-I/target/ffmpeg-minimal/armv7/dist/include"
}

cmd="${1:-}"
case "$cmd" in
  fmt)
    cd "$RUST_DIR"
    if ! cargo fmt --check; then
      need_component_hint rustfmt
      exit 1
    fi
    ;;
  fmt-fix)
    cd "$RUST_DIR"
    if ! cargo fmt; then
      need_component_hint rustfmt
      exit 1
    fi
    ;;
  test)
    cd "$RUST_DIR"
    cargo test --lib --no-default-features
    ;;
  check)
    cd "$RUST_DIR"
    cargo check --lib --no-default-features
    ;;
  host-tools)
    bash "$ROOT/scripts/test-host-tools.sh" --full
    ;;
  host-tools-fast)
    bash "$ROOT/scripts/test-host-tools.sh" --fast
    ;;
  check-arm-lib)
    "$RUST_DIR/build-arm.sh" --check --lib-only
    ;;
  check-arm-ui|check-ui)
    "$RUST_DIR/build-arm.sh" --check --ui-scope launcher
    ;;
  check-arm-arcade-ui)
    "$RUST_DIR/build-arm.sh" --check --ui-scope arcade
    ;;
  check-arm-ui-full|check-ui-full)
    "$RUST_DIR/build-arm.sh" --check --ui-scope all --experiments
    ;;
  build-arm-debug)
    cd "$RUST_DIR"
    cross_ui_env
    MISTER_UI_BUILD_SCOPE=launcher cross build \
      --target armv7-unknown-linux-gnueabihf \
      --features ui \
      --timings \
      --locked
    ;;
  build-arm-arcade-debug)
    cd "$RUST_DIR"
    cross_ui_env
    MISTER_UI_BUILD_SCOPE=arcade cross build \
      --target armv7-unknown-linux-gnueabihf \
      --features ui \
      --timings \
      --locked
    ;;
  build-arm-debug-full)
    cd "$RUST_DIR"
    cross_ui_env
    MISTER_UI_BUILD_SCOPE=all cross build \
      --target armv7-unknown-linux-gnueabihf \
      --features ui,experiments \
      --timings \
      --locked
    ;;
  build-ui)
    "$RUST_DIR/build-arm.sh"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
