#!/usr/bin/env bash
# Fast Rust dev commands for host-side checks and tests.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUST_DIR="$ROOT/magik-gui"
export RUSTC_WRAPPER=""

usage() {
  cat <<'EOF'
Usage: scripts/dev-rust <command>

Commands:
  fmt       Run cargo fmt --check
  fmt-fix   Run cargo fmt
  test      Run fast host logic tests without Slint/UI
  check     Compile the host-testable library without Slint/UI
  host-tools  Run cheap host-side script/AWK/Python checks
  check-arm-lib      Cross-check host-testable library for ARM, without Slint/UI
  check-arm-ui       Cross-check launcher/controller Slint UI for ARM
  check-ui           Alias for check-arm-ui
  check-arm-arcade-ui Cross-check standalone arcade page Slint UI for ARM
  check-arm-ui-full  Cross-check all Slint UI scenes for ARM
  check-ui-full      Alias for check-arm-ui-full
  build-arm-debug       Cross-build launcher/controller ARM debug binary
  build-arm-arcade-debug Cross-build standalone arcade page ARM debug binary
  build-arm-debug-full  Cross-build all-scene ARM debug binary
  build-ui  Build the ARM Slint binary via magik-gui/build-arm.sh --fast
EOF
}

need_component_hint() {
  local component="$1"
  echo "Hint: this repo declares Rust components in magik-gui/rust-toolchain.toml." >&2
  echo "      If rustup did not install $component automatically, run:" >&2
  echo "      rustup component add $component --toolchain stable-aarch64-apple-darwin" >&2
}

cross_env() {
  export DOCKER_DEFAULT_PLATFORM=linux/amd64
  export SLINT_FONT_SIZES="${SLINT_FONT_SIZES:-8,16,24,32,48}"
}

cmd="${1:-}"
case "$cmd" in
  fmt)
    cd "$RUST_DIR"
    if ! cargo fmt --check; then
      need_component_hint rustfmt
      exit 1
    fi
    ;;
  fmt-fix)
    cd "$RUST_DIR"
    if ! cargo fmt; then
      need_component_hint rustfmt
      exit 1
    fi
    ;;
  test)
    cd "$RUST_DIR"
    cargo test --lib --no-default-features
    ;;
  check)
    cd "$RUST_DIR"
    cargo check --lib --no-default-features
    ;;
  host-tools)
    "$ROOT/scripts/test-host-tools.sh"
    ;;
  check-arm-lib)
    cd "$RUST_DIR"
    cross_env
    cross check \
      --lib \
      --target armv7-unknown-linux-gnueabihf \
      --no-default-features \
      --timings \
      --locked
    ;;
  check-arm-ui|check-ui)
    cd "$RUST_DIR"
    cross_env
    MISTER_UI_BUILD_SCOPE=launcher cross check \
      --target armv7-unknown-linux-gnueabihf \
      --features ui \
      --timings \
      --locked
    ;;
  check-arm-arcade-ui)
    cd "$RUST_DIR"
    cross_env
    MISTER_UI_BUILD_SCOPE=arcade cross check \
      --target armv7-unknown-linux-gnueabihf \
      --features ui \
      --timings \
      --locked
    ;;
  check-arm-ui-full|check-ui-full)
    cd "$RUST_DIR"
    cross_env
    MISTER_UI_BUILD_SCOPE=all cross check \
      --target armv7-unknown-linux-gnueabihf \
      --features ui,bench-scenes \
      --timings \
      --locked
    ;;
  build-arm-debug)
    cd "$RUST_DIR"
    cross_env
    MISTER_UI_BUILD_SCOPE=launcher cross build \
      --target armv7-unknown-linux-gnueabihf \
      --features ui \
      --timings \
      --locked
    ;;
  build-arm-arcade-debug)
    cd "$RUST_DIR"
    cross_env
    MISTER_UI_BUILD_SCOPE=arcade cross build \
      --target armv7-unknown-linux-gnueabihf \
      --features ui \
      --timings \
      --locked
    ;;
  build-arm-debug-full)
    cd "$RUST_DIR"
    cross_env
    MISTER_UI_BUILD_SCOPE=all cross build \
      --target armv7-unknown-linux-gnueabihf \
      --features ui,bench-scenes \
      --timings \
      --locked
    ;;
  build-ui)
    "$RUST_DIR/build-arm.sh" --fast
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "ERROR: unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
