# Stable MiSTer SSH wrapper for agents/humans.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$HERE/scripts/magik-layout.sh"
export MISTER_IP="${MISTER_IP:-192.168.1.117}"
export MISTER_PASS="${MISTER_PASS:-1}"
export RUSTC_WRAPPER=""

cd "$HERE"
BIN="$HERE/tools/mister/target/debug/mister"
MANIFEST="$HERE/tools/mister/Cargo.toml"
LOCK="$HERE/tools/mister/Cargo.lock"

if [ ! -x "$BIN" ] ||
  [ "$MANIFEST" -nt "$BIN" ] ||
  [ "$LOCK" -nt "$BIN" ] ||
  find "$HERE/tools/mister/src" -type f -newer "$BIN" -print -quit | grep -q .; then
  if ! cargo build --quiet --manifest-path "$MANIFEST"; then
    if [ -x "$BIN" ]; then
      echo "warning: cargo build failed; using existing $BIN" >&2
    else
      exit 1
    fi
  fi
fi

exec "$BIN" "$@"
