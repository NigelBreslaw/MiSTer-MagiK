# Native macOS camera probe/capture via Swift + AVFoundation.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CLANG_MODULE_CACHE_PATH="${CLANG_MODULE_CACHE_PATH:-/tmp/swift-module-cache}"
swift "$HERE/tools/host-camera-native.swift" "$@"
