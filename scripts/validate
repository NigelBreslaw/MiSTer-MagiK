#!/usr/bin/env bash
# Copyright (C) 2026 Nigel Breslaw
# SPDX-License-Identifier: GPL-3.0-or-later

# Affected-path pre-commit validation and the complete CI host gate.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

RUST_TOOLCHAIN="$(
  sed -n 's/^channel = "\([^"]*\)"$/\1/p' magik-gui/rust-toolchain.toml
)"
[ -n "$RUST_TOOLCHAIN" ] || {
  echo "could not read the pinned Rust toolchain from magik-gui/rust-toolchain.toml" >&2
  exit 2
}
export RUSTUP_TOOLCHAIN="$RUST_TOOLCHAIN"

usage() {
  cat <<'EOF'
usage:
  scripts/validate affected [--paths-file FILE] [--print-plan] [--verbose|--json]
  scripts/validate working-tree [--print-plan] [--verbose|--json]
  scripts/validate paths PATH... [--print-plan] [--verbose|--json]
  scripts/validate full-host [--verbose|--json]

Without --paths-file, affected mode reads added, copied, modified, renamed,
and deleted paths from the staged Git index. --print-plan performs no checks.
working-tree combines staged, unstaged, and untracked non-ignored paths.
paths validates explicit files or recursively expands explicit directories.
EOF
}

step() {
  echo
  echo "==> $*"
}

now_ms() {
  python3 -c 'import time; print(time.time_ns() // 1_000_000)'
}

init_reporting() {
  local run_id
  run_id="$(date +%Y%m%d-%H%M%S)-$$"
  LOG_DIR="$ROOT/build/validation/$run_id"
  RESULT_DIR="$LOG_DIR/.results"
  mkdir -p "$RESULT_DIR"
}

run_check_recorded() {
  local check="$1" started finished duration status exit_code log result
  log="$LOG_DIR/$check.log"
  result="$RESULT_DIR/$check.tsv"
  started="$(now_ms)"
  printf 'VALIDATION start check=%s\n' "$check" >&2
  exit_code=0
  if run_check "$check" >"$log" 2>&1; then
    status=pass
  else
    exit_code=$?
    status=fail
  fi
  finished="$(now_ms)"
  duration=$((finished - started))
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$check" "$status" "$duration" "$exit_code" "$log" >"$result"
  printf 'VALIDATION %s check=%s duration_ms=%s\n' "$status" "$check" "$duration" >&2
  return "$exit_code"
}

emit_results() {
  local mode="$1"
  shift
  local names=("$@") name result status duration exit_code log overall=pass
  if [ "$json_output" -eq 1 ]; then
    python3 - "$mode" "$RESULT_DIR" "$LOG_DIR" "${names[@]}" <<'PY'
import json
from pathlib import Path
import sys

mode, result_dir, log_dir, *names = sys.argv[1:]
checks = []
overall = "pass"
for name in names:
    path = Path(result_dir) / f"{name}.tsv"
    if path.is_file():
        _, status, duration, exit_code, log_path = path.read_text().rstrip("\n").split("\t", 4)
    else:
        status, duration, exit_code = "skip", "0", "0"
        log_path = str(Path(log_dir) / f"{name}.log")
    if status == "fail":
        overall = "fail"
    checks.append({
        "name": name,
        "status": status,
        "duration_ms": int(duration),
        "exit_code": int(exit_code),
        "log_path": str(Path(log_path).resolve()),
    })
print(json.dumps({
    "schema": "mister-magik-validation-v1",
    "mode": mode,
    "status": overall,
    "checks": checks,
}, sort_keys=True))
PY
    return
  fi
  for name in "${names[@]}"; do
    result="$RESULT_DIR/$name.tsv"
    if [ -f "$result" ]; then
      IFS=$'\t' read -r _ status duration exit_code log <"$result"
    else
      status=skip
      duration=0
      exit_code=0
      log="$LOG_DIR/$name.log"
    fi
    printf '%-4s %-30s %7sms\n' "$(printf '%s' "$status" | tr '[:lower:]' '[:upper:]')" "$name" "$duration"
    if [ "$verbose" -eq 1 ] && [ -f "$log" ]; then
      cat "$log"
    elif [ "$status" = fail ]; then
      tail -40 "$log" >&2
      echo "LOG  $log" >&2
    fi
    [ "$status" != fail ] || overall=fail
  done
  echo "validation: $overall ($mode)"
}

run_full_host() {
  run_parallel_groups core catalog tools
}

run_group() {
  local group="$1"
  case "$group" in
    core)
      CARGO_BUILD_JOBS=2 run_check_recorded format || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded host-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded magik-gui-clippy || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded production-ui-check || return 1
      ;;
    catalog)
      CARGO_BUILD_JOBS=1 run_check_recorded catalog-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded catalog-clippy || return 1
      ;;
    tools)
      CARGO_BUILD_JOBS=1 run_check_recorded host-tools || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded mister-clippy || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded agent-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded agent-clippy || return 1
      ;;
    shared)
      CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-clippy || return 1
      ;;
    desktop)
      CARGO_BUILD_JOBS=1 run_check_recorded desktop-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded desktop-compiled-check || return 1
      ;;
    docs)
      run_check_recorded documentation-build || return 1
      ;;
    *)
      echo "unknown validation group: $group" >&2
      return 2
      ;;
  esac
}

run_parallel_groups() {
  local status group pid i
  local groups=("$@")
  local pids=()
  status=0
  for group in "${groups[@]}"; do
    run_group "$group" &
    pids+=("$!")
  done
  for ((i = 0; i < ${#groups[@]}; i++)); do
    pid="${pids[$i]}"
    if ! wait "$pid"; then
      status=1
    fi
  done
  return "$status"
}

contains_check() {
  local wanted="$1"
  local check
  shift
  for check in "$@"; do
    [ "$check" = "$wanted" ] && return 0
  done
  return 1
}

run_selected_group() {
  local group="$1"
  shift
  case "$group" in
    core)
      if contains_check host-tests "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded host-tests || return 1; fi
      if contains_check magik-gui-clippy "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded magik-gui-clippy || return 1; fi
      if contains_check production-ui-check "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded production-ui-check || return 1; fi
      ;;
    catalog)
      if contains_check catalog-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded catalog-tests || return 1; fi
      if contains_check catalog-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded catalog-clippy || return 1; fi
      ;;
    tools)
      if contains_check mister-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded mister-tests || return 1; fi
      if contains_check mister-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded mister-clippy || return 1; fi
      if contains_check agent-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded agent-tests || return 1; fi
      if contains_check agent-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded agent-clippy || return 1; fi
      ;;
    shared)
      if contains_check framebuffer-stream-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-tests || return 1; fi
      if contains_check framebuffer-stream-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-clippy || return 1; fi
      ;;
    desktop)
      if contains_check desktop-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded desktop-tests || return 1; fi
      if contains_check desktop-compiled-check "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded desktop-compiled-check || return 1; fi
      ;;
    docs)
      if contains_check documentation-build "$@"; then run_check_recorded documentation-build || return 1; fi
      ;;
    *)
      echo "unknown affected validation group: $group" >&2
      return 2
      ;;
  esac
}

run_affected_parallel_groups() {
  local status group pid i
  local groups=("$@")
  local pids=()
  [ "${#groups[@]}" -gt 0 ] || return 0
  status=0
  for group in "${groups[@]}"; do
    run_selected_group "$group" "${plan[@]}" &
    pids+=("$!")
  done
  for ((i = 0; i < ${#groups[@]}; i++)); do
    pid="${pids[$i]}"
    if ! wait "$pid"; then
      status=1
    fi
  done
  return "$status"
}

run_affected_plan() {
  local groups=() status=0
  run_check_recorded format || status=1
  run_check_recorded host-tools-fast || status=1
  if contains_check host-tests "${plan[@]}" ||
    contains_check magik-gui-clippy "${plan[@]}" ||
    contains_check production-ui-check "${plan[@]}"; then
    groups+=(core)
  fi
  if contains_check catalog-tests "${plan[@]}" ||
    contains_check catalog-clippy "${plan[@]}"; then
    groups+=(catalog)
  fi
  if contains_check mister-tests "${plan[@]}" ||
    contains_check mister-clippy "${plan[@]}" ||
    contains_check agent-tests "${plan[@]}" ||
    contains_check agent-clippy "${plan[@]}"; then
    groups+=(tools)
  fi
  if contains_check framebuffer-stream-tests "${plan[@]}" ||
    contains_check framebuffer-stream-clippy "${plan[@]}"; then
    groups+=(shared)
  fi
  if contains_check desktop-tests "${plan[@]}" ||
    contains_check desktop-compiled-check "${plan[@]}"; then
    groups+=(desktop)
  fi
  if contains_check documentation-build "${plan[@]}"; then
    groups+=(docs)
  fi
  run_affected_parallel_groups "${groups[@]}" || status=1
  return "$status"
}

run_public_rust_format() {
  local manifest
  for manifest in \
    magik-gui/Cargo.toml \
    magik-gui/catalog/Cargo.toml \
    magik-gui/ui-generated/Cargo.toml \
    framebuffer-stream/Cargo.toml \
    tools/mister/Cargo.toml \
    tools/magik-agent/Cargo.toml \
    desktop/Cargo.toml; do
    cargo fmt --manifest-path "$manifest" --check
  done
}

require_desktop_submodules() {
  local path
  for path in desktop/vendor/github-app desktop/vendor/material-icon-theme; do
    [ -e "$path/.git" ] || {
      echo "missing desktop submodule: $path" >&2
      echo "run: git submodule update --init desktop/vendor/github-app desktop/vendor/material-icon-theme" >&2
      return 1
    }
  done
}

require_documentation_dependencies() {
  local node_version node_major pnpm_version
  command -v node >/dev/null 2>&1 || {
    echo "Node.js 22 or newer is required for documentation validation" >&2
    echo "install Node.js 22+ with Corepack support" >&2
    return 1
  }
  node_version="$(node --version 2>/dev/null || true)"
  node_major="${node_version#v}"
  node_major="${node_major%%.*}"
  case "$node_major" in
    ""|*[!0-9]*)
      echo "could not determine Node.js version from: $node_version" >&2
      return 1
      ;;
  esac
  [ "$node_major" -ge 22 ] || {
    echo "Node.js 22 or newer is required; found $node_version" >&2
    echo "install Node.js 22+ with Corepack support" >&2
    return 1
  }
  command -v corepack >/dev/null 2>&1 || {
    echo "Corepack is required to run the pinned pnpm 11.10.0" >&2
    echo "install Node.js with Corepack support, then run: corepack enable" >&2
    return 1
  }
  pnpm_version="$(
    COREPACK_ENABLE_NETWORK=0 corepack pnpm --version 2>/dev/null || true
  )"
  [ "$pnpm_version" = "11.10.0" ] || {
    echo "pnpm 11.10.0 is required through Corepack; found ${pnpm_version:-unavailable}" >&2
    echo "run: corepack prepare pnpm@11.10.0 --activate" >&2
    return 1
  }
  local node_modules="${MISTER_DOCUMENTATION_NODE_MODULES:-documentation/node_modules}"
  [ -d "$node_modules/.pnpm" ] && [ -x "$node_modules/.bin/astro" ] || {
    echo "documentation dependencies are missing or incomplete" >&2
    echo "run: pnpm --dir documentation install --frozen-lockfile" >&2
    return 1
  }
}

run_check() {
  local check="$1"
  if [ -n "${MISTER_VALIDATE_FAKE_CHECK_DIR:-}" ]; then
    if [ -x "$MISTER_VALIDATE_FAKE_CHECK_DIR/$check" ]; then
      "$MISTER_VALIDATE_FAKE_CHECK_DIR/$check"
    else
      echo "fake check passed: $check"
    fi
    return
  fi
  case "$check" in
    format) step "Format all public Rust crates"; run_public_rust_format ;;
    host-tools-fast) step "Fast host tools"; scripts/dev-rust host-tools-fast ;;
    host-tests) step "Host logic tests"; scripts/dev-rust test ;;
    magik-gui-clippy) step "Clippy magik-gui host logic"; (cd magik-gui && cargo clippy --lib --no-default-features -- -D warnings) ;;
    catalog-tests) step "Catalog crate tests"; cargo test --manifest-path magik-gui/catalog/Cargo.toml ;;
    catalog-clippy) step "Clippy catalog crate"; cargo clippy --manifest-path magik-gui/catalog/Cargo.toml --all-targets -- -D warnings ;;
    production-ui-check) step "Check production magik-gui binary"; cargo check --manifest-path magik-gui/Cargo.toml --bin mister-magik-fb --no-default-features --features ui ;;
    host-tools) step "Full host tools"; scripts/dev-rust host-tools ;;
    mister-tests) step "Test host tools"; cargo test --manifest-path tools/mister/Cargo.toml ;;
    mister-clippy) step "Clippy host tools"; cargo clippy --manifest-path tools/mister/Cargo.toml --all-targets -- -D warnings ;;
    agent-tests) step "Test MagiK agent"; cargo test --manifest-path tools/magik-agent/Cargo.toml ;;
    agent-clippy) step "Clippy MagiK agent"; cargo clippy --manifest-path tools/magik-agent/Cargo.toml --all-targets -- -D warnings ;;
    framebuffer-stream-tests) step "Test framebuffer stream"; cargo test --manifest-path framebuffer-stream/Cargo.toml ;;
    framebuffer-stream-clippy) step "Clippy framebuffer stream"; cargo clippy --manifest-path framebuffer-stream/Cargo.toml --all-targets -- -D warnings ;;
    desktop-tests) step "Test desktop"; require_desktop_submodules; cargo test --manifest-path desktop/Cargo.toml ;;
    desktop-compiled-check)
      step "Check compiled desktop UI"
      require_desktop_submodules
      cargo check --manifest-path desktop/Cargo.toml --no-default-features --features compiled-ui
      ;;
    documentation-build)
      step "Build documentation"
      require_documentation_dependencies
      COREPACK_ENABLE_NETWORK=0 corepack pnpm --dir documentation run build
      ;;
  esac
}

if [ "${MISTER_VALIDATE_SELF_TEST:-}" = "documentation-prerequisites" ]; then
  require_documentation_dependencies
  exit
fi

mode="${1:-}"
case "$mode" in
  full-host|affected|working-tree|paths) shift ;;
  -h|--help|"") usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

paths_file=""
print_plan=0
verbose=0
json_output=0
explicit_paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --paths-file)
      [ "$mode" = affected ] || {
        echo "--paths-file is only supported by affected mode" >&2
        exit 2
      }
      paths_file="${2:?--paths-file requires a path}"
      shift 2
      ;;
    --print-plan) print_plan=1; shift ;;
    --verbose) verbose=1; shift ;;
    --json) json_output=1; shift ;;
    --*) usage >&2; exit 2 ;;
    *)
      [ "$mode" = paths ] || { usage >&2; exit 2; }
      explicit_paths+=("$1")
      shift
      ;;
  esac
done

[ "$verbose" -eq 0 ] || [ "$json_output" -eq 0 ] || {
  echo "--verbose and --json cannot be combined" >&2
  exit 2
}

if [ "$mode" = full-host ]; then
  [ -z "$paths_file" ] && [ "${#explicit_paths[@]}" -eq 0 ] && [ "$print_plan" -eq 0 ] || {
    usage >&2
    exit 2
  }
  report_order=(
    format host-tests magik-gui-clippy production-ui-check
    catalog-tests catalog-clippy host-tools mister-clippy agent-tests agent-clippy
    framebuffer-stream-tests framebuffer-stream-clippy
    desktop-tests desktop-compiled-check documentation-build
  )
  init_reporting
  status=0
  run_full_host || status=$?
  emit_results "$mode" "${report_order[@]}"
  exit "$status"
fi

paths=()

repo_relative_path() {
  local candidate="$1"
  case "$candidate" in
    "$ROOT") candidate="." ;;
    "$ROOT"/*) candidate="${candidate#"$ROOT"/}" ;;
    /*)
      echo "path is outside repository: $candidate" >&2
      return 2
      ;;
    *) candidate="${candidate#./}" ;;
  esac
  [ -n "$candidate" ] || candidate="."
  case "$candidate" in
    ..|../*|*/..|*/../*)
      echo "path is outside repository: $1" >&2
      return 2
      ;;
  esac
  printf '%s\n' "$candidate"
}

append_path() {
  local candidate existing
  candidate="$(repo_relative_path "$1")"
  [ -n "$candidate" ] || return 0
  for existing in "${paths[@]}"; do
    [ "$existing" = "$candidate" ] && return 0
  done
  paths+=("$candidate")
}

collect_name_status() {
  while IFS= read -r -d '' status; do
    case "$status" in
      R*|C*)
        IFS= read -r -d '' old_path
        IFS= read -r -d '' new_path
        append_path "$old_path"
        append_path "$new_path"
        ;;
      *)
        IFS= read -r -d '' path
        append_path "$path"
        ;;
    esac
  done
}

case "$mode" in
  affected)
    if [ -n "$paths_file" ]; then
      [ -f "$paths_file" ] || { echo "paths file not found: $paths_file" >&2; exit 2; }
      while IFS= read -r path; do
        append_path "$path"
      done <"$paths_file"
    else
      collect_name_status < <(git diff --cached --name-status -z --diff-filter=ACMRD)
    fi
    ;;
  working-tree)
    collect_name_status < <(git diff --cached --name-status -z --diff-filter=ACMRD)
    collect_name_status < <(git diff --name-status -z --diff-filter=ACMRD)
    while IFS= read -r -d '' path; do
      append_path "$path"
    done < <(git ls-files --others --exclude-standard -z)
    ;;
  paths)
    [ "${#explicit_paths[@]}" -gt 0 ] || {
      echo "paths mode requires at least one PATH" >&2
      exit 2
    }
    for path in "${explicit_paths[@]}"; do
      path="$(repo_relative_path "$path")"
      if [ -d "$path" ]; then
        while IFS= read -r -d '' child; do
          append_path "$child"
        done < <(git ls-files --cached --others --exclude-standard -z -- "$path")
      else
        append_path "$path"
      fi
    done
    ;;
esac

need_host=0
need_catalog=0
need_ui=0
need_mister=0
need_agent=0
need_stream=0
need_desktop=0
need_docs=0

for path in "${paths[@]}"; do
  case "$path" in
    magik-gui/catalog/*)
      need_catalog=1; need_host=1; need_ui=1; need_mister=1 ;;
    magik-gui/src/*)
      need_host=1; need_ui=1 ;;
    magik-gui/ui/*|magik-gui/ui-generated/*)
      need_ui=1 ;;
    magik-gui/Cargo.toml|magik-gui/Cargo.lock|magik-gui/build.rs|magik-gui/.cargo/*)
      need_catalog=1; need_host=1; need_ui=1 ;;
    magik-gui/rust-toolchain.toml)
      need_catalog=1; need_host=1; need_ui=1; need_mister=1; need_agent=1
      need_stream=1; need_desktop=1 ;;
    magik-gui/build-arm*.sh|magik-gui/Dockerfile*|magik-gui/Cross.toml|magik-gui/scripts/*)
      need_catalog=1; need_host=1; need_ui=1 ;;
    tools/mister/*)
      need_mister=1 ;;
    tools/magik-agent/*)
      need_agent=1 ;;
    framebuffer-stream/*)
      need_host=1; need_ui=1; need_agent=1; need_stream=1; need_desktop=1 ;;
    desktop/*)
      need_desktop=1 ;;
    documentation/*)
      need_docs=1 ;;
    Cargo.toml|Cargo.lock|rust-toolchain.toml|.cargo/*)
      need_catalog=1; need_host=1; need_ui=1; need_mister=1; need_agent=1
      need_stream=1; need_desktop=1; need_docs=1 ;;
  esac
done

plan=(format host-tools-fast)
[ "$need_host" -eq 1 ] && plan+=(host-tests magik-gui-clippy)
[ "$need_catalog" -eq 1 ] && plan+=(catalog-tests catalog-clippy)
[ "$need_ui" -eq 1 ] && plan+=(production-ui-check)
[ "$need_stream" -eq 1 ] && plan+=(framebuffer-stream-tests framebuffer-stream-clippy)
[ "$need_mister" -eq 1 ] && plan+=(mister-tests mister-clippy)
[ "$need_agent" -eq 1 ] && plan+=(agent-tests agent-clippy)
[ "$need_desktop" -eq 1 ] && plan+=(desktop-tests desktop-compiled-check)
[ "$need_docs" -eq 1 ] && plan+=(documentation-build)

if [ "$print_plan" -eq 1 ]; then
  printf '%s\n' "${plan[@]}"
  exit 0
fi

init_reporting
status=0
run_affected_plan || status=$?
emit_results "$mode" "${plan[@]}"
exit "$status"
