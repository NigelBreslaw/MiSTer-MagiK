#!/usr/bin/env bash
# Copyright (C) 2026 Nigel Breslaw
# SPDX-License-Identifier: GPL-3.0-or-later

# Affected-path pre-commit validation and the complete CI host gate.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

RUST_TOOLCHAIN="$(
  sed -n 's/^channel = "\([^"]*\)"$/\1/p' apps/mister/rust-toolchain.toml
)"
[ -n "$RUST_TOOLCHAIN" ] || {
  echo "could not read the pinned Rust toolchain from apps/mister/rust-toolchain.toml" >&2
  exit 2
}
export RUSTUP_TOOLCHAIN="$RUST_TOOLCHAIN"

usage() {
  cat <<'EOF'
usage:
  scripts/validate affected [--paths-file FILE] [--print-plan] [--verbose|--json]
  scripts/validate working-tree [--print-plan] [--verbose|--json]
  scripts/validate paths PATH... [--print-plan] [--verbose|--json]
  scripts/validate full-host [--group quality|domain|app|catalog|tools] [--verbose|--json]

Without --paths-file, affected mode reads added, copied, modified, renamed,
and deleted paths from the staged Git index. --print-plan performs no checks.
working-tree combines staged, unstaged, and untracked non-ignored paths.
paths validates explicit files or recursively expands explicit directories.
EOF
}

step() {
  echo
  echo "==> $*"
}

now_ms() {
  python3 -c 'import time; print(time.time_ns() // 1_000_000)'
}

init_reporting() {
  local run_id
  run_id="$(date +%Y%m%d-%H%M%S)-$$"
  LOG_DIR="$ROOT/build/validation/$run_id"
  RESULT_DIR="$LOG_DIR/.results"
  mkdir -p "$RESULT_DIR"
}

run_check_recorded() {
  local check="$1" started finished duration status exit_code log result
  log="$LOG_DIR/$check.log"
  result="$RESULT_DIR/$check.tsv"
  started="$(now_ms)"
  printf 'VALIDATION start check=%s\n' "$check" >&2
  exit_code=0
  if run_check "$check" >"$log" 2>&1; then
    status=pass
  else
    exit_code=$?
    status=fail
  fi
  finished="$(now_ms)"
  duration=$((finished - started))
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$check" "$status" "$duration" "$exit_code" "$log" >"$result"
  printf 'VALIDATION %s check=%s duration_ms=%s\n' "$status" "$check" "$duration" >&2
  return "$exit_code"
}

emit_results() {
  local mode="$1"
  shift
  local names=("$@") name result status duration exit_code log overall=pass
  if [ "$json_output" -eq 1 ]; then
    python3 - "$mode" "$RESULT_DIR" "$LOG_DIR" "${names[@]}" <<'PY'
import json
from pathlib import Path
import sys

mode, result_dir, log_dir, *names = sys.argv[1:]
checks = []
overall = "pass"
for name in names:
    path = Path(result_dir) / f"{name}.tsv"
    if path.is_file():
        _, status, duration, exit_code, log_path = path.read_text().rstrip("\n").split("\t", 4)
    else:
        status, duration, exit_code = "skip", "0", "0"
        log_path = str(Path(log_dir) / f"{name}.log")
    if status == "fail":
        overall = "fail"
    checks.append({
        "name": name,
        "status": status,
        "duration_ms": int(duration),
        "exit_code": int(exit_code),
        "log_path": str(Path(log_path).resolve()),
    })
print(json.dumps({
    "schema": "mister-magik-validation-v1",
    "mode": mode,
    "status": overall,
    "checks": checks,
}, sort_keys=True))
PY
    return
  fi
  for name in "${names[@]}"; do
    result="$RESULT_DIR/$name.tsv"
    if [ -f "$result" ]; then
      IFS=$'\t' read -r _ status duration exit_code log <"$result"
    else
      status=skip
      duration=0
      exit_code=0
      log="$LOG_DIR/$name.log"
    fi
    printf '%-4s %-30s %7sms\n' "$(printf '%s' "$status" | tr '[:lower:]' '[:upper:]')" "$name" "$duration"
    if [ "$verbose" -eq 1 ] && [ -f "$log" ]; then
      cat "$log"
    elif [ "$status" = fail ]; then
      tail -20 "$log" >&2
      echo "LOG  $log" >&2
    fi
    [ "$status" != fail ] || overall=fail
  done
  echo "validation: $overall ($mode)"
}

run_full_host() {
  run_parallel_groups core catalog tools
}

run_full_host_group() {
  local group="$1"
  case "$group" in
    quality)
      CARGO_BUILD_JOBS=2 run_check_recorded format || return 1
      MISTER_VALIDATE_ROUTING_CHILD=1 run_check_recorded validation-routing || return 1
      ;;
    domain)
      CARGO_BUILD_JOBS=2 run_check_recorded magik-core-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded magik-core-clippy || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded mister-runtime-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded mister-runtime-clippy || return 1
      ;;
    app)
      CARGO_BUILD_JOBS=2 run_check_recorded host-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded mister-app-clippy || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded production-ui-check || return 1
      ;;
    catalog)
      run_group catalog
      ;;
    tools)
      run_group tools
      ;;
    *)
      echo "unknown full-host group: $group" >&2
      return 2
      ;;
  esac
}

full_host_group_report_order() {
  case "$1" in
    quality) printf '%s\n' format validation-routing ;;
    domain) printf '%s\n' magik-core-tests magik-core-clippy mister-runtime-tests mister-runtime-clippy ;;
    app) printf '%s\n' host-tests mister-app-clippy production-ui-check ;;
    catalog) printf '%s\n' catalog-tests catalog-clippy ;;
    tools) printf '%s\n' host-tools mister-clippy agent-tests agent-clippy ;;
  esac
}

run_group() {
  local group="$1"
  case "$group" in
    core)
      CARGO_BUILD_JOBS=2 run_check_recorded format || return 1
      MISTER_VALIDATE_ROUTING_CHILD=1 run_check_recorded validation-routing || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded magik-core-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded magik-core-clippy || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded mister-runtime-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded mister-runtime-clippy || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded host-tests || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded mister-app-clippy || return 1
      CARGO_BUILD_JOBS=2 run_check_recorded production-ui-check || return 1
      ;;
    catalog)
      CARGO_BUILD_JOBS=1 run_check_recorded catalog-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded catalog-clippy || return 1
      ;;
    tools)
      CARGO_BUILD_JOBS=1 run_check_recorded host-tools || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded mister-clippy || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded agent-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded agent-clippy || return 1
      ;;
    shared)
      CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-clippy || return 1
      ;;
    desktop)
      CARGO_BUILD_JOBS=1 run_check_recorded desktop-tests || return 1
      CARGO_BUILD_JOBS=1 run_check_recorded desktop-compiled-check || return 1
      ;;
    docs)
      run_check_recorded documentation-build || return 1
      ;;
    *)
      echo "unknown validation group: $group" >&2
      return 2
      ;;
  esac
}

run_parallel_groups() {
  local status group pid i
  local groups=("$@")
  local pids=()
  status=0
  for group in "${groups[@]}"; do
    run_group "$group" &
    pids+=("$!")
  done
  for ((i = 0; i < ${#groups[@]}; i++)); do
    pid="${pids[$i]}"
    if ! wait "$pid"; then
      status=1
    fi
  done
  return "$status"
}

contains_check() {
  local wanted="$1"
  local check
  shift
  for check in "$@"; do
    [ "$check" = "$wanted" ] && return 0
  done
  return 1
}

run_selected_group() {
  local group="$1"
  shift
  case "$group" in
    core)
      if contains_check magik-core-tests "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded magik-core-tests || return 1; fi
      if contains_check magik-core-clippy "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded magik-core-clippy || return 1; fi
      if contains_check mister-runtime-tests "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded mister-runtime-tests || return 1; fi
      if contains_check mister-runtime-clippy "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded mister-runtime-clippy || return 1; fi
      if contains_check host-tests "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded host-tests || return 1; fi
      if contains_check mister-app-clippy "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded mister-app-clippy || return 1; fi
      if contains_check production-ui-check "$@"; then CARGO_BUILD_JOBS=2 run_check_recorded production-ui-check || return 1; fi
      ;;
    catalog)
      if contains_check catalog-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded catalog-tests || return 1; fi
      if contains_check catalog-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded catalog-clippy || return 1; fi
      ;;
    tools)
      if contains_check mister-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded mister-tests || return 1; fi
      if contains_check mister-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded mister-clippy || return 1; fi
      if contains_check agent-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded agent-tests || return 1; fi
      if contains_check agent-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded agent-clippy || return 1; fi
      ;;
    shared)
      if contains_check framebuffer-stream-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-tests || return 1; fi
      if contains_check framebuffer-stream-clippy "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded framebuffer-stream-clippy || return 1; fi
      ;;
    desktop)
      if contains_check desktop-tests "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded desktop-tests || return 1; fi
      if contains_check desktop-compiled-check "$@"; then CARGO_BUILD_JOBS=1 run_check_recorded desktop-compiled-check || return 1; fi
      ;;
    docs)
      if contains_check documentation-build "$@"; then run_check_recorded documentation-build || return 1; fi
      ;;
    *)
      echo "unknown affected validation group: $group" >&2
      return 2
      ;;
  esac
}

run_affected_parallel_groups() {
  local status group pid i
  local groups=("$@")
  local pids=()
  [ "${#groups[@]}" -gt 0 ] || return 0
  status=0
  for group in "${groups[@]}"; do
    run_selected_group "$group" "${plan[@]}" &
    pids+=("$!")
  done
  for ((i = 0; i < ${#groups[@]}; i++)); do
    pid="${pids[$i]}"
    if ! wait "$pid"; then
      status=1
    fi
  done
  return "$status"
}

run_affected_plan() {
  local groups=() status=0 check
  for check in "${plan[@]}"; do
    case "$check" in
      format|format-*) run_check_recorded "$check" || status=1 ;;
    esac
  done
  if contains_check validation-routing "${plan[@]}"; then
    MISTER_VALIDATE_ROUTING_CHILD=1 run_check_recorded validation-routing || status=1
  fi
  if contains_check host-tools-fast "${plan[@]}"; then
    run_check_recorded host-tools-fast || status=1
  fi
  if contains_check magik-core-tests "${plan[@]}" ||
    contains_check magik-core-clippy "${plan[@]}" ||
    contains_check mister-runtime-tests "${plan[@]}" ||
    contains_check mister-runtime-clippy "${plan[@]}" ||
    contains_check host-tests "${plan[@]}" ||
    contains_check mister-app-clippy "${plan[@]}" ||
    contains_check production-ui-check "${plan[@]}"; then
    groups+=(core)
  fi
  if contains_check catalog-tests "${plan[@]}" ||
    contains_check catalog-clippy "${plan[@]}"; then
    groups+=(catalog)
  fi
  if contains_check mister-tests "${plan[@]}" ||
    contains_check mister-clippy "${plan[@]}" ||
    contains_check agent-tests "${plan[@]}" ||
    contains_check agent-clippy "${plan[@]}"; then
    groups+=(tools)
  fi
  if contains_check framebuffer-stream-tests "${plan[@]}" ||
    contains_check framebuffer-stream-clippy "${plan[@]}"; then
    groups+=(shared)
  fi
  if contains_check desktop-tests "${plan[@]}" ||
    contains_check desktop-compiled-check "${plan[@]}"; then
    groups+=(desktop)
  fi
  if contains_check documentation-build "${plan[@]}"; then
    groups+=(docs)
  fi
  run_affected_parallel_groups "${groups[@]}" || status=1
  return "$status"
}

run_public_rust_format() {
  local manifest
  for manifest in \
    apps/mister/Cargo.toml \
    crates/magik-core/Cargo.toml \
    crates/catalog/Cargo.toml \
    apps/mister/ui-generated/Cargo.toml \
    crates/framebuffer-stream/Cargo.toml \
    crates/agent-protocol/Cargo.toml \
    crates/media-contract/Cargo.toml \
    mister/platform/contracts/latch/Cargo.toml \
    mister/platform/contracts/scanout/Cargo.toml \
    mister/tools/host/Cargo.toml \
    mister/tools/agent/Cargo.toml \
    mister/platform/runtime/Cargo.toml \
    apps/desktop/Cargo.toml; do
    cargo fmt --manifest-path "$manifest" --check
  done
}

run_manifest_format() {
  local manifest="$1"
  cargo fmt --manifest-path "$manifest" --check
}

require_desktop_submodules() {
  local path
  for path in apps/desktop/vendor/github-app apps/desktop/vendor/material-icon-theme; do
    [ -e "$path/.git" ] || {
      echo "missing desktop submodule: $path" >&2
      echo "run: git submodule update --init apps/desktop/vendor/github-app apps/desktop/vendor/material-icon-theme" >&2
      return 1
    }
  done
}

require_documentation_dependencies() {
  local node_version node_major pnpm_version
  command -v node >/dev/null 2>&1 || {
    echo "Node.js 22 or newer is required for documentation validation" >&2
    echo "install Node.js 22+ with Corepack support" >&2
    return 1
  }
  node_version="$(node --version 2>/dev/null || true)"
  node_major="${node_version#v}"
  node_major="${node_major%%.*}"
  case "$node_major" in
    ""|*[!0-9]*)
      echo "could not determine Node.js version from: $node_version" >&2
      return 1
      ;;
  esac
  [ "$node_major" -ge 22 ] || {
    echo "Node.js 22 or newer is required; found $node_version" >&2
    echo "install Node.js 22+ with Corepack support" >&2
    return 1
  }
  command -v corepack >/dev/null 2>&1 || {
    echo "Corepack is required to run the pinned pnpm 11.10.0" >&2
    echo "install Node.js with Corepack support, then run: corepack enable" >&2
    return 1
  }
  pnpm_version="$(
    COREPACK_ENABLE_NETWORK=0 corepack pnpm --version 2>/dev/null || true
  )"
  [ "$pnpm_version" = "11.10.0" ] || {
    echo "pnpm 11.10.0 is required through Corepack; found ${pnpm_version:-unavailable}" >&2
    echo "run: corepack prepare pnpm@11.10.0 --activate" >&2
    return 1
  }
  local node_modules="${MISTER_DOCUMENTATION_NODE_MODULES:-documentation/node_modules}"
  [ -d "$node_modules/.pnpm" ] && [ -x "$node_modules/.bin/astro" ] || {
    echo "documentation dependencies are missing or incomplete" >&2
    echo "run: pnpm --dir documentation install --frozen-lockfile" >&2
    return 1
  }
}

run_check() {
  local check="$1"
  if [ -n "${MISTER_VALIDATE_FAKE_CHECK_DIR:-}" ]; then
    if [ -x "$MISTER_VALIDATE_FAKE_CHECK_DIR/$check" ]; then
      "$MISTER_VALIDATE_FAKE_CHECK_DIR/$check"
    else
      echo "fake check passed: $check"
    fi
    return
  fi
  case "$check" in
    format) step "Format all public Rust crates"; run_public_rust_format ;;
    format-app-mister) step "Format apps/mister"; run_manifest_format apps/mister/Cargo.toml ;;
    format-ui-generated) step "Format apps/mister/ui-generated"; run_manifest_format apps/mister/ui-generated/Cargo.toml ;;
    format-magik-core) step "Format crates/magik-core"; run_manifest_format crates/magik-core/Cargo.toml ;;
    format-catalog) step "Format crates/catalog"; run_manifest_format crates/catalog/Cargo.toml ;;
    format-framebuffer-stream) step "Format crates/framebuffer-stream"; run_manifest_format crates/framebuffer-stream/Cargo.toml ;;
    format-agent-protocol) step "Format crates/agent-protocol"; run_manifest_format crates/agent-protocol/Cargo.toml ;;
    format-media-contract) step "Format crates/media-contract"; run_manifest_format crates/media-contract/Cargo.toml ;;
    format-latch-contract) step "Format mister/platform/contracts/latch"; run_manifest_format mister/platform/contracts/latch/Cargo.toml ;;
    format-scanout-contract) step "Format mister/platform/contracts/scanout"; run_manifest_format mister/platform/contracts/scanout/Cargo.toml ;;
    format-mister-host) step "Format mister/tools/host"; run_manifest_format mister/tools/host/Cargo.toml ;;
    format-mister-agent) step "Format mister/tools/agent"; run_manifest_format mister/tools/agent/Cargo.toml ;;
    format-mister-runtime) step "Format mister/platform/runtime"; run_manifest_format mister/platform/runtime/Cargo.toml ;;
    format-desktop) step "Format apps/desktop"; run_manifest_format apps/desktop/Cargo.toml ;;
    validation-routing) step "Test validation path routing"; bash scripts/tests/test-validate.sh ;;
    magik-core-tests) step "Test portable MagiK domain"; cargo test --manifest-path crates/magik-core/Cargo.toml ;;
    magik-core-clippy) step "Clippy portable MagiK domain"; cargo clippy --manifest-path crates/magik-core/Cargo.toml --all-targets -- -D warnings ;;
    mister-runtime-tests) step "Test MiSTer runtime adapter"; cargo test --manifest-path mister/platform/runtime/Cargo.toml ;;
    mister-runtime-clippy) step "Clippy MiSTer runtime adapter"; cargo clippy --manifest-path mister/platform/runtime/Cargo.toml --all-targets -- -D warnings ;;
    host-tools-fast) step "Fast host tools"; bash scripts/dev-rust host-tools-fast ;;
    host-tests) step "Host logic tests"; bash scripts/dev-rust test ;;
    mister-app-clippy) step "Clippy apps/mister host logic"; (cd apps/mister && cargo clippy --lib --no-default-features -- -D warnings) ;;
    catalog-tests)
      step "Catalog crate tests (all features)"
      cargo test --manifest-path crates/catalog/Cargo.toml --all-features
      cargo check --manifest-path crates/catalog/Cargo.toml --no-default-features --features reader
      ;;
    catalog-clippy) step "Clippy catalog crate"; cargo clippy --manifest-path crates/catalog/Cargo.toml --all-features --all-targets -- -D warnings ;;
    production-ui-check) step "Check production apps/mister binary"; cargo check --manifest-path apps/mister/Cargo.toml --bin mister-magik-fb --no-default-features --features ui ;;
    host-tools) step "Full host tools"; bash scripts/dev-rust host-tools ;;
    mister-tests) step "Test host tools"; cargo test --manifest-path mister/tools/host/Cargo.toml ;;
    mister-clippy) step "Clippy host tools"; cargo clippy --manifest-path mister/tools/host/Cargo.toml --all-targets -- -D warnings ;;
    agent-tests) step "Test MagiK agent"; cargo test --manifest-path mister/tools/agent/Cargo.toml ;;
    agent-clippy) step "Clippy MagiK agent"; cargo clippy --manifest-path mister/tools/agent/Cargo.toml --all-targets -- -D warnings ;;
    framebuffer-stream-tests) step "Test framebuffer stream"; cargo test --manifest-path crates/framebuffer-stream/Cargo.toml ;;
    framebuffer-stream-clippy) step "Clippy framebuffer stream"; cargo clippy --manifest-path crates/framebuffer-stream/Cargo.toml --all-targets -- -D warnings ;;
    desktop-tests) step "Test desktop"; require_desktop_submodules; cargo test --manifest-path apps/desktop/Cargo.toml ;;
    desktop-compiled-check)
      step "Check compiled desktop UI"
      require_desktop_submodules
      cargo check --manifest-path apps/desktop/Cargo.toml --no-default-features --features compiled-ui
      ;;
    documentation-build)
      step "Build documentation"
      require_documentation_dependencies
      COREPACK_ENABLE_NETWORK=0 corepack pnpm --dir documentation run build
      ;;
  esac
}

if [ "${MISTER_VALIDATE_SELF_TEST:-}" = "documentation-prerequisites" ]; then
  require_documentation_dependencies
  exit
fi

mode="${1:-}"
case "$mode" in
  full-host|affected|working-tree|paths) shift ;;
  -h|--help|"") usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

paths_file=""
print_plan=0
verbose=0
json_output=0
explicit_paths=()
full_host_group=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --group)
      [ "$mode" = full-host ] || {
        echo "--group is only supported by full-host mode" >&2
        exit 2
      }
      full_host_group="${2:?--group requires a group name}"
      shift 2
      ;;
    --paths-file)
      [ "$mode" = affected ] || {
        echo "--paths-file is only supported by affected mode" >&2
        exit 2
      }
      paths_file="${2:?--paths-file requires a path}"
      shift 2
      ;;
    --print-plan) print_plan=1; shift ;;
    --verbose) verbose=1; shift ;;
    --json) json_output=1; shift ;;
    --*) usage >&2; exit 2 ;;
    *)
      [ "$mode" = paths ] || { usage >&2; exit 2; }
      explicit_paths+=("$1")
      shift
      ;;
  esac
done

[ "$verbose" -eq 0 ] || [ "$json_output" -eq 0 ] || {
  echo "--verbose and --json cannot be combined" >&2
  exit 2
}

if [ "$mode" = full-host ]; then
  [ -z "$paths_file" ] && [ "${#explicit_paths[@]}" -eq 0 ] && [ "$print_plan" -eq 0 ] || {
    usage >&2
    exit 2
  }
  if [ -n "$full_host_group" ]; then
    case "$full_host_group" in quality|domain|app|catalog|tools) ;; *)
      echo "unknown full-host group: $full_host_group" >&2
      exit 2
    esac
    report_order=()
    while IFS= read -r check; do
      report_order+=("$check")
    done < <(full_host_group_report_order "$full_host_group")
  else
    report_order=(
      format validation-routing magik-core-tests magik-core-clippy mister-runtime-tests mister-runtime-clippy
      host-tests mister-app-clippy production-ui-check
      catalog-tests catalog-clippy host-tools mister-clippy agent-tests agent-clippy
      framebuffer-stream-tests framebuffer-stream-clippy
      desktop-tests desktop-compiled-check documentation-build
    )
  fi
  init_reporting
  status=0
  if [ -n "$full_host_group" ]; then
    run_full_host_group "$full_host_group" || status=$?
  else
    run_full_host || status=$?
  fi
  emit_results "$mode" "${report_order[@]}"
  exit "$status"
fi

paths=()

repo_relative_path() {
  local candidate="$1"
  case "$candidate" in
    "$ROOT") candidate="." ;;
    "$ROOT"/*) candidate="${candidate#"$ROOT"/}" ;;
    /*)
      echo "path is outside repository: $candidate" >&2
      return 2
      ;;
    *) candidate="${candidate#./}" ;;
  esac
  [ -n "$candidate" ] || candidate="."
  case "$candidate" in
    ..|../*|*/..|*/../*)
      echo "path is outside repository: $1" >&2
      return 2
      ;;
  esac
  printf '%s\n' "$candidate"
}

append_path() {
  local candidate existing
  candidate="$(repo_relative_path "$1")"
  [ -n "$candidate" ] || return 0
  for existing in "${paths[@]}"; do
    [ "$existing" = "$candidate" ] && return 0
  done
  paths+=("$candidate")
}

collect_name_status() {
  while IFS= read -r -d '' status; do
    case "$status" in
      R*|C*)
        IFS= read -r -d '' old_path
        IFS= read -r -d '' new_path
        append_path "$old_path"
        append_path "$new_path"
        ;;
      *)
        IFS= read -r -d '' path
        append_path "$path"
        ;;
    esac
  done
}

case "$mode" in
  affected)
    if [ -n "$paths_file" ]; then
      [ -f "$paths_file" ] || { echo "paths file not found: $paths_file" >&2; exit 2; }
      while IFS= read -r path; do
        append_path "$path"
      done <"$paths_file"
    else
      collect_name_status < <(git diff --cached --name-status -z --diff-filter=ACMRD)
    fi
    ;;
  working-tree)
    collect_name_status < <(git diff --cached --name-status -z --diff-filter=ACMRD)
    collect_name_status < <(git diff --name-status -z --diff-filter=ACMRD)
    while IFS= read -r -d '' path; do
      append_path "$path"
    done < <(git ls-files --others --exclude-standard -z)
    ;;
  paths)
    [ "${#explicit_paths[@]}" -gt 0 ] || {
      echo "paths mode requires at least one PATH" >&2
      exit 2
    }
    for path in "${explicit_paths[@]}"; do
      path="$(repo_relative_path "$path")"
      if [ -d "$path" ]; then
        while IFS= read -r -d '' child; do
          append_path "$child"
        done < <(git ls-files --cached --others --exclude-standard -z -- "$path")
      else
        append_path "$path"
      fi
    done
    ;;
esac

need_core=0
need_runtime=0
need_app=0
need_catalog=0
need_ui=0
need_mister=0
need_agent=0
need_stream=0
need_desktop=0
need_docs=0
need_validation_routing=0
need_host_tools_fast=0
format_all=0
format_app_mister=0
format_ui_generated=0
format_magik_core=0
format_catalog=0
format_framebuffer_stream=0
format_agent_protocol=0
format_media_contract=0
format_latch_contract=0
format_scanout_contract=0
format_mister_host=0
format_mister_agent=0
format_mister_runtime=0
format_desktop=0

for path in "${paths[@]}"; do
  case "$path" in
    scripts/validate|scripts/tests/test-validate.sh)
      need_validation_routing=1 ;;
  esac
  case "$path" in
    scripts/*|.githooks/*|AGENTS.md|*/AGENTS.md|docs/agents/*|.github/workflows/*|\
    apps/mister/build-arm*.sh|apps/mister/Dockerfile*|apps/mister/Cross.toml|apps/mister/scripts/*|apps/mister/rust-toolchain.toml|\
    Cargo.toml|Cargo.lock|rust-toolchain.toml|.cargo/*)
      need_host_tools_fast=1 ;;
  esac
  case "$path" in
    rustfmt.toml|.rustfmt.toml|apps/mister/rust-toolchain.toml)
      format_all=1 ;;
    apps/mister/ui-generated/*.rs|apps/mister/ui-generated/**/*.rs)
      format_ui_generated=1 ;;
    apps/mister/*.rs|apps/mister/**/*.rs)
      format_app_mister=1 ;;
    crates/magik-core/*.rs|crates/magik-core/**/*.rs)
      format_magik_core=1 ;;
    crates/catalog/*.rs|crates/catalog/**/*.rs)
      format_catalog=1 ;;
    crates/framebuffer-stream/*.rs|crates/framebuffer-stream/**/*.rs)
      format_framebuffer_stream=1 ;;
    crates/agent-protocol/*.rs|crates/agent-protocol/**/*.rs)
      format_agent_protocol=1 ;;
    crates/media-contract/*.rs|crates/media-contract/**/*.rs)
      format_media_contract=1 ;;
    mister/platform/contracts/latch/*.rs|mister/platform/contracts/latch/**/*.rs)
      format_latch_contract=1 ;;
    mister/platform/contracts/scanout/*.rs|mister/platform/contracts/scanout/**/*.rs)
      format_scanout_contract=1 ;;
    mister/tools/host/*.rs|mister/tools/host/**/*.rs)
      format_mister_host=1 ;;
    mister/tools/agent/*.rs|mister/tools/agent/**/*.rs)
      format_mister_agent=1 ;;
    mister/platform/runtime/*.rs|mister/platform/runtime/**/*.rs)
      format_mister_runtime=1 ;;
    apps/desktop/*.rs|apps/desktop/**/*.rs)
      format_desktop=1 ;;
  esac
  case "$path" in
    crates/catalog/*)
      need_catalog=1; need_runtime=1; need_app=1; need_ui=1; need_mister=1 ;;
    crates/magik-core/*)
      need_core=1; need_runtime=1; need_app=1; need_ui=1 ;;
    mister/platform/runtime/*)
      need_runtime=1; need_app=1; need_ui=1 ;;
    apps/mister/src/*)
      need_app=1; need_ui=1 ;;
    apps/mister/ui/*|apps/mister/ui-generated/*)
      need_ui=1 ;;
    apps/mister/Cargo.toml|apps/mister/Cargo.lock|apps/mister/build.rs|apps/mister/.cargo/*)
      need_app=1; need_ui=1 ;;
    apps/mister/rust-toolchain.toml)
      need_catalog=1; need_core=1; need_runtime=1; need_app=1; need_ui=1; need_mister=1; need_agent=1
      need_stream=1; need_desktop=1 ;;
    apps/mister/build-arm*.sh|apps/mister/Dockerfile*|apps/mister/Cross.toml|apps/mister/scripts/*)
      need_app=1; need_ui=1 ;;
    mister/tools/host/*)
      need_mister=1 ;;
    mister/tools/agent/*)
      need_agent=1 ;;
    crates/framebuffer-stream/*)
      need_runtime=1; need_app=1; need_ui=1; need_agent=1; need_stream=1; need_desktop=1 ;;
    apps/desktop/*)
      need_desktop=1 ;;
    documentation/*)
      need_docs=1 ;;
    Cargo.toml|Cargo.lock|rust-toolchain.toml|.cargo/*)
      need_catalog=1; need_core=1; need_runtime=1; need_app=1; need_ui=1; need_mister=1; need_agent=1
      need_stream=1; need_desktop=1; need_docs=1 ;;
  esac
done

plan=()
if [ "$format_all" -eq 1 ]; then
  plan+=(format)
else
  [ "$format_app_mister" -eq 1 ] && plan+=(format-app-mister)
  [ "$format_ui_generated" -eq 1 ] && plan+=(format-ui-generated)
  [ "$format_magik_core" -eq 1 ] && plan+=(format-magik-core)
  [ "$format_catalog" -eq 1 ] && plan+=(format-catalog)
  [ "$format_framebuffer_stream" -eq 1 ] && plan+=(format-framebuffer-stream)
  [ "$format_agent_protocol" -eq 1 ] && plan+=(format-agent-protocol)
  [ "$format_media_contract" -eq 1 ] && plan+=(format-media-contract)
  [ "$format_latch_contract" -eq 1 ] && plan+=(format-latch-contract)
  [ "$format_scanout_contract" -eq 1 ] && plan+=(format-scanout-contract)
  [ "$format_mister_host" -eq 1 ] && plan+=(format-mister-host)
  [ "$format_mister_agent" -eq 1 ] && plan+=(format-mister-agent)
  [ "$format_mister_runtime" -eq 1 ] && plan+=(format-mister-runtime)
  [ "$format_desktop" -eq 1 ] && plan+=(format-desktop)
fi
if [ "$need_validation_routing" -eq 1 ] && [ "${MISTER_VALIDATE_ROUTING_CHILD:-0}" != 1 ]; then
  plan+=(validation-routing)
fi
[ "$need_host_tools_fast" -eq 1 ] && plan+=(host-tools-fast)
[ "$need_core" -eq 1 ] && plan+=(magik-core-tests magik-core-clippy)
[ "$need_runtime" -eq 1 ] && plan+=(mister-runtime-tests mister-runtime-clippy)
[ "$need_app" -eq 1 ] && plan+=(host-tests mister-app-clippy)
[ "$need_catalog" -eq 1 ] && plan+=(catalog-tests catalog-clippy)
[ "$need_ui" -eq 1 ] && plan+=(production-ui-check)
[ "$need_stream" -eq 1 ] && plan+=(framebuffer-stream-tests framebuffer-stream-clippy)
[ "$need_mister" -eq 1 ] && plan+=(mister-tests mister-clippy)
[ "$need_agent" -eq 1 ] && plan+=(agent-tests agent-clippy)
[ "$need_desktop" -eq 1 ] && plan+=(desktop-tests desktop-compiled-check)
[ "$need_docs" -eq 1 ] && plan+=(documentation-build)

if [ "$print_plan" -eq 1 ]; then
  [ "${#plan[@]}" -eq 0 ] || printf '%s\n' "${plan[@]}"
  exit 0
fi

init_reporting
status=0
run_affected_plan || status=$?
emit_results "$mode" "${plan[@]}"
exit "$status"
