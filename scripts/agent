#!/usr/bin/env bash
# Copyright (C) 2026 Nigel Breslaw
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MANIFEST="${MISTER_AGENT_CLI_MANIFEST:-$ROOT/agent-cli/Cargo.toml}"
SOURCE_ROOT="$(dirname "$MANIFEST")"
TARGET_ROOT="${CARGO_TARGET_DIR:-$SOURCE_ROOT/target}"
BINARY="${MISTER_AGENT_CLI_BINARY:-$TARGET_ROOT/release/agent-cli}"
LOCK="$TARGET_ROOT/.agent-cli-build-lock"

INPUTS=(
  "$MANIFEST"
  "$SOURCE_ROOT/Cargo.lock"
  "$SOURCE_ROOT/src"
  "$SOURCE_ROOT/../mister/tools/host/Cargo.toml"
  "$SOURCE_ROOT/../mister/tools/host/src"
  "$SOURCE_ROOT/../crates/catalog/Cargo.toml"
  "$SOURCE_ROOT/../crates/catalog/src"
  "$SOURCE_ROOT/../crates/catalog/data"
  "$SOURCE_ROOT/../crates/media-contract/Cargo.toml"
  "$SOURCE_ROOT/../crates/media-contract/src"
  "$SOURCE_ROOT/../crates/agent-protocol/Cargo.toml"
  "$SOURCE_ROOT/../crates/agent-protocol/src"
)

inputs_are_stale() {
  local input
  [[ -x "$BINARY" ]] || return 0
  for input in "${INPUTS[@]}"; do
    [[ -e "$input" ]] || continue
    if [[ -f "$input" && "$input" -nt "$BINARY" ]]; then
      return 0
    fi
    if [[ -d "$input" && -n "$(find "$input" -type f -newer "$BINARY" -print -quit)" ]]; then
      return 0
    fi
  done
  return 1
}

if inputs_are_stale; then
  mkdir -p "$TARGET_ROOT"
  waited=0
  until mkdir "$LOCK" 2>/dev/null; do
    if (( waited >= 1200 )); then
      echo "agent-cli build lock timed out" >&2
      exit 1
    fi
    sleep 0.05
    waited=$((waited + 1))
  done
  cleanup() { rmdir "$LOCK" 2>/dev/null || true; }
  trap cleanup EXIT INT TERM

  # Another launcher may have completed the build while this process waited.
  if inputs_are_stale; then
    cargo build --release --locked --quiet --manifest-path "$MANIFEST"
  fi
  cleanup
  trap - EXIT INT TERM
fi

exec "$BINARY" "$@"
