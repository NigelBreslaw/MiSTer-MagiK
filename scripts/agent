#!/bin/bash
# Copyright (C) 2026 Nigel Breslaw
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
DELIVERY_TIMING=0
for argument in "$@"; do
  if [[ "$argument" == "deliver" ]]; then
    DELIVERY_TIMING=1
    break
  fi
done
WRAPPER_STARTED=$SECONDS
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/shared-worktree-cache.sh"
if [[ "${1:-}" == "plan" ]]; then
  shift
  exec python3 "$ROOT/scripts/checks/pre-push.py" --repository "$ROOT" --plan "$@"
fi
if [[ "${1:-}" == "guidance" ]]; then
  shift
  exec python3 "$ROOT/scripts/magik_ci/guidance.py" --repository "$ROOT" "$@"
fi
MANIFEST="${MISTER_AGENT_CLI_MANIFEST:-$ROOT/agent-cli/Cargo.toml}"
SOURCE_ROOT="$(dirname "$MANIFEST")"
CONTENT_BINARY=0
if [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
  TARGET_ROOT="$CARGO_TARGET_DIR"
elif [[ "$MANIFEST" == "$ROOT/agent-cli/Cargo.toml" ]]; then
  PRIMARY_CHECKOUT="$(shared_primary_checkout "$ROOT")"
  TARGET_ROOT="$PRIMARY_CHECKOUT/agent-cli/target"
  [[ -n "${MISTER_AGENT_CLI_BINARY:-}" ]] || CONTENT_BINARY=1
else
  TARGET_ROOT="$SOURCE_ROOT/target"
fi
PROFILE="${MISTER_AGENT_CLI_PROFILE:-debug}"
case "$PROFILE" in
  debug)
    PROFILE_DIR=debug
    BUILD_ARGS=(build --locked --quiet)
    ;;
  release)
    PROFILE_DIR=release
    BUILD_ARGS=(build --release --locked --quiet)
    ;;
  *)
    echo "MISTER_AGENT_CLI_PROFILE must be debug or release; got $PROFILE" >&2
    exit 2
    ;;
esac
BUILD_BINARY="$TARGET_ROOT/$PROFILE_DIR/agent-cli"
LOCK="$TARGET_ROOT/.agent-cli-build-lock"
BUILD_LOCK_SECONDS=0
BUILD_SECONDS=0
BUILD_LOCK_STATUS=skipped
BUILD_STATUS=skipped

REQUIRED_INPUTS=(
  "$MANIFEST"
  "$SOURCE_ROOT/Cargo.lock"
  "$SOURCE_ROOT/src"
)
DEPENDENCY_INPUTS=(
  "$SOURCE_ROOT/../crates/catalog/Cargo.toml"
  "$SOURCE_ROOT/../crates/catalog/src"
  "$SOURCE_ROOT/../crates/catalog/data"
  "$SOURCE_ROOT/../crates/media-contract/Cargo.toml"
  "$SOURCE_ROOT/../crates/media-contract/src"
  "$SOURCE_ROOT/../crates/agent-protocol/Cargo.toml"
  "$SOURCE_ROOT/../crates/agent-protocol/src"
)

input_identity() {
  {
    git -C "$ROOT" rev-parse HEAD
    git -C "$ROOT" diff --binary --no-ext-diff HEAD --
  } | shasum -a 256 | awk '{print $1}'
}

if ((CONTENT_BINARY)); then
  INPUT_IDENTITY="$(input_identity)"
  BINARY="$TARGET_ROOT/agent-cli-bootstrap/$PROFILE_DIR/$INPUT_IDENTITY/agent-cli"
else
  BINARY="${MISTER_AGENT_CLI_BINARY:-$BUILD_BINARY}"
fi

inputs_are_stale() {
  local input newer
  local directories=()
  [[ -x "$BINARY" ]] || return 0
  ((CONTENT_BINARY)) && return 1
  for input in "${REQUIRED_INPUTS[@]}"; do
    [[ -e "$input" ]] || return 0
    if [[ -f "$input" && "$input" -nt "$BINARY" ]]; then
      return 0
    fi
    [[ ! -d "$input" ]] || directories+=("$input")
  done
  for input in "${DEPENDENCY_INPUTS[@]}"; do
    [[ -e "$input" ]] || continue
    if [[ -f "$input" && "$input" -nt "$BINARY" ]]; then
      return 0
    fi
    [[ ! -d "$input" ]] || directories+=("$input")
  done
  if ((${#directories[@]})); then
    if ! newer="$(find "${directories[@]}" -type f -newer "$BINARY" -print -quit)"; then
      return 0
    fi
    [[ -z "$newer" ]] || return 0
  fi
  return 1
}

input_scan_started=$SECONDS
INPUTS_STALE=0
if inputs_are_stale; then
  INPUTS_STALE=1
fi
INPUT_SCAN_SECONDS=$((SECONDS - input_scan_started))

if (( INPUTS_STALE )); then
  mkdir -p "$TARGET_ROOT"
  waited=0
  lock_started=$SECONDS
  until mkdir "$LOCK" 2>/dev/null; do
    if (( waited >= 1200 )); then
      echo "agent-cli build lock timed out" >&2
      exit 1
    fi
    sleep 0.05
    waited=$((waited + 1))
  done
  BUILD_LOCK_SECONDS=$((SECONDS - lock_started))
  BUILD_LOCK_STATUS=passed
  cleanup() { rmdir "$LOCK" 2>/dev/null || true; }
  trap cleanup EXIT INT TERM

  # Another launcher may have completed the build while this process waited.
  if inputs_are_stale; then
    build_started=$SECONDS
    CARGO_TARGET_DIR="$TARGET_ROOT" MISTER_AGENT_CLI_BINARY="$BINARY" \
      cargo "${BUILD_ARGS[@]}" --manifest-path "$MANIFEST"
    if ((CONTENT_BINARY)); then
      destination="$(dirname "$BINARY")"
      mkdir -p "$destination"
      temporary="$destination/.agent-cli.$$"
      cp "$BUILD_BINARY" "$temporary"
      chmod +x "$temporary"
      mv "$temporary" "$BINARY"
    fi
    BUILD_SECONDS=$((SECONDS - build_started))
    BUILD_STATUS=passed
  fi
  cleanup
  trap - EXIT INT TERM
fi

if (( DELIVERY_TIMING )); then
  printf 'delivery-timing: scope=wrapper phase=input-scan status=passed seconds=%d.000\n' "$INPUT_SCAN_SECONDS" >&2
  printf 'delivery-timing: scope=wrapper phase=build-lock status=%s seconds=%d.000\n' "$BUILD_LOCK_STATUS" "$BUILD_LOCK_SECONDS" >&2
  printf 'delivery-timing: scope=wrapper phase=agent-cli-build status=%s seconds=%d.000\n' "$BUILD_STATUS" "$BUILD_SECONDS" >&2
  printf 'delivery-timing: scope=wrapper phase=bootstrap-total status=passed seconds=%d.000\n' "$((SECONDS - WRAPPER_STARTED))" >&2
fi

exec "$BINARY" "$@"
