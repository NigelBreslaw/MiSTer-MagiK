# Keep commits responsive. Full verification runs at pre-push and in CI.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

exec python3 "$ROOT/scripts/checks/run-with-deadline.py" \
  --seconds 10 \
  --label "pre-commit validation" \
  -- python3 "$ROOT/scripts/checks/pre-commit.py" --repository "$ROOT"
