set -euo pipefail

# Git exports these variables while invoking a hook. Clear them before the
# fixture tests create temporary repositories, otherwise their Git commands
# can accidentally operate on this repository's worktree administration.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

exec python3 "$ROOT/scripts/checks/pre-push.py" --repository "$ROOT" --remote "$1"
